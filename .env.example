# Sama Ecole — modèle de variables d'environnement
#
# Copier en `.env` pour le développement local (Docker Compose le lit automatiquement — voir
# docker-compose.yml) ou configurer ces mêmes clés comme variables d'environnement sur la plateforme
# d'hébergement en Staging/Production. AUCUNE valeur réelle ne doit être committée (AGENTS.md,
# section « Ne jamais faire »).
#
# Convention ASP.NET Core : `Section__Cle` (double underscore) correspond à `Section:Cle` dans
# appsettings.json — une variable d'environnement définie ici prévaut toujours sur la valeur du
# fichier JSON. Les intégrations optionnelles (PayDunya, Smtp, Sms, WhatsApp) traitent la valeur
# littérale "REMPLACER" comme NON CONFIGURÉE (voir *Options.IsConfigured dans SamaEcole.Infrastructure) :
# utile pour désactiver une intégration en développement sans lever d'exception au démarrage.

# ─── Base de données — PostgreSQL uniquement (AGENTS.md règles #1 et #2) ──────────────────────────

# Rôle APPLICATIF (sama_ecole_app) : NOSUPERUSER, NOBYPASSRLS, soumis à la Row-Level Security sur
# toutes les tables tenant. REQUIS — l'application refuse de démarrer si cette clé est absente
# (SamaEcole.Persistence.DependencyInjection.AddPersistence).
ConnectionStrings__Default=Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=YOUR_SUPABASE_USER;Password=YOUR_PASSWORD;SslMode=Require;Trust Server Certificate=true;Search Path=public

# Rôle PROPRIÉTAIRE (sama_ecole) : réservé aux migrations (`dotnet ef database update`, conteneur
# `migrate` de docker-compose, outil SamaEcole.Tools MigrateCommand). NE JAMAIS l'utiliser côté
# application — PostgreSQL exempte le propriétaire d'une table de ses policies RLS, et RlsGuard refuse
# le démarrage si le rôle applicatif s'avère être ce rôle.
ConnectionStrings__Migrations=Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=YOUR_SUPABASE_OWNER_USER;Password=YOUR_OWNER_PASSWORD;SslMode=Require;Trust Server Certificate=true;Search Path=public

# Optionnel, DÉVELOPPEMENT UNIQUEMENT — alternative à ConnectionStrings__Migrations pour le semis
# initial de données (DbSeeder, actif seulement en Development). Sans double underscore car lue
# directement via IConfiguration["DATABASE_OWNER_CONNECTION_STRING"] (Program.cs). Si absente, le
# code retombe sur ConnectionStrings__Migrations puis ConnectionStrings__Default — inutile à définir
# si l'une des deux est déjà configurée.
# DATABASE_OWNER_CONNECTION_STRING=Host=localhost;Port=5432;Database=sama_ecole_dev;Username=sama_ecole;Password=changeme;Search Path=public

# ─── JWT — authentification (AGENTS.md règle #10 ; docs/Volume_7_Security.md) ──────────────────────
Jwt__Issuer=https://api.sama-ecole.sn
Jwt__Audience=sama-ecole-clients
# REQUIS — minimum 32 caractères, valeur aléatoire propre à chaque environnement. L'application refuse
# de démarrer si absent (voir Program.cs) ; ne JAMAIS réutiliser une clé de développement en production.
Jwt__SigningKey=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__AccessTokenMinutes=15

# ─── Authentification — verrouillage, réinitialisation (docs/Volume_7_Security.md §2) ─────────────
Auth__RefreshTokenDays=14
Auth__MaxFailedAttempts=5
Auth__PasswordResetMinutes=20
# REQUIS en Staging/Production — URL PUBLIQUE vue par l'utilisateur (sert à construire le lien de
# réinitialisation de mot de passe envoyé par e-mail ; jamais l'adresse interne du conteneur).
Auth__PublicBaseUrl=https://app.sama-ecole.sn

# ─── Reverse proxy — en-têtes transférés (Staging/Production UNIQUEMENT) ───────────────────────────
# Derrière Nginx (Volume 9 §2), sans ceci l'application voit l'IP du proxy à la place du client :
# les limiteurs de débit par IP (login, inscription publique, réinitialisation) s'effondrent sur une
# seule partition, et Request.Scheme reste "http" (UseHttpsRedirection boucle). Absent/false en
# Development (pas de proxy).
ForwardedHeaders__Enabled=true
# Nombre de proxys de confiance dans la chaîne X-Forwarded-For (1 = uniquement le Nginx en façade).
ForwardedHeaders__ForwardLimit=1
# OPTIONNEL — IP du/des proxy(s) de confiance, séparées par des virgules. À renseigner SI le port
# applicatif peut être atteint autrement que par le proxy (sinon un client pourrait usurper son IP
# source et contourner les limiteurs par IP). Laissé vide : on fait confiance à tout émetteur de
# X-Forwarded-* — acceptable uniquement si seul le proxy peut joindre l'application.
# ForwardedHeaders__KnownProxies=10.0.0.2,10.0.0.3

# ─── Paiement d'abonnement — PayDunya (AGENTS.md règle #11 ; ticket JGK-I05) ───────────────────────
# Les 4 clés sont vides/"REMPLACER" par défaut : sans elles, DevPaymentService prend le relais en
# Development uniquement ; PayDunyaPaymentService lève une exception explicite en Staging/Production
# plutôt que d'appeler l'agrégateur avec des clés invalides.
PayDunya__MasterKey=REMPLACER
PayDunya__PrivateKey=REMPLACER
PayDunya__PublicKey=REMPLACER
PayDunya__Token=REMPLACER
# Origine publique utilisée pour construire les URLs de retour/annulation/callback transmises à PayDunya.
PayDunya__PublicBaseUrl=https://app.sama-ecole.sn
# Optionnel — inchangées entre bac à sable et production chez PayDunya (seules les 4 clés ci-dessus
# distinguent les deux modes) ; ne redéfinir que si PayDunya change ces URLs.
# PayDunya__ApiBaseUrl=https://app.paydunya.com/api/v1
# PayDunya__CheckoutBaseUrl=https://paydunya.com/checkout/invoice

# ─── E-mail — SMTP (ticket JGK-G03) ─────────────────────────────────────────────────────────────────
# Sans configuration complète, LoggingEmailSender prend le relais en Development uniquement ;
# EmailSenderGuard bloque le démarrage en Staging/Production si absent.
Smtp__Host=REMPLACER
Smtp__Port=587
Smtp__User=REMPLACER
Smtp__Password=REMPLACER
Smtp__FromAddress=REMPLACER
# Renonciation EXPLICITE à cette garde, pour un déploiement qui doit monter sans e-mail (recette,
# démonstration, première mise en service avant l'obtention des identifiants SMTP). Contrairement à
# Development, l'application NE retombe PAS sur LoggingEmailSender : elle utilise
# UnconfiguredEmailSender, qui ne journalise aucun corps de message — le mot de passe provisoire du
# Directeur ne peut donc pas fuiter dans les journaux — et qui ÉCHOUE au premier envoi plutôt que de
# faire croire qu'un message est parti. Un avertissement est émis à chaque démarrage.
# Ne jamais laisser à true sur un environnement dont les utilisateurs ont besoin de leurs e-mails.
# Smtp__AllowUnconfigured=true

# ─── SMS — notifications sortantes (formule Premium, Feature.SmsNotifications — AGENTS.md) ────────
Sms__Provider=Infobip
Sms__BaseUrl=REMPLACER
Sms__ApiKey=REMPLACER
Sms__SenderId=REMPLACER
Sms__AuthScheme=App
# Secret HMAC-SHA256 DISTINCT de Sms__ApiKey — authentifie les accusés de réception entrants
# (SmsWebhooksController). Sans lui, le webhook d'accusés refuse TOUT appel (échec sûr par défaut).
# Ne jamais réutiliser Sms__ApiKey ici : une fuite de la clé sortante ne doit pas autoriser l'écriture
# dans l'historique des envois.
Sms__WebhookSecret=REMPLACER
# Cadence du worker d'envoi (SmsQueueHostedService) — valeurs par défaut raisonnables, à ne redéfinir
# qu'en cas de besoin spécifique.
# Sms__Queue__BatchSize=20
# Sms__Queue__MaxAttempts=3

# ─── WhatsApp — API Cloud Meta ──────────────────────────────────────────────────────────────────────
WhatsApp__BaseUrl=REMPLACER
WhatsApp__AccessToken=REMPLACER
# Endpoint de dépôt des pièces jointes — requis EN PLUS de BaseUrl/AccessToken pour joindre des PDF
# (bulletins) aux messages WhatsApp.
WhatsApp__MediaUrl=REMPLACER

# ─── Cache applicatif — Redis (docs/Volume_3_DDS.md §2.5 ; prévu dès la V1) ─────────────────────────
# Enregistré par anticipation (ITenantCacheKeyFactory) pour qu'un futur ajout de cache n'ait jamais à
# composer une clé « à la main » — toute clé embarque systématiquement le SchoolId du tenant courant
# (AGENTS.md règle #2). Pas encore consommé par un IDistributedCache à ce jour ; le cache KPI ci-dessous
# utilise IMemoryCache en attendant.
Redis__ConnectionString=YOUR_REDIS_HOST:6379

# ─── Cache KPI (dashboards Finance/Directeur — IMemoryCache derrière IKpiCacheService) ─────────────
# Désactivé explicitement dans les tests fonctionnels (AuthApiFactory) pour qu'un dashboard lu deux
# fois dans la même classe de tests reflète toujours l'état réel après une mutation.
# Kpi__Cache__Enabled=true
# Kpi__Cache__TtlMinutes=7

# ─── Tâches de fond (optionnel — désactivées explicitement dans les tests fonctionnels) ───────────
# Finance__DebtorAging__Enabled=true
# Subscriptions__Lifecycle__Enabled=true

# ─── Développement local uniquement (Docker Compose — voir docker-compose.yml) ────────────────────
# Pilotent les identifiants Postgres LOCAUX du conteneur `postgres`. Jamais utilisées telles quelles en
# Staging/Production : là-bas, ConnectionStrings__Default et ConnectionStrings__Migrations ci-dessus
# pointent directement vers la base managée.
# DB_USER=sama_ecole
# DB_PASSWORD=changeme
# DB_NAME=sama_ecole_dev
# DB_APP_USER=sama_ecole_app
# DB_APP_PASSWORD=changeme_app
