# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne JAMAIS committer le fichier .env — voir .gitignore.

# --- Base de données (PostgreSQL uniquement) ---
# DEUX rôles, et ce n'est pas négociable (ticket JGK-A03, AGENTS.md règle #2) :
#
#   * DB_USER (propriétaire)      : migrations SEULEMENT. PostgreSQL exempte le propriétaire d'une
#                                   table de ses policies RLS — l'utiliser au runtime désactiverait
#                                   silencieusement l'isolation multi-tenant.
#   * DB_APP_USER (applicatif)    : runtime. NOSUPERUSER, NOBYPASSRLS, propriétaire d'aucune table,
#                                   donc pleinement soumis aux policies.
#
# L'application REFUSE de démarrer si ConnectionStrings__Default pointe sur un rôle qui contourne
# la RLS (voir RlsGuard) : c'est voulu, ne le contournez pas en repassant sur le propriétaire.
DB_USER=sama_ecole
DB_PASSWORD=changeme
DB_NAME=sama_ecole_dev
DB_APP_USER=sama_ecole_app
DB_APP_PASSWORD=changeme_app

ConnectionStrings__Default=Host=localhost;Port=5432;Database=sama_ecole_dev;Username=sama_ecole_app;Password=changeme_app
ConnectionStrings__Migrations=Host=localhost;Port=5432;Database=sama_ecole_dev;Username=sama_ecole;Password=changeme

# --- JWT ---
Jwt__Issuer=https://api.sama-ecole.sn
Jwt__Audience=sama-ecole-clients
Jwt__SigningKey=REMPLACER_PAR_UNE_CLE_ALEATOIRE_256_BITS
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# --- Redis (cache, rate limiting) ---
Redis__ConnectionString=localhost:6379

# --- Envoi d'emails (réinitialisation de mot de passe, alertes d'abonnement) ---
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=no-reply@sama-ecole.sn
Smtp__Password=REMPLACER
Smtp__FromAddress=no-reply@sama-ecole.sn

# --- PayDunya (paiement d'abonnement, ticket JGK-I05) ---
# Compte marchand PayDunya requis (sandbox ou production) : https://paydunya.com. Les 4 clés se
# trouvent dans le tableau de bord marchand. Sans elles, PayDunyaPaymentService refuse explicitement
# d'appeler l'agrégateur (voir sa garde) plutôt que d'envoyer une requête vouée à un 401.
PayDunya__MasterKey=REMPLACER
PayDunya__PrivateKey=REMPLACER
PayDunya__PublicKey=REMPLACER
PayDunya__Token=REMPLACER
# Origine publique de Sama Ecole, utilisée pour construire les URLs de retour/annulation/callback
# transmises à PayDunya (API et pages Razor partagent le même hôte dans ce projet).
PayDunya__PublicBaseUrl=https://app.sama-ecole.sn

# --- Stockage fichiers (logos d'établissement, bulletins PDF générés) ---
Storage__Provider=S3Compatible
Storage__Endpoint=https://REMPLACER.s3.example.com
Storage__Bucket=sama-ecole-documents
Storage__AccessKey=REMPLACER
Storage__SecretKey=REMPLACER

# --- Environnement ---
ASPNETCORE_ENVIRONMENT=Development
