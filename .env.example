# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne JAMAIS committer le fichier .env — voir .gitignore.

# --- Base de données (PostgreSQL uniquement) ---
DB_USER=jangalekat
DB_PASSWORD=changeme
DB_NAME=jangalekat_dev
ConnectionStrings__Default=Host=localhost;Port=5432;Database=jangalekat_dev;Username=jangalekat;Password=changeme

# --- JWT ---
Jwt__Issuer=https://api.jangalekat.sn
Jwt__Audience=jangalekat-clients
Jwt__SigningKey=REMPLACER_PAR_UNE_CLE_ALEATOIRE_256_BITS
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# --- Redis (cache, rate limiting) ---
Redis__ConnectionString=localhost:6379

# --- Envoi d'emails (réinitialisation de mot de passe, alertes d'abonnement) ---
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=no-reply@jangalekat.sn
Smtp__Password=REMPLACER
Smtp__FromAddress=no-reply@jangalekat.sn

# --- Stockage fichiers (logos d'établissement, bulletins PDF générés) ---
Storage__Provider=S3Compatible
Storage__Endpoint=https://REMPLACER.s3.example.com
Storage__Bucket=jangalekat-documents
Storage__AccessKey=REMPLACER
Storage__SecretKey=REMPLACER

# --- Environnement ---
ASPNETCORE_ENVIRONMENT=Development
