@*
    Vue: Views/Home/AnnuaireB2C.cshtml
    Description: Page Annuaire B2C (Portail d'orientation)
*@

@{
    ViewData["Title"] = "Trouvez l'école idéale";
    Layout = "_LayoutPublic";
}

@section Scripts {
    <script src="~/js/public-directory.js" asp-append-version="true"></script>
}

@* GetPublicSchoolsQuery (PublicDirectoryController) n'accepte que trois critères : recherche sur le
   nom, ville exacte, et UN SEUL cycle à la fois — pas de filtre "type d'établissement" (public/privé),
   la vue SQL public_school_directory ne l'expose pas. *@
<div x-data="publicDirectoryView()">

<!-- Header & Search Bar -->
<div class="bg-indigo-700 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        @* Bandeau bleu foncé : le lockup bleu-sur-transparent y disparaîtrait — on prend donc la
           version sur fond blanc (logo-unikol-solid.png), qui s'y lit comme un cartouche. *@
        <img src="~/images/logo-unikol-solid.png" asp-append-version="true" alt="Unikol"
             class="mx-auto mb-8 h-24 w-auto rounded-2xl shadow-lg" />
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
            Trouvez l'établissement idéal pour votre enfant
        </h1>
        <p class="mt-4 max-w-2xl text-xl text-indigo-200 mx-auto">
            Recherchez parmi les établissements du Sénégal référencés sur Unikol.
        </p>

        <!-- Search Form -->
        <div class="mt-10 max-w-3xl mx-auto">
            <form class="flex flex-col sm:flex-row shadow-lg rounded-lg overflow-hidden bg-white" x-on:submit.prevent="applyFilters()">
                <div class="flex-1 min-w-0 px-4 py-3 border-b sm:border-b-0 sm:border-r border-gray-200">
                    <label for="search" class="sr-only">Nom de l'école</label>
                    <div class="flex items-center">
                        <icon name="search" class="h-5 w-5 text-gray-400 mr-2 shrink-0" />
                        <input type="text" name="search" id="search" x-model="search" x-on:input.debounce.400ms="applyFilters()"
                               class="block w-full focus:ring-0 focus:outline-none border-none sm:text-lg" placeholder="Ex: Lycée d'Excellence...">
                    </div>
                </div>
                <div class="flex-1 min-w-0 px-4 py-3 border-b sm:border-b-0 sm:border-r border-gray-200">
                    <label for="location" class="sr-only">Ville</label>
                    <div class="flex items-center">
                        <icon name="globe" class="h-5 w-5 text-gray-400 mr-2 shrink-0" />
                        <input type="text" name="location" id="location" x-model="city" x-on:input.debounce.400ms="applyFilters()"
                               class="block w-full focus:ring-0 focus:outline-none border-none sm:text-lg" placeholder="Dakar, Thiès...">
                    </div>
                </div>
                <button type="submit" class="w-full sm:w-auto flex items-center justify-center px-8 py-3 sm:py-4 border border-transparent text-base font-medium text-white bg-indigo-600 hover:bg-indigo-800 transition-colors">
                    Rechercher
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Filters & Results Grid -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- Sidebar Filters -->
        <aside class="w-full lg:w-64 flex-shrink-0">
            <h2 class="text-lg font-medium text-gray-900 mb-4">Filtres</h2>

            <div class="border-t border-gray-200 pt-4">
                <h3 class="text-sm font-medium text-gray-900 mb-3">Niveau</h3>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <input id="level-all" name="level" type="radio" value="" x-model="cycle" x-on:change="applyFilters()"
                               class="radio-field">
                        <label for="level-all" class="ml-3 text-sm text-gray-600">Tous les niveaux</label>
                    </div>
                    <div class="flex items-center">
                        <input id="level-primaire" name="level" type="radio" value="Primaire" x-model="cycle" x-on:change="applyFilters()"
                               class="radio-field">
                        <label for="level-primaire" class="ml-3 text-sm text-gray-600">Préscolaire / Primaire</label>
                    </div>
                    <div class="flex items-center">
                        <input id="level-college" name="level" type="radio" value="College" x-model="cycle" x-on:change="applyFilters()"
                               class="radio-field">
                        <label for="level-college" class="ml-3 text-sm text-gray-600">Collège</label>
                    </div>
                    <div class="flex items-center">
                        <input id="level-lycee" name="level" type="radio" value="Lycee" x-model="cycle" x-on:change="applyFilters()"
                               class="radio-field">
                        <label for="level-lycee" class="ml-3 text-sm text-gray-600">Lycée</label>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Results Grid -->
        <main class="flex-1">
            <div class="mb-4 flex items-center justify-between">
                <p class="text-sm text-gray-500" x-show="!isLoading && !error">
                    Affichage de <span class="font-medium text-gray-900" x-text="rangeStart"></span>-<span class="font-medium text-gray-900" x-text="rangeEnd"></span> sur <span class="font-medium text-gray-900" x-text="totalCount"></span> écoles
                </p>
            </div>

            <div x-show="error" x-cloak class="mb-6 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="error"></div>

            <div x-show="isLoading" x-cloak class="py-16 text-center text-sm text-gray-500">
                Chargement des établissements…
            </div>

            <template x-if="!isLoading && !error && schools.length === 0">
                <empty-state icon="building" title="Aucun établissement ne correspond à votre recherche."
                             hint="Essayez un autre nom, une autre ville, ou retirez le filtre de niveau." />
            </template>

            <div x-show="!isLoading && schools.length > 0" x-cloak
                 class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                <template x-for="(school, index) in schools" :key="school.id">
                    <article class="dir-card-in group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 ease-in-out hover:-translate-y-1 hover:border-primary-200 hover:shadow-lg hover:shadow-primary-500/10"
                             :style="'animation-delay:' + Math.min(index * 60, 360) + 'ms'">

                        <!-- Bannière compacte : dégradé Unikol + motif abstrait, léger zoom au survol -->
                        <div class="relative h-20 overflow-hidden bg-gradient-to-br from-primary-500 via-primary-600 to-primary-700">
                            <div aria-hidden="true"
                                 class="absolute inset-0 transition-transform duration-500 ease-out group-hover:scale-110">
                                <span class="absolute -right-6 -top-10 h-28 w-28 rounded-full bg-white/15 blur-xl"></span>
                                <span class="absolute -left-8 -bottom-10 h-24 w-24 rounded-full bg-white/10 blur-lg"></span>
                                <span class="absolute right-1/3 top-2 h-10 w-10 rounded-full border border-white/20"></span>
                            </div>
                            <img :src="school.logoUrl" x-show="school.logoUrl" alt=""
                                 class="absolute inset-0 h-full w-full object-cover opacity-40 transition-transform duration-500 ease-out group-hover:scale-105">
                        </div>

                        <!-- Avatar superposé : badge circulaire (logo, sinon initiale sur dégradé) -->
                        <div class="relative -mt-9 px-5">
                            <div class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-full border-4 border-white bg-white shadow-md">
                                <img :src="school.logoUrl" x-show="school.logoUrl" alt=""
                                     class="h-full w-full object-contain p-1.5">
                                <span x-show="!school.logoUrl"
                                      class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary-500 to-primary-700 text-2xl font-bold text-white"
                                      x-text="(school.name || '?').charAt(0).toUpperCase()"></span>
                            </div>
                        </div>

                        <div class="flex flex-1 flex-col p-5 pt-3">
                            <h3 class="text-base font-bold leading-snug text-slate-900 line-clamp-2" x-text="school.name"></h3>

                            <p x-show="school.city || school.region"
                               class="mt-1.5 flex items-center gap-1.5 text-sm text-slate-500">
                                <icon name="map-pin" class="h-4 w-4 shrink-0 text-primary-400" />
                                <span class="truncate" x-text="[school.city, school.region].filter(Boolean).join(', ')"></span>
                            </p>

                            <p x-show="school.description"
                               class="mt-2 text-sm leading-relaxed text-slate-500 line-clamp-2" x-text="school.description"></p>

                            <!-- Cycles d'enseignement -->
                            <div x-show="school.cycles && school.cycles.length" class="mt-3 flex flex-wrap gap-1.5">
                                <template x-for="cycleLabel in school.cycles" :key="cycleLabel">
                                    <span class="inline-flex items-center rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-semibold text-primary-700 ring-1 ring-inset ring-primary-100"
                                          x-text="cycleLabel"></span>
                                </template>
                            </div>

                            <!-- Contact : icônes propres, liens cliquables tel:/mailto: -->
                            <div x-show="school.phone || school.email"
                                 class="mt-4 space-y-0.5 border-t border-slate-100 pt-3">
                                <a x-show="school.phone" :href="'tel:' + (school.phone || '')"
                                   class="-mx-1 flex items-center gap-2.5 rounded-lg px-1 py-1 text-sm text-slate-600 transition-colors hover:bg-primary-50/70 hover:text-primary-700">
                                    <icon name="phone" class="h-4 w-4 shrink-0 text-primary-400" />
                                    <span class="truncate" x-text="school.phone"></span>
                                </a>
                                <a x-show="school.email" :href="'mailto:' + (school.email || '')"
                                   class="-mx-1 flex items-center gap-2.5 rounded-lg px-1 py-1 text-sm text-slate-600 transition-colors hover:bg-primary-50/70 hover:text-primary-700">
                                    <icon name="envelope" class="h-4 w-4 shrink-0 text-primary-400" />
                                    <span class="truncate" x-text="school.email"></span>
                                </a>
                            </div>

                            <!-- Action principale, ancrée en bas de carte -->
                            <div class="mt-4 flex flex-1 items-end pt-1">
                                <a x-show="school.email || school.phone"
                                   :href="school.email ? ('mailto:' + school.email) : ('tel:' + (school.phone || ''))"
                                   class="inline-flex w-full items-center justify-center gap-1.5 rounded-xl bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-primary-700 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                                    Contacter l'établissement
                                    <icon name="chevron-right" class="h-4 w-4" />
                                </a>
                                <p x-show="!school.email && !school.phone"
                                   class="w-full text-center text-xs italic text-slate-400">
                                    Coordonnées non communiquées
                                </p>
                            </div>
                        </div>
                    </article>
                </template>
            </div>

            <!-- Pagination -->
            <div class="mt-8 flex items-center justify-between border-t border-gray-200 pt-6" x-show="totalCount > 0">
                <button type="button" x-on:click="goToPage(-1)" :disabled="page <= 1"
                        class="flex items-center text-sm font-medium text-gray-500 hover:text-gray-700 disabled:opacity-40 disabled:cursor-not-allowed">
                    <icon name="chevron-left" class="mr-2 h-4 w-4 text-gray-400" />
                    Précédent
                </button>
                <span class="text-sm text-gray-500">Page <span x-text="page"></span> sur <span x-text="totalPages"></span></span>
                <button type="button" x-on:click="goToPage(1)" :disabled="page >= totalPages"
                        class="flex items-center text-sm font-medium text-gray-500 hover:text-gray-700 disabled:opacity-40 disabled:cursor-not-allowed">
                    Suivant
                    <icon name="chevron-right" class="ml-2 h-4 w-4 text-gray-400" />
                </button>
            </div>
        </main>
    </div>
</div>
</div>
