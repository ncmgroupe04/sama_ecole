@{
 ViewData["Title"] = "Paramètres";
 var dateFormatOptions = new List<SelectFieldOption> {
 new("dd/MM/yyyy", "31/12/2026 (jj/MM/aaaa)"), new("dd MMMM yyyy", "31 décembre 2026 (jj mois aaaa)")
 };
}

@* auth.js et api.js sont chargés par _Layout. school-years.js alimente le spoke « Années
 scolaires » (composant schoolYearsView monté par la partial _SchoolYearsPanel).

 Ticket JGK-UI02 : navigation Hub & Spoke — sidebar verticale par pilier métier
 (_SettingsSidebar.cshtml) en remplacement des 7 anciens onglets horizontaux. Même composant
 Alpine settingsView() (settings.js), mêmes appels API : voir l'en-tête de settings.js pour le
 détail de la répartition des champs entre spokes. *@
@section Scripts {
 <script src="~/js/settings.js" asp-append-version="true"></script>
 <script src="~/js/school-years.js" asp-append-version="true"></script>
 <script src="~/js/users.js" asp-append-version="true"></script>
 <script src="~/js/audit-log.js" asp-append-version="true"></script>
 <script src="~/js/subscription-payments-history.js" asp-append-version="true"></script>
 <script src="~/js/sms-settings.js" asp-append-version="true"></script>
}

<div x-data="settingsView()">

 <!-- Titre -->
 <div>
 <h1 class="page-title">Paramètres</h1>
 <p class="page-subtitle">
 Configurez l'identité de votre établissement, ses réglages et ses années scolaires.
 </p>
 </div>

 <!-- Écriture réservée au Directeur (Volume 7 §15), sauf le barème, les matières et les mentions
 (JGK-G02, canManageGradingConfig) délégables au Secrétariat — SI le Directeur a coché la case
 dédiée (spoke « Notation & mentions »). Les autres rôles, et le Secrétariat sans délégation
 active, consultent en lecture seule. -->
 <div x-show="!isDirecteur && !canManageGradingConfig" x-cloak class="mt-4 rounded-xl border-l-4 border-primary bg-primary-50 p-3">
 <p class="text-sm text-primary-700">
 Seul le Directeur peut modifier les paramètres de l'établissement. Vous les consultez en lecture seule.
 </p>
 </div>
 <div x-show="isSecretariat && canManageGradingConfig" x-cloak class="mt-4 rounded-xl border-l-4 border-primary bg-primary-50 p-3">
 <p class="text-sm text-primary-700">
 Le Directeur vous a délégué la gestion du barème de notation, des matières/coefficients et des mentions du bulletin. Les autres réglages restent réservés au Directeur.
 </p>
 </div>

 <!-- ============================= COQUILLE HUB & SPOKE (JGK-UI02) ============================= -->
 <div class="mt-6 flex flex-col lg:flex-row gap-6 items-start">

 <!-- Bouton d'ouverture du tiroir, MOBILE/TABLETTE UNIQUEMENT (< lg) : le sidebar desktop est
 toujours visible en colonne fixe, ce bouton n'a donc aucune raison d'exister à partir de lg. -->
 <button type="button" x-on:click="settingsSidebarOpen = true"
 class="lg:hidden w-full flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm">
 <span class="flex items-center gap-2">
 <icon name="menu" class="w-4 h-4 text-slate-400" />
 Sections des paramètres
 </span>
 <icon name="chevron-right" class="w-4 h-4 text-slate-400" />
 </button>

 @await Html.PartialAsync("_SettingsSidebar")

 <!-- ============================= ZONE DE CONTENU (cartes blanches, fond neutre) ============================= -->
 <main class="flex-1 min-w-0 w-full">

 <!-- Chargement -->
 <div x-show="isLoading" class="flex items-center justify-center py-12">
 <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 </div>

 @await Html.PartialAsync("_ErrorBanner", "loadError")

 <!-- ============================= SPOKE : PROFIL DE L'ÉTABLISSEMENT ============================= -->
 <div x-show="!isLoading && !loadError && tab === 'profil'" x-cloak>
 <div class="card p-6 w-full">
 <form x-on:submit.prevent="saveProfile()" novalidate class="space-y-5 max-w-2xl">

 <div>
 <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Identité de l'établissement</h2>
 <p class="text-xs text-slate-400 mt-0.5">Ces informations figurent sur le reçu d'inscription et les documents officiels.</p>
 </div>

 <div>
 <label for="school-name" class="form-label form-label-required">Nom de l'établissement</label>
 <input id="school-name" type="text" x-model="profile.name" maxlength="200" :disabled="!isDirecteur"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.name && 'input-field-error'">
 <p x-show="profileErrors.name" x-cloak x-text="profileErrors.name" class="field-error"></p>
 </div>

 <div>
 <label for="school-address" class="form-label">Adresse</label>
 <input id="school-address" type="text" x-model="profile.address" maxlength="300" :disabled="!isDirecteur"
 placeholder="ex : Rue 12, Médina, Dakar"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500">
 <p class="mt-1 text-xs text-slate-400">La ville (dernier élément de l'adresse) apparaît dans le « Fait à … » du reçu.</p>
 <p x-show="profileErrors.address" x-cloak x-text="profileErrors.address" class="field-error"></p>
 </div>

 <div class="form-grid">
 <div>
 <label for="school-phone" class="form-label">Téléphone</label>
 <input id="school-phone" type="tel" x-model="profile.phone" maxlength="30" :disabled="!isDirecteur"
 placeholder="+221 77 000 00 00"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.phone && 'input-field-error'">
 <p x-show="profileErrors.phone" x-cloak x-text="profileErrors.phone" class="field-error"></p>
 </div>
 <div>
 <label for="school-email" class="form-label">E-mail</label>
 <input id="school-email" type="email" x-model="profile.email" maxlength="150" :disabled="!isDirecteur"
 placeholder="ex : contact@monecole.sn"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.email && 'input-field-error'">
 <p x-show="profileErrors.email" x-cloak x-text="profileErrors.email" class="field-error"></p>
 </div>
 </div>

 <div>
 <label for="school-logo" class="form-label">Logo de l'établissement</label>

 <div class="mt-2 flex flex-col sm:flex-row items-start sm:items-center gap-4">
 <!-- Prévisualisation du logo existante -->
 <div x-show="profile.logoUrl" x-cloak class="w-16 h-16 rounded-xl border border-slate-200 bg-white p-1.5 flex items-center justify-center shrink-0 shadow-sm overflow-hidden">
 <img :src="profile.logoUrl" alt="Logo établissement" class="max-w-full max-h-full object-contain">
 </div>
 <div x-show="!profile.logoUrl" x-cloak class="w-16 h-16 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 flex flex-col items-center justify-center shrink-0 text-slate-400">
 <icon name="image" class="w-6 h-6" />
 </div>

 <!-- Champ URL et bouton d'upload file input -->
 <div class="flex-1 w-full space-y-2">
 <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
 <div class="flex-1 flex items-center">
 <input id="school-logo" type="url" x-model="profile.logoUrl" maxlength="500" :disabled="!isDirecteur || isUploadingLogo"
 placeholder="Saisir l'URL https://… ou importer un fichier"
 class="input-field !my-0 w-full disabled:bg-slate-50 disabled:text-slate-500">
 </div>

 <label x-show="isDirecteur" class="cursor-pointer inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium shadow-sm transition-all duration-150 shrink-0 disabled:opacity-50 disabled:cursor-not-allowed">
 <template x-if="!isUploadingLogo">
 <span class="flex items-center gap-2">
 <icon name="upload-cloud" class="w-4 h-4 text-indigo-600" />
 <span>Choisir un fichier...</span>
 </span>
 </template>
 <template x-if="isUploadingLogo">
 <span class="flex items-center gap-2 text-indigo-600">
 <icon name="loader" class="w-4 h-4 animate-spin" />
 <span>Envoi en cours...</span>
 </span>
 </template>
 <input type="file" accept="image/png, image/jpeg, image/webp" class="hidden" :disabled="isUploadingLogo" x-on:change="uploadLogoFile($event)">
 </label>
 </div>
 <p class="text-xs text-slate-400">Formats acceptés : PNG, JPEG, WEBP. Taille maximale : 2 Mo.</p>
 <p x-show="logoUploadError" x-cloak x-text="logoUploadError" class="field-error !mt-0 font-medium"></p>
 <p x-show="profileErrors.logourl" x-cloak x-text="profileErrors.logourl" class="field-error !mt-0"></p>
 </div>
 </div>
 </div>

 @* Mentions légales de l'entreprise : ce qui fait du reçu une pièce opposable, et non un
 simple justificatif interne. Imprimées dans l'en-tête du reçu d'inscription. *@
 <div class="pt-5 border-t border-slate-100">
 <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Mentions légales</h3>
 <p class="text-xs text-slate-400 mt-0.5">Ces identifiants figurent dans l'en-tête des reçus imprimés. Laissez vide tant que vous ne les avez pas : la mention ne s'imprime pas.</p>

 <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-5">
 <div>
 <label for="school-ninea" class="form-label">NINEA</label>
 <input id="school-ninea" type="text" x-model="profile.ninea" maxlength="50" :disabled="!isDirecteur"
 placeholder="ex : 005151978"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.ninea && 'input-field-error'">
 <p x-show="profileErrors.ninea" x-cloak x-text="profileErrors.ninea" class="field-error"></p>
 </div>
 <div>
 <label for="school-rccm" class="form-label">Registre du commerce (RCCM)</label>
 <input id="school-rccm" type="text" x-model="profile.registreCommerce" maxlength="50" :disabled="!isDirecteur"
 placeholder="ex : SN DKR 2020 B 1234"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.registrecommerce && 'input-field-error'">
 <p x-show="profileErrors.registrecommerce" x-cloak x-text="profileErrors.registrecommerce" class="field-error"></p>
 </div>
 </div>
 </div>

 <div x-show="isDirecteur" x-cloak class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100 mt-2">
 <button type="submit" :disabled="profileSaving" class="btn-modal-primary group">
 <span x-text="profileSaving ? 'Enregistrement…' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </div>
 </div>

 <!-- ============================= SPOKE : INTÉGRATION ÉTATIQUE (SIMEN) ============================= -->
 @* Même <form> logique que le spoke « Profil » : les DEUX appellent saveProfile(), qui envoie
 TOUJOURS l'objet `profile` complet — voir settings.js. Regrouper IA/IEF avec le code SIMEN/GPS
 suit le ticket JGK-UI02 à la lettre (« Intégration Étatique : SIMEN, GPS, IEF »), alors qu'ils
 vivaient avant dans la colonne de droite du même onglet « Établissement ». *@
 <div x-show="!isLoading && !loadError && tab === 'integration-etatique'" x-cloak>
 <div class="card p-6 w-full">
 <form x-on:submit.prevent="saveProfile()" novalidate class="space-y-6 max-w-2xl">

 @* En-tête administratif du bulletin de notes (IA / IEF / LYCEE DE) : reproduit les
 trois premières lignes de docs/design-references/bulletin-reference.png. *@
 <div>
 <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Informations Académiques &amp; Administration</h3>
 <p class="text-xs text-slate-400 mt-0.5">Ces trois lignes forment l'en-tête officiel du bulletin de notes.</p>

 <div class="mt-4 space-y-5">
 <div class="form-grid">
 <div>
 <label for="school-ia" class="form-label">Inspection d'Académie (IA)</label>
 <input id="school-ia" type="text" x-model="profile.inspectionAcademie" maxlength="150" :disabled="!isDirecteur"
 placeholder="ex : Thies"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.inspectionacademie && 'input-field-error'">
 <p x-show="profileErrors.inspectionacademie" x-cloak x-text="profileErrors.inspectionacademie" class="field-error"></p>
 </div>
 <div>
 <label for="school-ief" class="form-label">Inspection de l'Éducation (IEF)</label>
 <input id="school-ief" type="text" x-model="profile.inspectionEducationFormation" maxlength="150" :disabled="!isDirecteur"
 placeholder="ex : Mbour 1"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.inspectioneducationformation && 'input-field-error'">
 <p x-show="profileErrors.inspectioneducationformation" x-cloak x-text="profileErrors.inspectioneducationformation" class="field-error"></p>
 </div>
 </div>
 <div>
 <label for="school-nom-lycee" class="form-label">Nom de l'établissement sur le bulletin</label>
 <input id="school-nom-lycee" type="text" x-model="profile.nomLycee" maxlength="150" :disabled="!isDirecteur"
 placeholder="ex : Popenguine"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500">
 <p class="mt-1 text-xs text-slate-400">N'indiquez que le nom, sans préfixe : « ÉCOLE ÉLÉMENTAIRE DE », « COLLÈGE DE » ou « LYCÉE DE » est ajouté automatiquement selon le cycle de la classe de l'élève.</p>
 <p x-show="profileErrors.nomlycee" x-cloak x-text="profileErrors.nomlycee" class="field-error"></p>
 </div>
 </div>
 </div>

 @* Intégration étatique (SIMEN) — module Intégration étatique (JGK-M05). Le code établissement
 national conditionne l'export Planète et la génération d'IEN provisoire : tant qu'il est vide,
 ces fonctions renvoient une erreur explicite. *@
 <div class="pt-6 border-t border-slate-100">
 <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Identifiants SIMEN</h3>
 <p class="text-xs text-slate-400 mt-0.5">
 Identifiants et localisation attendus par le ministère (Planète, STATEDUC, carte scolaire).
 Le code établissement national est indispensable à l'export Planète.
 </p>

 <div class="mt-4 space-y-5">
 <div>
 <label for="school-national-code" class="form-label">Code établissement national</label>
 <input id="school-national-code" type="text" x-model="profile.nationalSchoolCode" maxlength="30" :disabled="!isDirecteur"
 placeholder="ex : 012347"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.nationalschoolcode && 'input-field-error'">
 <p class="mt-1 text-xs text-slate-400">Tel qu'il figure sur les fichiers du SIMEN. Mis en majuscules à l'enregistrement, sans autre retouche.</p>
 <p x-show="profileErrors.nationalschoolcode" x-cloak x-text="profileErrors.nationalschoolcode" class="field-error"></p>
 </div>

 <div class="form-grid">
 <div>
 <label for="school-authorization" class="form-label">N° d'autorisation ministérielle</label>
 <input id="school-authorization" type="text" x-model="profile.ministryAuthorizationNumber" maxlength="80" :disabled="!isDirecteur"
 placeholder="Arrêté d'ouverture"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.ministryauthorizationnumber && 'input-field-error'">
 <p x-show="profileErrors.ministryauthorizationnumber" x-cloak x-text="profileErrors.ministryauthorizationnumber" class="field-error"></p>
 </div>
 <div>
 <label for="school-district" class="form-label">Code de circonscription scolaire</label>
 <input id="school-district" type="text" x-model="profile.schoolDistrictCode" maxlength="30" :disabled="!isDirecteur"
 placeholder="Carte scolaire"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.schooldistrictcode && 'input-field-error'">
 <p x-show="profileErrors.schooldistrictcode" x-cloak x-text="profileErrors.schooldistrictcode" class="field-error"></p>
 </div>
 </div>

 <div>
 <label class="form-label">Coordonnées GPS</label>
 <div class="form-grid">
 <input type="number" step="0.000001" min="-90" max="90" x-model="profile.gpsLatitude" :disabled="!isDirecteur"
 placeholder="Latitude (ex : 14.692800)"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.gpslatitude && 'input-field-error'">
 <input type="number" step="0.000001" min="-180" max="180" x-model="profile.gpsLongitude" :disabled="!isDirecteur"
 placeholder="Longitude (ex : -17.446700)"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500" :class="profileErrors.gpslongitude && 'input-field-error'">
 </div>
 <p class="mt-1 text-xs text-slate-400">Les deux ensemble, ou aucune. Séparateur décimal : le point.</p>
 <p x-show="profileErrors.gpslatitude" x-cloak x-text="profileErrors.gpslatitude" class="field-error"></p>
 <p x-show="profileErrors.gpslongitude" x-cloak x-text="profileErrors.gpslongitude" class="field-error"></p>
 <p x-show="profileErrors.global" x-cloak x-text="profileErrors.global" class="field-error"></p>
 <p x-show="profile.gpsCoordinates" x-cloak class="mt-1 text-xs text-slate-500">
 Enregistré : <span class="font-mono" x-text="profile.gpsCoordinates"></span>
 </p>
 </div>
 </div>
 </div>

 <div x-show="isDirecteur" x-cloak class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100 mt-2">
 <button type="submit" :disabled="profileSaving" class="btn-modal-primary group">
 <span x-text="profileSaving ? 'Enregistrement…' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </div>
 </div>

 <!-- ============================= SPOKE : FORMATS & SIGNATURES OFFICIELLES ============================= -->
 <div x-show="!isLoading && !loadError && tab === 'formats-signatures'" x-cloak>
 <div class="card p-6 w-full">
 <form x-on:submit.prevent="saveConfig()" novalidate class="space-y-5 max-w-2xl">

 <div>
 <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Format des matricules</h3>
 <p class="text-xs text-slate-400 mt-0.5 mb-3">Jetons disponibles : <code class="text-slate-600">{YEAR}</code> (année scolaire) et <code class="text-slate-600">{SEQ:n}</code> (compteur sur n chiffres).</p>

 <div class="form-grid">
 <div>
 <label for="cfg-mat-student" class="form-label">Élèves</label>
 <input id="cfg-mat-student" type="text" x-model="config.studentMatriculeFormat" :disabled="!isDirecteur"
 placeholder="ELEV-{YEAR}-{SEQ:4}"
 class="input-field font-mono disabled:bg-slate-50 disabled:text-slate-500" :class="configErrors.studentmatriculeformat && 'input-field-error'">
 <p x-show="configErrors.studentmatriculeformat" x-cloak x-text="configErrors.studentmatriculeformat" class="field-error"></p>
 </div>
 <div>
 <label for="cfg-mat-teacher" class="form-label">Enseignants</label>
 <input id="cfg-mat-teacher" type="text" x-model="config.teacherMatriculeFormat" :disabled="!isDirecteur"
 placeholder="ENS-{YEAR}-{SEQ:3}"
 class="input-field font-mono disabled:bg-slate-50 disabled:text-slate-500" :class="configErrors.teachermatriculeformat && 'input-field-error'">
 <p x-show="configErrors.teachermatriculeformat" x-cloak x-text="configErrors.teachermatriculeformat" class="field-error"></p>
 </div>
 </div>
 </div>

 <div class="border-t border-slate-100 pt-5 space-y-5">
 <div>
 <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Signatures &amp; Cachet Officiel</h3>
 <p class="text-xs text-slate-400 mt-0.5 mb-3">Ces images sont automatiquement injectées au bas des reçus de caisse, certificats et bulletins officiels (PNG sur fond transparent recommandé).</p>
 </div>

 <!-- Signature du Directeur -->
 <div>
 <label for="cfg-director-sig" class="form-label">Signature du Directeur</label>
 <div class="mt-2 flex flex-col sm:flex-row items-start sm:items-center gap-4">
 <div x-show="config.directorSignatureUrl" x-cloak class="w-16 h-16 rounded-xl border border-slate-200 bg-white p-1.5 flex items-center justify-center shrink-0 shadow-sm overflow-hidden">
 <img :src="config.directorSignatureUrl" alt="Signature Directeur" class="max-w-full max-h-full object-contain">
 </div>
 <div x-show="!config.directorSignatureUrl" x-cloak class="w-16 h-16 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 flex flex-col items-center justify-center shrink-0 text-slate-400">
 <icon name="image" class="w-6 h-6" />
 </div>
 <div class="flex-1 w-full space-y-2">
 <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
 <div class="flex-1 flex items-center">
 <input id="cfg-director-sig" type="url" x-model="config.directorSignatureUrl" maxlength="500" :disabled="!isDirecteur || isUploadingDirectorSignature"
 placeholder="URL https://… ou fichier"
 class="input-field !my-0 w-full disabled:bg-slate-50 disabled:text-slate-500">
 </div>
 <label x-show="isDirecteur" class="cursor-pointer inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium shadow-sm transition-all duration-150 shrink-0 disabled:opacity-50 disabled:cursor-not-allowed">
 <template x-if="!isUploadingDirectorSignature">
 <span class="flex items-center gap-2">
 <icon name="upload-cloud" class="w-4 h-4 text-indigo-600" />
 <span>Choisir un fichier...</span>
 </span>
 </template>
 <template x-if="isUploadingDirectorSignature">
 <span class="flex items-center gap-2 text-indigo-600">
 <icon name="loader" class="w-4 h-4 animate-spin" />
 <span>Envoi...</span>
 </span>
 </template>
 <input type="file" accept="image/png, image/jpeg, image/webp" class="hidden" :disabled="isUploadingDirectorSignature" x-on:change="uploadDirectorSignatureFile($event)">
 </label>
 </div>
 <p x-show="directorSignatureUploadError" x-cloak x-text="directorSignatureUploadError" class="field-error !mt-0"></p>
 </div>
 </div>
 </div>

 <!-- Signature du Secrétariat -->
 <div>
 <label for="cfg-secretary-sig" class="form-label">Signature du Secrétariat</label>
 <div class="mt-2 flex flex-col sm:flex-row items-start sm:items-center gap-4">
 <div x-show="config.secretarySignatureUrl" x-cloak class="w-16 h-16 rounded-xl border border-slate-200 bg-white p-1.5 flex items-center justify-center shrink-0 shadow-sm overflow-hidden">
 <img :src="config.secretarySignatureUrl" alt="Signature Secrétariat" class="max-w-full max-h-full object-contain">
 </div>
 <div x-show="!config.secretarySignatureUrl" x-cloak class="w-16 h-16 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 flex flex-col items-center justify-center shrink-0 text-slate-400">
 <icon name="image" class="w-6 h-6" />
 </div>
 <div class="flex-1 w-full space-y-2">
 <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
 <div class="flex-1 flex items-center">
 <input id="cfg-secretary-sig" type="url" x-model="config.secretarySignatureUrl" maxlength="500" :disabled="!isDirecteur || isUploadingSecretarySignature"
