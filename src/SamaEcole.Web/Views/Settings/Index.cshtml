 <icon name="pencil" class="w-4 h-4" />
 </button>
 <button type="button" x-on:click="m.id ? openDeleteMention(m) : openCreateMentionFromDefault(m)" title="Supprimer" aria-label="Supprimer la mention"
 class="p-1.5 rounded-lg text-slate-400 hover:text-danger hover:bg-danger-bg transition-colors">
 <icon name="trash-2" class="w-4 h-4" />
 </button>
 </div>
 </td>
 </tr>
 </template>
