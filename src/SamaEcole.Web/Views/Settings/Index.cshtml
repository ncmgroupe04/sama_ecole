@{
 ViewData["Title"] = "Paramètres";
 var dateFormatOptions = new List<SelectFieldOption> {
 new("dd/MM/yyyy", "31/12/2026 (jj/MM/aaaa)"), new("dd MMMM yyyy", "31 décembre 2026 (jj mois aaaa)")
 };
}

@* auth.js et api.js sont chargés par _Layout. school-years.js alimente l'onglet « Années scolaires »
 (composant schoolYearsView monté par la partial _SchoolYearsPanel). *@
@section Scripts {
 <script src="~/js/settings.js" asp-append-version="true"></script>
 <script src="~/js/school-years.js" asp-append-version="true"></script>
 <script src="~/js/users.js" asp-append-version="true"></script>
 <script src="~/js/audit-log.js" asp-append-version="true"></script>
 <script src="~/js/subscription-payments-history.js" asp-append-version="true"></script>
}

<div x-data="settingsView()">

 <!-- Titre -->
 <div>
 <h1 class="text-jgk-title font-bold text-slate-900">Paramètres</h1>
 <p class="text-jgk-subtitle text-slate-500 mt-1">
 Configurez l'identité de votre établissement, ses réglages et ses années scolaires.
 </p>
 </div>

 <!-- Écriture réservée au Directeur (Volume 7 §15), sauf le barème, les matières et les mentions
 (JGK-G02, canManageGradingConfig) délégables au Secrétariat — SI le Directeur a coché la case
 dédiée (onglet Configuration). Les autres rôles, et le Secrétariat sans délégation active,
 consultent en lecture seule. -->
 <div x-show="!isDirecteur && !canManageGradingConfig" x-cloak class="mt-4 rounded-xl border-l-4 border-primary bg-primary-50 p-3">
 <p class="text-sm text-primary-700">
 Seul le Directeur peut modifier les paramètres de l'établissement. Vous les consultez en lecture seule.
 </p>
 </div>
 <div x-show="isSecretariat && canManageGradingConfig" x-cloak class="mt-4 rounded-xl border-l-4 border-primary bg-primary-50 p-3">
 <p class="text-sm text-primary-700">
 Le Directeur vous a délégué la gestion du barème de notation, des matières/coefficients et des mentions du bulletin. Les autres réglages restent réservés au Directeur.
 </p>
 </div>

 <!-- Onglets : segmented control (fond neutre unifié, pastille active blanche + ombre légère).
 Changement purement visuel : seules les classes rendues par tabClass() (settings.js) évoluent. -->
 <div class="mt-6">
 <nav class="flex flex-nowrap items-center gap-1 overflow-x-auto scrollbar-hide rounded-xl bg-slate-100 p-1" aria-label="Onglets des paramètres">
 <button type="button" x-on:click="tab = 'etablissement'"
 class="whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-all"
 :class="tabClass('etablissement')">
 Établissement
 </button>
 <button type="button" x-on:click="tab = 'configuration'"
 class="whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-all"
 :class="tabClass('configuration')">
 Configuration
 </button>
 <button type="button" x-on:click="tab = 'annees-scolaires'"
 class="whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-all"
 :class="tabClass('annees-scolaires')">
 Années scolaires
 </button>
 @* Réservé au Directeur : l'API entière de gestion des utilisateurs est
 [Authorize(Roles = Directeur)] (voir UsersController) — les autres rôles n'ont rien à
 faire sur cet onglet, contrairement à Établissement/Configuration qu'ils consultent en
 lecture seule. *@
 <button type="button" x-show="isDirecteur" x-cloak x-on:click="tab = 'utilisateurs'"
 class="whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-all"
 :class="tabClass('utilisateurs')">
 Utilisateurs
 </button>
 @* Réservé au Directeur : GET /audit-logs est [Authorize(Roles = Directeur)] (voir
 AuditLogsController) — le journal de sécurité de tout l'établissement n'a pas sa place
 dans le rôle du Secrétariat ou de la Finance. *@
 <button type="button" x-show="isDirecteur" x-cloak x-on:click="tab = 'journal-audit'"
 class="whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-all"
 :class="tabClass('journal-audit')">
 Journal d'audit
 </button>
 @* Réservé au Directeur : GET /subscriptions/{schoolId}/payments est [Authorize(Roles =
 Directeur)] (voir SubscriptionsController, ticket JGK-I07) — la facturation de
 l'établissement ne concerne que lui. *@
 <button type="button" x-show="isDirecteur" x-cloak x-on:click="tab = 'facturation'"
 class="whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-all"
 :class="tabClass('facturation')">
 Facturation &amp; Historique
 </button>
 </nav>
 </div>

 <!-- Chargement -->
 <div x-show="isLoading" class="mt-8 flex items-center justify-center py-12">
 <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 </div>

 @await Html.PartialAsync("_ErrorBanner", "loadError")

 <!-- ============================= ONGLET ÉTABLISSEMENT ============================= -->
 <div x-show="!isLoading && !loadError && tab === 'etablissement'" x-cloak class="mt-6">
 <div class="card p-6 max-w-2xl">
 <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Identité de l'établissement</h2>
 <p class="text-xs text-slate-400 mt-0.5">Ces informations figurent sur le reçu d'inscription et les documents officiels.</p>

 <form x-on:submit.prevent="saveProfile()" class="mt-5 space-y-5">
 <div>
 <label for="school-name" class="block text-sm font-medium text-slate-700">Nom de l'établissement <span class="text-danger">*</span></label>
 <input id="school-name" type="text" x-model="profile.name" maxlength="200" :disabled="!isDirecteur"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="profileErrors.name" x-cloak x-text="profileErrors.name" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label for="school-address" class="block text-sm font-medium text-slate-700">Adresse</label>
 <input id="school-address" type="text" x-model="profile.address" maxlength="300" :disabled="!isDirecteur"
 placeholder="ex : Rue 12, Médina, Dakar"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p class="mt-1 text-xs text-slate-400">La ville (dernier élément de l'adresse) apparaît dans le « Fait à … » du reçu.</p>
 <p x-show="profileErrors.address" x-cloak x-text="profileErrors.address" class="mt-1 text-xs text-danger"></p>
 </div>

 <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
 <div>
 <label for="school-phone" class="block text-sm font-medium text-slate-700">Téléphone</label>
 <input id="school-phone" type="tel" x-model="profile.phone" maxlength="30" :disabled="!isDirecteur"
 placeholder="+221 77 000 00 00"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="profileErrors.phone" x-cloak x-text="profileErrors.phone" class="mt-1 text-xs text-danger"></p>
 </div>
 <div>
 <label for="school-logo" class="block text-sm font-medium text-slate-700">URL du logo</label>
 <input id="school-logo" type="url" x-model="profile.logoUrl" maxlength="500" :disabled="!isDirecteur"
 placeholder="https://…"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="profileErrors.logourl" x-cloak x-text="profileErrors.logourl" class="mt-1 text-xs text-danger"></p>
 </div>
 </div>

 @* En-tête administratif du bulletin de notes (IA / IEF / LYCEE DE) : reproduit les
 trois premières lignes de docs/design-references/bulletin-reference.png. *@
 <div class="pt-4 border-t border-slate-100">
 <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Informations Académiques &amp; Administration</h3>
 <p class="text-xs text-slate-400 mt-0.5">Ces trois lignes forment l'en-tête officiel du bulletin de notes.</p>

 <div class="mt-4 space-y-5">
 <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
 <div>
 <label for="school-ia" class="block text-sm font-medium text-slate-700">Inspection d'Académie (IA)</label>
 <input id="school-ia" type="text" x-model="profile.inspectionAcademie" maxlength="150" :disabled="!isDirecteur"
 placeholder="ex : Thies"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="profileErrors.inspectionacademie" x-cloak x-text="profileErrors.inspectionacademie" class="mt-1 text-xs text-danger"></p>
 </div>
 <div>
 <label for="school-ief" class="block text-sm font-medium text-slate-700">Inspect. de l'Éducation et de la Formation (IEF)</label>
 <input id="school-ief" type="text" x-model="profile.inspectionEducationFormation" maxlength="150" :disabled="!isDirecteur"
 placeholder="ex : Mbour 1"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="profileErrors.inspectioneducationformation" x-cloak x-text="profileErrors.inspectioneducationformation" class="mt-1 text-xs text-danger"></p>
 </div>
 </div>
 <div>
 <label for="school-nom-lycee" class="block text-sm font-medium text-slate-700">Nom de l'établissement sur le bulletin</label>
 <input id="school-nom-lycee" type="text" x-model="profile.nomLycee" maxlength="150" :disabled="!isDirecteur"
 placeholder="ex : Popenguine"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p class="mt-1 text-xs text-slate-400">N'indiquez que le nom, sans préfixe : « ÉCOLE ÉLÉMENTAIRE DE », « COLLÈGE DE » ou « LYCÉE DE » est ajouté automatiquement selon le cycle de la classe de l'élève.</p>
 <p x-show="profileErrors.nomlycee" x-cloak x-text="profileErrors.nomlycee" class="mt-1 text-xs text-danger"></p>
 </div>
 </div>
 </div>

 <div x-show="isDirecteur" x-cloak class="pt-2 flex items-center justify-end gap-3 border-t border-slate-100">
 <button type="submit" :disabled="profileSaving" class="btn-primary mt-4">
 <span x-text="profileSaving ? 'Enregistrement…' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </div>
 </div>

 <!-- ============================= ONGLET CONFIGURATION ============================= -->
 <div x-show="!isLoading && !loadError && tab === 'configuration'" x-cloak class="mt-6">

 @* Même gabarit que le panneau « Années scolaires » (_SchoolYearsPanel) : un bandeau d'état en
 haut (icônes rondes + texte), puis le contenu sur toute la largeur au lieu de cartes
 étroites empilées au centre. *@
 <div class="card">

 @* Le barème n'est PLUS un réglage d'établissement : il découle du cycle de la classe
 (GradingScaleGuard.ScaleForCycle — Primaire /10, Collège & Lycée /20), appliqué par la
 saisie de notes, l'import, la fiche élève et le bulletin PDF. Le sélecteur qui vivait ici
 laissait croire l'inverse : on le remplace par une note explicative. La bascule de
 délégation (à droite) n'est décidée que par le Directeur : PUT /schools/current/settings
 (saveConfig) est la SEULE requête à pouvoir l'écrire, jamais /subjects ni /grades/mentions
 — d'où l'appel direct à saveConfig() sur le switch, sans nouveau point d'entrée. *@
 <div class="p-6 border-b border-slate-200 bg-slate-50/50 rounded-t-xl flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
 <div class="flex items-start gap-3 rounded-xl border-l-4 border-primary bg-primary-50 p-3 max-w-2xl">
 <icon name="book" class="w-5 h-5 text-primary shrink-0 mt-0.5" />
 <div class="text-sm text-primary-700">
 <p class="font-medium">Barème de notation automatique</p>
 <p class="text-xs mt-1">
 Le barème s'adapte au cycle de chaque classe : <span class="font-semibold">sur 10</span>
 au Primaire, <span class="font-semibold">sur 20</span> au Collège et au Lycée.
 Aucun réglage n'est nécessaire — la saisie des notes, les moyennes et les bulletins
 suivent automatiquement le cycle de la classe concernée.
 </p>
 </div>
 </div>

 @* Réservé au Directeur (docs/Volume_7_Security.md, JGK-G02, matrice d'autorisation
 "Photoshop") : la délégation elle-même n'est décidée que par lui — visible de lui
 SEUL, pas juste désactivée pour les autres, car le rôle qui EN bénéficie ne doit
 même pas la voir tant qu'elle ne lui a pas été accordée. Trois commutateurs
 indépendants : notation (Secrétariat), montants de frais et suppression de frais
 (Finance) — chacun sa propre portée, activable séparément. *@
 <div x-show="isDirecteur" x-cloak class="flex flex-col gap-3">
 <div class="flex items-center gap-3">
 <span id="delegation-switch-label" class="text-sm font-medium text-slate-700">
 Autoriser le Secrétariat à gérer la configuration des notes
 </span>
 <button type="button" role="switch" aria-labelledby="delegation-switch-label"
 :aria-checked="config.allowSecretaryToManageGrading.toString()"
 x-on:click="config.allowSecretaryToManageGrading = !config.allowSecretaryToManageGrading; saveConfig(false)"
 :disabled="configSaving"
 :class="config.allowSecretaryToManageGrading ? 'bg-primary' : 'bg-slate-300'"
 class="relative inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50">
 <span aria-hidden="true" :class="config.allowSecretaryToManageGrading ? 'translate-x-6' : 'translate-x-1'"
 class="inline-block h-4 w-4 transform rounded-full bg-white shadow-sm transition-transform"></span>
 </button>
 </div>
 <div class="flex items-center gap-3">
 <span id="delegation-switch-finance-modify-label" class="text-sm font-medium text-slate-700">
 Autoriser la Finance à modifier les montants de frais
 </span>
 <button type="button" role="switch" aria-labelledby="delegation-switch-finance-modify-label"
 :aria-checked="config.allowFinanceToModifyFees.toString()"
 x-on:click="config.allowFinanceToModifyFees = !config.allowFinanceToModifyFees; saveConfig(false)"
 :disabled="configSaving"
 :class="config.allowFinanceToModifyFees ? 'bg-primary' : 'bg-slate-300'"
 class="relative inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50">
 <span aria-hidden="true" :class="config.allowFinanceToModifyFees ? 'translate-x-6' : 'translate-x-1'"
 class="inline-block h-4 w-4 transform rounded-full bg-white shadow-sm transition-transform"></span>
 </button>
 </div>
 <div class="flex items-center gap-3">
 <span id="delegation-switch-finance-delete-label" class="text-sm font-medium text-slate-700">
 Autoriser la Finance à supprimer des frais
 </span>
 <button type="button" role="switch" aria-labelledby="delegation-switch-finance-delete-label"
 :aria-checked="config.allowFinanceToDeleteFees.toString()"
 x-on:click="config.allowFinanceToDeleteFees = !config.allowFinanceToDeleteFees; saveConfig(false)"
 :disabled="configSaving"
 :class="config.allowFinanceToDeleteFees ? 'bg-primary' : 'bg-slate-300'"
 class="relative inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50">
 <span aria-hidden="true" :class="config.allowFinanceToDeleteFees ? 'translate-x-6' : 'translate-x-1'"
 class="inline-block h-4 w-4 transform rounded-full bg-white shadow-sm transition-transform"></span>
 </button>
 </div>
 </div>
 </div>

 <!-- Corps : réglages généraux (gauche) et mentions du bulletin (droite) -->
 <div class="p-6 grid grid-cols-1 lg:grid-cols-5 gap-8">

 <!-- Bloc 1 : Réglages généraux de l'établissement (Directeur seul) -->
 <div class="lg:col-span-3">
 <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Réglages de l'établissement</h2>
 <p class="text-xs text-slate-400 mt-0.5">Affichage des dates, sécurité et facturation.</p>

 <form x-on:submit.prevent="saveConfig()" class="mt-5 space-y-5">

 <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
 <div>
 <label for="cfg-date" class="block text-sm font-medium text-slate-700">Format des dates</label>
 <select-field id="cfg-date" model="config.dateFormat" disabled="!isDirecteur"
 options="dateFormatOptions" />
 <p x-show="configErrors.dateformat" x-cloak x-text="configErrors.dateformat" class="mt-1 text-xs text-danger"></p>
 </div>
 <div>
 <label for="cfg-tuition" class="block text-sm font-medium text-slate-700">Mensualités par an</label>
 <input id="cfg-tuition" type="number" min="1" max="12" x-model.number="config.tuitionMonthsPerYear" :disabled="!isDirecteur"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p class="mt-1 text-xs text-slate-400">Tranches de scolarité (souvent 9 au Sénégal). Multiplie chaque mensualité au calcul du dû.</p>
 <p x-show="configErrors.tuitionmonthsperyear" x-cloak x-text="configErrors.tuitionmonthsperyear" class="mt-1 text-xs text-danger"></p>
 </div>
 <div>
 <label for="cfg-logout" class="block text-sm font-medium text-slate-700">Déconnexion automatique (minutes)</label>
 <input id="cfg-logout" type="number" min="1" max="480" x-model.number="config.autoLogoutMinutes" :disabled="!isDirecteur"
 class="input-field disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="configErrors.autologoutminutes" x-cloak x-text="configErrors.autologoutminutes" class="mt-1 text-xs text-danger"></p>
 </div>
 </div>

 <div class="border-t border-slate-100 pt-5">
 <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Format des matricules</h3>
 <p class="text-xs text-slate-400 mt-0.5 mb-3">Jetons disponibles : <code class="text-slate-600">{YEAR}</code> (année scolaire) et <code class="text-slate-600">{SEQ:n}</code> (compteur sur n chiffres).</p>

 <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
 <div>
 <label for="cfg-mat-student" class="block text-sm font-medium text-slate-700">Élèves</label>
 <input id="cfg-mat-student" type="text" x-model="config.studentMatriculeFormat" :disabled="!isDirecteur"
 placeholder="ELEV-{YEAR}-{SEQ:4}"
 class="input-field font-mono disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="configErrors.studentmatriculeformat" x-cloak x-text="configErrors.studentmatriculeformat" class="mt-1 text-xs text-danger"></p>
 </div>
 <div>
 <label for="cfg-mat-teacher" class="block text-sm font-medium text-slate-700">Enseignants</label>
 <input id="cfg-mat-teacher" type="text" x-model="config.teacherMatriculeFormat" :disabled="!isDirecteur"
 placeholder="ENS-{YEAR}-{SEQ:3}"
 class="input-field font-mono disabled:bg-slate-50 disabled:text-slate-500 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="configErrors.teachermatriculeformat" x-cloak x-text="configErrors.teachermatriculeformat" class="mt-1 text-xs text-danger"></p>
 </div>
 </div>
 </div>

 <!-- Erreur métier globale éventuelle -->
 <div x-show="configErrors.global" x-cloak class="rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="configErrors.global"></div>

 <div x-show="isDirecteur" x-cloak class="pt-2 flex items-center justify-end gap-3 border-t border-slate-100">
 <button type="submit" :disabled="configSaving" class="btn-primary mt-4">
 <span x-text="configSaving ? 'Enregistrement…' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </div>

 @* Ressource séparée (GradesController /grades/mentions) : pas un champ de SchoolSettings,
 donc formulaire indépendant. Masquée (pas juste lecture seule) à Secrétariat/Finance
 non concernés : voir canViewMentions dans settings.js. *@
 <div x-show="canViewMentions" x-cloak class="lg:col-span-2 lg:border-l lg:border-slate-100 lg:pl-8">
 <div class="flex items-start justify-between gap-4">
 <div>
 <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Mentions du bulletin</h2>
 <p class="text-xs text-slate-400 mt-0.5">Attribuées automatiquement selon la moyenne générale de l'élève.</p>
 </div>
 <button type="button" x-show="canManageGradingConfig" x-cloak x-on:click="openCreateMention()"
 class="btn-primary whitespace-nowrap text-xs">
 <icon name="plus" class="w-4 h-4" />
 Ajouter
 </button>
 </div>

 <!-- Tant qu'aucune mention n'a été créée, l'école reçoit un barème par défaut (id null) ;
 dès le premier ajout personnalisé, ce barème par défaut disparaît entièrement. -->
 <div x-show="isDefaultMentions" x-cloak class="mt-4 rounded-xl border-l-4 border-primary bg-primary-50 p-3 text-sm text-primary-700">
 Valeurs par défaut, non personnalisées. Dès votre première mention ajoutée, cette liste
 par défaut n'est plus utilisée — pensez à recréer toutes les mentions souhaitées, pas seulement la vôtre.
 </div>

 <div class="mt-4 overflow-x-auto rounded-2xl border border-slate-100">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-2.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Mention</th>
 <th class="py-2.5 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">Seuil</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out" x-show="mentions.length === 0" x-cloak>
 <td colspan="2">
 <empty-state icon="book" title="Aucune mention n'est encore définie." />
 </td>
 </tr>
 <template x-for="(m, index) in mentions" :key="m.id || index">
 <tr class="hover:bg-slate-50 transition-colors transition-all duration-200 ease-in-out transition-all duration-200 ease-in-out">
 <td class="py-2.5 px-4 font-medium text-slate-900" x-text="m.label"></td>
 <td class="py-2.5 px-4 text-right text-sm text-slate-500">
 À partir de <span class="font-semibold text-slate-900" x-text="formatAverage(m.minAverage)"></span>/20
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 </div>

 <!-- ============================= ONGLET ANNÉES SCOLAIRES ============================= -->
 <div x-show="tab === 'annees-scolaires'" x-cloak class="mt-6">
 @await Html.PartialAsync("_SchoolYearsPanel")
 </div>

 <!-- ============================= ONGLET UTILISATEURS ============================= -->
 <div x-show="isDirecteur && tab === 'utilisateurs'" x-cloak class="mt-6">
 @await Html.PartialAsync("_UsersPanel")
 </div>

 <!-- ============================= ONGLET JOURNAL D'AUDIT ============================= -->
 <div x-show="isDirecteur && tab === 'journal-audit'" x-cloak class="mt-6">
 @await Html.PartialAsync("_AuditLogPanel")
 </div>

 <!-- ============================= ONGLET FACTURATION & HISTORIQUE ============================= -->
 <div x-show="isDirecteur && tab === 'facturation'" x-cloak class="mt-6">
 @await Html.PartialAsync("_SubscriptionPaymentsPanel")
 </div>

 <!-- Création d'une mention -->
 <modal-shell open="isMentionCreateOpen" title="Nouvelle mention">
 <modal-subtitle>Le seuil est la moyenne minimale, sur 20, pour l'obtenir. Le bulletin du Primaire le transpose automatiquement sur 10.</modal-subtitle>

 <div x-show="mentionCreateErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="mentionCreateErrors.global"></div>

 <form x-on:submit.prevent="submitCreateMention()" class="space-y-4">
 <div>
 <label for="mention-label" class="block text-sm font-medium text-slate-700">Libellé <span class="text-danger">*</span></label>
 <input id="mention-label" type="text" x-model="newMention.label" required maxlength="40" placeholder="ex : Excellent" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="mentionCreateErrors.label" x-cloak x-text="mentionCreateErrors.label" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label for="mention-min-average" class="block text-sm font-medium text-slate-700">Seuil minimum <span class="text-danger">*</span></label>
 <input id="mention-min-average" type="number" x-model.number="newMention.minAverage" required min="0" max="20" step="0.1"
 class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="mentionCreateErrors.minaverage" x-cloak x-text="mentionCreateErrors.minaverage" class="mt-1 text-xs text-danger"></p>
 </div>

 <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
 <button type="button" x-on:click="isMentionCreateOpen = false" class="btn-secondary">Annuler</button>
 <button type="submit" :disabled="mentionSubmitting" class="btn-primary">
 <span x-text="mentionSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : mention ajoutée -->
 <modal-shell open="showMentionAddedDialog" size="md" on-close="showMentionAddedDialog = false" title="Mention ajoutée">
 <confirm-dialog-body close-action="showMentionAddedDialog = false"
 new-action="showMentionAddedDialog = false; openCreateMention()" new-label="Nouvelle mention">
 La mention <span class="font-medium text-slate-900" x-text="addedMentionLabel"></span> a bien été ajoutée.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Confirmation : établissement mis à jour -->
 <modal-shell open="profileSaved" size="md" on-close="profileSaved = false" title="Établissement mis à jour">
 <confirm-dialog-body close-action="profileSaved = false">
 Les informations de l'établissement ont bien été enregistrées.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Confirmation : configuration enregistrée -->
 <modal-shell open="configSaved" size="md" on-close="configSaved = false" title="Modification enregistrée">
 <confirm-dialog-body close-action="configSaved = false">
 Les réglages de l'établissement ont bien été mis à jour.
 </confirm-dialog-body>
 </modal-shell>

</div>
