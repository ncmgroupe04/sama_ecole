 <!-- Création d'une mention -->
 <modal-shell open="isMentionCreateOpen" title="Nouvelle mention">
 <modal-subtitle>Le seuil est la moyenne minimale, sur 20, pour l'obtenir. Le bulletin du Primaire le transpose automatiquement sur 10.</modal-subtitle>

 <div x-show="mentionCreateErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="mentionCreateErrors.global"></div>

 <form x-on:submit.prevent="submitCreateMention()" novalidate class="space-y-4">
 <div>
 <label for="mention-label" class="block text-sm font-medium text-slate-700">Libellé <span class="text-danger">*</span></label>
 <input id="mention-label" type="text" x-model="newMention.label" required maxlength="40" placeholder="ex : Excellent" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="mentionCreateErrors.label" x-cloak x-text="mentionCreateErrors.label" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label for="mention-min-average" class="block text-sm font-medium text-slate-700">Seuil minimum <span class="text-danger">*</span></label>
 <input id="mention-min-average" type="number" x-model.number="newMention.minAverage" required min="0" max="20" step="0.1"
 class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="mentionCreateErrors.minaverage" x-cloak x-text="mentionCreateErrors.minaverage" class="mt-1 text-xs text-danger"></p>
 </div>

 <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
 <button type="button" x-on:click="isMentionCreateOpen = false" class="btn-secondary">Annuler</button>
 <button type="submit" :disabled="mentionSubmitting" class="btn-primary">
 <span x-text="mentionSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : mention ajoutée -->
 <modal-shell open="showMentionAddedDialog" size="md" on-close="showMentionAddedDialog = false" title="Mention ajoutée">
 <confirm-dialog-body close-action="showMentionAddedDialog = false"
 new-action="showMentionAddedDialog = false; openCreateMention()" new-label="Nouvelle mention">
 La mention <span class="font-medium text-slate-900" x-text="addedMentionLabel"></span> a bien été ajoutée.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Modification d'une mention (correction d'une erreur de saisie) -->
 <modal-shell open="editingMention" on-close="closeEditMention()" title="Modifier la mention">
 <modal-subtitle>Le seuil est la moyenne minimale, sur 20, pour l'obtenir. Le bulletin du Primaire le transpose automatiquement sur 10.</modal-subtitle>

 <div x-show="mentionEditErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="mentionEditErrors.global"></div>

 <form x-on:submit.prevent="submitEditMention()" novalidate class="space-y-4" x-show="editingMention">
 <div>
 <label for="mention-edit-label" class="block text-sm font-medium text-slate-700">Libellé <span class="text-danger">*</span></label>
 <input id="mention-edit-label" type="text" x-model="editingMention.label" required maxlength="40" placeholder="ex : Excellent" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="mentionEditErrors.label" x-cloak x-text="mentionEditErrors.label" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label for="mention-edit-min-average" class="block text-sm font-medium text-slate-700">Seuil minimum <span class="text-danger">*</span></label>
 <input id="mention-edit-min-average" type="number" x-model.number="editingMention.minAverage" required min="0" max="20" step="0.1"
 class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="mentionEditErrors.minaverage" x-cloak x-text="mentionEditErrors.minaverage" class="mt-1 text-xs text-danger"></p>
 </div>

 <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
 <button type="button" x-on:click="closeEditMention()" class="btn-secondary">Annuler</button>
 <button type="submit" :disabled="isSavingMentionEdit" class="btn-primary">
 <span x-text="isSavingMentionEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Suppression d'une mention -->
 <modal-shell open="deletingMention" size="md" on-close="closeDeleteMention()" title="Supprimer la mention">
 <div x-show="deletingMention">
 <p class="text-sm text-slate-600">
 Supprimer la mention <span class="font-medium text-slate-900" x-text="deletingMention ? deletingMention.label : ''"></span> ?
 Elle n'est jamais effacée définitivement (suppression logique) et n'apparaîtra plus dans la liste.
 </p>
 <div x-show="deleteMentionError" x-cloak class="mt-3 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="deleteMentionError"></div>
 <div class="mt-6 flex justify-end gap-3">
 <button type="button" x-on:click="closeDeleteMention()" class="btn-secondary">Annuler</button>
 <button type="button" x-on:click="confirmDeleteMention()" :disabled="isDeletingMention" class="btn-danger">
 <span x-text="isDeletingMention ? 'Suppression...' : 'Supprimer'"></span>
 </button>
 </div>
 </div>
 </modal-shell>

 <!-- Confirmation : établissement mis à jour -->
 <modal-shell open="profileSaved" size="md" on-close="profileSaved = false" title="Établissement mis à jour">
 <confirm-dialog-body close-action="profileSaved = false">
 Les informations de l'établissement ont bien été enregistrées.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Confirmation : configuration enregistrée -->
 <modal-shell open="configSaved" size="md" on-close="configSaved = false" title="Modification enregistrée">
 <confirm-dialog-body close-action="configSaved = false">
 Les réglages de l'établissement ont bien été mis à jour.
 </confirm-dialog-body>
 </modal-shell>

</div>

