@{
    ViewData["Title"] = "Ma Halqa";
}

@* Espace de l'Oustaz (tablette). Écran en arabe, de droite à gauche : dir="rtl" est posé sur la racine du composant,
   pas sur la page — le menu latéral et l'en-tête de l'application restent dans leur sens habituel.
   auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois.
   Pas de `x-init="init()"` : Alpine appelle DÉJÀ la méthode init() d'un composant x-data.
   Pas de <badge>/<stat-card> pour les valeurs dynamiques : ces Tag Helpers lisent leurs attributs au rendu serveur,
   un binding Alpine y reste inerte (même piège que celui documenté dans Internat/Index.cshtml). *@
@section Scripts {
    <script src="~/js/trend-chart.js" asp-append-version="true"></script>
    <script src="~/js/halqa.js" asp-append-version="true"></script>
}

<div x-data="halqaPage()" dir="rtl" lang="ar">

    <div class="page-header">
        <div>
            <h1 class="page-title" x-text="halqa ? name(halqa.instructorNameAr, halqa.instructorName) : 'حلقتي'">حلقتي</h1>
            <p class="page-subtitle" x-show="halqa && !selected" x-cloak>
                <span x-text="halqa ? halqa.studentCount : 0"></span> طالبًا
                · متوسط الحفظ <span dir="ltr" x-text="(halqa ? halqa.averageProgressPercent : 0) + '%'"></span>
            </p>
        </div>

        <button type="button" x-show="selected" x-cloak
                class="inline-flex items-center gap-2 min-h-[48px] px-4 rounded-xl border border-slate-300 bg-white text-slate-700 font-semibold hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-primary"
                x-on:click="closeStudent()">
            <icon name="chevron-right" class="w-5 h-5" />
            <span>رجوع إلى الحلقة</span>
        </button>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    @* Conflit d'écriture résolu par rechargement : information, pas une erreur bloquante. *@
    <div x-show="notice" x-cloak class="mt-6 rounded-xl border-l-4 border-warning bg-warning-bg p-4" role="status">
        <p class="text-sm font-medium text-slate-800" x-text="notice"></p>
    </div>

    @* Compte sans fiche d'Oustaz, ou fiche suspendue : un état vide, pas une panne. *@
    <div x-show="noHalqa && !loading" x-cloak class="card p-12 mt-6 text-center">
        <p class="text-lg font-bold text-slate-700">لا توجد حلقة مرتبطة بحسابك.</p>
        <p class="mt-2 text-sm text-slate-500">اطلب من المدير ربط حسابك بملف المعلّم، أو إعادة تفعيله.</p>
    </div>

    <template x-if="loading">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
            <template x-for="i in 6" :key="i">
                <div class="card p-5 h-[104px] skeleton"></div>
            </template>
        </div>
    </template>

    @* ------------------------------------------------------------------ Liste des élèves de la Halqa *@
    <div x-show="!loading && halqa && !selected" x-cloak class="mt-6">
        <div x-show="halqa && halqa.students.length === 0" class="card p-12 text-center">
            <p class="text-lg font-bold text-slate-700">لا يوجد طلاب في حلقتك بعد.</p>
            <p class="mt-2 text-sm text-slate-500">يضيف المدير الطلاب إلى حلقتك.</p>
        </div>

        @* Tuiles compactes : la grille s'adapte à la largeur (auto-fill) — 2 par ligne sur téléphone, 3 à 6 selon la largeur sur tablette et grand
           écran — pour qu'une Halqa de 30 élèves tienne sans défilement inutile. Toutes les informations restent
           visibles : pastille « Hizb complets », nom, matricule, barre de progression et pourcentage. *@
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(13.5rem,1fr))]">
            <template x-for="student in (halqa ? halqa.students : [])" :key="student.studentId">
                <button type="button"
                        class="card flex min-h-[76px] w-full items-center gap-3 p-3 text-start transition duration-150 hover:-translate-y-0.5 hover:border-emerald-500/40 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary active:scale-[0.99] motion-reduce:transform-none motion-reduce:transition-none"
                        :aria-label="name(student.fullNameAr, student.fullName) + ' — ' + student.completedHizbs + ' حزبًا كاملًا، ' + student.progressPercent + '%'"
                        x-on:click="openStudent(student)">
                    <span class="flex h-12 w-12 shrink-0 flex-col items-center justify-center rounded-xl bg-emerald-50 leading-none text-emerald-700" aria-hidden="true">
                        <span class="text-lg font-bold" x-text="student.completedHizbs"></span>
                        <span class="mt-0.5 text-[10px] font-semibold">حزب</span>
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-[15px] font-bold text-slate-800" x-text="name(student.fullNameAr, student.fullName)"></span>
                        <span class="block text-xs text-slate-400"><bdi x-text="student.matricule"></bdi></span>
                        <span class="mt-1.5 flex items-center gap-2" aria-hidden="true">
                            <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-100">
                                <span class="block h-full rounded-full bg-emerald-500 transition-all"
                                      :style="'width: ' + (student.progressPercent > 0 ? 'max(' + student.progressPercent + '%, 0.375rem)' : '0')"></span>
                            </span>
                            <span class="shrink-0 text-xs font-semibold text-slate-500" dir="ltr" x-text="student.progressPercent + '%'"></span>
                        </span>
                    </span>
                </button>
            </template>
        </div>
    </div>

    @* ------------------------------------------------------------------ Grille des 60 Hizb d'un élève *@
    <div x-show="selected" x-cloak class="mt-6">
        <div class="card p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-xl font-bold text-slate-800" x-text="selected ? name(selected.fullNameAr, selected.fullName) : ''"></p>
                @* Bulletin coranique PDF : la portée est vérifiée par le serveur (un Oustaz ne tire que celui de ses élèves). *@
                <button type="button"
                        class="inline-flex items-center gap-2 min-h-[48px] px-4 rounded-xl border border-slate-300 bg-white text-slate-700 font-semibold hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-primary"
                        x-on:click="openReport()">
                    <icon name="document" class="w-5 h-5" />
                    <span>كشف الحفظ (PDF)</span>
                </button>
            </div>
            <div class="mt-3 grid grid-cols-3 gap-3 text-center" x-show="grid" x-cloak>
                <div class="rounded-xl bg-emerald-50 p-3">
                    <p class="text-2xl font-bold text-emerald-700" x-text="grid ? grid.summary.completedHizbs : 0"></p>
                    <p class="text-xs text-slate-600">حزب كامل</p>
                </div>
                <div class="rounded-xl bg-amber-50 p-3">
                    <p class="text-2xl font-bold text-amber-700" x-text="grid ? grid.summary.inProgressHizbs : 0"></p>
                    <p class="text-xs text-slate-600">قيد الحفظ</p>
                </div>
                <div class="rounded-xl bg-slate-50 p-3">
                    <p class="text-2xl font-bold text-slate-700" dir="ltr" x-text="(grid ? grid.summary.progressPercent : 0) + '%'"></p>
                    <p class="text-xs text-slate-600">من القرآن</p>
                </div>
            </div>

            @* Légende : trois états, trois teintes — la couleur ne porte jamais seule l'information (les quarts sont aussi dessinés). *@
            <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-slate-600">
                <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border-2 border-slate-300 bg-white"></span>لم يبدأ</span>
                <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border-2 border-amber-400 bg-amber-50"></span>قيد الحفظ</span>
                <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border-2 border-emerald-500 bg-emerald-100"></span>مكتمل</span>
            </div>
        </div>

        @* ------------------------------------------------------------------ Évolution (journal des évaluations) *@
        @* Courbe du pourcentage du Coran mémorisé, une période au choix, puis les dernières évaluations. Le journal commence au jour où
           il a été activé : on le dit (historySince) au lieu de tracer un zéro inventé avant cette date. *@
        <section class="card mt-4 p-4" aria-labelledby="halqa-history-title">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 id="halqa-history-title" class="text-lg font-bold text-slate-800">التطور</h3>
                <div class="flex flex-wrap gap-2" role="group" aria-label="الفترة">
                    <template x-for="p in periods" :key="p.key">
                        <button type="button"
                                class="min-h-[44px] rounded-full border px-4 text-sm font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
                                :class="historyPeriod === p.key ? 'border-emerald-500 bg-emerald-50 text-emerald-800' : 'border-slate-300 bg-white text-slate-600 hover:bg-slate-50'"
                                :aria-pressed="(historyPeriod === p.key).toString()"
                                x-on:click="setHistoryPeriod(p.key)" x-text="p.label"></button>
                    </template>
                </div>
            </div>

            <p x-show="historyLoading" x-cloak class="mt-3 text-sm text-slate-500">جارٍ التحميل…</p>
            <p x-show="historyError" x-cloak role="alert" class="mt-3 text-sm text-rose-700" x-text="historyError"></p>
            <p x-show="historyEmpty && !historyLoading && !historyError" x-cloak class="mt-3 text-sm text-slate-500">
                لا توجد تقييمات في هذه الفترة بعد. يبدأ السجل من أول تقييم بعد تفعيل الميزة.
            </p>
            <p x-show="historySince" x-cloak class="mt-3 text-xs text-slate-500">
                يبدأ السجل في <bdi dir="ltr" x-text="historySince"></bdi> — لا توجد بيانات قبل هذا التاريخ.
            </p>

            @* Le tracé est un SVG lu de gauche à droite (temps croissant), même dans une page de droite à gauche. *@
            <div x-show="history && !historyEmpty" x-cloak dir="ltr" class="mt-3" x-html="historySvg"></div>

            <ul x-show="historyEntries.length > 0" x-cloak class="mt-4 divide-y divide-slate-100 rounded-xl border border-slate-200">
                <template x-for="(entry, i) in historyEntries" :key="i">
                    <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
                        <div class="min-w-0">
                            <p class="text-sm font-bold text-slate-800">
                                <span x-text="entry.title"></span>
                                <span x-show="entry.baseline" x-cloak class="me-2 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">نقطة البداية</span>
                            </p>
                            <p class="text-sm text-slate-600" x-text="entry.change"></p>
                        </div>
                        <div class="text-end text-xs text-slate-500">
                            <p x-show="entry.rating" x-cloak>التجويد <bdi dir="ltr" x-text="entry.rating"></bdi></p>
                            <p><bdi dir="ltr" x-text="entry.date"></bdi></p>
                            <p x-show="entry.by" x-cloak x-text="entry.by"></p>
                        </div>
                    </li>
                </template>
            </ul>
        </section>

        <div x-show="gridLoading" class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <template x-for="i in 10" :key="i">
                <div class="card h-[140px] skeleton"></div>
            </template>
        </div>

        <div x-show="!gridLoading" class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <template x-for="group in groups" :key="group.juz">
                <section class="card p-3">
                    <h3 class="text-sm font-bold text-slate-500">الجزء <span x-text="group.juz"></span></h3>
                    <div class="mt-2 grid grid-cols-2 gap-2">
                        <template x-for="cell in group.hizbs" :key="cell.hizbNumber">
                            <button type="button"
                                    class="rounded-xl border-2 p-2 min-h-[76px] flex flex-col items-center justify-center gap-2 transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
                                    :class="cellClasses(cell.state)"
                                    :aria-label="'الحزب ' + cell.hizbNumber + ' — ' + quarterLabel(cell.completedQuarters)"
                                    x-on:click="openDrawer(cell)">
                                <span class="text-xl font-bold" x-text="cell.hizbNumber"></span>
                                <span class="flex w-full gap-1" aria-hidden="true">
                                    <template x-for="q in [1, 2, 3, 4]" :key="q">
                                        <span class="h-2 flex-1 rounded-full" :class="quarterFilled(cell, q) ? 'bg-emerald-600' : 'bg-slate-200'"></span>
                                    </template>
                                </span>
                            </button>
                        </template>
                    </div>
                </section>
            </template>
        </div>
    </div>

    @* ------------------------------------------------------------------ Fenêtre de saisie des quarts
       Tablette/mobile : feuille ancrée en bas (pouce). Écran large : modale centrée verticalement, plafonnée à la
       hauteur visible (dvh) — l'en-tête et le pied restent fixes, seul le corps défile si l'écran est vraiment petit.
       Verre dépoli (fond translucide + flou), vert émeraude réservé à la progression. Pas de classes dark: — l'application
       n'a pas de mode sombre, elles suivraient le thème du système et ne rendraient sombre que cette fenêtre. *@
    <div x-show="drawer.open" x-cloak class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-6" role="dialog" aria-modal="true"
         aria-labelledby="hizb-dialog-title" x-on:keydown.escape.window="closeDrawer()">
        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" x-on:click="closeDrawer()"
             x-show="drawer.open" x-transition.opacity.duration.200ms></div>

        <div class="relative flex w-full max-h-[94dvh] flex-col overflow-hidden rounded-t-3xl border border-white/60 bg-white/85 shadow-2xl shadow-slate-900/10 backdrop-blur-xl sm:max-h-[calc(100dvh-3rem)] sm:max-w-xl sm:rounded-3xl"
             x-show="drawer.open" x-transition:enter="transition duration-200 ease-out motion-reduce:transition-none" x-transition:enter-start="translate-y-6 opacity-0 sm:translate-y-2 sm:scale-95"
             x-transition:enter-end="translate-y-0 opacity-100 sm:scale-100">

            @* Lueur d'ambiance : une seule tache émeraude, derrière l'anneau *@
            <div class="pointer-events-none absolute -top-16 -end-10 h-48 w-48 rounded-full bg-emerald-300/30 blur-3xl" aria-hidden="true"></div>

            @* En-tête : anneau des quatre quarts (aperçu en direct de la sélection) + numéro du Hizb *@
            <div class="relative flex items-center gap-5 border-b border-slate-200/60 px-6 py-5">
                <div class="relative h-24 w-24 shrink-0" aria-hidden="true">
                    <svg viewBox="0 0 64 64" class="h-24 w-24 -rotate-90">
                        <circle cx="32" cy="32" r="26" fill="none" stroke-width="7" stroke-linecap="round" stroke-dasharray="34 129.4" stroke-dashoffset="0"
                                class="transition-colors duration-200" :class="drawer.quarters >= 1 ? 'stroke-emerald-500' : 'stroke-slate-200'"></circle>
                        <circle cx="32" cy="32" r="26" fill="none" stroke-width="7" stroke-linecap="round" stroke-dasharray="34 129.4" stroke-dashoffset="-40.84"
                                class="transition-colors duration-200" :class="drawer.quarters >= 2 ? 'stroke-emerald-500' : 'stroke-slate-200'"></circle>
                        <circle cx="32" cy="32" r="26" fill="none" stroke-width="7" stroke-linecap="round" stroke-dasharray="34 129.4" stroke-dashoffset="-81.68"
                                class="transition-colors duration-200" :class="drawer.quarters >= 3 ? 'stroke-emerald-500' : 'stroke-slate-200'"></circle>
                        <circle cx="32" cy="32" r="26" fill="none" stroke-width="7" stroke-linecap="round" stroke-dasharray="34 129.4" stroke-dashoffset="-122.52"
                                class="transition-colors duration-200" :class="drawer.quarters >= 4 ? 'stroke-emerald-500' : 'stroke-slate-200'"></circle>
                    </svg>
                    <span class="absolute inset-0 flex items-center justify-center text-lg font-bold text-slate-700" dir="ltr"
                          x-text="drawer.quarters + '/4'"></span>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 id="hizb-dialog-title" class="text-3xl font-bold leading-tight text-slate-900">الحزب <span x-text="drawer.cell ? drawer.cell.hizbNumber : ''"></span></h2>
                    <p class="mt-0.5 text-base text-slate-500">الجزء <span x-text="drawer.juz"></span></p>
                </div>
                <button type="button" class="min-h-[48px] min-w-[48px] shrink-0 self-start rounded-2xl text-slate-400 transition-colors hover:bg-slate-900/5 hover:text-slate-600 focus:outline-none focus:ring-2 focus:ring-primary"
                        aria-label="إغلاق" x-on:click="closeDrawer()">
                    <icon name="x" class="w-6 h-6 mx-auto" />
                </button>
            </div>

            @* Corps défilant *@
            <div class="relative flex-1 overflow-y-auto px-6 py-5">
                <p class="text-sm font-semibold text-slate-600">ما حفظه الطالب من هذا الحزب</p>
                <div class="mt-3 grid grid-cols-2 gap-3">
                    <template x-for="q in [1, 2, 3, 4]" :key="q">
                        <button type="button"
                                class="group flex min-h-[68px] items-center gap-3 rounded-2xl border px-3 py-2 text-start text-base font-bold transition duration-150 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-primary active:scale-[0.98] motion-reduce:transform-none motion-reduce:transition-none"
                                :class="drawer.quarters === q
                                    ? 'border-emerald-500/60 bg-emerald-50/90 text-emerald-800 ring-1 ring-emerald-500/30'
                                    : 'border-slate-200/80 bg-white/70 text-slate-700 hover:border-slate-300 hover:bg-white'"
                                :aria-pressed="drawer.quarters === q"
                                x-on:click="pickQuarters(q)">
                            @* Pastille : un camembert de la fraction mémorisée (le plein = coche) *@
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl transition-colors"
                                  :class="drawer.quarters === q ? 'bg-emerald-500 text-white' : 'bg-slate-100 text-slate-500 group-hover:bg-emerald-50 group-hover:text-emerald-600'"
                                  aria-hidden="true">
                                <svg x-show="q < 4" viewBox="0 0 24 24" class="h-6 w-6 -rotate-90">
                                    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="2.5"></circle>
                                    <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="9" :stroke-dasharray="(q * 7.07) + ' 28.27'"></circle>
                                </svg>
                                <svg x-show="q === 4" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12.5l4.5 4.5L19 7.5"></path>
                                </svg>
                            </span>
                            <span class="min-w-0 flex-1 truncate" x-text="quarterLabel(q)"></span>
                        </button>
                    </template>
                    <button type="button"
                            class="col-span-2 flex min-h-[56px] items-center justify-center gap-2 rounded-2xl border border-dashed px-3 text-base font-semibold transition duration-150 hover:scale-[1.01] focus:outline-none focus:ring-2 focus:ring-primary active:scale-[0.99] motion-reduce:transform-none motion-reduce:transition-none"
                            :class="drawer.quarters === 0 ? 'border-slate-400 bg-slate-100/80 text-slate-700' : 'border-slate-300/80 text-slate-500 hover:bg-white/70'"
                            :aria-pressed="drawer.quarters === 0"
                            x-on:click="pickQuarters(0)">
                        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle></svg>
                        <span x-text="quarterLabel(0)"></span>
                    </button>
                </div>

                <div class="mt-6 flex items-baseline justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-600">جودة التلاوة (التجويد) <span class="font-normal text-slate-400">— اختياري</span></p>
                    <span x-show="drawer.rating" x-cloak class="text-sm font-bold text-amber-600" dir="ltr" x-text="drawer.rating + ' / 5'"></span>
                </div>
                <div class="mt-3 flex items-center justify-between gap-1 rounded-2xl border border-slate-200/70 bg-slate-100/70 px-3 py-2 transition-opacity" :class="drawer.quarters === 0 ? 'opacity-50' : ''">
                    <template x-for="r in [1, 2, 3, 4, 5]" :key="r">
                        <button type="button"
                                class="flex h-12 w-12 items-center justify-center rounded-full transition-transform focus:outline-none focus:ring-2 focus:ring-primary enabled:hover:scale-110 enabled:active:scale-90 disabled:cursor-not-allowed motion-reduce:transform-none"
                                :disabled="drawer.quarters === 0"
                                :aria-pressed="drawer.rating === r"
                                :aria-label="r + ' / 5'"
                                x-on:click="pickRating(r)">
                            <svg viewBox="0 0 24 24" class="h-9 w-9 transition-colors" stroke-width="1.5" stroke-linejoin="round"
                                 :class="drawer.rating && r <= drawer.rating ? 'fill-amber-400 stroke-amber-500' : 'fill-white stroke-slate-300'">
                                <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2 6.3 20.3l1.2-6.4L2.8 9.5l6.4-.8L12 2.8z"></path>
                            </svg>
                        </button>
                    </template>
                </div>

                <p x-show="drawer.error" x-cloak class="mt-4 rounded-2xl bg-danger-bg p-3 text-sm text-danger" role="alert" x-text="drawer.error"></p>
            </div>

            @* Pied fixe *@
            <div class="relative grid grid-cols-5 gap-3 border-t border-slate-200/60 px-6 py-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
                <button type="button"
                        class="col-span-3 min-h-[56px] rounded-2xl bg-primary-700 text-lg font-bold text-white shadow-lg shadow-primary/20 transition hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 disabled:shadow-none"
                        :disabled="!canSave" x-on:click="save()">
                    <span x-show="!drawer.saving">حفظ</span>
                    <span x-show="drawer.saving" x-cloak>جارٍ الحفظ…</span>
                </button>
                <button type="button"
                        class="col-span-2 min-h-[56px] rounded-2xl border border-slate-300/80 bg-white/70 text-lg font-semibold text-slate-700 transition-colors hover:bg-white focus:outline-none focus:ring-2 focus:ring-primary"
                        x-on:click="closeDrawer()">إلغاء</button>
            </div>
        </div>
    </div>

    @* Aperçu du bulletin coranique : même modale que le reste de l'application, dont la barre d'outils est en français. Le
