@{
    ViewData["Title"] = "Ma Halqa";
}

@* Espace de l'Oustaz (tablette). Écran en arabe, de droite à gauche : dir="rtl" est posé sur la racine du composant,
   pas sur la page — le menu latéral et l'en-tête de l'application restent dans leur sens habituel.
   auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois.
   Pas de `x-init="init()"` : Alpine appelle DÉJÀ la méthode init() d'un composant x-data.
   Pas de <badge>/<stat-card> pour les valeurs dynamiques : ces Tag Helpers lisent leurs attributs au rendu serveur,
   un binding Alpine y reste inerte (même piège que celui documenté dans Internat/Index.cshtml). *@
@section Scripts {
    <script src="~/js/halqa.js" asp-append-version="true"></script>
}

<div x-data="halqaPage()" dir="rtl" lang="ar">

    <div class="page-header">
        <div>
            <h1 class="page-title" x-text="halqa ? name(halqa.instructorNameAr, halqa.instructorName) : 'حلقتي'">حلقتي</h1>
            <p class="page-subtitle" x-show="halqa && !selected" x-cloak>
                <span x-text="halqa ? halqa.studentCount : 0"></span> طالبًا
                · متوسط الحفظ <span dir="ltr" x-text="(halqa ? halqa.averageProgressPercent : 0) + '%'"></span>
            </p>
        </div>

        <button type="button" x-show="selected" x-cloak
                class="inline-flex items-center gap-2 min-h-[48px] px-4 rounded-xl border border-slate-300 bg-white text-slate-700 font-semibold hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-primary"
                x-on:click="closeStudent()">
            <icon name="chevron-right" class="w-5 h-5" />
            <span>رجوع إلى الحلقة</span>
        </button>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    @* Conflit d'écriture résolu par rechargement : information, pas une erreur bloquante. *@
    <div x-show="notice" x-cloak class="mt-6 rounded-xl border-l-4 border-warning bg-warning-bg p-4" role="status">
        <p class="text-sm font-medium text-slate-800" x-text="notice"></p>
    </div>

    @* Compte sans fiche d'Oustaz, ou fiche suspendue : un état vide, pas une panne. *@
    <div x-show="noHalqa && !loading" x-cloak class="card p-12 mt-6 text-center">
        <p class="text-lg font-bold text-slate-700">لا توجد حلقة مرتبطة بحسابك.</p>
        <p class="mt-2 text-sm text-slate-500">اطلب من المدير ربط حسابك بملف المعلّم، أو إعادة تفعيله.</p>
    </div>

    <template x-if="loading">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
            <template x-for="i in 6" :key="i">
                <div class="card p-5 h-[104px] skeleton"></div>
            </template>
        </div>
    </template>

    @* ------------------------------------------------------------------ Liste des élèves de la Halqa *@
    <div x-show="!loading && halqa && !selected" x-cloak class="mt-6">
        <div x-show="halqa && halqa.students.length === 0" class="card p-12 text-center">
            <p class="text-lg font-bold text-slate-700">لا يوجد طلاب في حلقتك بعد.</p>
            <p class="mt-2 text-sm text-slate-500">يضيف المدير الطلاب إلى حلقتك.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <template x-for="student in (halqa ? halqa.students : [])" :key="student.studentId">
                <button type="button"
                        class="card p-4 w-full min-h-[104px] text-start transition-colors hover:border-primary/40 focus:outline-none focus:ring-2 focus:ring-primary active:bg-slate-50"
                        x-on:click="openStudent(student)">
                    <p class="text-lg font-bold text-slate-800 truncate" x-text="name(student.fullNameAr, student.fullName)"></p>
                    <p class="text-xs text-slate-400" dir="ltr" x-text="student.matricule"></p>
                    <div class="mt-3 h-2 rounded-full bg-slate-100 overflow-hidden">
                        <div class="h-full rounded-full bg-emerald-500 transition-all" :style="'width: ' + student.progressPercent + '%'"></div>
                    </div>
                    <p class="mt-2 text-sm text-slate-600">
                        <span class="font-semibold" x-text="student.completedHizbs"></span> حزبًا كاملًا
                        · <span dir="ltr" x-text="student.progressPercent + '%'"></span>
                    </p>
                </button>
            </template>
        </div>
    </div>

    @* ------------------------------------------------------------------ Grille des 60 Hizb d'un élève *@
    <div x-show="selected" x-cloak class="mt-6">
        <div class="card p-4">
            <p class="text-xl font-bold text-slate-800" x-text="selected ? name(selected.fullNameAr, selected.fullName) : ''"></p>
            <div class="mt-3 grid grid-cols-3 gap-3 text-center" x-show="grid" x-cloak>
                <div class="rounded-xl bg-emerald-50 p-3">
                    <p class="text-2xl font-bold text-emerald-700" x-text="grid ? grid.summary.completedHizbs : 0"></p>
                    <p class="text-xs text-slate-600">حزب كامل</p>
                </div>
                <div class="rounded-xl bg-amber-50 p-3">
                    <p class="text-2xl font-bold text-amber-700" x-text="grid ? grid.summary.inProgressHizbs : 0"></p>
                    <p class="text-xs text-slate-600">قيد الحفظ</p>
                </div>
                <div class="rounded-xl bg-slate-50 p-3">
                    <p class="text-2xl font-bold text-slate-700" dir="ltr" x-text="(grid ? grid.summary.progressPercent : 0) + '%'"></p>
                    <p class="text-xs text-slate-600">من القرآن</p>
                </div>
            </div>

            @* Légende : trois états, trois teintes — la couleur ne porte jamais seule l'information (les quarts sont aussi dessinés). *@
            <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-slate-600">
                <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border-2 border-slate-300 bg-white"></span>لم يبدأ</span>
                <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border-2 border-amber-400 bg-amber-50"></span>قيد الحفظ</span>
                <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border-2 border-emerald-500 bg-emerald-100"></span>مكتمل</span>
            </div>
        </div>

        <div x-show="gridLoading" class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <template x-for="i in 10" :key="i">
                <div class="card h-[140px] skeleton"></div>
            </template>
        </div>

        <div x-show="!gridLoading" class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <template x-for="group in groups" :key="group.juz">
                <section class="card p-3">
                    <h3 class="text-sm font-bold text-slate-500">الجزء <span x-text="group.juz"></span></h3>
                    <div class="mt-2 grid grid-cols-2 gap-2">
                        <template x-for="cell in group.hizbs" :key="cell.hizbNumber">
                            <button type="button"
                                    class="rounded-xl border-2 p-2 min-h-[76px] flex flex-col items-center justify-center gap-2 transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
                                    :class="cellClasses(cell.state)"
                                    :aria-label="'الحزب ' + cell.hizbNumber + ' — ' + quarterLabel(cell.completedQuarters)"
                                    x-on:click="openDrawer(cell)">
                                <span class="text-xl font-bold" x-text="cell.hizbNumber"></span>
                                <span class="flex w-full gap-1" aria-hidden="true">
                                    <template x-for="q in [1, 2, 3, 4]" :key="q">
                                        <span class="h-2 flex-1 rounded-full" :class="quarterFilled(cell, q) ? 'bg-emerald-600' : 'bg-slate-200'"></span>
                                    </template>
                                </span>
                            </button>
                        </template>
                    </div>
                </section>
            </template>
        </div>
    </div>

    @* ------------------------------------------------------------------ Tiroir de saisie des quarts *@
    <div x-show="drawer.open" x-cloak class="fixed inset-0 z-50" role="dialog" aria-modal="true"
         x-on:keydown.escape.window="closeDrawer()">
        <div class="absolute inset-0 bg-slate-900/50" x-on:click="closeDrawer()"></div>

        <div class="absolute inset-x-0 bottom-0 max-h-[92vh] overflow-y-auto rounded-t-2xl bg-white p-5 shadow-2xl sm:mx-auto sm:max-w-xl">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-xl font-bold text-slate-800">الحزب <span x-text="drawer.cell ? drawer.cell.hizbNumber : ''"></span></h2>
                    <p class="text-sm text-slate-500">الجزء <span x-text="drawer.juz"></span></p>
                </div>
                <button type="button" class="min-h-[48px] min-w-[48px] rounded-xl text-slate-500 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-primary"
                        aria-label="إغلاق" x-on:click="closeDrawer()">
                    <icon name="x" class="w-6 h-6 mx-auto" />
                </button>
            </div>

            <p class="mt-5 text-sm font-semibold text-slate-600">ما حفظه الطالب من هذا الحزب</p>
            <div class="mt-2 grid grid-cols-2 gap-3">
                <template x-for="q in [1, 2, 3, 4, 0]" :key="q">
                    <button type="button"
                            class="min-h-[64px] rounded-xl border-2 px-3 text-lg font-bold transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
                            :class="(drawer.quarters === q ? 'border-primary bg-primary-50 text-primary-700' : 'border-slate-200 bg-white text-slate-700') + (q === 0 ? ' col-span-2' : '')"
                            :aria-pressed="drawer.quarters === q"
                            x-on:click="pickQuarters(q)"
                            x-text="quarterLabel(q)"></button>
                </template>
            </div>

            <p class="mt-5 text-sm font-semibold text-slate-600">جودة التلاوة (التجويد) <span class="font-normal text-slate-400">— اختياري</span></p>
            <div class="mt-2 flex items-center justify-between gap-2">
                <template x-for="r in [1, 2, 3, 4, 5]" :key="r">
                    <button type="button"
                            class="h-14 w-14 rounded-full border-2 text-lg font-bold transition-colors focus:outline-none focus:ring-2 focus:ring-primary disabled:opacity-40 disabled:cursor-not-allowed"
                            :class="drawer.rating === r ? 'border-primary bg-primary text-white' : 'border-slate-200 bg-white text-slate-700'"
                            :disabled="drawer.quarters === 0"
                            :aria-pressed="drawer.rating === r"
                            x-on:click="pickRating(r)"
                            x-text="r"></button>
                </template>
            </div>

            <p x-show="drawer.error" x-cloak class="mt-4 rounded-lg bg-danger-bg p-3 text-sm text-danger" role="alert" x-text="drawer.error"></p>

            <div class="mt-6 grid grid-cols-2 gap-3">
                <button type="button"
                        class="min-h-[56px] rounded-xl bg-primary text-lg font-bold text-white hover:bg-primary-600 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-40 disabled:cursor-not-allowed"
                        :disabled="!canSave" x-on:click="save()">
                    <span x-show="!drawer.saving">حفظ</span>
                    <span x-show="drawer.saving" x-cloak>جارٍ الحفظ…</span>
                </button>
                <button type="button"
                        class="min-h-[56px] rounded-xl border border-slate-300 bg-white text-lg font-semibold text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-primary"
                        x-on:click="closeDrawer()">إلغاء</button>
            </div>
        </div>
    </div>
</div>
