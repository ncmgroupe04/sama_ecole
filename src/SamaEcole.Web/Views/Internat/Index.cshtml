@{
    ViewData["Title"] = "Internat";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/internat.js" asp-append-version="true"></script>
}

@* Pas de `x-init="init()"` : Alpine appelle DÉJÀ tout seul la méthode `init()` d'un composant
   x-data. L'ajouter la déclenchait une seconde fois — GET /api/v1/internat/dashboard
   serait demandé deux fois à chaque ouverture. *@
<div x-data="internatPage()">
    <div class="page-header">
        <div>
            <h1 class="page-title">Internat</h1>
            <p class="page-subtitle">Occupation des dortoirs pour l'année scolaire active et affectation des élèves internes et demi-pensionnaires.</p>
        </div>
    </div>

    <!-- Barre KPI -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        <template x-if="loading">
            <template x-for="i in 4" :key="i">
                <div class="card p-5 h-[92px] skeleton"></div>
            </template>
        </template>

        <template x-if="!loading && dashboard">
            <stat-card label="Occupation" icon="bed" accent="primary">
                <span x-text="dashboard.totalOccupied + ' / ' + dashboard.totalCapacity">0</span>
            </stat-card>
        </template>
        <template x-if="!loading && dashboard">
            <stat-card label="Internes" icon="users" accent="blue">
                <span x-text="dashboard.interneCount">0</span>
            </stat-card>
        </template>
        <template x-if="!loading && dashboard">
            <stat-card label="Demi-pensionnaires" icon="users" accent="purple">
                <span x-text="dashboard.demiPensionnaireCount">0</span>
            </stat-card>
        </template>
        <template x-if="!loading && dashboard">
            <stat-card label="Chambres complètes" icon="alert-circle" accent="warning">
                <span x-text="dashboard.fullRoomsCount + ' / ' + dashboard.rooms.length">0</span>
            </stat-card>
        </template>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- Cartes par chambre -->
    <div class="mt-6">
        <template x-if="!loading && dashboard && dashboard.rooms.length === 0">
            <div class="card p-12">
                <empty-state icon="bed" title="Aucun dortoir n'est configuré."
                             hint="Créez une salle de type « Dortoir » depuis Bâtiments et Salles (/infrastructures) pour commencer à affecter des élèves." />
            </div>
        </template>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <template x-for="room in (dashboard ? dashboard.rooms : [])" :key="room.roomId">
                <div class="card p-4" x-data="{ expanded: false }">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <p class="font-semibold text-slate-800 truncate" x-text="room.roomName"></p>
                            <p class="text-xs text-slate-400 truncate" x-text="room.buildingName"></p>
                        </div>
                        @* Task 15 rendait ceci via <badge :variant="..."> — un binding Alpine inerte (BadgeTagHelper
                           lit Variant comme une propriété C# statique au rendu serveur) qui affichait toujours la
                           variante neutre par défaut. Trois badges statiques, chacun sa propre condition x-show,
                           comme la pastille de statut de la modale d'affectation ci-dessous (Correction Task 16). *@
                        <badge x-show="room.occupantsCount >= room.capacity" variant="danger">
                            <span x-text="room.occupantsCount + ' / ' + room.capacity"></span>
                        </badge>
                        <badge x-show="room.occupantsCount === 0" variant="neutral">
                            <span x-text="room.occupantsCount + ' / ' + room.capacity"></span>
                        </badge>
                        <badge x-show="room.occupantsCount > 0 && room.occupantsCount < room.capacity" variant="success">
                            <span x-text="room.occupantsCount + ' / ' + room.capacity"></span>
                        </badge>
                    </div>

                    <div class="mt-3 h-2 rounded-full bg-slate-100 overflow-hidden">
                        <div class="h-full rounded-full transition-all" :class="occupancyColor(room)" :style="'width: ' + occupancyPercent(room) + '%'"></div>
                    </div>

                    <button type="button" x-show="room.occupants.length > 0" x-cloak
                            class="mt-3 text-xs font-medium text-primary-600 hover:text-primary-700"
                            x-on:click="expanded = !expanded">
                        <span x-text="expanded ? 'Masquer les occupants' : 'Voir les occupants (' + room.occupants.length + ')'"></span>
                    </button>

                    <ul x-show="expanded" x-cloak class="mt-2 space-y-2 border-t border-slate-100 pt-2">
                        <template x-for="occupant in room.occupants" :key="occupant.enrollmentId">
                            <li class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-slate-700 truncate" x-text="occupant.fullName"></p>
                                    <p class="text-xs text-slate-400 truncate" x-text="occupant.classroomName + (occupant.guardianPhone ? ' · ' + occupant.guardianPhone : '')"></p>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <badge x-show="occupant.boardingStatus === 'Interne'" variant="primary">
                                        <span>Interne</span>
                                    </badge>
                                    <badge x-show="occupant.boardingStatus !== 'Interne'" variant="neutral">
                                        <span>Demi-pensionnaire</span>
                                    </badge>
                                    <button type="button" class="text-xs text-rose-600 hover:text-rose-700 whitespace-nowrap"
                                            x-on:click="openChangeOccupantModal(room, occupant)">
                                        Changer / Libérer
                                    </button>
                                </div>
                            </li>
                        </template>
                    </ul>

                    <button type="button"
                            class="mt-3 inline-flex items-center justify-center gap-1.5 w-full px-3 py-1.5 rounded-lg border border-primary/30 bg-primary-50 text-primary text-xs font-semibold hover:bg-primary-100 focus:outline-none focus:ring-2 focus:ring-primary transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            :disabled="room.occupantsCount >= room.capacity"
                            x-on:click="openAssignModal(room)">
                        <icon name="plus" class="w-4 h-4" />
                        Affecter un élève
                    </button>
                </div>
            </template>
        </div>
    </div>

    <!-- Modale d'affectation rapide (Task 16) : recherche d'élève, statut actuel, avertissement de
         transfert, choix du régime (dont Externe = libération), pension, confirmation. -->
    <modal-shell open="assignModal.open" on-close="closeAssignModal()" size="md" title="Affecter un élève">
        <div class="space-y-4">
            <p class="text-sm text-slate-500">
                Chambre : <strong x-text="assignModal.room?.roomName"></strong>
                (<span x-text="assignModal.room?.buildingName"></span>)
            </p>

            <div class="relative">
                <label class="form-label">Élève</label>
                <input type="text" x-model="assignModal.searchTerm" x-on:input="onSearchInput()"
                       placeholder="Nom, prénom ou matricule" class="input-field mt-1" autocomplete="off" />
                <ul x-show="assignModal.results.length > 0" x-cloak
                    class="absolute z-10 w-full bg-white border border-slate-200 rounded-lg mt-1 shadow-lg max-h-48 overflow-auto">
                    <template x-for="student in assignModal.results" :key="student.enrollmentId">
                        <li class="px-3 py-2 hover:bg-slate-50 cursor-pointer text-sm" x-on:click="selectStudent(student)">
                            <span x-text="student.fullName"></span>
                            <span class="text-xs text-slate-400" x-text="' — ' + student.classroomName"></span>
                        </li>
                    </template>
                </ul>
            </div>

            <template x-if="assignModal.selected">
                <div class="space-y-3">
                    <div>
                        <badge x-show="assignModal.selected.boardingStatus === 'Externe'" variant="neutral">
                            <span>Externe</span>
                        </badge>
                        <badge x-show="assignModal.selected.boardingStatus === 'DemiPensionnaire'" variant="primary">
                            <span x-text="'Demi-pensionnaire' + (assignModal.selected.currentRoomName ? ' — ' + assignModal.selected.currentRoomName : '')"></span>
                        </badge>
                        <badge x-show="assignModal.selected.boardingStatus === 'Interne'" variant="primary">
                            <span x-text="'Interne' + (assignModal.selected.currentRoomName ? ' — ' + assignModal.selected.currentRoomName : '')"></span>
                        </badge>
                    </div>

                    <p x-show="isTransfer() && !isReleasing()" x-cloak
                       class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
                        <span x-text="assignModal.selected.fullName"></span> sera transféré depuis
                        <strong x-text="assignModal.selected.currentRoomName"></strong> vers
                        <strong x-text="assignModal.room?.roomName"></strong>.
                    </p>

                    <div>
                        <label class="form-label">Régime</label>
                        <select-field model="assignModal.boardingStatus"
                                      options-expr="[{value:'Interne', label:'Interne'},{value:'DemiPensionnaire', label:'Demi-pensionnaire'},{value:'Externe', label:'Externe (libérer)'}]" />
                    </div>

                    <div class="flex items-start gap-2" x-show="!isReleasing()" x-cloak>
                        <input id="assign-boarding-fee" type="checkbox" x-model="assignModal.includeBoardingFee" class="checkbox-field mt-1">
                        <label for="assign-boarding-fee" class="text-sm text-slate-700">
                            Ajouter le frais de pension au dossier de l'élève (sans doublon s'il existe déjà)
                        </label>
                    </div>
                </div>
            </template>

            <p x-show="assignModal.error" x-cloak class="field-error" x-text="assignModal.error"></p>

            <div class="flex justify-end gap-3 pt-2">
                <button type="button" class="btn-modal-secondary group" x-on:click="closeAssignModal()">Annuler</button>
                <button type="button" class="btn-modal-primary group"
                        :disabled="!assignModal.selected || assignModal.saving"
                        x-on:click="confirmAssignment()">
                    <span x-text="assignModal.saving ? 'Enregistrement…' : (isReleasing() ? 'Confirmer la libération' : 'Confirmer l\'affectation')"></span>
                </button>
            </div>
        </div>
    </modal-shell>
</div>
