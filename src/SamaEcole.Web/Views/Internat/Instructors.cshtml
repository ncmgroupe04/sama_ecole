@{
    ViewData["Title"] = "Oustaz";
}

@* Gestion des Oustaz (Direction). auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une
   seconde fois. Pas de `x-init="init()"` : Alpine appelle DÉJÀ la méthode init() d'un composant x-data.
   Pas d'attribut dynamique sur <badge> : ce Tag Helper lit ses attributs au rendu serveur, un binding Alpine y reste
   inerte (même piège que dans Internat/Index.cshtml) — d'où un badge statique par statut, chacun avec son x-show. *@
@section Scripts {
    <script src="~/js/instructors.js" asp-append-version="true"></script>
}

<div x-data="instructorsPage()">
    <div class="page-header">
        <div>
            <h1 class="page-title">Oustaz</h1>
            <p class="page-subtitle">Les maîtres coraniques et leur Halqa : fiche, statut et compte de connexion pour la tablette.</p>
        </div>
        <button type="button" x-show="canWrite" x-cloak class="btn-modal-primary" x-on:click="openCreate()">
            <icon name="plus" class="w-4 h-4" />
            Nouvel Oustaz
        </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
        <template x-if="loading">
            <template x-for="i in 3" :key="i">
                <div class="card p-5 h-[92px] skeleton"></div>
            </template>
        </template>
        <template x-if="!loading">
            <stat-card label="Oustaz" icon="users" accent="primary">
                <span x-text="instructors.length">0</span>
            </stat-card>
        </template>
        <template x-if="!loading">
            <stat-card label="Actifs" icon="checkmark-circle" accent="blue">
                <span x-text="activeCount">0</span>
            </stat-card>
        </template>
        <template x-if="!loading">
            <stat-card label="Élèves en Halqa" icon="book" accent="purple">
                <span x-text="totalStudents">0</span>
            </stat-card>
        </template>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <div class="card mt-6">
        <div class="flex flex-col sm:flex-row gap-3 p-4 border-b border-slate-100">
            <input type="search" x-model="search" placeholder="Rechercher un nom, un téléphone, un compte…" class="input-field sm:max-w-sm" aria-label="Rechercher un Oustaz">
            <select x-model="statusFilter" class="input-field sm:max-w-[200px]" aria-label="Filtrer par statut">
                <option value="">Tous les statuts</option>
                <option value="Active">Actifs</option>
                <option value="Suspended">Suspendus</option>
                <option value="Blocked">Bloqués</option>
            </select>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4">Oustaz</th>
                        <th class="py-3 px-4">Téléphone</th>
                        <th class="py-3 px-4">Compte de connexion</th>
                        <th class="py-3 px-4 text-right">Élèves</th>
                        <th class="py-3 px-4">Statut</th>
                        <th class="py-3 px-4 text-right" x-show="canWrite" x-cloak>Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr x-show="!loading && filtered.length === 0" x-cloak>
                        <td colspan="6">
                            <empty-state icon="users" title="Aucun Oustaz à afficher."
                                         hint="Créez la fiche d'un Oustaz, puis rattachez-lui ses élèves avec le bouton « Élèves » de sa ligne." />
                        </td>
                    </tr>
                    <template x-for="instructor in filtered" :key="instructor.id">
                        <tr class="hover:bg-slate-50/60">
                            <td class="py-3 px-4">
                                <p class="font-semibold text-slate-800" x-text="instructor.fullName"></p>
                                <p x-show="instructor.fullNameAr" x-cloak dir="rtl" class="text-sm text-slate-500" x-text="instructor.fullNameAr"></p>
                            </td>
                            <td class="py-3 px-4 text-sm text-slate-600" x-text="instructor.phone || '—'"></td>
                            <td class="py-3 px-4 text-sm">
                                <span x-show="instructor.userEmail" x-text="instructor.userEmail" class="text-slate-700"></span>
                                <span x-show="!instructor.userEmail" x-cloak class="text-slate-400">Aucun compte</span>
                            </td>
                            <td class="py-3 px-4 text-right font-medium text-slate-700" x-text="instructor.studentCount"></td>
                            <td class="py-3 px-4">
                                <badge x-show="instructor.status === 'Active'" variant="success"><span>Actif</span></badge>
                                <badge x-show="instructor.status === 'Suspended'" variant="warning"><span>Suspendu</span></badge>
                                <badge x-show="instructor.status === 'Blocked'" variant="danger"><span>Bloqué</span></badge>
                            </td>
                            <td class="py-3 px-4 text-right whitespace-nowrap" x-show="canWrite" x-cloak>
                                <button type="button" class="mr-3 text-sm font-medium text-primary-600 hover:text-primary-700" x-on:click="openHalqa(instructor)">Élèves</button>
                                <button type="button" class="text-sm font-medium text-primary-600 hover:text-primary-700" x-on:click="openEdit(instructor)">Modifier</button>
                                <button type="button" x-show="instructor.status === 'Active'"
                                        class="ml-3 text-sm font-medium text-rose-600 hover:text-rose-700"
                                        x-on:click="openStatusChange(instructor, 'Suspended')">Suspendre</button>
                                <button type="button" x-show="instructor.status !== 'Active'" x-cloak
                                        class="ml-3 text-sm font-medium text-emerald-600 hover:text-emerald-700"
                                        x-on:click="openStatusChange(instructor, 'Active')">Réactiver</button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    @* ------------------------------------------------------------------ Création / modification *@
    <modal-shell size="lg" open="form.open" on-close="closeForm()" title="Fiche d'Oustaz">
        <modal-subtitle><span x-text="form.mode === 'create' ? 'Nouvel Oustaz : identité et compte de connexion facultatif.' : 'Modifier l\'identité, le compte lié ou le statut.'"></span></modal-subtitle>

        <div x-show="form.errors.global" x-cloak class="form-error-banner">
            <span x-text="form.errors.global"></span>
        </div>

        <form x-on:submit.prevent="submitForm()" novalidate class="space-y-4">
            <div>
                <label class="form-label form-label-required">Nom complet</label>
                <input type="text" x-model="form.fullName" required maxlength="200" placeholder="ex : Serigne Modou Diop"
                       class="input-field" :class="form.errors.fullname && 'input-field-error'">
                <p x-show="form.errors.fullname" x-text="form.errors.fullname" class="field-error"></p>
            </div>
            <div>
                <label class="form-label">Nom en arabe</label>
                <input type="text" x-model="form.fullNameAr" maxlength="200" dir="rtl" placeholder="الاسم الكامل"
                       class="input-field" :class="form.errors.fullnamear && 'input-field-error'">
                <p x-show="form.errors.fullnamear" x-text="form.errors.fullnamear" class="field-error"></p>
            </div>
            <div>
                <label class="form-label">Téléphone</label>
                <input type="tel" x-model="form.phone" maxlength="30" placeholder="ex : 77 123 45 67"
                       class="input-field" :class="form.errors.phone && 'input-field-error'">
                <p x-show="form.errors.phone" x-text="form.errors.phone" class="field-error"></p>
            </div>

            <div x-show="canWrite">
                <label class="form-label">Compte de connexion</label>
                <p class="text-xs text-slate-500 mb-1">Un compte « Enseignant » qui ouvre la Halqa de cet Oustaz sur la tablette. Un compte ne sert qu'à un seul Oustaz.</p>
                <select-field model="form.userId" placeholder="Aucun" options-expr="accountOptions" />
                <p x-show="form.errors.userid" x-text="form.errors.userid" class="field-error"></p>
            </div>

            <div x-show="form.mode === 'edit'" x-cloak>
                <label class="form-label">Statut</label>
                <select x-model="form.status" class="input-field">
                    <option value="Active">Actif</option>
                    <option value="Suspended">Suspendu</option>
                    <option value="Blocked">Bloqué</option>
                </select>
                <p class="text-xs text-slate-500 mt-1">Suspendre ou bloquer coupe aussitôt l'accès de l'Oustaz à sa Halqa. Ses élèves restent rattachés tant qu'ils ne sont pas réaffectés.</p>
            </div>

            <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
                <button type="button" x-on:click="closeForm()" class="btn-modal-secondary group">Annuler</button>
                <button type="submit" :disabled="form.saving" class="btn-modal-primary group">
                    <span x-text="form.saving ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    @* ------------------------------------------------------------------ Élèves d'une Halqa : affecter, retirer (Directeur) *@
    @* À gauche la Halqa actuelle, à droite les élèves à lui rattacher. Aucune écriture n'a lieu avant un clic explicite : « Affecter »
       envoie les élèves cochés (200 au plus), « Retirer » détache un élève après confirmation. Le serveur garde les droits et les règles. *@
    <modal-shell size="5xl" open="halqa.open" on-close="closeHalqa()" title="Élèves de la Halqa">
        <div class="space-y-4">
            <div>
                <p class="text-lg font-semibold text-slate-800" x-text="halqa.instructor ? halqa.instructor.fullName : ''"></p>
                <p x-show="halqa.instructor && halqa.instructor.fullNameAr" x-cloak dir="rtl" class="text-sm text-slate-500" x-text="halqa.instructor ? halqa.instructor.fullNameAr : ''"></p>
            </div>

            <div x-show="halqa.notice" x-cloak role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" x-text="halqa.notice"></div>
            <div x-show="halqa.error" x-cloak role="alert" class="form-error-banner"><span x-text="halqa.error"></span></div>
            <div x-show="halqa.instructor && !canAssign" x-cloak class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                Cet Oustaz n'est pas actif : réactivez-le pour lui affecter des élèves. Vous pouvez en revanche retirer ceux qu'il a déjà.
            </div>

            <div class="grid gap-6 lg:grid-cols-2">

                @* ---------------------------------------------- Halqa actuelle *@
                <section aria-labelledby="halqa-members-title">
                    <h3 id="halqa-members-title" class="text-sm font-semibold text-slate-700">
                        Dans la Halqa <span class="text-slate-400" x-text="'(' + halqa.members.length + ')'"></span>
                    </h3>
                    <p x-show="halqa.membersLoading" x-cloak class="mt-3 text-sm text-slate-500">Chargement…</p>
                    <p x-show="membersError" x-cloak role="alert" class="mt-3 text-sm text-rose-700" x-text="membersError"></p>
                    <p x-show="!halqa.membersLoading && !membersError && halqa.members.length === 0" x-cloak class="mt-3 text-sm text-slate-500">
                        Aucun élève dans cette Halqa pour l'instant.
                    </p>
                    <ul class="mt-3 max-h-[26rem] divide-y divide-slate-100 overflow-y-auto rounded-xl border border-slate-200">
                        <template x-for="member in halqa.members" :key="member.studentId">
                            <li class="flex items-center justify-between gap-3 px-3 py-2">
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-medium text-slate-800" x-text="member.fullName"></p>
                                    <p class="text-xs text-slate-500">
                                        <span x-text="member.matricule"></span>
                                        <span x-text="' · ' + member.completedHizbs + ' Hizb · ' + member.progressPercent + ' %'"></span>
                                    </p>
                                </div>
                                <div class="shrink-0 text-right">
                                    <button type="button" x-show="halqa.pendingRemoval !== member.studentId"
                                            class="text-sm font-medium text-rose-600 hover:text-rose-700"
                                            :aria-label="'Retirer ' + member.fullName + ' de la Halqa'"
                                            x-on:click="askRemove(member)">Retirer</button>
                                    <span x-show="halqa.pendingRemoval === member.studentId" x-cloak class="whitespace-nowrap text-xs">
                                        <span class="text-slate-600">Retirer ?</span>
                                        <button type="button" class="ml-2 font-semibold text-rose-600 hover:text-rose-700" :disabled="halqa.saving" x-on:click="confirmRemove()">Oui</button>
                                        <button type="button" class="ml-2 font-medium text-slate-500 hover:text-slate-700" x-on:click="cancelRemove()">Non</button>
                                    </span>
                                </div>
                            </li>
                        </template>
                    </ul>
                    <p class="mt-2 text-xs text-slate-400">Retirer un élève le détache de la Halqa ; son suivi de mémorisation est conservé.</p>
                </section>

                @* ---------------------------------------------- Élèves à affecter *@
                <section aria-labelledby="halqa-add-title">
                    <h3 id="halqa-add-title" class="text-sm font-semibold text-slate-700">Ajouter des élèves</h3>

                    <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                        <input type="search" x-model="halqa.search" x-on:input.debounce.300ms="searchCandidates()"
                               placeholder="Nom, nom arabe ou matricule" aria-label="Rechercher un élève" class="input-field sm:flex-1">
                        <select x-model="halqa.scope" x-on:change="searchCandidates()" aria-label="Élèves à afficher" class="input-field sm:max-w-[190px]">
                            <option value="unassigned">Sans Oustaz</option>
                            <option value="all">Tous les élèves</option>
                        </select>
                    </div>

                    <p x-show="halqa.candidatesLoading" x-cloak class="mt-3 text-sm text-slate-500">Chargement…</p>
                    <p x-show="candidatesError" x-cloak role="alert" class="mt-3 text-sm text-rose-700" x-text="candidatesError"></p>
                    <p x-show="!halqa.candidatesLoading && !candidatesError && halqa.candidates.length === 0" x-cloak class="mt-3 text-sm text-slate-500">
                        Aucun élève ne correspond.
                    </p>

                    <div x-show="halqa.candidates.length > 0" x-cloak class="mt-3">
                        <label class="mb-2 flex items-center gap-2 text-xs text-slate-600">
                            <input type="checkbox" class="checkbox-field" :disabled="!canAssign" x-on:change="toggleSelectPage()"
                                   :checked="pageFullySelected">
                            Sélectionner les élèves de cette page
                        </label>
                        <ul class="max-h-[22rem] divide-y divide-slate-100 overflow-y-auto rounded-xl border border-slate-200">
                            <template x-for="student in halqa.candidates" :key="student.studentId">
                                <li class="px-3 py-2">
                                    <label class="flex items-start gap-3" :class="isSelectable(student) && canAssign ? 'cursor-pointer' : 'opacity-60'">
                                        <input type="checkbox" class="checkbox-field mt-1"
                                               :checked="isSelected(student.studentId)"
                                               :disabled="!isSelectable(student) || !canAssign"
                                               x-on:change="toggleSelect(student)">
                                        <span class="min-w-0">
                                            <span class="block truncate text-sm font-medium text-slate-800" x-text="student.fullName"></span>
                                            <span class="block text-xs text-slate-500" x-text="student.matricule + ' · ' + student.classroomName"></span>
                                            <span x-show="student.instructorId && student.instructorId === halqa.instructor.id" x-cloak class="block text-xs text-emerald-700">Déjà dans cette Halqa</span>
                                            <span x-show="moveWarning(student)" x-cloak class="block text-xs text-amber-700" x-text="moveWarning(student)"></span>
                                        </span>
                                    </label>
                                </li>
                            </template>
                        </ul>

                        <div class="mt-2 flex items-center justify-between text-xs text-slate-500">
                            <span x-text="halqa.total + (halqa.total === 1 ? ' élève' : ' élèves')"></span>
                            <span class="flex items-center gap-2" x-show="pageCount > 1" x-cloak>
                                <button type="button" class="font-medium text-primary-600 disabled:text-slate-300" :disabled="halqa.page <= 1" x-on:click="goToCandidatePage(halqa.page - 1)">Précédent</button>
                                <span x-text="'Page ' + halqa.page + ' / ' + pageCount"></span>
                                <button type="button" class="font-medium text-primary-600 disabled:text-slate-300" :disabled="halqa.page >= pageCount" x-on:click="goToCandidatePage(halqa.page + 1)">Suivant</button>
                            </span>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <div class="bg-white border-t border-slate-100 p-4 px-6 flex flex-wrap items-center justify-between gap-3 -mx-6 -mb-6 mt-6 z-10">
            <p class="text-sm text-slate-600" aria-live="polite">
                <span x-text="selectedCount"></span> <span x-text="selectedCount === 1 ? 'élève sélectionné' : 'élèves sélectionnés'"></span>
            </p>
            <div class="flex gap-3">
                <button type="button" x-on:click="closeHalqa()" class="btn-modal-secondary group">Fermer</button>
                <button type="button" x-on:click="assignSelected()" :disabled="halqa.saving || selectedCount === 0 || !canAssign" class="btn-modal-primary group">
                    <span x-text="halqa.saving ? 'Enregistrement...' : 'Affecter à ' + (halqa.instructor ? halqa.instructor.fullName : '')"></span>
                </button>
            </div>
        </div>
    </modal-shell>

    @* ------------------------------------------------------------------ Confirmation de suspension / réactivation *@
    <modal-shell size="lg" open="confirm.open" on-close="closeConfirm()" title="Changer le statut">
        <div x-show="confirm.error" x-cloak class="form-error-banner">
            <span x-text="confirm.error"></span>
        </div>

        <div class="space-y-3">
            <p class="text-sm text-slate-700" x-show="confirm.target === 'Suspended'">
                Suspendre <strong x-text="confirm.instructor ? confirm.instructor.fullName : ''"></strong> ? Il perdra
                immédiatement l'accès à sa Halqa sur la tablette et ne pourra plus recevoir de nouveaux élèves. Ses élèves
                actuels restent rattachés jusqu'à leur réaffectation.
            </p>
            <p class="text-sm text-slate-700" x-show="confirm.target === 'Active'" x-cloak>
                Réactiver <strong x-text="confirm.instructor ? confirm.instructor.fullName : ''"></strong> ? Il retrouvera
                l'accès à sa Halqa.
            </p>
        </div>

        <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
            <button type="button" x-on:click="closeConfirm()" class="btn-modal-secondary group">Annuler</button>
            <button type="button" x-on:click="confirmStatusChange()" :disabled="confirm.saving" class="btn-modal-primary group">
                <span x-text="confirm.saving ? 'Enregistrement...' : 'Confirmer'"></span>
            </button>
        </div>
    </modal-shell>
</div>
