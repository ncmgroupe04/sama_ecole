@*
    Onglet « Pointage » de /internat (lot G4, tâche 11) — feuille d'appel d'une SESSION de pointage (appel de nuit, repas, appel d'une Halqa) et pointage
    collectif, sur /api/v1/boarding. Composant Alpine `attendanceTab` (wwwroot/js/internat-attendance.js) ; la configuration des sessions (Directeur) est
    la modale `attendanceSessionsConfig` (wwwroot/js/attendance-sessions.js), ouverte par l'événement `open-attendance-sessions`.

    Un pensionnaire en permission est verrouillé « absent » (le serveur refuserait « présent » : BOARDER_ON_LEAVE). Seules les lignes décidées et modifiées
    sont envoyées. Un résultat mixte garde chaque refus visible sur sa ligne.
*@
<div x-data="attendanceTab()" x-on:internat-tab-shown.window="onTabShown($event.detail.key)" x-on:attendance-sessions-changed.window="onSessionsChanged()">
    <div class="mt-6 flex flex-wrap items-start justify-between gap-3">
        <p class="text-sm text-slate-500">
            <span x-show="!hasSessions">Appel du soir par pavillon : choisissez le pavillon et la nuit, pointez chaque interne, puis enregistrez.</span>
            <span x-show="hasSessions" x-cloak>Choisissez la session (appel de nuit, repas, appel d'une Halqa…), le groupe et le jour, pointez chaque élève, puis enregistrez.</span>
        </p>
        <button type="button" x-show="canConfigure" x-cloak class="btn-modal-secondary group" x-on:click="$dispatch('open-attendance-sessions')">
            <icon name="settings" class="w-4 h-4" />
            Configurer les sessions
        </button>
    </div>

    <!-- Session, groupe (pavillon, classe ou Oustaz) et jour -->
    <div class="card mt-4 p-4">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div x-show="hasSessions" x-cloak>
                <label class="form-label">Session</label>
                <select-field model="sel.sessionId" options-expr="sessionOptions" on-change="onSessionChange()" placeholder="Choisir une session…" />
            </div>
            <div :class="hasSessions ? '' : 'sm:col-span-2'" x-show="!isGroup">
                <label class="form-label">Pavillon</label>
                <select-field model="sel.dormitoryId" options-expr="dormitoryOptions" on-change="onSelectionChange()" placeholder="Choisir un pavillon…" />
            </div>
            <div x-show="isGroup" x-cloak>
                <label class="form-label" x-text="groupLabel"></label>
                <select-field model="sel.groupId" options-expr="groupOptions" on-change="onSelectionChange()" placeholder="Choisir…" />
            </div>
            <div>
                <label class="form-label" x-text="dayLabel"></label>
                <date-field model="sel.date" required="true" aria-label="Jour à pointer" class="mt-1" />
                <button type="button" class="mt-2 text-xs font-semibold text-primary-600 hover:text-primary-700" x-on:click="onSelectionChange()">Charger ce jour</button>
            </div>
        </div>
        <p x-show="dateError" x-cloak class="field-error mt-2" role="alert" x-text="dateError"></p>
        <p x-show="isGroup && groups.length === 0 && !loading" x-cloak class="mt-3 text-sm text-slate-500">
            Aucun groupe à pointer pour cette session : aucune classe n'a de pensionnaire de ce type, ou aucun Oustaz n'est actif.
        </p>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <p x-show="notice" x-cloak class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status" x-text="notice"></p>

    <template x-if="loading">
        <div class="card mt-4 space-y-2 p-4">
            <template x-for="i in 6" :key="i"><div class="h-10 rounded skeleton"></div></template>
        </div>
    </template>

    <template x-if="!loading && !hasSheet && !error">
        <div class="card mt-4 p-12">
            <empty-state icon="moon" title="Aucune feuille d'appel affichée."
                         hint="Choisissez un groupe (pavillon, classe ou Oustaz) pour afficher les élèves à pointer." />
        </div>
    </template>

    <template x-if="!loading && hasSheet">
        <div class="mt-4 space-y-4">
            <!-- Bilan et actions -->
            <div class="card flex flex-wrap items-center justify-between gap-3 p-4">
                <div class="flex flex-wrap items-center gap-2 text-sm">
                    <strong class="text-slate-800" x-text="sheetName"></strong>
                    <badge variant="success"><span x-text="counts.present + ' présent(s)'"></span></badge>
                    <badge variant="danger"><span x-text="counts.absent + ' absent(s)'"></span></badge>
                    <badge variant="neutral"><span x-text="counts.pending + ' à pointer'"></span></badge>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" class="btn-modal-secondary group" x-on:click="markAllPresent()" :disabled="counts.pending === 0">Tout présent</button>
                    <button type="button" x-show="canSummarize" x-cloak class="btn-modal-secondary group" x-on:click="openSummary()">
                        <icon name="calendar" class="w-4 h-4" />
                        Récapitulatif du mois
                    </button>
                    <button type="button" x-show="canPrintRegister" x-cloak class="btn-modal-secondary group" x-on:click="openRegisterPdf()">
                        <icon name="print" class="w-4 h-4" />
                        Registre PDF
                    </button>
                    <button type="button" class="btn-modal-primary group" :disabled="!canSave" x-on:click="save()">
                        <span x-text="saving ? 'Enregistrement…' : 'Enregistrer le pointage'"></span>
                    </button>
                </div>
            </div>

            <!-- Un jour que la session ne couvre pas : on le dit, on ne le bloque pas -->
            <p x-show="outsideDays" x-cloak role="status" class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                Ce jour n'est pas dans les jours prévus pour cette session. Vous pouvez quand même pointer.
            </p>

            <!-- Refus du serveur : chaque ligne refusée est détaillée, sans masquer les lignes enregistrées -->
            <div x-show="rejectedLines.length > 0" x-cloak role="alert" class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
                <p class="font-semibold" x-text="rejectedLines.length + ' ligne(s) refusée(s) par le serveur :'"></p>
                <ul class="mt-1 list-disc space-y-1 pl-5">
                    <template x-for="line in rejectedLines" :key="line.boarderId">
                        <li><strong x-text="line.studentName"></strong> — <span x-text="line.rejection"></span></li>
                    </template>
                </ul>
            </div>

            <!-- Feuille d'appel : chambre → lit -->
            <div class="card overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-100 text-sm">
                        <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                            <tr>
                                <th scope="col" class="px-4 py-3" x-text="isPavilionSheet ? 'Chambre · lit' : 'Détail'"></th>
                                <th scope="col" class="px-4 py-3">Élève</th>
                                <th scope="col" class="px-4 py-3">Présence</th>
                                <th scope="col" class="px-4 py-3">Note</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <template x-for="line in lines" :key="line.boarderId">
                                <tr :class="line.rejection ? 'bg-rose-50/50' : ''">
                                    <td class="px-4 py-3 text-slate-600 whitespace-nowrap">
                                        <template x-if="isPavilionSheet">
                                            <span><span x-text="line.roomName"></span> · Lit <span x-text="line.bedNumber"></span></span>
                                        </template>
                                        <template x-if="!isPavilionSheet">
                                            <span x-text="line.roomName || '—'"></span>
                                        </template>
                                    </td>
                                    <td class="px-4 py-3">
                                        <p class="font-medium text-slate-800" x-text="line.studentName"></p>
                                        <p class="text-xs text-slate-400">
                                            <span x-text="line.matricule"></span>
                                            <badge x-show="line.onLeave" x-cloak variant="warning" class="ml-1">En permission</badge>
                                            <badge x-show="line.recorded && !logic().isDirty(line)" x-cloak variant="success" class="ml-1">Enregistré</badge>
                                        </p>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="inline-flex overflow-hidden rounded-lg border border-slate-200" role="group" :aria-label="'Présence de ' + line.studentName">
                                            <button type="button" class="px-3 py-1.5 text-xs font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-40"
                                                    :class="line.isPresent === true ? 'bg-emerald-600 text-white' : 'bg-white text-slate-600 hover:bg-slate-50'"
                                                    :aria-pressed="line.isPresent === true" :disabled="line.onLeave"
                                                    :title="line.onLeave ? 'En permission : ne peut être pointé qu\'absent' : ''"
                                                    x-on:click="setPresence(line, true)">Présent</button>
                                            <button type="button" class="border-l border-slate-200 px-3 py-1.5 text-xs font-semibold transition-colors"
                                                    :class="line.isPresent === false ? 'bg-rose-600 text-white' : 'bg-white text-slate-600 hover:bg-slate-50'"
                                                    :aria-pressed="line.isPresent === false"
                                                    x-on:click="setPresence(line, false)">Absent</button>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <input type="text" maxlength="300" x-model="line.note" class="input-field" placeholder="Note (facultatif)" :aria-label="'Note pour ' + line.studentName" />
                                        <p x-show="line.rejection" x-cloak class="mt-1 text-xs text-rose-700" x-text="line.rejection"></p>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </template>

    <!-- Saisie non enregistrée : changer de pavillon ou de nuit la jetterait -->
    <modal-shell open="discard.open" on-close="cancelDiscard()" size="md" title="Abandonner la saisie ?">
        <div class="space-y-4">
            <p class="text-sm text-slate-700">Des pointages de cette feuille n'ont pas été enregistrés. Changer de session, de groupe ou de jour les abandonnerait.</p>
            <div class="flex justify-end gap-3 pt-2">
                <button type="button" class="btn-modal-secondary group" x-on:click="cancelDiscard()">Revenir à la feuille</button>
                <button type="button" class="btn-modal-primary group" x-on:click="confirmDiscard()">Abandonner la saisie</button>
            </div>
        </div>
    </modal-shell>

    <!-- Récapitulatif du mois : présents / absents / en permission / non pointés par élève, imprimable -->
    <modal-shell open="summary.open" on-close="closeSummary()" size="xl" title="Récapitulatif du mois">
        <div class="space-y-4">
            <div class="flex flex-wrap items-end justify-between gap-3">
                <div>
                    <label for="summary-month" class="form-label">Mois</label>
                    <input id="summary-month" type="month" class="input-field mt-1" x-model="summary.month" x-on:change="loadSummary()" />
                </div>
                <button type="button" class="btn-modal-secondary group" :disabled="!summary.data || summary.loading" x-on:click="openSummaryPdf()">
                    <icon name="print" class="w-4 h-4" />
                    Imprimer (PDF)
                </button>
            </div>

            <p x-show="summaryError" x-cloak class="field-error" role="alert" x-text="summaryError"></p>
            <div x-show="summary.loading" x-cloak class="space-y-2"><div class="h-8 rounded skeleton"></div><div class="h-8 rounded skeleton"></div></div>

            <template x-if="summary.data && !summary.loading">
                <div class="space-y-3">
                    <p class="text-sm font-semibold text-slate-800" x-text="summaryTitle"></p>
                    <p class="text-xs text-slate-500">
                        <span x-text="summary.data.days.length + ' jour(s) pointé(s)'"></span>
                        <span x-show="summary.data.days.length === 0"> — aucun pointage ce mois-ci pour cette session.</span>
                    </p>
                    <div class="max-h-[50vh] overflow-auto rounded-lg border border-slate-200">
                        <table class="min-w-full divide-y divide-slate-100 text-sm">
                            <thead class="sticky top-0 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                                <tr>
                                    <th scope="col" class="px-3 py-2">Élève</th>
                                    <th scope="col" class="px-3 py-2 text-center">Présents</th>
                                    <th scope="col" class="px-3 py-2 text-center">Absents</th>
                                    <th scope="col" class="px-3 py-2 text-center">En perm.</th>
                                    <th scope="col" class="px-3 py-2 text-center">Non pointés</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <template x-for="row in summary.data.rows" :key="row.studentId">
                                    <tr>
                                        <td class="px-3 py-2">
                                            <p class="font-medium text-slate-800" x-text="row.studentName"></p>
                                            <p class="text-xs text-slate-400"><span x-text="row.matricule"></span><span x-show="row.detail"> · <span x-text="row.detail"></span></span></p>
                                        </td>
                                        <td class="px-3 py-2 text-center" x-text="row.present"></td>
                                        <td class="px-3 py-2 text-center" x-text="row.absent"></td>
                                        <td class="px-3 py-2 text-center" x-text="row.onLeave"></td>
                                        <td class="px-3 py-2 text-center" x-text="row.notRecorded"></td>
                                    </tr>
                                </template>
                            </tbody>
                            <tfoot x-show="summary.data.rows.length > 0" class="bg-slate-50 font-semibold">
                                <tr>
                                    <td class="px-3 py-2">Total du groupe</td>
                                    <td class="px-3 py-2 text-center" x-text="summaryTotals.present"></td>
                                    <td class="px-3 py-2 text-center" x-text="summaryTotals.absent"></td>
                                    <td class="px-3 py-2 text-center" x-text="summaryTotals.onLeave"></td>
                                    <td class="px-3 py-2 text-center" x-text="summaryTotals.notRecorded"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <p x-show="summary.data.rows.length === 0" x-cloak class="text-sm text-slate-500">Aucun élève dans ce groupe.</p>
                </div>
            </template>

            <div class="flex justify-end pt-2">
                <button type="button" class="btn-modal-secondary group" x-on:click="closeSummary()">Fermer</button>
            </div>
        </div>
    </modal-shell>

    @* Configuration des sessions (Directeur) : modale propre, ouverte par « Configurer les sessions ». *@
    @await Html.PartialAsync("~/Views/Internat/_AttendanceSessions.cshtml")

    @* Après les autres modales dans le DOM : l'aperçu du registre s'ouvre par-dessus. *@
    @await Html.PartialAsync("_PdfPreviewModal")
</div>
