@{
 ViewData["Title"] = "Rapports d'assiduité";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/attendance-report.js" asp-append-version="true"></script>
}

<div x-data="attendanceReportView()">
 <div>
 <h1 class="page-title">Rapports d'assiduité</h1>
 <p class="page-subtitle">Taux de présence par classe et par élève, sur une période choisie.</p>
 </div>

 <!-- Cartes de synthèse -->
 <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
 <template x-if="isLoading">
 <template x-for="i in 3" :key="i">
 <div class="card p-5 h-[92px] skeleton"></div>
 </template>
 </template>

 <template x-if="!isLoading && data">
 <stat-card label="Taux d'assiduité moyen" icon="checkmark-circle" accent="success">
 <span x-text="formatPercent(data.averageAttendanceRate)"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Élèves suivis" icon="users" accent="primary">
 <span x-text="data.totalCount"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Période" icon="document" accent="primary">
 <span class="text-base" x-text="periodLabel()"></span>
 </stat-card>
 </template>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <div class="card mt-6 relative">
 <!-- Filtres : classe + période -->
 <div class="filter-bar lg:items-end lg:justify-between">
 <div class="flex flex-wrap items-end gap-3">
 <div>
 <label class="form-label-sm">Classe</label>
 <select-field model="classId" aria-label="Filtrer par classe" class="mt-0" placeholder="Toutes les classes"
 options-expr="[{value:'', label:'Toutes les classes'}].concat(classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'})))" />
 </div>
 <div>
 <label class="form-label-sm">Du</label>
 <date-field model="startDate" aria-label="Date de début" class="mt-0" />
 </div>
 <div>
 <label class="form-label-sm">Au</label>
 <date-field model="endDate" aria-label="Date de fin" class="mt-0" />
 </div>
 <button type="button" x-on:click="applyFilters()" class="btn-modal-primary group">
 <icon name="chart-multiple" class="w-4 h-4" />
 Générer
 </button>
 <button type="button" x-on:click="resetFilters()" class="text-sm font-medium text-slate-500 hover:text-slate-900">
 Réinitialiser
 </button>
 </div>

 <!-- Export PDF / CSV (JGK-R03) : conserve les filtres actifs de période et de classe. -->
 <div class="relative" x-data="{ open: false }" x-on:keydown.escape="open = false">
 <button type="button" x-on:click="open = !open" :disabled="exporting || !data"
 class="btn-modal-secondary group" aria-haspopup="true" :aria-expanded="open">
 <icon name="download" class="w-4 h-4" />
 <span x-text="exporting ? 'Export…' : 'Exporter'"></span>
 <icon name="chevron-down" class="w-4 h-4" />
 </button>
 <div x-show="open" x-cloak x-on:click.outside="open = false"
 class="absolute right-0 mt-1 w-40 rounded-xl border border-slate-200 bg-white shadow-lg z-10 py-1">
 <button type="button" x-on:click="open = false; exportReport('pdf')"
 class="w-full text-left px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-all duration-200 ease-in-out">Format PDF</button>
 <button type="button" x-on:click="open = false; exportReport('csv')"
 class="w-full text-left px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-all duration-200 ease-in-out">Format CSV (Excel)</button>
 </div>
 </div>
 </div>

 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head">
 <th class="py-3 px-4">Élève</th>
 <th class="py-3 px-4">Classe</th>
 <th class="py-3 px-4 text-center">Appels</th>
 <th class="py-3 px-4 text-center">Présents</th>
 <th class="py-3 px-4 text-center">Retards</th>
 <th class="py-3 px-4 text-center">Min. retard</th>
 <th class="py-3 px-4 text-center">Abs. justif.</th>
 <th class="py-3 px-4 text-center">Abs. non justif.</th>
 <th class="py-3 px-4 text-right">Taux</th>
 @* Colonne masquée au Secrétariat : ParentSummonsController n'accepte que Directeur,
    Surveillant et Super Admin. Un bouton qui partirait en 403 vaut moins que pas de bouton. *@
 <th class="py-3 px-4 text-right" x-show="canSummon" x-cloak>Action</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-if="isLoading">
 <template x-for="i in 5" :key="i">
 <tr class="hover:bg-slate-50 transition-colors duration-150"><td class="py-3 px-4" colspan="10"><div class="skeleton h-4 w-full"></div></td></tr>
 </template>
 </template>

 <tr class="hover:bg-slate-50 transition-colors duration-150" x-show="!isLoading && (!data || data.students.length === 0)" x-cloak>
 <td colspan="10">
 <empty-state icon="checkmark-circle" title="Aucun appel sur cette période."
 hint="Ajustez la classe ou les dates ; les fiches d'appel saisies apparaîtront ici." />
 </td>
 </tr>

 <template x-if="!isLoading && data">
 <template x-for="row in data.students" :key="row.studentId">
 <tr class="hover:bg-slate-50 transition-colors duration-150">
 <td class="py-3 px-4">
 <div class="flex items-center gap-3">
 <div class="w-8 h-8 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xs" x-text="initials(row.fullName)"></div>
 <div>
 <p class="font-medium text-slate-900" x-text="row.fullName"></p>
 <p class="font-mono text-xs text-slate-500" x-text="row.matricule"></p>
 </div>
 </div>
 </td>
 <td class="py-3 px-4 text-slate-500" x-text="row.classroomName"></td>
 <td class="py-3 px-4 text-center" x-text="row.totalCalls"></td>
 <td class="py-3 px-4 text-center" x-text="row.present"></td>
 <td class="py-3 px-4 text-center" x-text="row.late"></td>
 <td class="py-3 px-4 text-center" x-text="row.totalLateMinutes"></td>
 <td class="py-3 px-4 text-center" x-text="row.justifiedAbsences"></td>
 <td class="py-3 px-4 text-center">
 <span x-show="row.unjustifiedAbsences > 0" class="inline-flex items-center px-2 py-0.5 rounded-xl text-xs font-medium bg-danger-bg text-danger" x-text="row.unjustifiedAbsences"></span>
 <span x-show="row.unjustifiedAbsences === 0" class="text-slate-400">0</span>
 </td>
 <td class="py-3 px-4 text-right">
 <span class="inline-flex items-center px-2.5 py-0.5 rounded-xl text-xs font-bold"
 :class="rateBadgeClass(row.attendanceRate)"
 x-text="formatPercent(row.attendanceRate)"></span>
 </td>

 @* Le bilan devient actionnable : la convocation part des chiffres comptés sur la période
    affichée, plus d'une ressaisie de mémoire dans un autre écran. Proposée UNIQUEMENT quand
    il y a matière (au moins un retard ou une absence) — sur une ligne à 100 % de présence,
    le bouton n'aurait aucun sens. *@
 <td class="py-3 px-4 text-right" x-show="canSummon" x-cloak>
 <button type="button" x-show="hasAttendanceIssue(row)" x-on:click="openSummons(row)"
 class="text-xs font-semibold text-primary hover:underline py-1 px-2 rounded hover:bg-primary-50 transition-colors whitespace-nowrap">
 Convoquer
 </button>
 <span x-show="!hasAttendanceIssue(row)" class="text-slate-300">—</span>
 </td>
 </tr>
 </template>
 </template>
 </tbody>
 </table>
 </div>

 <pagination page="page" page-size="pageSize" total="totalCount" on-change="load()" />
 </div>

    @* Convocation émise DEPUIS le bilan (02/09/2026). Le motif est pré-rempli avec les retards et
       absences réellement comptés sur la période affichée — il reste modifiable : c'est le Directeur
       qui convoque, pas le compteur. Aucun seuil automatique (Volume 1 §18.2). *@
    <modal-shell size="60" open="isSummonsOpen" on-close="closeSummons()" title="Convoquer le parent">
        <modal-subtitle>
            <span x-text="summonsTarget ? summonsTarget.fullName : ''"></span>
            <span x-show="summonsTarget" x-cloak>
                · <span x-text="summonsTarget ? summonsTarget.classroomName : ''"></span>
            </span>
        </modal-subtitle>

        <div x-show="summonsErrors.global" x-cloak class="form-error-banner" x-text="summonsErrors.global"></div>

        <form x-on:submit.prevent="submitSummons()" novalidate class="space-y-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
                Relevé de la période affichée :
                <span class="font-semibold text-slate-900" x-text="summonsTarget ? summonsTarget.late : 0"></span> retard(s),
                <span class="font-semibold text-slate-900" x-text="summonsTarget ? summonsTarget.unjustifiedAbsences : 0"></span> absence(s) non justifiée(s),
                <span class="font-semibold text-slate-900" x-text="summonsTarget ? summonsTarget.justifiedAbsences : 0"></span> justifiée(s).
            </div>

            <div>
                <label class="form-label form-label-required">Date de convocation</label>
                <date-field model="summonsForm.scheduledDate" required="true" aria-label="Date de convocation" />
                <p x-show="summonsErrors.scheduledat" x-cloak x-text="summonsErrors.scheduledat" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Heure de convocation</label>
                <input type="time" x-model="summonsForm.scheduledTime" required class="input-field" />
            </div>

            <div>
                <label class="form-label form-label-required">Motif</label>
                <textarea x-model="summonsForm.reason" rows="4" required
                          class="input-field" :class="summonsErrors.reason && 'input-field-error'"></textarea>
                <p x-show="summonsErrors.reason" x-cloak x-text="summonsErrors.reason" class="field-error"></p>
            </div>

            <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
                <button type="button" x-on:click="closeSummons()" class="btn-modal-secondary group">Annuler</button>
                <button type="submit" :disabled="isSummoning" class="btn-modal-primary group">
                    <span x-text="isSummoning ? 'Enregistrement...' : 'Convoquer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    @* Convocation émise : le PDF s'imprime depuis ici, sans passer par l'écran Convocations. *@
    <modal-shell open="showSummonsCreated" size="md" on-close="showSummonsCreated = false" title="Convocation enregistrée">
        <confirm-dialog-body close-action="showSummonsCreated = false"
                             new-action="showSummonsCreated = false; printCreatedSummons()"
                             new-label="Imprimer la convocation">
            La convocation de <span class="font-medium text-slate-900" x-text="summonsCreatedName"></span>
            est enregistrée au registre de la Vie scolaire.
        </confirm-dialog-body>
    </modal-shell>

    @* Aperçu PDF partagé — voir wwwroot/js/pdf-preview.js *@
    @await Html.PartialAsync("_PdfPreviewModal")
</div>
