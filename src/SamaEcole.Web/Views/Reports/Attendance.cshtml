@{
    ViewData["Title"] = "Rapports d'assiduité";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/attendance-report.js" asp-append-version="true"></script>
}

<div x-data="attendanceReportView()">
    <div>
        <h1 class="text-jgk-title font-bold text-gray-900">Rapports d'assiduité</h1>
        <p class="text-jgk-subtitle text-gray-500 mt-1">Taux de présence par classe et par élève, sur une période choisie.</p>
    </div>

    <!-- Cartes de synthèse -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
        <template x-if="isLoading">
            <template x-for="i in 3" :key="i">
                <div class="card p-5 h-[92px] skeleton"></div>
            </template>
        </template>

        <template x-if="!isLoading && data">
            <stat-card label="Taux d'assiduité moyen" icon="checkmark-circle" accent="success">
                <span x-text="formatPercent(data.averageAttendanceRate)"></span>
            </stat-card>
        </template>
        <template x-if="!isLoading && data">
            <stat-card label="Élèves suivis" icon="users" accent="primary">
                <span x-text="data.totalCount"></span>
            </stat-card>
        </template>
        <template x-if="!isLoading && data">
            <stat-card label="Période" icon="document" accent="primary">
                <span class="text-base" x-text="periodLabel()"></span>
            </stat-card>
        </template>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <div class="card mt-6 relative">
        <!-- Filtres : classe + période -->
        <div class="p-4 border-b border-gray-200 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
            <div class="flex flex-wrap items-end gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Classe</label>
                    <select x-model="classId" aria-label="Filtrer par classe" class="input-field mt-0 bg-white">
                        <option value="">Toutes les classes</option>
                        <template x-for="c in classrooms" :key="c.id">
                            <option :value="c.id" x-text="c.name + ' (' + c.level + ')'"></option>
                        </template>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Du</label>
                    <input type="date" x-model="startDate" aria-label="Date de début" class="input-field mt-0" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Au</label>
                    <input type="date" x-model="endDate" aria-label="Date de fin" class="input-field mt-0" />
                </div>
                <button type="button" x-on:click="applyFilters()" class="btn-primary">
                    <icon name="chart-multiple" class="w-4 h-4" />
                    Générer
                </button>
                <button type="button" x-on:click="resetFilters()" class="text-sm font-medium text-gray-500 hover:text-gray-900">
                    Réinitialiser
                </button>
            </div>

            <!-- Export PDF / CSV (JGK-R03) : conserve les filtres actifs de période et de classe. -->
            <div class="relative" x-data="{ open: false }" x-on:keydown.escape="open = false">
                <button type="button" x-on:click="open = !open" :disabled="exporting || !data"
                        class="btn-secondary" aria-haspopup="true" :aria-expanded="open">
                    <icon name="download" class="w-4 h-4" />
                    <span x-text="exporting ? 'Export…' : 'Exporter'"></span>
                    <icon name="chevron-down" class="w-4 h-4" />
                </button>
                <div x-show="open" x-cloak x-on:click.outside="open = false"
                     class="absolute right-0 mt-1 w-40 rounded-md border border-gray-200 bg-white shadow-lg z-10 py-1">
                    <button type="button" x-on:click="open = false; exportReport('pdf')"
                            class="w-full text-left px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">Format PDF</button>
                    <button type="button" x-on:click="open = false; exportReport('csv')"
                            class="w-full text-left px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">Format CSV (Excel)</button>
                </div>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4">Élève</th>
                        <th class="py-3 px-4">Classe</th>
                        <th class="py-3 px-4 text-center">Appels</th>
                        <th class="py-3 px-4 text-center">Présents</th>
                        <th class="py-3 px-4 text-center">Retards</th>
                        <th class="py-3 px-4 text-center">Min. retard</th>
                        <th class="py-3 px-4 text-center">Abs. justif.</th>
                        <th class="py-3 px-4 text-center">Abs. non justif.</th>
                        <th class="py-3 px-4 text-right">Taux</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <template x-if="isLoading">
                        <template x-for="i in 5" :key="i">
                            <tr><td class="py-3 px-4" colspan="9"><div class="skeleton h-4 w-full"></div></td></tr>
                        </template>
                    </template>

                    <tr x-show="!isLoading && (!data || data.students.length === 0)" x-cloak>
                        <td colspan="9">
                            <empty-state icon="checkmark-circle" title="Aucun appel sur cette période."
                                         hint="Ajustez la classe ou les dates ; les fiches d'appel saisies apparaîtront ici." />
                        </td>
                    </tr>

                    <template x-if="!isLoading && data">
                        <template x-for="row in data.students" :key="row.studentId">
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xs" x-text="initials(row.fullName)"></div>
                                        <div>
                                            <p class="font-medium text-gray-900" x-text="row.fullName"></p>
                                            <p class="font-mono text-xs text-gray-500" x-text="row.matricule"></p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-gray-500" x-text="row.classroomName"></td>
                                <td class="py-3 px-4 text-center" x-text="row.totalCalls"></td>
                                <td class="py-3 px-4 text-center" x-text="row.present"></td>
                                <td class="py-3 px-4 text-center" x-text="row.late"></td>
                                <td class="py-3 px-4 text-center" x-text="row.totalLateMinutes"></td>
                                <td class="py-3 px-4 text-center" x-text="row.justifiedAbsences"></td>
                                <td class="py-3 px-4 text-center">
                                    <span x-show="row.unjustifiedAbsences > 0" class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger-bg text-danger" x-text="row.unjustifiedAbsences"></span>
                                    <span x-show="row.unjustifiedAbsences === 0" class="text-gray-400">0</span>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold"
                                          :class="rateBadgeClass(row.attendanceRate)"
                                          x-text="formatPercent(row.attendanceRate)"></span>
                                </td>
                            </tr>
                        </template>
                    </template>
                </tbody>
            </table>
        </div>

        <pagination page="page" page-size="pageSize" total="totalCount" on-change="load()" />
    </div>
</div>
