@{
 ViewData["Title"] = "Rapports d'assiduité";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/attendance-report.js" asp-append-version="true"></script>
}

<div x-data="attendanceReportView()">
 <div>
 <h1 class="text-jgk-title font-bold text-slate-900">Rapports d'assiduité</h1>
 <p class="text-jgk-subtitle text-slate-500 mt-1">Taux de présence par classe et par élève, sur une période choisie.</p>
 </div>

 <!-- Cartes de synthèse -->
 <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
 <template x-if="isLoading">
 <template x-for="i in 3" :key="i">
 <div class="card p-5 h-[92px] skeleton"></div>
 </template>
 </template>

 <template x-if="!isLoading && data">
 <stat-card label="Taux d'assiduité moyen" icon="checkmark-circle" accent="success">
 <span x-text="formatPercent(data.averageAttendanceRate)"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Élèves suivis" icon="users" accent="primary">
 <span x-text="data.totalCount"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Période" icon="document" accent="primary">
 <span class="text-base" x-text="periodLabel()"></span>
 </stat-card>
 </template>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <div class="card mt-6 relative">
 <!-- Filtres : classe + période -->
 <div class="p-6 border-b border-slate-200 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
 <div class="flex flex-wrap items-end gap-3">
 <div>
 <label class="form-label-sm">Classe</label>
 <select-field model="classId" aria-label="Filtrer par classe" class="mt-0" placeholder="Toutes les classes"
 options-expr="[{value:'', label:'Toutes les classes'}].concat(classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'})))" />
 </div>
 <div>
 <label class="form-label-sm">Du</label>
 <date-field model="startDate" aria-label="Date de début" class="mt-0" />
 </div>
 <div>
 <label class="form-label-sm">Au</label>
 <date-field model="endDate" aria-label="Date de fin" class="mt-0" />
 </div>
 <button type="button" x-on:click="applyFilters()" class="btn-modal-primary">
 <icon name="chart-multiple" class="w-4 h-4" />
 Générer
 </button>
 <button type="button" x-on:click="resetFilters()" class="text-sm font-medium text-slate-500 hover:text-slate-900">
 Réinitialiser
 </button>
 </div>

 <!-- Export PDF / CSV (JGK-R03) : conserve les filtres actifs de période et de classe. -->
 <div class="relative" x-data="{ open: false }" x-on:keydown.escape="open = false">
 <button type="button" x-on:click="open = !open" :disabled="exporting || !data"
 class="btn-modal-secondary" aria-haspopup="true" :aria-expanded="open">
 <icon name="download" class="w-4 h-4" />
 <span x-text="exporting ? 'Export…' : 'Exporter'"></span>
 <icon name="chevron-down" class="w-4 h-4" />
 </button>
 <div x-show="open" x-cloak x-on:click.outside="open = false"
 class="absolute right-0 mt-1 w-40 rounded-xl border border-slate-200 bg-white shadow-lg z-10 py-1">
 <button type="button" x-on:click="open = false; exportReport('pdf')"
 class="w-full text-left px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-all duration-200 ease-in-out">Format PDF</button>
 <button type="button" x-on:click="open = false; exportReport('csv')"
 class="w-full text-left px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-all duration-200 ease-in-out">Format CSV (Excel)</button>
 </div>
 </div>
 </div>

 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Élève</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Classe</th>
 <th class="py-3 px-4 text-center uppercase tracking-wider text-slate-500 font-semibold">Appels</th>
 <th class="py-3 px-4 text-center uppercase tracking-wider text-slate-500 font-semibold">Présents</th>
 <th class="py-3 px-4 text-center uppercase tracking-wider text-slate-500 font-semibold">Retards</th>
 <th class="py-3 px-4 text-center uppercase tracking-wider text-slate-500 font-semibold">Min. retard</th>
 <th class="py-3 px-4 text-center uppercase tracking-wider text-slate-500 font-semibold">Abs. justif.</th>
 <th class="py-3 px-4 text-center uppercase tracking-wider text-slate-500 font-semibold">Abs. non justif.</th>
 <th class="py-3 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">Taux</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-if="isLoading">
 <template x-for="i in 5" :key="i">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out"><td class="py-3 px-4" colspan="9"><div class="skeleton h-4 w-full"></div></td></tr>
 </template>
 </template>

 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out" x-show="!isLoading && (!data || data.students.length === 0)" x-cloak>
 <td colspan="9">
 <empty-state icon="checkmark-circle" title="Aucun appel sur cette période."
 hint="Ajustez la classe ou les dates ; les fiches d'appel saisies apparaîtront ici." />
 </td>
 </tr>

 <template x-if="!isLoading && data">
 <template x-for="row in data.students" :key="row.studentId">
 <tr class="hover:bg-slate-50 transition-colors transition-all duration-200 ease-in-out">
 <td class="py-3 px-4">
 <div class="flex items-center gap-3">
 <div class="w-8 h-8 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xs" x-text="initials(row.fullName)"></div>
 <div>
 <p class="font-medium text-slate-900" x-text="row.fullName"></p>
 <p class="font-mono text-xs text-slate-500" x-text="row.matricule"></p>
 </div>
 </div>
 </td>
 <td class="py-3 px-4 text-slate-500" x-text="row.classroomName"></td>
 <td class="py-3 px-4 text-center" x-text="row.totalCalls"></td>
 <td class="py-3 px-4 text-center" x-text="row.present"></td>
 <td class="py-3 px-4 text-center" x-text="row.late"></td>
 <td class="py-3 px-4 text-center" x-text="row.totalLateMinutes"></td>
 <td class="py-3 px-4 text-center" x-text="row.justifiedAbsences"></td>
 <td class="py-3 px-4 text-center">
 <span x-show="row.unjustifiedAbsences > 0" class="inline-flex items-center px-2 py-0.5 rounded-xl text-xs font-medium bg-danger-bg text-danger" x-text="row.unjustifiedAbsences"></span>
 <span x-show="row.unjustifiedAbsences === 0" class="text-slate-400">0</span>
 </td>
 <td class="py-3 px-4 text-right">
 <span class="inline-flex items-center px-2.5 py-0.5 rounded-xl text-xs font-bold"
 :class="rateBadgeClass(row.attendanceRate)"
 x-text="formatPercent(row.attendanceRate)"></span>
 </td>
 </tr>
 </template>
 </template>
 </tbody>
 </table>
 </div>

 <pagination page="page" page-size="pageSize" total="totalCount" on-change="load()" />
 </div>
</div>
