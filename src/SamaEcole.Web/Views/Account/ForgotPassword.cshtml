@{
    ViewData["Title"] = "Mot de passe oublié";
    Layout = "_AuthLayout";
}

<div class="min-h-screen flex items-center justify-center p-6 sm:p-12">
    <div class="w-full max-w-lg" x-data="forgotPasswordForm()">

        <div class="flex items-center justify-center gap-2 mb-8">
            <div class="w-9 h-9 rounded-2xl bg-gradient-to-r from-primary-600 to-primary-500 text-white shadow-sm transition-all duration-200 ease-in-out flex items-center justify-center font-bold text-lg">S</div>
            <span class="font-bold text-lg text-slate-900 tracking-tight">Sama Ecole</span>
        </div>

        <div class="text-center mb-8">
            <h1 class="text-jgk-title font-bold text-slate-900">Mot de passe oublié</h1>
            <p class="text-jgk-body text-slate-500 mt-2">
                Indiquez l'adresse e-mail de votre compte. Vous recevrez un lien pour choisir un nouveau mot de passe.
            </p>
        </div>

        @* Confirmation VOLONTAIREMENT identique que l'adresse existe ou non : afficher « adresse
           inconnue » ferait de cet écran un moyen de vérifier qui possède un compte sur la
           plateforme (voir ForgotPasswordCommandHandler). *@
        <div x-show="sent" x-cloak class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-jgk-body text-emerald-900">
            <p class="font-semibold">Demande enregistrée.</p>
            <p class="mt-1">
                Si un compte est associé à cette adresse, un lien de réinitialisation vient d'y être envoyé.
                Il est valable 20 minutes et ne peut servir qu'une seule fois.
            </p>
            <p class="mt-3 text-emerald-800">
                Pensez à vérifier vos courriers indésirables.
            </p>
        </div>

        <form x-show="!sent" x-on:submit.prevent="submit()" novalidate class="flex flex-col gap-4">
            <div>
                <label for="email" class="block text-jgk-body font-medium text-slate-700 mb-1.5">Adresse e-mail</label>
                <input id="email"
                       type="email"
                       x-model="email"
                       autocomplete="email"
                       required
                       x-bind:aria-invalid="error ? 'true' : 'false'"
                       class="w-full px-5 py-2.5 bg-white border border-slate-200 rounded-2xl text-jgk-body placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                       placeholder="vous@etablissement.sn" />
                <p x-show="error" x-cloak x-text="error" class="mt-1.5 text-xs text-danger"></p>
            </div>

            <button type="submit"
                    x-bind:disabled="isSubmitting"
                    x-bind:aria-busy="isSubmitting.toString()"
                    class="flex items-center justify-center gap-2 bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-700 hover:to-primary-600 text-white shadow-sm rounded-2xl px-5 py-2.5 text-jgk-body font-medium focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed transition-all">
                <svg x-cloak x-show="isSubmitting" aria-hidden="true" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span x-text="isSubmitting ? 'Envoi…' : 'Envoyer le lien'">Envoyer le lien</span>
            </button>
        </form>

        <p class="mt-6 text-center text-jgk-body text-slate-700">
            <a href="/login" class="text-primary font-semibold hover:underline">Retour à la connexion</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/password-reset.js" asp-append-version="true"></script>
}
