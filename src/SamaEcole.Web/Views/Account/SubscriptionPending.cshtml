@{
 ViewData["Title"] = "Abonnement en attente de paiement";
 Layout = "_AuthLayout";
 var paymentMethodOptions = new List<SelectFieldOption> {
 new("MobileMoney", "Mobile Money (Wave, Orange Money)"), new("BankTransfer", "Virement bancaire"), new("Card", "Carte bancaire")
 };
 var billingPeriodOptions = new List<SelectFieldOption> { new("Monthly", "Mensuel"), new("Yearly", "Annuel") };
}

@* Page de prise en charge PLEINE (pas le gabarit _Layout à sidebar) : tant que l'abonnement est en
 attente de paiement, tout module qu'afficherait la sidebar renverrait de toute façon un 403 dès son
 premier appel d'API (SubscriptionAwaitingPaymentMiddleware, ticket JGK-I04) et rebondirait ici — une
 sidebar pleine de liens morts n'aiderait personne. Redirige les visiteurs anonymes vers /login, comme
 _Layout.cshtml le fait pour les écrans applicatifs.
 Fichier EXTERNE et non inline : la CSP n'autorise pas script-src 'unsafe-inline' (JGK-F01). *@
<script src="~/js/require-session.js" asp-append-version="true"></script>

<div class="min-h-screen flex items-center justify-center p-6 sm:p-12">
 <div class="w-full max-w-lg text-center" x-data="subscriptionPaymentForm()">

 <!-- Logo -->
 <div class="flex items-center justify-center gap-2 mb-8">
 <div class="w-9 h-9 rounded-2xl bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-700 hover:to-primary-600 text-white shadow-sm hover:shadow-sm transition-all duration-200 ease-in-out text-white flex items-center justify-center font-bold text-lg">S</div>
 <span class="font-bold text-lg text-slate-900 tracking-tight">Sama Ecole</span>
 </div>

 <div class="mx-auto w-14 h-14 rounded-full bg-warning-bg flex items-center justify-center mb-5">
 <svg aria-hidden="true" class="w-7 h-7 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
 </div>

 <h1 class="text-jgk-title font-bold text-slate-900">Abonnement en attente de paiement</h1>

 <p class="text-jgk-body text-slate-500 mt-3 leading-relaxed">
 Votre inscription a bien été validée. Il ne reste qu'une étape avant d'accéder pleinement à
 votre espace Sama Ecole : la régularisation de votre abonnement par un premier paiement.
 </p>

 <p class="text-jgk-body text-slate-500 mt-3 leading-relaxed">
 En attendant, l'accès aux élèves, classes, notes et autres modules reste indisponible. Seules
 votre session et le paiement le restent.
 </p>

 <!-- Message d'erreur. aria-live : lu par un lecteur d'écran sans déplacer le focus. -->
 <div x-cloak
 x-show="error"
 x-transition.opacity
 role="alert"
 aria-live="polite"
 class="mt-6 flex items-start gap-3 rounded-2xl bg-danger/10 border border-danger/20 px-4 py-3 text-left">
 <svg aria-hidden="true" class="w-5 h-5 text-danger shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19H19a2 2 0 001.75-2.96l-6.93-12a2 2 0 00-3.5 0l-6.93 12A2 2 0 005.07 19z" /></svg>
 <p class="text-jgk-body text-danger" x-text="error"></p>
 </div>

 <form x-on:submit.prevent="submit()" novalidate class="mt-6 text-left space-y-4">
 <div>
 <label for="payment-method" class="block text-jgk-body font-medium text-slate-700 mb-1.5">Moyen de paiement</label>
 <select-field id="payment-method" model="method" options="paymentMethodOptions" />
 </div>

 <div>
 <label for="billing-period" class="block text-jgk-body font-medium text-slate-700 mb-1.5">Période</label>
 <select-field id="billing-period" model="billingPeriod" options="billingPeriodOptions" />
 </div>

 <button type="submit"
 x-bind:disabled="isSubmitting"
 x-bind:aria-busy="isSubmitting.toString()"
 class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-700 hover:to-primary-600 text-white shadow-sm hover:shadow-md transition-all duration-200 ease-in-out rounded-xl px-5 py-3 text-jgk-body font-medium focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed">
 <svg x-cloak x-show="isSubmitting" aria-hidden="true" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
 <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
 <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
 </svg>
 <span x-text="isSubmitting ? 'Redirection…' : 'Procéder au paiement'">Procéder au paiement</span>
 </button>

 <p class="text-center text-jgk-table text-slate-400">
 Vous serez redirigé(e) vers le guichet sécurisé de notre partenaire de paiement.
 </p>
 </form>

 <button type="button"
 x-on:click="window.auth.logout()"
 class="mt-6 btn-secondary">
 Se déconnecter
 </button>
 </div>
</div>

@section Scripts {
 <script src="~/js/subscription-payment.js" asp-append-version="true"></script>
}
