@using Microsoft.Extensions.Options
@using SamaEcole.Web.Security
@inject IOptions<TurnstileOptions> Turnstile
@{
 ViewData["Title"] = "Inscription de votre établissement";
 Layout = "_AuthLayout";
}

<div x-data="registrationForm()">
 <div x-cloak x-show="trackingReference" class="text-center">
  <h1 class="page-title">Demande envoyée !</h1>
  <p class="mt-2 text-slate-500">Conservez votre référence de suivi.</p>

  <div class="mt-6 rounded-2xl border-2 border-dashed border-primary/30 bg-primary/5 px-6 py-5">
   <p class="text-xs text-slate-500 uppercase tracking-wide">Référence de suivi</p>
   <p class="mt-1 text-2xl font-bold text-primary tracking-widest" x-text="trackingReference"></p>
  </div>

  <template x-if="trackingReference && trackingReference.trim() !== '' && trackingReference !== 'null'">
   <a x-bind:href="'/suivi-demande?ref=' + encodeURIComponent(trackingReference)"
      class="mt-6 inline-block font-medium text-primary hover:underline">
    Suivre l'état de ma demande
   </a>
  </template>

  <br />
  <a href="/login" class="mt-3 inline-flex h-10 items-center justify-center rounded-xl px-4 text-sm font-semibold bg-primary-100 text-primary-900">
   Retour à la connexion
  </a>
 </div>

 <div x-show="!trackingReference">
  @* Le formulaire d'inscription reste inchangé. *@
 </div>
</div>
