@{
 ViewData["Title"] = "Notes et bulletins";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/grades.js" asp-append-version="true"></script>
}

<div x-data="gradesView()">
 <!-- Titre -->
 <div>
 <h1 class="text-jgk-title font-bold text-slate-900">Notes et bulletins</h1>
 <p class="text-jgk-subtitle text-slate-500 mt-1">
 Sélectionnez une classe, une matière et un trimestre pour saisir ou corriger les notes.
 </p>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- Sélecteurs -->
 <div class="card mt-6 p-6">
 <div class="flex flex-col sm:flex-row sm:items-end gap-5">
 <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 flex-1">
 <div>
 <label for="grades-classroom" class="block text-sm font-medium text-slate-700">Classe</label>
 <select-field id="grades-classroom" model="selectedClassroomId" on-change="reload()"
 placeholder="Sélectionnez une classe…"
 options-expr="[{value:'', label:'Sélectionnez une classe…'}].concat(classrooms.map(c => ({value: c.id, label: c.name + ' — ' + c.level})))" />
 </div>
 <div>
 <label for="grades-subject" class="block text-sm font-medium text-slate-700">Matière</label>
 <select-field id="grades-subject" model="selectedSubjectId" on-change="reload()"
 placeholder="Sélectionnez une matière…"
 options-expr="[{value:'', label:'Sélectionnez une matière…'}].concat(subjects.map(s => ({value: s.id, label: s.name})))" />
 </div>
 <div>
 <label for="grades-term" class="block text-sm font-medium text-slate-700">Trimestre</label>
 <select-field id="grades-term" model="selectedTermId" on-change="reload()" disabled="terms.length === 0"
 placeholder="Sélectionnez un trimestre…"
 options-expr="[{value:'', label:'Sélectionnez un trimestre…'}].concat(terms.map(t => ({value: t.id, label: t.label})))" />
 </div>
 </div>

 <!-- Bulletins de toute la classe (JGK-G03) : classe + trimestre suffisent, indépendant de la
 matière sélectionnée pour la saisie — ouvert au Directeur, à l'Enseignant et au Secrétariat. -->
 <div x-show="canDownloadReportCard && hasClassAndTerm" x-cloak class="flex gap-2">
 <button type="button" x-on:click="downloadClassBulletinsMergedPdf()" :disabled="downloadingClassBulletins"
 class="btn-secondary whitespace-nowrap text-sm" title="Un seul PDF, une page par élève — pour l'impression en lot">
 <icon name="download" class="w-4 h-4" />
 <span x-text="downloadingClassBulletins ? 'Génération…' : 'Bulletins (PDF)'"></span>
 </button>
 <button type="button" x-on:click="downloadClassBulletinsZip()" :disabled="downloadingClassBulletins"
 class="btn-secondary whitespace-nowrap text-sm" title="Une archive ZIP, un fichier par élève — pour l'envoi ou la sauvegarde">
 <icon name="download" class="w-4 h-4" />
 <span x-text="downloadingClassBulletins ? 'Génération…' : 'Bulletins (ZIP)'"></span>
 </button>
 <button type="button" x-on:click="downloadClassDeliberationPdf()" :disabled="downloadingClassDeliberation"
 class="btn-secondary whitespace-nowrap text-sm" title="PV de délibération du conseil de classe pour ce trimestre">
 <icon name="download" class="w-4 h-4" />
 <span x-text="downloadingClassDeliberation ? 'Génération…' : 'PV Délibération'"></span>
 </button>
 </div>

 <!-- Mode de saisie alternatif : réservé à l'Enseignant, comme la saisie cellule par cellule. -->
 <button type="button" x-show="canEnterGrades && hasSelection" x-cloak x-on:click="openImport()"
 class="btn-secondary whitespace-nowrap">
 <icon name="upload" class="w-4 h-4" />
 Importer un fichier
 </button>
 </div>

 <!-- Erreur de génération/téléchargement des bulletins de classe (JGK-G03). -->
 <div x-show="classBulletinsError" x-cloak class="mt-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="classBulletinsError"></div>

 <!-- Aucune année active : rien à proposer comme trimestre -->
 <div x-show="!isLoadingContext && terms.length === 0" x-cloak class="mt-4 rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning">
 Aucune année scolaire active n'a de trimestre disponible. Configurez une année active dans
 <a href="/parametres" class="underline font-medium">Paramètres</a>.
 </div>
 </div>

 <!-- Rôle Secrétariat : rappel que seule la correction (pas la saisie) leur est ouverte -->
 <div x-show="!canEnterGrades && hasSelection" x-cloak class="mt-4 rounded-xl border-l-4 border-primary bg-indigo-50 p-3 text-sm text-primary">
 Vous pouvez corriger une note déjà saisie, mais vous ne pouvez pas saisir de nouvelle note.
 </div>

 <!-- Conflit de concurrence (AGENTS.md règle #5) -->
 <div x-show="conflictError" x-cloak class="mt-4 rounded-xl border-l-4 border-danger bg-danger-bg p-6">
 <p class="text-sm font-medium text-danger">Une note a été modifiée entre-temps par une autre personne.</p>
 <button type="button" x-on:click="reload()" class="mt-2 text-sm font-medium text-danger underline">Recharger le tableau</button>
 </div>

 <!-- Aucune sélection complète -->
 <div x-show="!hasSelection" x-cloak class="card mt-6">
 <empty-state icon="book" title="Choisissez une classe, une matière et un trimestre."
 hint="Le tableau de saisie apparaît une fois les trois sélections faites." />
 </div>

 <!-- Chargement -->
 <div x-show="hasSelection && isLoadingRows" x-cloak class="card mt-6 p-12 flex items-center justify-center">
 <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 </div>

 <!-- Aucun élève dans la classe -->
 <div x-show="hasSelection && !isLoadingRows && rows.length === 0" x-cloak class="card mt-6">
 <empty-state icon="users" title="Cette classe ne compte aucun élève." hint="Inscrivez des élèves dans cette classe pour saisir leurs notes." />
 </div>

 <!-- Tableau de saisie -->
 <div x-show="hasSelection && !isLoadingRows && rows.length > 0" x-cloak class="card mt-6 relative">
 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-3 px-4 w-12 text-center uppercase tracking-wider text-slate-500 font-semibold">N°</th>
 <th class="py-3 px-4 whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Matricule</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Élève</th>
 <th class="py-3 px-4 w-40 text-center uppercase tracking-wider text-slate-500 font-semibold">Devoir <span class="text-slate-400 font-normal" x-text="'/ ' + gradingScale"></span></th>
 <th class="py-3 px-4 w-40 text-center uppercase tracking-wider text-slate-500 font-semibold">Composition <span class="text-slate-400 font-normal" x-text="'/ ' + gradingScale"></span></th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-for="(row, index) in rows" :key="row.studentId">
 <tr class="hover:bg-slate-50 transition-colors transition-all duration-200 ease-in-out transition-all duration-200 ease-in-out">
 <td class="py-2 px-4 text-center text-slate-400 font-medium" x-text="index + 1"></td>
 <td class="py-2 px-4 text-xs font-mono text-slate-500 whitespace-nowrap" x-text="row.matricule"></td>
 <td class="py-2 px-4 font-medium text-slate-900" x-text="row.fullName"></td>

 <td class="py-2 px-4">
 <div class="flex items-center gap-2 justify-center">
 <input type="number" min="0" :max="gradingScale" :placeholder="'0 – ' + gradingScale"
 class="input-field mt-0 w-20 text-center"
 :class="row.devoir.status === 'error' ? 'border-danger' : '' transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"
 :data-row="index" data-field="devoir"
 :disabled="row.devoir.status === 'saving' || (row.devoir.id ? !canCorrectGrades : !canEnterGrades)"
 :title="row.devoir.id ? (!canCorrectGrades ? 'Réservé au Directeur et au Secrétariat' : '') : (!canEnterGrades ? 'Réservé à l\'enseignant' : '')"
 x-model="row.devoir.value"
 x-on:blur="saveCell(index, 'devoir')"
 x-on:keydown.enter.prevent="focusNextRow(index, 'devoir')" />
 <svg x-show="row.devoir.status === 'saving'" x-cloak aria-hidden="true" class="animate-spin w-4 h-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 <icon x-show="row.devoir.status === 'saved'" x-cloak name="checkmark-circle" class="w-4 h-4 text-success" />
 </div>
 <p x-show="row.devoir.error" x-cloak x-text="row.devoir.error" class="mt-1 text-xs text-danger text-center"></p>
 <p x-show="row.devoir.status === 'saved'" x-cloak class="mt-1 text-xs text-success text-center">Enregistré</p>
 </td>

 <td class="py-2 px-4">
 <div class="flex items-center gap-2 justify-center">
 <input type="number" min="0" :max="gradingScale" :placeholder="'0 – ' + gradingScale"
 class="input-field mt-0 w-20 text-center"
 :class="row.composition.status === 'error' ? 'border-danger' : '' transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"
 :data-row="index" data-field="composition"
 :disabled="row.composition.status === 'saving' || (row.composition.id ? !canCorrectGrades : !canEnterGrades)"
 :title="row.composition.id ? (!canCorrectGrades ? 'Réservé au Directeur et au Secrétariat' : '') : (!canEnterGrades ? 'Réservé à l\'enseignant' : '')"
 x-model="row.composition.value"
 x-on:blur="saveCell(index, 'composition')"
 x-on:keydown.enter.prevent="focusNextRow(index, 'composition')" />
 <svg x-show="row.composition.status === 'saving'" x-cloak aria-hidden="true" class="animate-spin w-4 h-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 <icon x-show="row.composition.status === 'saved'" x-cloak name="checkmark-circle" class="w-4 h-4 text-success" />
 </div>
 <p x-show="row.composition.error" x-cloak x-text="row.composition.error" class="mt-1 text-xs text-danger text-center"></p>
 <p x-show="row.composition.status === 'saved'" x-cloak class="mt-1 text-xs text-success text-center">Enregistré</p>
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>
 </div>

 <!-- Import de notes par fichier CSV/Excel : mode de saisie alternatif, réservé à l'Enseignant. -->
 <modal-shell open="isImportOpen" on-close="isImportOpen = false" title="Importer des notes (CSV/Excel)" size="lg">
 <modal-subtitle>Un fichier à deux colonnes : matricule, puis note — pour Devoir OU Composition, jamais les deux à la fois.</modal-subtitle>

 <div x-show="importGlobalError" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="importGlobalError"></div>

 <div x-show="importSuccess" x-cloak class="mb-4 rounded-xl border-l-4 border-success bg-success-bg p-3 text-sm text-success" x-text="importSuccess"></div>

 <!-- Rien n'a été enregistré tant qu'une seule ligne est en erreur (validation intégrale avant écriture). -->
 <div x-show="importErrors.length > 0" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3">
 <p class="text-sm font-medium text-danger mb-2">
 Le fichier contient des erreurs — rien n'a été enregistré. Corrigez puis réessayez :
 </p>
 <ul class="text-sm text-danger space-y-1 max-h-52 overflow-y-auto">
 <template x-for="e in importErrors" :key="e.line + e.message">
 <li><span class="font-semibold" x-text="e.line"></span> — <span x-text="e.message"></span></li>
 </template>
 </ul>
 </div>

 <div class="space-y-4">
 <div>
 <label class="block text-sm font-medium text-slate-700">Colonne à remplir <span class="text-danger">*</span></label>
 <div class="mt-1.5 flex items-center gap-6">
 <label class="flex items-center gap-2 text-sm font-medium text-slate-700 cursor-pointer">
 <input type="radio" x-model="importEvaluationType" value="devoir" class="border-slate-300 text-primary focus:ring-primary transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 Devoir
 </label>
 <label class="flex items-center gap-2 text-sm font-medium text-slate-700 cursor-pointer">
 <input type="radio" x-model="importEvaluationType" value="composition" class="border-slate-300 text-primary focus:ring-primary transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 Composition
 </label>
 </div>
 </div>

 <div class="rounded-xl bg-slate-50 border border-slate-200 p-3 flex items-center justify-between gap-3">
 <p class="text-xs text-slate-600">
 Le modèle reprend les matricules exacts des élèves de cette classe : évite toute erreur de matricule à la saisie.
 </p>
 <button type="button" x-on:click="downloadTemplate()" :disabled="!importEvaluationType"
 class="btn-secondary whitespace-nowrap text-xs disabled:opacity-50 disabled:cursor-not-allowed">
 <icon name="download" class="w-4 h-4" />
 Modèle
 </button>
 </div>

 <div>
 <label for="grades-import-file" class="block text-sm font-medium text-slate-700">Fichier <span class="text-danger">*</span></label>
 <input id="grades-import-file" type="file" accept=".csv,.xlsx,.xls" x-on:change="onImportFileChange($event)"
 class="input-field bg-white file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-primary file:cursor-pointer transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" />
 <p class="mt-1 text-xs text-slate-500">CSV ou Excel, deux colonnes (matricule, note) — une ligne d'en-tête est acceptée mais pas obligatoire.</p>
 </div>
 </div>

 <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
 <button type="button" x-on:click="isImportOpen = false" class="btn-secondary">Fermer</button>
 <button type="button" x-on:click="submitImport()" :disabled="importSubmitting" class="btn-primary">
 <span x-text="importSubmitting ? 'Import en cours...' : 'Importer'"></span>
 </button>
 </div>
 </modal-shell>
</div>
