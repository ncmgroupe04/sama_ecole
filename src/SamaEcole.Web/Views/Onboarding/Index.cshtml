@{
 ViewData["Title"] = "Configuration initiale";
 Layout = "_AuthLayout";
}

@* /onboarding/select-profile — première configuration de l'établissement : le Directeur choisit son
 PROFIL (5 cartes) puis sa TRANCHE D'EFFECTIF (3 cartes + le sur-mesure, géré par l'équipe commerciale).
 Un seul envoi, POST /api/v1/onboarding/select-profile : la souscription passe de PendingOnboarding à Active
 et le quota s'applique immédiatement. Les cartes sont décrites dans onboarding.js (une seule source pour
 les libellés), pas répétées ici.

 Page de prise en charge PLEINE (pas le gabarit _Layout à sidebar) : tant que le choix n'est pas fait,
 l'API entière répond 403 ONBOARDING_REQUIRED et la sidebar n'aurait rien à afficher. api.js amène ici.
 Redirige les visiteurs anonymes vers /login. Fichier EXTERNE et non inline : la CSP n'autorise pas
 script-src 'unsafe-inline' (JGK-F01). *@
<script src="~/js/require-session.js" asp-append-version="true"></script>

<div class="min-h-screen flex items-center justify-center p-6 sm:p-12" x-data="onboardingWizard()" x-init="load()">
 <div class="w-full max-w-6xl">

 <!-- Logo -->
 <div class="flex items-center justify-center gap-2 mb-8">
 <div class="w-9 h-9 rounded-2xl bg-gradient-to-r from-primary-600 to-primary-500 text-white shadow-sm flex items-center justify-center font-bold text-lg">U</div>
 <span class="font-bold text-lg text-slate-900 tracking-tight">Unikol</span>
 </div>

 <!-- Chargement de l'état de la souscription -->
 <div x-show="state === 'loading'" class="text-center text-jgk-body text-slate-500" role="status">Chargement…</div>

 <!-- Un autre rôle que le Directeur ne peut pas valider ce choix -->
 <div x-cloak x-show="state === 'waitDirector'" class="max-w-xl mx-auto text-center">
 <h1 class="page-title">Configuration en attente</h1>
 <p class="text-jgk-body text-slate-500 mt-3">
 Le Directeur de votre établissement doit choisir le profil et la tranche d'effectif avant que
 l'application ne soit accessible. Revenez après sa configuration.
 </p>
 <button type="button" x-on:click="window.auth.logout()"
 class="mt-6 inline-flex items-center rounded-2xl border border-slate-200 bg-white px-5 py-2.5 text-jgk-body font-semibold text-slate-700 hover:bg-slate-50">
 Se déconnecter
 </button>
 </div>

 <!-- Erreur de chargement (hors refus d'accès) -->
 <div x-cloak x-show="state === 'loadError'" class="max-w-xl mx-auto text-center" role="alert">
 <p class="text-jgk-body text-danger" x-text="error"></p>
 <button type="button" x-on:click="load()"
 class="mt-4 inline-flex items-center rounded-2xl bg-primary-600 px-5 py-2.5 text-jgk-body font-semibold text-white hover:bg-primary-700">
 Réessayer
 </button>
 </div>

 <div x-cloak x-show="state === 'ready'">
 <div class="text-center mb-10">
 <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-50 text-primary-700 text-jgk-table font-semibold uppercase tracking-wide mb-4">
 <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
 Configuration initiale
 </span>
 <h1 class="page-title">Bienvenue — configurons votre établissement</h1>
 <p class="text-jgk-body text-slate-500 mt-2 max-w-2xl mx-auto">
 Deux choix et c'est prêt : le profil qui correspond à votre établissement (il adapte le menu et les
 formulaires), puis la tranche d'effectif qui fixe votre nombre d'élèves.
 </p>
 </div>

 <!-- Message d'erreur. aria-live : lu par un lecteur d'écran sans déplacer le focus. -->
 <div x-cloak
 x-show="error"
 x-transition.opacity
 role="alert"
 aria-live="polite"
 class="mb-6 flex items-start gap-3 rounded-2xl bg-danger/10 border border-danger/20 px-4 py-3 max-w-2xl mx-auto">
 <icon name="alert-circle" class="w-5 h-5 text-danger shrink-0 mt-0.5" />
 <p class="text-jgk-body text-danger" x-text="error"></p>
 </div>

 <!-- Étape 1 : le profil -->
 <h2 class="text-jgk-body font-semibold text-slate-900 mb-4">1. Votre profil d'établissement</h2>
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" role="radiogroup" aria-label="Profil d'établissement">
 <template x-for="p in profiles" x-bind:key="p.id">
 <button type="button"
 role="radio"
 x-bind:aria-checked="(profile === p.id).toString()"
 x-on:click="profile = p.id"
 x-bind:disabled="isSubmitting"
 x-bind:class="profile === p.id ? 'border-primary ring-2 ring-primary/30 shadow-lg shadow-primary/10' : 'border-slate-200 hover:border-primary hover:shadow-lg hover:shadow-primary/10'"
 class="group relative text-left flex flex-col rounded-2xl border-2 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed">
 <span x-show="p.recommended" class="absolute top-0 right-0 bg-primary text-white text-[11px] font-bold px-3 py-1 rounded-tr-2xl rounded-bl-xl uppercase tracking-wider">Recommandé</span>
 <span class="inline-flex self-start items-center px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[11px] font-semibold uppercase tracking-wide mb-3" x-text="p.tag"></span>
 <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-4 transition-all duration-300"
 x-bind:class="profile === p.id ? 'bg-primary text-white' : 'bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white'">
 <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-5 h-5"><use x-bind:href="'#icon-' + p.icon"></use></svg>
 </div>
 <h3 class="text-jgk-body font-semibold text-slate-900" x-text="p.title"></h3>
 <p class="mt-2 text-jgk-table text-slate-500 leading-relaxed flex-1" x-text="p.description"></p>
 <ul class="mt-4 space-y-1.5 text-jgk-table text-slate-500">
 <template x-for="b in p.bullets" x-bind:key="b">
 <li class="flex items-center gap-2">
 <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-3.5 h-3.5 text-primary shrink-0"><use href="#icon-check"></use></svg>
 <span x-text="b"></span>
 </li>
 </template>
 </ul>
 </button>
 </template>
 </div>

 <!-- Étape 2 : la tranche d'effectif -->
 <h2 class="text-jgk-body font-semibold text-slate-900 mt-10 mb-4">2. Votre tranche d'effectif</h2>
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" role="radiogroup" aria-label="Tranche d'effectif">
 <template x-for="t in tiers" x-bind:key="t.id">
 <button type="button"
 role="radio"
 x-bind:aria-checked="(tier === t.id).toString()"
 x-on:click="tier = t.id"
 x-bind:disabled="isSubmitting"
 x-bind:class="tier === t.id ? 'border-primary ring-2 ring-primary/30 shadow-lg shadow-primary/10' : 'border-slate-200 hover:border-primary hover:shadow-lg hover:shadow-primary/10'"
 class="text-left flex flex-col rounded-2xl border-2 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed">
 <span class="text-2xl font-bold text-slate-900" x-text="t.label"></span>
 <span class="mt-1 text-jgk-table text-slate-500" x-text="t.hint"></span>
 </button>
 </template>

 <!-- Sur-mesure : fixé par l'équipe commerciale, jamais choisi ici (refusé en 422 par l'API). -->
 <div class="flex flex-col rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 p-5">
 <span class="text-2xl font-bold text-slate-400">Sur mesure</span>
 <span class="mt-1 text-jgk-table text-slate-500">Plus de 800 élèves ou besoin particulier : contactez-nous, nous fixons votre plafond.</span>
 </div>
 </div>

 <p class="mt-3 text-jgk-table text-slate-500">
 Vous pouvez dépasser légèrement votre plafond : un bandeau d'avertissement s'affiche, puis la
 création d'élèves s'arrête à la limite de tolérance. Votre tranche peut être modifiée à tout moment
 par notre équipe.
 </p>

 <div class="mt-8 flex justify-center">
 <button type="button"
 x-on:click="submit()"
 x-bind:disabled="!canSubmit"
 x-bind:aria-busy="isSubmitting.toString()"
 class="inline-flex items-center gap-2 rounded-2xl bg-primary-600 px-8 py-3 text-jgk-body font-semibold text-white shadow-sm transition-all hover:bg-primary-700 disabled:opacity-50 disabled:cursor-not-allowed">
 <svg x-cloak x-show="isSubmitting" aria-hidden="true" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
 <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
 <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
 </svg>
 <span x-text="isSubmitting ? 'Enregistrement…' : 'Terminer la configuration'"></span>
 </button>
 </div>
 </div>
 </div>
</div>

@section Scripts {
 <script src="~/js/onboarding.js" asp-append-version="true"></script>
}
