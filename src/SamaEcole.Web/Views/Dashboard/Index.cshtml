@{
    ViewData["Title"] = "Tableau de bord";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

<div x-data="dashboardView()">
    <div>
        <h1 class="text-jgk-title font-bold text-gray-900">Tableau de bord financier</h1>
        <p class="text-jgk-subtitle text-gray-500 mt-1">Encaissements et recouvrement de l'établissement sur l'année scolaire active.</p>
    </div>

    <!-- Rôle non autorisé : le Secrétariat compose le dû à l'inscription, il ne pilote pas la trésorerie (règle #4). -->
    <div x-show="!canView" x-cloak class="card mt-6 py-12 text-center">
        <p class="text-gray-500 font-medium">Seuls le Directeur et le service Finance ont accès au tableau de bord financier.</p>
    </div>

    <div x-show="canView" x-cloak>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- Cartes KPI (4 cartes, docs/design-references/dashboard-reference.jpg) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        <template x-if="isLoading">
            <template x-for="i in 4" :key="i">
                <div class="card p-5 h-[92px] skeleton"></div>
            </template>
        </template>

        <template x-if="!isLoading && data">
            <stat-card label="Encaissé aujourd'hui" icon="wallet" accent="success">
                <span x-text="formatMoney(data.collectedToday)"></span>
            </stat-card>
        </template>
        <template x-if="!isLoading && data">
            <stat-card label="Encaissé ce mois" icon="wallet" accent="primary">
                <span x-text="formatMoney(data.collectedThisMonth)"></span>
            </stat-card>
        </template>
        <template x-if="!isLoading && data">
            <stat-card label="Encaissé cette année" icon="wallet" accent="primary">
                <span x-text="formatMoney(data.collectedThisYear)"></span>
            </stat-card>
        </template>
        <template x-if="!isLoading && data">
            <stat-card label="Solde dû" icon="alert-circle" accent="warning">
                <span x-text="formatMoney(data.outstandingBalance)"></span>
                <badge variant="warning" class="ml-2 text-[11px]"><span x-text="formatPercent(data.recoveryRate)"></span> recouvré</badge>
            </stat-card>
        </template>
    </div>

    <!-- Derniers paiements -->
    <div class="card mt-6 relative">
        <div class="p-4 border-b border-gray-200 bg-gray-50/50 rounded-t-xl flex items-center justify-between gap-4">
            <div>
                <p class="text-sm font-semibold text-gray-900">Derniers paiements</p>
                <p class="text-xs text-gray-500 mt-0.5">Les 10 versements les plus récents encaissés à la caisse.</p>
            </div>
            <div class="relative w-full max-w-xs">
                <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3">
                    <icon name="search" class="w-4 h-4 text-gray-400" />
                </span>
                <input type="search" x-model="search" placeholder="Élève, matricule, reçu…"
                       aria-label="Rechercher dans les derniers paiements"
                       class="w-full pl-9 pr-3 py-2 rounded-md border border-gray-300 text-sm shadow-sm focus:border-primary focus:ring-primary">
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4">Élève</th>
                        <th class="py-3 px-4">Matricule</th>
                        <th class="py-3 px-4">Reçu N°</th>
                        <th class="py-3 px-4 text-right">Montant</th>
                        <th class="py-3 px-4">Mode</th>
                        <th class="py-3 px-4">Date</th>
                        <th class="py-3 px-4 w-12"><span class="sr-only">Reçu PDF</span></th>
                    </tr>
                </thead>
                <tbody class="table-cell divide-y divide-gray-100">
                    <tr x-show="!isLoading && filteredPayments().length === 0" x-cloak>
                        <td colspan="7">
                            <empty-state icon="wallet" title="Aucun paiement récent."
                                         hint="Les encaissements de la caisse apparaîtront ici." />
                        </td>
                    </tr>

                    <template x-for="payment in filteredPayments()" :key="payment.paymentId">
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center gap-2">
                                    <span class="w-8 h-8 shrink-0 rounded-full bg-primary text-white flex items-center justify-center text-xs font-medium uppercase"
                                          x-text="initials(payment.studentFullName)"></span>
                                    <span class="font-medium text-gray-900" x-text="payment.studentFullName"></span>
                                </span>
                            </td>
                            <td class="py-3 px-4 font-mono text-xs text-gray-500" x-text="payment.matricule"></td>
                            <td class="py-3 px-4 font-mono text-xs text-gray-500" x-text="payment.receiptNumber"></td>
                            <td class="py-3 px-4 text-right font-medium" x-text="formatMoney(payment.amount)"></td>
                            <td class="py-3 px-4"><badge variant="neutral" x-text="methodLabel(payment.method)"></badge></td>
                            <td class="py-3 px-4 text-gray-500" x-text="formatDate(payment.paidAt)"></td>
                            <td class="py-3 px-4 text-center">
                                <button type="button"
                                        x-on:click="downloadReceipt(payment.paymentId, payment.receiptNumber)"
                                        title="Télécharger le reçu"
                                        aria-label="Télécharger le reçu"
                                        class="p-1.5 text-gray-400 hover:text-primary rounded-md focus:outline-none focus:ring-2 focus:ring-primary transition-colors">
                                    <icon name="download" class="w-4 h-4" />
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>
    </div>
</div>
