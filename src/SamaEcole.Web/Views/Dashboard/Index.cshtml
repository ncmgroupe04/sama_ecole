@{
 ViewData["Title"] = "Tableau de bord";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

@* JGK-R01 — Vue d'ensemble analytique de l'établissement (Directeur / Super Admin). Composant
 distinct du tableau de bord financier ci-dessous : périmètre de rôles différent (le Directeur voit
 les deux, la Finance seulement le financier, le Super Admin seulement l'analytique). *@
<div x-data="dashboardAnalytics()" x-show="canView" x-cloak class="mb-10">
 <div>
 <h1 class="text-jgk-title font-bold text-slate-900">Tableau de bord</h1>
 <p class="text-jgk-subtitle text-slate-500 mt-1">Effectifs, ressources humaines, assiduité et abonnement de l'établissement.</p>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
 <template x-if="isLoading">
 <template x-for="i in 4" :key="i">
 <div class="card p-5 h-[92px] skeleton"></div>
 </template>
 </template>

 <template x-if="!isLoading && data">
 <stat-card label="Élèves inscrits (année active)" icon="users" accent="primary">
 <span x-text="data.enrollments.total"></span>
 <span class="ml-2 text-xs font-normal text-slate-500">
 <span x-text="data.enrollments.boys"></span> G · <span x-text="data.enrollments.girls"></span> F
 </span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Enseignants actifs" icon="book" accent="primary">
 <span x-text="data.activeTeachers"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Taux de présence (ce mois)" icon="checkmark-circle" accent="success">
 <span x-text="formatPercent(data.attendanceRate)"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Abonnement" icon="wallet" accent="primary">
 <span x-text="subscriptionValue()"></span>
 <span x-show="data.subscription" class="ml-2 text-[11px] font-normal text-slate-500"
 x-text="subscriptionStatusLabel()"></span>
 </stat-card>
 </template>
 </div>

 <!-- Bloc 2 : Vie scolaire & effectifs — répartition par genre (donut) + taux de présence
 (jauge), en section nommée et séparée du bloc KPI ci-dessus pour une lecture en sections
 plutôt qu'un empilement continu de cartes. -->
 <div class="mt-10">
 <h2 class="text-jgk-title font-bold text-slate-900">Vie scolaire &amp; effectifs</h2>
 <p class="text-jgk-subtitle text-slate-500 mt-1">Répartition des élèves par genre et assiduité du mois en cours.</p>

 <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4">
 <template x-if="!isLoading && data">
 <div class="card p-5 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <p class="text-sm font-semibold text-slate-900">Répartition par genre</p>
 <p class="text-xs text-slate-500 mt-0.5">Élèves inscrits, année active.</p>
 <div class="mt-4 flex items-center gap-6">
 <svg viewBox="0 0 36 36" class="w-28 h-28 -rotate-90 shrink-0" role="img" aria-label="Répartition filles / garçons">
 <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#E5E7EB" stroke-width="3.2"></circle>
 <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#1D4ED8" stroke-width="3.2"
 stroke-linecap="round"
 :stroke-dasharray="boysFraction() + ' ' + (100 - boysFraction())"></circle>
 <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#BE185D" stroke-width="3.2"
 stroke-linecap="round"
 :stroke-dasharray="girlsFraction() + ' ' + (100 - girlsFraction())"
 :stroke-dashoffset="-boysFraction()"></circle>
 </svg>
 <dl class="space-y-2.5 text-sm">
 <div class="flex items-center gap-2">
 <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:#1D4ED8"></span>
 <dt class="text-slate-600">Garçons</dt>
 <dd class="font-bold text-slate-900" x-text="data.enrollments.boys"></dd>
 <dd class="text-slate-400" x-text="'(' + pct(data.enrollments.boys, data.enrollments.total) + ')'"></dd>
 </div>
 <div class="flex items-center gap-2">
 <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:#BE185D"></span>
 <dt class="text-slate-600">Filles</dt>
 <dd class="font-bold text-slate-900" x-text="data.enrollments.girls"></dd>
 <dd class="text-slate-400" x-text="'(' + pct(data.enrollments.girls, data.enrollments.total) + ')'"></dd>
 </div>
 </dl>
 </div>
 </div>
 </template>

 <template x-if="!isLoading && data">
 <div class="card p-5 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <p class="text-sm font-semibold text-slate-900">Taux de présence</p>
 <p class="text-xs text-slate-500 mt-0.5">Part des présences (dont retards) sur les appels du mois en cours.</p>
 <div class="mt-6">
 <div class="flex items-baseline justify-between mb-1.5">
 <span class="text-2xl font-bold text-slate-900" x-text="formatPercent(data.attendanceRate)"></span>
 </div>
 <div class="h-2.5 rounded-full bg-slate-100 overflow-hidden">
 <div class="h-full rounded-full bg-success transition-all"
 :style="'width: ' + Math.round((data.attendanceRate || 0) * 100) + '%'"></div>
 </div>
 <p x-show="data.attendanceRate === null" class="mt-2 text-xs text-slate-400">Aucun appel saisi ce mois-ci.</p>
 </div>
 </div>
 </template>
 </div>
 </div>
</div>

<div x-data="dashboardView()" class="pt-10 border-t border-slate-200">
 <div>
 <h1 class="text-jgk-title font-bold text-slate-900">Tableau de bord financier</h1>
 <p class="text-jgk-subtitle text-slate-500 mt-1">Encaissements et recouvrement de l'établissement sur l'année scolaire active.</p>
 </div>

 <!-- Rôle non autorisé : le Secrétariat compose le dû à l'inscription, il ne pilote pas la trésorerie (règle #4). -->
 <div x-show="!canView" x-cloak class="card mt-6 py-12 text-center">
 <p class="text-slate-500 font-medium">Seuls le Directeur et le service Finance ont accès au tableau de bord financier.</p>
 </div>

 <div x-show="canView" x-cloak>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- Cartes KPI (4 cartes, docs/design-references/dashboard-reference.jpg) -->
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
 <template x-if="isLoading">
 <template x-for="i in 4" :key="i">
 <div class="card p-5 h-[92px] skeleton"></div>
 </template>
 </template>

 <template x-if="!isLoading && data">
 <stat-card label="Encaissé aujourd'hui" icon="wallet" accent="success">
 <span x-text="formatMoney(data.collectedToday)"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Encaissé ce mois" icon="wallet" accent="primary">
 <span x-text="formatMoney(data.collectedThisMonth)"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Encaissé cette année" icon="wallet" accent="primary">
 <span x-text="formatMoney(data.collectedThisYear)"></span>
 </stat-card>
 </template>
 <template x-if="!isLoading && data">
 <stat-card label="Solde dû" icon="alert-circle" accent="warning">
 <span x-text="formatMoney(data.outstandingBalance)"></span>
 <badge variant="warning" class="ml-2 text-[11px]"><span x-text="formatPercent(data.recoveryRate)"></span> recouvré</badge>
 </stat-card>
 </template>
 </div>

            <!-- Navigation Onglets et Bilan Dual (Ticket JGK-F04 / Axe 3) -->
            <div x-show="!isLoading && data" x-cloak class="mt-8">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-3">
                    <div>
                        <h2 class="text-jgk-title font-bold text-slate-900">Bilan Financier Dual</h2>
                        <p class="text-jgk-subtitle text-slate-500 mt-1">Comparaison en temps réel entre l'exercice annuel et le mois en cours.</p>
                    </div>
                    <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200/60 self-start sm:self-auto">
                        <button type="button" x-on:click="activeTab = 'dual'"
                                :class="activeTab === 'dual' ? 'bg-white text-slate-900 shadow-2xs font-semibold' : 'text-slate-600 hover:text-slate-900'"
                                class="px-3 py-1.5 rounded-lg text-xs transition-all">
                            Côte à côte (Dual)
                        </button>
                        <button type="button" x-on:click="activeTab = 'annual'"
                                :class="activeTab === 'annual' ? 'bg-white text-slate-900 shadow-2xs font-semibold' : 'text-slate-600 hover:text-slate-900'"
                                class="px-3 py-1.5 rounded-lg text-xs transition-all">
                            Bilan Annuel
                        </button>
                        <button type="button" x-on:click="activeTab = 'monthly'"
                                :class="activeTab === 'monthly' ? 'bg-white text-slate-900 shadow-2xs font-semibold' : 'text-slate-600 hover:text-slate-900'"
                                class="px-3 py-1.5 rounded-lg text-xs transition-all">
                            Bilan Mensuel
                        </button>
                    </div>
                </div>
                <!-- Contenu Bilan Dual -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-4">
                    <!-- BILAN ANNUEL -->
                    <div x-show="activeTab === 'dual' || activeTab === 'annual'"
                         :class="activeTab === 'annual' ? 'lg:col-span-2' : ''"
                         class="card p-6 border-l-4 border-indigo-600 bg-gradient-to-br from-white to-indigo-50/20 shadow-sm">
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-md border border-indigo-100">Exercice actif</span>
                                <h3 class="text-lg font-bold text-slate-900 mt-1">Bilan Annuel Global</h3>
                            </div>
                            <span class="text-2xl font-black text-indigo-600" x-text="formatPercent(data.recoveryRate || data.yearlyRecoveryRate)"></span>
                        </div>

                        <dl class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6 pt-6 border-t border-slate-100 text-center">
                            <div class="bg-slate-50/80 p-3.5 rounded-xl border border-slate-100">
                                <dt class="text-xs text-slate-500">Encaissé sur l'année</dt>
                                <dd class="text-base font-bold text-slate-900 mt-1" x-text="formatMoney(data.collectedThisYear)"></dd>
                            </div>
                            <div class="bg-slate-50/80 p-3.5 rounded-xl border border-slate-100">
                                <dt class="text-xs text-slate-500">Solde dû global</dt>
                                <dd class="text-base font-bold text-warning mt-1" x-text="formatMoney(data.outstandingBalance)"></dd>
                            </div>
                            <div class="bg-slate-50/80 p-3.5 rounded-xl border border-slate-100 col-span-2 sm:col-span-1">
                                <dt class="text-xs text-slate-500">Taux global</dt>
                                <dd class="text-base font-bold text-success mt-1" x-text="formatPercent(data.recoveryRate || data.yearlyRecoveryRate)"></dd>
                            </div>
                        </dl>

                        <!-- Barre de progression annuelle -->
                        <div class="mt-5 space-y-1.5">
                            <div class="flex justify-between text-xs font-medium text-slate-600">
                                <span>Progression du recouvrement annuel</span>
                                <span x-text="formatPercent(data.recoveryRate || data.yearlyRecoveryRate)"></span>
                            </div>
                            <div class="h-2.5 rounded-full bg-slate-100 overflow-hidden">
                                <div class="h-full rounded-full bg-indigo-600 transition-all duration-500"
                                     :style="'width: ' + Math.min(100, Math.round((data.recoveryRate || data.yearlyRecoveryRate || 0) * 100)) + '%'"></div>
                            </div>
                        </div>
                    </div>

                    <!-- BILAN DU MOIS EN COURS -->
                    <div x-show="activeTab === 'dual' || activeTab === 'monthly'"
                         :class="activeTab === 'monthly' ? 'lg:col-span-2' : ''"
                         class="card p-6 border-l-4 border-emerald-600 bg-gradient-to-br from-white to-emerald-50/20 shadow-sm">
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-100">Mois en cours</span>
                                <h3 class="text-lg font-bold text-slate-900 mt-1">Bilan Mensuel</h3>
                            </div>
                            <span class="text-2xl font-black text-emerald-600" x-text="formatPercent(data.monthlyRecoveryRate || (data.expectedThisMonth ? (data.collectedThisMonth / data.expectedThisMonth) : 0))"></span>
                        </div>

                        <dl class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6 pt-6 border-t border-slate-100 text-center">
                            <div class="bg-slate-50/80 p-3.5 rounded-xl border border-slate-100">
                                <dt class="text-xs text-slate-500">Encaissé ce mois</dt>
                                <dd class="text-base font-bold text-slate-900 mt-1" x-text="formatMoney(data.collectedThisMonth)"></dd>
                            </div>
                            <div class="bg-slate-50/80 p-3.5 rounded-xl border border-slate-100">
                                <dt class="text-xs text-slate-500">Attendu ce mois</dt>
                                <dd class="text-base font-bold text-slate-700 mt-1" x-text="formatMoney(data.expectedThisMonth || 0)"></dd>
                            </div>
                            <div class="bg-slate-50/80 p-3.5 rounded-xl border border-slate-100 col-span-2 sm:col-span-1">
                                <dt class="text-xs text-slate-500">Taux mensuel</dt>
                                <dd class="text-base font-bold text-emerald-600 mt-1" x-text="formatPercent(data.monthlyRecoveryRate || (data.expectedThisMonth ? (data.collectedThisMonth / data.expectedThisMonth) : 0))"></dd>
                            </div>
                        </dl>

                        <!-- Barre de progression mensuelle -->
                        <div class="mt-5 space-y-1.5">
                            <div class="flex justify-between text-xs font-medium text-slate-600">
                                <span>Réalisation par rapport aux échéances du mois</span>
                                <span x-text="formatPercent(data.monthlyRecoveryRate || (data.expectedThisMonth ? (data.collectedThisMonth / data.expectedThisMonth) : 0))"></span>
                            </div>
                            <div class="h-2.5 rounded-full bg-slate-100 overflow-hidden">
                                <div class="h-full rounded-full bg-emerald-600 transition-all duration-500"
                                     :style="'width: ' + Math.min(100, Math.round((data.monthlyRecoveryRate || (data.expectedThisMonth ? (data.collectedThisMonth / data.expectedThisMonth) : 0)) * 100)) + '%'"></div>
                            </div>
                        </div>
                </div>
            </div>

 <!-- Diagrammes : recouvrement (donut) + comparaison jour/mois/année (barres), avec le détail en
 pourcentage de chaque chiffre affiché dans les cartes KPI ci-dessus. -->
 <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4">
 <template x-if="!isLoading && data">
 <div class="card p-5 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <p class="text-sm font-semibold text-slate-900">Recouvrement</p>
 <p class="text-xs text-slate-500 mt-0.5">Encaissé vs solde dû, année scolaire active.</p>
 <div class="mt-4 flex items-center gap-6">
 <svg viewBox="0 0 36 36" class="w-28 h-28 -rotate-90 shrink-0" role="img" aria-label="Part recouvrée du solde dû">
 <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#E5E7EB" stroke-width="3.2"></circle>
 <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#1E8E3E" stroke-width="3.2"
 stroke-linecap="round"
 :stroke-dasharray="(data.recoveryRate * 100) + ' ' + (100 - data.recoveryRate * 100)"></circle>
 </svg>
 <dl class="space-y-2.5 text-sm">
 <div class="flex items-center gap-2">
 <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-success"></span>
 <dt class="text-slate-600">Encaissé</dt>
 <dd class="font-bold text-slate-900" x-text="formatPercent(data.recoveryRate)"></dd>
 </div>
 <div class="flex items-center gap-2">
 <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:#E5E7EB"></span>
 <dt class="text-slate-600">Solde dû</dt>
 <dd class="font-bold text-slate-900" x-text="formatPercent(1 - data.recoveryRate)"></dd>
 </div>
 </dl>
 </div>
 </div>
 </template>

 <template x-if="!isLoading && data">
 <div class="card p-5 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <p class="text-sm font-semibold text-slate-900">Encaissements</p>
 <p class="text-xs text-slate-500 mt-0.5">Comparaison jour / mois / année.</p>
 <div class="mt-5 space-y-3.5">
 <div>
 <div class="flex items-center justify-between text-xs text-slate-500 mb-1">
 <span>Aujourd'hui</span>
 <span class="font-semibold text-slate-900" x-text="formatMoney(data.collectedToday)"></span>
 </div>
 <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
 <div class="h-full rounded-full bg-primary" :style="'width: ' + barWidth(data.collectedToday) + '%'"></div>
 </div>
 </div>
 <div>
 <div class="flex items-center justify-between text-xs text-slate-500 mb-1">
 <span>Ce mois</span>
 <span class="font-semibold text-slate-900" x-text="formatMoney(data.collectedThisMonth)"></span>
 </div>
 <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
 <div class="h-full rounded-full bg-primary" :style="'width: ' + barWidth(data.collectedThisMonth) + '%'"></div>
 </div>
 </div>
 <div>
 <div class="flex items-center justify-between text-xs text-slate-500 mb-1">
 <span>Cette année</span>
 <span class="font-semibold text-slate-900" x-text="formatMoney(data.collectedThisYear)"></span>
 </div>
 <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
 <div class="h-full rounded-full bg-primary" :style="'width: ' + barWidth(data.collectedThisYear) + '%'"></div>
 </div>
 </div>
 </div>
 <p class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500">
 Aujourd'hui représente <span class="font-semibold text-slate-700" x-text="pct(data.collectedToday, data.collectedThisMonth)"></span> du mois en cours ·
 ce mois représente <span class="font-semibold text-slate-700" x-text="pct(data.collectedThisMonth, data.collectedThisYear)"></span> de l'année.
 </p>
 </div>
 </template>
 </div>

 <!-- Derniers paiements -->
 <div class="card mt-6 relative">
 <div class="p-6 border-b border-slate-200 bg-slate-50/50 rounded-t-xl flex items-center justify-between gap-4">
 <div>
 <p class="text-sm font-semibold text-slate-900">Derniers paiements</p>
 <p class="text-xs text-slate-500 mt-0.5">Les 10 versements les plus récents encaissés à la caisse.</p>
 </div>
 <div class="relative w-full max-w-xs">
 <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3">
 <icon name="search" class="w-4 h-4 text-slate-400" />
 </span>
 <input type="search" x-model="search" placeholder="Élève, matricule, reçu…"
 aria-label="Rechercher dans les derniers paiements"
 class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm shadow-sm focus:border-primary focus:ring-primary transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 </div>
 </div>

 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Élève</th>
 <th class="py-3 px-4 whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Matricule</th>
 <th class="py-3 px-4 whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Reçu N°</th>
 <th class="py-3 px-4 text-right whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Montant</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Mode</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Date</th>
 <th class="py-3 px-4 w-12 uppercase tracking-wider text-slate-500 font-semibold"><span class="sr-only">Reçu PDF</span></th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out" x-show="!isLoading && filteredPayments().length === 0" x-cloak>
 <td colspan="7">
 <empty-state icon="wallet" title="Aucun paiement récent."
 hint="Les encaissements de la caisse apparaîtront ici." />
 </td>
 </tr>

 <template x-for="payment in filteredPayments()" :key="payment.paymentId">
 <tr class="hover:bg-slate-50 transition-colors transition-all duration-200 ease-in-out transition-all duration-200 ease-in-out">
 <td class="py-3 px-4">
 <span class="inline-flex items-center gap-2">
 <span class="w-8 h-8 shrink-0 rounded-full bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-700 hover:to-primary-600 text-white shadow-sm hover:shadow-sm transition-all duration-200 ease-in-out text-white flex items-center justify-center text-xs font-medium uppercase"
 x-text="initials(payment.studentFullName)"></span>
 <span class="font-medium text-slate-900" x-text="payment.studentFullName"></span>
 </span>
 </td>
 <td class="py-3 px-4 font-mono text-xs text-slate-500 whitespace-nowrap" x-text="payment.matricule"></td>
 <td class="py-3 px-4 font-mono text-xs text-slate-500 whitespace-nowrap" x-text="payment.receiptNumber"></td>
 <td class="py-3 px-4 text-right font-medium whitespace-nowrap" x-text="formatMoney(payment.amount)"></td>
 <td class="py-3 px-4"><badge variant="neutral" x-text="methodLabel(payment.method)"></badge></td>
 <td class="py-3 px-4 text-slate-500 whitespace-nowrap" x-text="formatDate(payment.paidAt)"></td>
                                <td class="py-3 px-4 text-center">
                                    <button type="button"
                                            x-on:click="previewReceipt(payment.paymentId, payment.receiptNumber)"
                                            title="Ouvrir l'aperçu du reçu (PDF)"
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-indigo-50 hover:border-indigo-200 text-slate-700 hover:text-indigo-700 text-xs font-semibold shadow-2xs transition-all">
                                        <icon name="document-text" class="w-4 h-4 text-indigo-600" />
                                        <span>Aperçu / Reçu</span>
                                    </button>
                                </td>
                            </tr>
 </template>
 </tbody>
 </table>
    </div>
    </div>
    </div>

    <!-- Modale d'Aperçu PDF -->
    <modal-shell open="showPdfModal" size="xl" on-close="closePdfPreview()" :title="pdfPreviewTitle">
        <div class="space-y-4">
            <div x-show="pdfPreviewUrl" class="w-full bg-slate-100 rounded-xl border border-slate-200 overflow-hidden" style="height: 600px;">
                <iframe :src="pdfPreviewUrl" id="dash-pdf-preview-frame" class="w-full h-full border-0" title="Prévisualisation du reçu"></iframe>
            </div>
            <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                <button type="button" x-on:click="closePdfPreview()" class="btn-secondary">Fermer</button>
                <button type="button" x-on:click="downloadPreviewPdf()" class="btn-secondary">
                    <icon name="download" class="w-4 h-4" />
                    <span>Télécharger</span>
                </button>
                <button type="button" x-on:click="printPreviewPdf()" class="btn-primary">
                    <icon name="print" class="w-4 h-4" />
                    <span>Imprimer</span>
                </button>
            </div>
        </div>
    </modal-shell>
</div>
