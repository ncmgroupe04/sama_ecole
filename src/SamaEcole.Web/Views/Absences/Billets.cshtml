@{
    ViewData["Title"] = "Billets d'entrée";
}

@section Scripts {
    <script src="~/js/billets.js" asp-append-version="true"></script>
}

<div x-data="billetsView()" class="space-y-6">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="page-title">Billets</h1>
            <p class="page-subtitle">Retards et sorties anticipées, avec impression du billet A5 correspondant.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <button x-show="tab === 'entree' && canManageBillets" x-cloak @@click="openCreate()" class="btn-modal-primary group">
                <icon name="plus" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-90" />
                Enregistrer un retard
            </button>
            <button x-show="tab === 'sortie' && canManageBillets" x-cloak @@click="openCreateExit()" class="btn-modal-primary group">
                <icon name="plus" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-90" />
                Enregistrer une sortie
            </button>
        </div>
    </div>

    <!-- Onglets -->
    <nav class="tab-nav" role="tablist" aria-label="Onglets Billets">
        <button type="button" role="tab" @@click="tab = 'entree'"
                class="tab-btn" :class="tab === 'entree' ? 'tab-btn-active' : ''">
            Billets d'entrée
        </button>
        <button type="button" role="tab" @@click="tab = 'sortie'"
                class="tab-btn" :class="tab === 'sortie' ? 'tab-btn-active' : ''">
            Billets de sortie
        </button>
    </nav>

    <!-- Tableau : Billets d'entrée -->
    <div x-show="tab === 'entree'" x-cloak class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3.5 px-4">Date</th>
                        <th class="py-3.5 px-4">Élève</th>
                        <th class="py-3.5 px-4">Retard</th>
                        <th class="py-3.5 px-4">Statut</th>
                        <th class="py-3.5 px-4">Motif</th>
                        <th class="py-3.5 px-4 text-right">Billet</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <template x-if="isLoading">
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-slate-500">
                                Chargement des retards...
                            </td>
                        </tr>
                    </template>
                    <template x-if="!isLoading && lateArrivals.length === 0">
                        <tr>
                            <td colspan="6">
                                <empty-state icon="clock" title="Aucun retard enregistré."
                                    hint="Les retards saisis par la Surveillance apparaîtront ici." />
                            </td>
                        </tr>
                    </template>
                    <template x-for="item in lateArrivals" :key="item.id">
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-4 py-4 whitespace-nowrap text-slate-600" x-text="formatDate(item.date)"></td>
                            <td class="px-4 py-4">
                                <div class="font-semibold text-slate-900" x-text="item.studentFullName"></div>
                                <div class="text-xs text-slate-500" x-text="'Matricule : ' + item.studentMatricule"></div>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span class="status-badge-warning" x-text="lateCellText(item)"></span>
                            </td>
                            @* Statut du billet (Évolution N°5) : vide pour un retard sans cours visé (tout l'historique). *@
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span x-show="item.status" x-cloak :class="ticketStatusBadge(item.status)" x-text="ticketStatusLabel(item.status)"></span>
                                <span x-show="!item.status" class="text-slate-400">—</span>
                            </td>
                            <td class="px-4 py-4 text-slate-600 truncate max-w-xs" x-text="item.reason" :title="item.reason"></td>
                            <td class="px-4 py-4 whitespace-nowrap text-right">
                                <button x-show="canCancelTicket(item)" x-cloak @@click="askCancelTicket(item)"
                                        class="btn-modal-secondary mr-2 text-danger">Annuler</button>
                                <button @@click="printBillet(item.id)" :disabled="printingId === item.id"
                                        class="btn-modal-secondary inline-flex items-center gap-2 disabled:opacity-60 group">
                                    <icon name="print" class="w-4 h-4" x-show="printingId !== item.id" />
                                    <icon name="loader" class="w-4 h-4 animate-spin" x-show="printingId === item.id" x-cloak />
                                    <span x-text="printingId === item.id ? 'Génération...' : 'Imprimer le billet'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modale de création : Nouveau retard -->
    <modal-shell size="60" open="isCreateOpen" on-close="closeCreate()" title="Nouveau retard">
        <modal-subtitle>Enregistrer l'arrivée tardive d'un élève.</modal-subtitle>

        <div x-show="createErrors.global" x-cloak class="form-error-banner" x-text="createErrors.global"></div>

        <form x-on:submit.prevent="submitCreate()" novalidate class="space-y-4">
            <div>
                <label class="form-label form-label-required">Élève concerné</label>
                <select-field model="form.studentId" required="true" aria-label="Élève concerné"
                              placeholder="Sélectionnez un élève..."
                              options-expr="students.map(s => ({value: s.id, label: s.fullName + ' (' + s.matricule + ')'}))" />
                <p x-show="createErrors.studentid" x-text="createErrors.studentid" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Date</label>
                <date-field model="form.date" required="true" aria-label="Date" />
                <p x-show="createErrors.date" x-text="createErrors.date" class="field-error"></p>
            </div>

            @* Heure d'arrivée (Complément N°5 bis) : quand la classe de l'élève a des cours ce jour-là, on ne saisit que
               l'heure réelle d'arrivée. Le serveur en déduit les cours manqués (justifiés par le billet), le retard sur
               le cours en cours, le cours que l'enseignant acceptera et la durée totale — l'aperçu ci-dessous est SON calcul. *@
            <div x-show="hasSlots" x-cloak>
                <label class="form-label form-label-required">Heure d'arrivée</label>
                <input type="time" x-model="form.arrivalTime" :required="hasSlots"
                       class="input-field" :class="(arrivalError || createErrors.arrivaltime) && 'input-field-error'"
                       aria-label="Heure d'arrivée" />
                <p class="mt-1 text-xs text-slate-500">
                    L'heure réelle à laquelle l'élève rejoint l'école : les cours manqués, le retard et la durée se calculent
                    d'après l'emploi du temps de sa classe.
                </p>
                <p x-show="arrivalError" x-cloak x-text="arrivalError" class="field-error"></p>
                <p x-show="createErrors.arrivaltime" x-cloak x-text="createErrors.arrivaltime" class="field-error"></p>
                <p x-show="isLoadingPreview" x-cloak class="mt-2 text-xs text-slate-400">Calcul en cours…</p>

                <template x-if="arrivalPreview">
                    <div role="status" class="mt-3 space-y-1 rounded-xl border border-primary/20 bg-primary-50 p-3 text-sm text-slate-700">
                        <template x-for="slot in arrivalPreview.missedSlots" :key="slot.slotId">
                            <p>
                                Cours manqué : <span class="font-semibold text-slate-900" x-text="slot.subjectName"></span>
                                <span x-text="slot.label + ' (' + formatDuration(slot.minutes) + ')'"></span>
                            </p>
                        </template>
                        <p x-show="arrivalPreview.inProgress" x-cloak>
                            En retard de <span class="font-semibold text-slate-900" x-text="arrivalPreview.inProgress ? formatDuration(arrivalPreview.inProgress.lateMinutes) : ''"></span>
                            à <span class="font-semibold text-slate-900" x-text="arrivalPreview.inProgress ? arrivalPreview.inProgress.subjectName : ''"></span>
                            <span x-text="arrivalPreview.inProgress ? arrivalPreview.inProgress.label : ''"></span>
                        </p>
                        <p class="font-semibold text-slate-900">
                            Durée totale : <span x-text="formatDuration(arrivalPreview.totalMinutes)"></span>
                        </p>
                    </div>
                </template>
            </div>

            @* Sans cours ce jour-là (jour de repos, classe sans emploi du temps) : les minutes se saisissent comme avant. *@
            <div x-show="!hasSlots" x-cloak>
                <label class="form-label form-label-required">Minutes de retard</label>
                <input type="number" min="1" x-model.number="form.minutes" :required="!hasSlots"
                       class="input-field" :class="createErrors.minutes && 'input-field-error'" />
                <p x-show="form.studentId && !isLoadingSlots" class="mt-1 text-xs text-slate-500">
                    Aucun cours à l'emploi du temps de sa classe ce jour-là : le billet est émis sans cours précis.
                </p>
                <p x-show="createErrors.minutes" x-text="createErrors.minutes" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Motif</label>
                <textarea x-model="form.reason" rows="4" placeholder="Motif du retard..." required
                          class="input-field"></textarea>
                <p x-show="createErrors.reason" x-text="createErrors.reason" class="field-error"></p>
            </div>

            <div>
                <label class="form-label">Observations</label>
                <textarea x-model="form.observations" rows="3" placeholder="Observations de la Surveillance (facultatif)..."
                          class="input-field"></textarea>
                <p x-show="createErrors.observations" x-text="createErrors.observations" class="field-error"></p>
            </div>

            <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
                <button type="button" @@click="closeCreate()" class="btn-modal-secondary group">Annuler</button>
                <button type="submit" :disabled="!canSubmitCreate" class="btn-modal-primary group">
                    <span x-text="isCreating ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    @* Annulation d'un billet en attente : l'appel de la classe reprend son état d'avant (Évolution N°5). *@
    <modal-shell open="ticketToCancel !== null" size="md" on-close="closeCancel()" title="Annuler ce billet ?">
        <p class="text-base font-medium text-slate-800">
            Le billet de <span x-text="ticketToCancel ? ticketToCancel.studentFullName : ''"></span> ne l'autorisera plus à rejoindre sa classe.
            Sa ligne dans l'appel reprendra son statut d'avant le billet.
        </p>
        <div x-show="cancelError" x-cloak class="form-error-banner mt-3" x-text="cancelError"></div>
        <div class="flex justify-end gap-3 mt-6">
            <button type="button" @@click="closeCancel()" class="btn-modal-secondary group">Garder le billet</button>
            <button type="button" @@click="confirmCancelTicket()" :disabled="isCancelling" class="btn-modal-primary group">
                <span x-text="isCancelling ? 'Annulation...' : 'Annuler le billet'"></span>
            </button>
        </div>
    </modal-shell>

    @* Confirmation : retard enregistré *@
    <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Retard enregistré">
        <confirm-dialog-body close-action="showAddedDialog = false"
                              new-action="showAddedDialog = false; openCreate()" new-label="Nouveau retard">
            Le retard de <span class="font-medium text-slate-900" x-text="addedLateArrivalName"></span> a bien été enregistré et figure désormais dans la liste. Vous pouvez imprimer le billet correspondant.
        </confirm-dialog-body>
    </modal-shell>

    <!-- Tableau : Billets de sortie -->
    <div x-show="tab === 'sortie'" x-cloak class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3.5 px-4">Date</th>
                        <th class="py-3.5 px-4">Élève</th>
                        <th class="py-3.5 px-4">Heure de sortie</th>
                        <th class="py-3.5 px-4">Motif</th>
                        <th class="py-3.5 px-4">Récupéré par</th>
                        <th class="py-3.5 px-4 text-right">Billet</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <template x-if="isLoadingExits">
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-slate-500">
                                Chargement des sorties...
                            </td>
                        </tr>
                    </template>
                    <template x-if="!isLoadingExits && earlyDepartures.length === 0">
                        <tr>
                            <td colspan="6">
                                <empty-state icon="sign-out" title="Aucune sortie anticipée enregistrée."
                                    hint="Les sorties anticipées saisies par la Surveillance apparaîtront ici." />
                            </td>
                        </tr>
                    </template>
                    <template x-for="item in earlyDepartures" :key="item.id">
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-4 py-4 whitespace-nowrap text-slate-600" x-text="formatDate(item.date)"></td>
                            <td class="px-4 py-4">
                                <div class="font-semibold text-slate-900" x-text="item.studentFullName"></div>
                                <div class="text-xs text-slate-500" x-text="'Matricule : ' + item.studentMatricule"></div>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span class="status-badge-primary" x-text="item.departureTime"></span>
                            </td>
                            <td class="px-4 py-4 text-slate-600 truncate max-w-xs" x-text="item.reason" :title="item.reason"></td>
                            <td class="px-4 py-4 text-slate-600" x-text="item.pickedUpBy || '—'"></td>
                            <td class="px-4 py-4 whitespace-nowrap text-right">
                                <button @@click="printExitBillet(item.id)" :disabled="printingExitId === item.id"
                                        class="btn-modal-secondary inline-flex items-center gap-2 disabled:opacity-60 group">
                                    <icon name="print" class="w-4 h-4" x-show="printingExitId !== item.id" />
                                    <icon name="loader" class="w-4 h-4 animate-spin" x-show="printingExitId === item.id" x-cloak />
                                    <span x-text="printingExitId === item.id ? 'Génération...' : 'Imprimer le billet'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modale de création : Nouvelle sortie anticipée -->
    <modal-shell size="60" open="isCreateExitOpen" on-close="closeCreateExit()" title="Nouvelle sortie anticipée">
        <modal-subtitle>Enregistrer la sortie anticipée d'un élève.</modal-subtitle>

        <div x-show="createExitErrors.global" x-cloak class="form-error-banner" x-text="createExitErrors.global"></div>

        <form x-on:submit.prevent="submitCreateExit()" novalidate class="space-y-4">
            <div>
                <label class="form-label form-label-required">Élève concerné</label>
                <select-field model="exitForm.studentId" required="true" aria-label="Élève concerné"
                              placeholder="Sélectionnez un élève..."
                              options-expr="students.map(s => ({value: s.id, label: s.fullName + ' (' + s.matricule + ')'}))" />
                <p x-show="createExitErrors.studentid" x-text="createExitErrors.studentid" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Date</label>
                <date-field model="exitForm.date" required="true" aria-label="Date" />
                <p x-show="createExitErrors.date" x-text="createExitErrors.date" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Heure de sortie</label>
                <input type="time" x-model="exitForm.departureTime" required
                       class="input-field" :class="createExitErrors.departuretime && 'input-field-error'" />
                <p x-show="createExitErrors.departuretime" x-text="createExitErrors.departuretime" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Motif</label>
                <textarea x-model="exitForm.reason" rows="3" placeholder="Motif de la sortie..." required
                          class="input-field"></textarea>
                <p x-show="createExitErrors.reason" x-text="createExitErrors.reason" class="field-error"></p>
            </div>

            <div>
                <label class="form-label">Récupéré par</label>
                <input type="text" x-model="exitForm.pickedUpBy" placeholder="Nom de la personne (optionnel)"
                       class="input-field" />
            </div>

            <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
                <button type="button" @@click="closeCreateExit()" class="btn-modal-secondary group">Annuler</button>
                <button type="submit" :disabled="isCreatingExit" class="btn-modal-primary group">
                    <span x-text="isCreatingExit ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    @* Confirmation : sortie enregistrée *@
    <modal-shell open="showAddedExitDialog" size="md" on-close="showAddedExitDialog = false" title="Sortie enregistrée">
        <confirm-dialog-body close-action="showAddedExitDialog = false"
                              new-action="showAddedExitDialog = false; openCreateExit()" new-label="Nouvelle sortie">
            La sortie de <span class="font-medium text-slate-900" x-text="addedEarlyDepartureName"></span> a bien été enregistrée et figure désormais dans la liste. Vous pouvez imprimer le billet correspondant.
        </confirm-dialog-body>
    </modal-shell>

    @* Aperçu PDF partagé — voir wwwroot/js/pdf-preview.js *@
    @await Html.PartialAsync("_PdfPreviewModal")
</div>
