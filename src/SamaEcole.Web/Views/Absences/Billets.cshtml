@{
    ViewData["Title"] = "Billets d'entrée";
}

@section Scripts {
    <script src="~/js/billets.js" asp-append-version="true"></script>
}

<div x-data="billetsView()" class="space-y-6">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-jgk-title font-bold text-slate-900">Billets</h1>
            <p class="text-jgk-subtitle text-slate-500 mt-1">Retards et sorties anticipées, avec impression du billet A5 correspondant.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <button x-show="tab === 'entree' && canManageBillets" x-cloak @@click="isCreateOpen = true" class="btn-primary">
                <icon name="plus" class="w-4 h-4" />
                Enregistrer un retard
            </button>
            <button x-show="tab === 'sortie' && canManageBillets" x-cloak @@click="isCreateExitOpen = true" class="btn-primary">
                <icon name="plus" class="w-4 h-4" />
                Enregistrer une sortie
            </button>
        </div>
    </div>

    <!-- Onglets -->
    <nav class="flex p-1.5 space-x-1 bg-slate-100 rounded-xl w-fit" role="tablist" aria-label="Onglets Billets">
        <button type="button" role="tab" @@click="tab = 'entree'"
                class="px-4 py-2.5 text-sm whitespace-nowrap rounded-lg transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-1"
                :class="tab === 'entree' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'">
            Billets d'entrée
        </button>
        <button type="button" role="tab" @@click="tab = 'sortie'"
                class="px-4 py-2.5 text-sm whitespace-nowrap rounded-lg transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-1"
                :class="tab === 'sortie' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'">
            Billets de sortie
        </button>
    </nav>

    <!-- Tableau : Billets d'entrée -->
    <div x-show="tab === 'entree'" x-cloak class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 font-semibold">Date</th>
                        <th class="px-6 py-4 font-semibold">Élève</th>
                        <th class="px-6 py-4 font-semibold">Retard</th>
                        <th class="px-6 py-4 font-semibold">Motif</th>
                        <th class="px-6 py-4 font-semibold text-right">Billet</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    <template x-if="isLoading">
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                                Chargement des retards...
                            </td>
                        </tr>
                    </template>
                    <template x-if="!isLoading && lateArrivals.length === 0">
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                                Aucun retard enregistré.
                            </td>
                        </tr>
                    </template>
                    <template x-for="item in lateArrivals" :key="item.id">
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-slate-600" x-text="formatDate(item.date)"></td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-slate-900" x-text="item.studentFullName"></div>
                                <div class="text-xs text-slate-500" x-text="'Matricule : ' + item.studentMatricule"></div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-800"
                                      x-text="item.minutes + ' min'"></span>
                            </td>
                            <td class="px-6 py-4 text-slate-600 truncate max-w-xs" x-text="item.reason" :title="item.reason"></td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <button @@click="printBillet(item.id)" :disabled="printingId === item.id"
                                        class="btn-secondary inline-flex items-center gap-2 disabled:opacity-60">
                                    <icon name="print" class="w-4 h-4" x-show="printingId !== item.id" />
                                    <icon name="loader" class="w-4 h-4 animate-spin" x-show="printingId === item.id" x-cloak />
                                    <span x-text="printingId === item.id ? 'Génération...' : 'Imprimer le billet'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Slide-over Création -->
    <div x-show="isCreateOpen" style="display: none;" class="relative z-50" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div x-show="isCreateOpen" x-transition.opacity class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity"></div>

        <div class="fixed inset-0 overflow-hidden">
            <div class="absolute inset-0 overflow-hidden">
                <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10 sm:pl-16">
                    <div x-show="isCreateOpen"
                         x-transition:enter="transform transition ease-in-out duration-300 sm:duration-500"
                         x-transition:enter-start="translate-x-full"
                         x-transition:enter-end="translate-x-0"
                         x-transition:leave="transform transition ease-in-out duration-300 sm:duration-500"
                         x-transition:leave-start="translate-x-0"
                         x-transition:leave-end="translate-x-full"
                         class="pointer-events-auto w-screen max-w-md">
                        <form @@submit.prevent="submitCreate" class="flex h-full flex-col bg-white shadow-xl">
                            <!-- En-tête -->
                            <div class="px-6 py-6 sm:px-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                                <div>
                                    <h2 class="text-lg font-semibold text-slate-900" id="slide-over-title">Nouveau retard</h2>
                                    <p class="text-sm text-slate-500 mt-1">Enregistrer l'arrivée tardive d'un élève.</p>
                                </div>
                                <button type="button" @@click="isCreateOpen = false" class="rounded-md bg-white text-slate-400 hover:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
                                    <span class="sr-only">Fermer</span>
                                    <icon name="x" class="h-6 w-6" />
                                </button>
                            </div>
                            <!-- Contenu -->
                            <div class="relative flex-1 px-6 py-6 sm:px-8 overflow-y-auto space-y-6">

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Élève concerné <span class="text-red-500">*</span></label>
                                    <select x-model="form.studentId" class="input-field mt-1" required>
                                        <option value="">Sélectionnez un élève...</option>
                                        <template x-for="student in students" :key="student.id">
                                            <option :value="student.id" x-text="student.fullName + ' (' + student.matricule + ')'"></option>
                                        </template>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Date <span class="text-red-500">*</span></label>
                                    <input type="date" x-model="form.date" class="input-field mt-1" required />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Minutes de retard <span class="text-red-500">*</span></label>
                                    <input type="number" min="1" x-model="form.minutes" class="input-field mt-1" required />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Motif <span class="text-red-500">*</span></label>
                                    <textarea x-model="form.reason" rows="4" class="input-field mt-1" placeholder="Motif du retard..." required></textarea>
                                </div>

                            </div>
                            <!-- Pied de page -->
                            <div class="flex items-center justify-end gap-3 px-6 py-5 border-t border-slate-100 bg-slate-50">
                                <button type="button" @@click="isCreateOpen = false" class="btn-secondary">Annuler</button>
                                <button type="submit" class="btn-primary" :disabled="isCreating">
                                    <span x-show="!isCreating">Enregistrer</span>
                                    <span x-show="isCreating" class="flex items-center gap-2">
                                        <icon name="loader" class="w-4 h-4 animate-spin" />
                                        Enregistrement...
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau : Billets de sortie -->
    <div x-show="tab === 'sortie'" x-cloak class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 font-semibold">Date</th>
                        <th class="px-6 py-4 font-semibold">Élève</th>
                        <th class="px-6 py-4 font-semibold">Heure de sortie</th>
                        <th class="px-6 py-4 font-semibold">Motif</th>
                        <th class="px-6 py-4 font-semibold">Récupéré par</th>
                        <th class="px-6 py-4 font-semibold text-right">Billet</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    <template x-if="isLoadingExits">
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-slate-500">
                                Chargement des sorties...
                            </td>
                        </tr>
                    </template>
                    <template x-if="!isLoadingExits && earlyDepartures.length === 0">
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-slate-500">
                                Aucune sortie anticipée enregistrée.
                            </td>
                        </tr>
                    </template>
                    <template x-for="item in earlyDepartures" :key="item.id">
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-slate-600" x-text="formatDate(item.date)"></td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-slate-900" x-text="item.studentFullName"></div>
                                <div class="text-xs text-slate-500" x-text="'Matricule : ' + item.studentMatricule"></div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800"
                                      x-text="item.departureTime"></span>
                            </td>
                            <td class="px-6 py-4 text-slate-600 truncate max-w-xs" x-text="item.reason" :title="item.reason"></td>
                            <td class="px-6 py-4 text-slate-600" x-text="item.pickedUpBy || '—'"></td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <button @@click="printExitBillet(item.id)" :disabled="printingExitId === item.id"
                                        class="btn-secondary inline-flex items-center gap-2 disabled:opacity-60">
                                    <icon name="print" class="w-4 h-4" x-show="printingExitId !== item.id" />
                                    <icon name="loader" class="w-4 h-4 animate-spin" x-show="printingExitId === item.id" x-cloak />
                                    <span x-text="printingExitId === item.id ? 'Génération...' : 'Imprimer le billet'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Slide-over Création : Billet de sortie -->
    <div x-show="isCreateExitOpen" style="display: none;" class="relative z-50" aria-labelledby="slide-over-exit-title" role="dialog" aria-modal="true">
        <div x-show="isCreateExitOpen" x-transition.opacity class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity"></div>

        <div class="fixed inset-0 overflow-hidden">
            <div class="absolute inset-0 overflow-hidden">
                <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10 sm:pl-16">
                    <div x-show="isCreateExitOpen"
                         x-transition:enter="transform transition ease-in-out duration-300 sm:duration-500"
                         x-transition:enter-start="translate-x-full"
                         x-transition:enter-end="translate-x-0"
                         x-transition:leave="transform transition ease-in-out duration-300 sm:duration-500"
                         x-transition:leave-start="translate-x-0"
                         x-transition:leave-end="translate-x-full"
                         class="pointer-events-auto w-screen max-w-md">
                        <form @@submit.prevent="submitCreateExit" class="flex h-full flex-col bg-white shadow-xl">
                            <div class="px-6 py-6 sm:px-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                                <div>
                                    <h2 class="text-lg font-semibold text-slate-900" id="slide-over-exit-title">Nouvelle sortie anticipée</h2>
                                    <p class="text-sm text-slate-500 mt-1">Enregistrer la sortie anticipée d'un élève.</p>
                                </div>
                                <button type="button" @@click="isCreateExitOpen = false" class="rounded-md bg-white text-slate-400 hover:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
                                    <span class="sr-only">Fermer</span>
                                    <icon name="x" class="h-6 w-6" />
                                </button>
                            </div>
                            <div class="relative flex-1 px-6 py-6 sm:px-8 overflow-y-auto space-y-6">

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Élève concerné <span class="text-red-500">*</span></label>
                                    <select x-model="exitForm.studentId" class="input-field mt-1" required>
                                        <option value="">Sélectionnez un élève...</option>
                                        <template x-for="student in students" :key="student.id">
                                            <option :value="student.id" x-text="student.fullName + ' (' + student.matricule + ')'"></option>
                                        </template>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Date <span class="text-red-500">*</span></label>
                                    <input type="date" x-model="exitForm.date" class="input-field mt-1" required />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Heure de sortie <span class="text-red-500">*</span></label>
                                    <input type="time" x-model="exitForm.departureTime" class="input-field mt-1" required />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Motif <span class="text-red-500">*</span></label>
                                    <textarea x-model="exitForm.reason" rows="3" class="input-field mt-1" placeholder="Motif de la sortie..." required></textarea>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Récupéré par</label>
                                    <input type="text" x-model="exitForm.pickedUpBy" class="input-field mt-1" placeholder="Nom de la personne (optionnel)" />
                                </div>

                            </div>
                            <div class="flex items-center justify-end gap-3 px-6 py-5 border-t border-slate-100 bg-slate-50">
                                <button type="button" @@click="isCreateExitOpen = false" class="btn-secondary">Annuler</button>
                                <button type="submit" class="btn-primary" :disabled="isCreatingExit">
                                    <span x-show="!isCreatingExit">Enregistrer</span>
                                    <span x-show="isCreatingExit" class="flex items-center gap-2">
                                        <icon name="loader" class="w-4 h-4 animate-spin" />
                                        Enregistrement...
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
