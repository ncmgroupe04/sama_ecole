@{
    ViewData["Title"] = "Pointage Profs";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/pointage-profs.js" asp-append-version="true"></script>
}

<div x-data="pointageProfsView()" class="space-y-6">
    <div>
        <h1 class="page-title">Pointage Profs</h1>
        <p class="page-subtitle">Relevé d'heures des enseignants vacataires — base de calcul de leur bulletin de paie.</p>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- ===================== Sélection ===================== -->
    <div class="card p-6">
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 items-end">
            <div class="sm:col-span-2">
                <label class="form-label">Enseignant vacataire <span class="text-red-500">*</span></label>
                <select-field model="selectedContractId" placeholder="Sélectionnez un enseignant vacataire..."
                    options-expr="vacataireContracts.map(c => ({value: c.id, label: c.employeeFullName}))"
                    on-change="loadHourRecords()" />
            </div>
            <div>
                <label class="form-label-sm">Mois</label>
                <select-field model="filter.month" placeholder="Sélectionnez un mois..." on-change="loadHourRecords()"
                    options-expr="[{value:1,label:'Janvier'},{value:2,label:'Février'},{value:3,label:'Mars'},{value:4,label:'Avril'},{value:5,label:'Mai'},{value:6,label:'Juin'},{value:7,label:'Juillet'},{value:8,label:'Août'},{value:9,label:'Septembre'},{value:10,label:'Octobre'},{value:11,label:'Novembre'},{value:12,label:'Décembre'}]" />
            </div>
            <div>
                <label class="form-label-sm">Année</label>
                <input type="number" x-model="filter.year" x-on:change="loadHourRecords()" class="input-field mt-0" />
            </div>
        </div>

        <div class="mt-4 flex justify-end">
            <button type="button" x-on:click="downloadHourRecordSheet()" :disabled="!selectedContractId || downloadingSheet" class="btn-modal-secondary group">
                <icon name="download" class="w-4 h-4" x-show="!downloadingSheet" />
                <icon name="loader" class="w-4 h-4 animate-spin" x-show="downloadingSheet" x-cloak />
                <span x-text="downloadingSheet ? 'Génération...' : 'Fiche heures (PDF)'"></span>
            </button>
        </div>
    </div>

    @* Le champ ci-dessus ne liste que les CONTRATS de type Vacataire (Comptabilité > Paie), pas le
       « Statut administratif » du formulaire Enseignant (STATEDUC, Paramètres du même nom) — deux
       champs distincts qui portent la même étiquette et se confondent facilement : marquer un
       enseignant "Vacataire" sur sa fiche ne suffit pas, il faut aussi lui créer un contrat Vacataire
       dans Paie pour qu'il apparaisse ici. Message dédié tant qu'aucun contrat n'existe DU TOUT,
       distinct du cas "des contrats existent, choisissez-en un". *@
    <template x-if="!isLoading && !selectedContractId && vacataireContracts.length === 0">
        <div class="card p-6">
            <div class="flex flex-col items-center justify-center py-12 text-center">
                <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-warning-bg text-warning">
                    <icon name="alert-circle" class="h-6 w-6" />
                </div>
                <p class="font-medium text-slate-600">Aucun enseignant vacataire n'a de contrat actif.</p>
                <p class="mt-1 max-w-md text-xs text-slate-400">
                    Marquer un enseignant « Vacataire » sur sa fiche (onglet STATEDUC) ne suffit pas : il lui faut
                    aussi un <strong>contrat</strong> de type Vacataire, créé dans Comptabilité — c'est ce contrat,
                    pas le statut de la fiche, qui le fait apparaître ici.
                </p>
                <a href="/paie" class="mt-4 text-sm font-medium text-primary hover:underline">Créer son contrat dans Paie →</a>
            </div>
        </div>
    </template>

    <template x-if="!selectedContractId && vacataireContracts.length > 0">
        <div class="card p-6">
            <empty-state icon="clock" title="Aucun enseignant vacataire sélectionné."
                hint="Choisissez un enseignant vacataire ci-dessus pour consulter ou saisir son relevé d'heures." />
        </div>
    </template>

    <div x-show="selectedContractId" x-cloak class="space-y-6">
        <!-- ===================== Relevé d'heures ===================== -->
        <div class="card">
            <div class="p-6 border-b border-slate-200">
                <h2 class="text-sm font-semibold text-slate-700">Relevé d'heures</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="table-head">
                            <th class="py-3 px-4">Date</th>
                            <th class="py-3 px-4 text-right">Heures</th>
                            <th class="py-3 px-4">Note</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr x-show="!isLoading && hourRecords.length === 0" x-cloak>
                            <td colspan="3">
                                <empty-state icon="document" title="Aucune heure enregistrée sur cette période."
                                    hint="Ajoutez une ligne d'heures ci-dessous." />
                            </td>
                        </tr>
                        <template x-for="record in hourRecords" :key="record.id">
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-3 px-4 text-slate-600" x-text="record.date"></td>
                                <td class="py-3 px-4 text-right text-slate-600" x-text="record.hours"></td>
                                <td class="py-3 px-4 text-slate-500" x-text="record.note"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ===================== Saisir des heures ===================== -->
        <div class="card p-6">
            <h2 class="text-sm font-semibold text-slate-700 mb-4">Ajouter des heures</h2>
            <form x-on:submit.prevent="submitHourRecord()" novalidate class="grid grid-cols-1 sm:grid-cols-4 gap-4 items-end">
                <div>
                    <label class="form-label">Date <span class="text-red-500">*</span></label>
                    <date-field model="hourRecordForm.date" required="true" aria-label="Date" class="mt-1" />
                </div>
                <div>
                    <label class="form-label">Heures <span class="text-red-500">*</span></label>
                    <input type="number" min="0" step="0.5" x-model="hourRecordForm.hours" required class="input-field mt-1" />
                </div>
                <div class="sm:col-span-2">
                    <label class="form-label">Note</label>
                    <input type="text" x-model="hourRecordForm.note" class="input-field mt-1" />
                </div>
                <div class="sm:col-span-4 flex justify-end">
                    <button type="submit" class="btn-modal-primary group" :disabled="isSavingHourRecord">
                        <span x-show="!isSavingHourRecord">Ajouter les heures</span>
                        <span x-show="isSavingHourRecord">Enregistrement...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* Aperçu PDF partagé — voir wwwroot/js/pdf-preview.js *@
    @await Html.PartialAsync("_PdfPreviewModal")
</div>
