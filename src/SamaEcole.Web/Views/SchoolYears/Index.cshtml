@{
    ViewData["Title"] = "Pédagogie - Années scolaires";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/school-years.js" asp-append-version="true"></script>
}

<div x-data="schoolYearsView()">
    <!-- Titre et bouton Nouvelle année -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-jgk-title font-bold text-gray-900">Années scolaires</h1>
            <p class="text-jgk-subtitle text-gray-500 mt-1">
                L'année active est l'exercice sur lequel travaille l'établissement : inscriptions, frais et bulletins s'y rattachent.
            </p>
        </div>

        @* Réservé au Directeur (Volume 7 §15). Masquer le bouton n'est qu'un confort : l'API répond
           403 à qui l'appellerait quand même. *@
        <button x-show="isDirecteur" x-cloak x-on:click="openCreate()"
                class="px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-sm shadow-indigo-200 flex items-center justify-center gap-2">
            <svg aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            Nouvelle année
        </button>
    </div>

    <!-- Alerte d'erreur API globale -->
    <div x-show="error" x-cloak class="mt-6 bg-red-50 border-l-4 border-danger p-4 rounded-md">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg aria-hidden="true" class="h-5 w-5 text-danger" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
            </div>
            <div class="ml-3">
                <p class="text-sm text-red-700" x-text="error"></p>
            </div>
        </div>
    </div>

    <!-- Synthèse et tableau -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 mt-6 relative">

        <!-- Voile de chargement -->
        <div x-show="isLoading" class="absolute inset-0 z-10 bg-white/70 flex items-center justify-center rounded-xl backdrop-blur-sm">
            <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </div>

        <div class="p-4 border-b border-gray-200 bg-gray-50/50 rounded-t-xl flex gap-6">
            <div>
                <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Année active</p>
                <p class="text-lg font-bold" x-cloak
                   :class="activeYear() ? 'text-gray-900' : 'text-warning'"
                   x-text="activeYear() ? activeYear().label : 'Aucune'"></p>
            </div>
            <div>
                <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Années enregistrées</p>
                <p class="text-lg font-bold text-gray-900" x-text="years.length"></p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <th class="py-3 px-4">Libellé</th>
                        <th class="py-3 px-4">Période</th>
                        <th class="py-3 px-4">Statut</th>
                        <th class="py-3 px-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="text-sm text-gray-700 divide-y divide-gray-100">
                    <tr x-show="!isLoading && years.length === 0" x-cloak>
                        <td colspan="4" class="py-12 text-center">
                            <div class="flex flex-col items-center justify-center">
                                <div aria-hidden="true" class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 mb-3">
                                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                </div>
                                <p class="text-gray-500 font-medium">Aucune année scolaire n'est enregistrée.</p>
                                <p class="text-xs text-gray-400 mt-1">
                                    La première année créée devient l'année active de l'établissement.
                                </p>
                            </div>
                        </td>
                    </tr>

                    <template x-for="(year, index) in years" :key="year.id || index">
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-3 px-4 font-bold text-gray-900">
                                <span class="inline-flex items-center gap-2">
                                    <span aria-hidden="true" class="w-2 h-2 rounded-full"
                                          :class="year.isActive ? 'bg-success' : 'bg-gray-300'"></span>
                                    <span x-text="year.label"></span>
                                </span>
                            </td>
                            <td class="py-3 px-4 text-gray-600"
                                x-text="`${formatDate(year.startDate)} — ${formatDate(year.endDate)}`"></td>
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium"
                                      :class="statusClass(year)"
                                      x-text="statusLabel(year)"></span>
                            </td>
                            <td class="py-3 px-4 text-right">
                                <button x-show="canActivate(year)" x-cloak
                                        x-on:click="openActivate(year)"
                                        class="px-3 py-1.5 text-xs font-medium text-primary bg-indigo-50 rounded-md hover:bg-indigo-100 transition-colors">
                                    Activer
                                </button>

                                @* Une année terminée est en lecture seule (ticket JGK-C01) : on le DIT,
                                   au lieu d'afficher un bouton grisé dont personne ne devine la raison. *@
                                <span x-show="year.isClosed" x-cloak
                                      class="inline-flex items-center gap-1 text-xs text-gray-400">
                                    <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                                    Lecture seule
                                </span>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Panneau latéral : création d'une année scolaire -->
    <div x-show="isCreateOpen" class="fixed inset-0 overflow-hidden z-40" x-cloak>
        <div class="absolute inset-0 overflow-hidden">
            <div x-show="isCreateOpen" x-transition.opacity class="absolute inset-0 bg-gray-500 bg-opacity-75 transition-opacity" x-on:click="isCreateOpen = false"></div>

            <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
                <div x-show="isCreateOpen"
                     x-transition:enter="transform transition ease-in-out duration-300 sm:duration-500" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
                     x-transition:leave="transform transition ease-in-out duration-300 sm:duration-500" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
                     class="pointer-events-auto w-screen max-w-md">
                    <div class="flex h-full flex-col overflow-y-scroll bg-white shadow-xl">
                        <div class="bg-primary px-4 py-6 sm:px-6">
                            <div class="flex items-center justify-between">
                                <h2 class="text-lg font-medium text-white">Nouvelle année scolaire</h2>
                                <div class="ml-3 flex h-7 items-center">
                                    <button type="button" x-on:click="isCreateOpen = false" class="rounded-md bg-primary text-indigo-200 hover:text-white focus:outline-none">
                                        <span class="sr-only">Fermer</span>
                                        <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="mt-1">
                                <p class="text-sm text-indigo-200">
                                    Créer une année ne fait pas basculer l'établissement dessus : elle reste inactive jusqu'à son activation.
                                </p>
                            </div>
                        </div>

                        <div class="relative flex-1 px-4 py-6 sm:px-6">
                            <!-- Erreur globale (conflit de libellé, réseau…) -->
                            <div x-show="createErrors.global" x-cloak class="mb-4 bg-red-50 p-3 rounded-md border-l-4 border-danger">
                                <p class="text-sm text-red-700" x-text="createErrors.global"></p>
                            </div>

                            <form x-on:submit.prevent="submitCreate()" class="space-y-4">
                                <div>
                                    <label for="year-label" class="block text-sm font-medium text-gray-700">Libellé <span class="text-danger">*</span></label>
                                    <input id="year-label" type="text" x-model="newYear.label" required maxlength="20" placeholder="ex : 2026-2027"
                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2">
                                    <p x-show="createErrors.label" x-cloak x-text="createErrors.label" class="mt-1 text-xs text-danger"></p>
                                </div>

                                <div>
                                    <label for="year-start" class="block text-sm font-medium text-gray-700">Date de début <span class="text-danger">*</span></label>
                                    <input id="year-start" type="date" x-model="newYear.startDate" required
                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2">
                                    @* Le chevauchement est rapporté sur ce champ : c'est la période qui est en cause,
                                       et c'est là que l'API place l'erreur (StartDate). *@
                                    <p x-show="createErrors.startdate" x-cloak x-text="createErrors.startdate" class="mt-1 text-xs text-danger"></p>
                                </div>

                                <div>
                                    <label for="year-end" class="block text-sm font-medium text-gray-700">Date de fin <span class="text-danger">*</span></label>
                                    <input id="year-end" type="date" x-model="newYear.endDate" required
                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2">
                                    <p x-show="createErrors.enddate" x-cloak x-text="createErrors.enddate" class="mt-1 text-xs text-danger"></p>
                                </div>

                                <p class="text-xs text-gray-500">
                                    La rentrée sénégalaise a lieu en octobre : une année court généralement d'octobre à juillet.
                                </p>

                                <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
                                    <button type="button" x-on:click="isCreateOpen = false" class="rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none">
                                        Annuler
                                    </button>
                                    <button type="submit" :disabled="isSubmitting" class="inline-flex justify-center items-center gap-2 rounded-md border border-transparent bg-primary py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-600 focus:outline-none disabled:opacity-50">
                                        <svg x-show="isSubmitting" x-cloak aria-hidden="true" class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                        <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*
        Modale de DOUBLE CONFIRMATION (docs/Volume_7_Security.md §16 — « changement de l'année scolaire
        active »). Volontairement centrée et non glissée sur le côté comme le formulaire de création :
        ce n'est pas une saisie de plus, c'est un acte qui engage tout l'établissement, et l'écran doit
        s'arrêter pour le dire.
    *@
    <div x-show="yearToActivate" x-cloak class="fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true">
        <div class="flex min-h-full items-center justify-center p-4">
            <div x-show="yearToActivate" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75" x-on:click="closeActivate()"></div>

            <div x-show="yearToActivate"
                 x-transition:enter="ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-4 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-on:keydown.escape.window="closeActivate()"
                 class="relative w-full max-w-md transform overflow-hidden rounded-xl bg-white p-6 text-left shadow-xl transition-all">

                <div class="flex items-start gap-4">
                    <div aria-hidden="true" class="mx-auto flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-orange-50">
                        <svg class="h-6 w-6 text-warning" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-base font-semibold text-gray-900">Changer l'année scolaire active</h3>
                        <p class="mt-2 text-sm text-gray-600">
                            L'établissement basculera sur
                            <span class="font-semibold text-gray-900" x-text="yearToActivate?.label"></span>.
                            Les inscriptions, les frais et les bulletins saisis à partir de maintenant s'y rattacheront.
                        </p>
                        <p x-show="activeYear()" x-cloak class="mt-2 text-sm text-gray-600">
                            <span class="font-semibold text-gray-900" x-text="activeYear()?.label"></span>
                            cessera d'être l'année active — une seule année l'est à la fois.
                        </p>
                    </div>
                </div>

                <!-- Erreur non rattachable à un champ : année terminée, réseau… -->
                <div x-show="activateErrors.global || activateErrors.id" x-cloak class="mt-4 bg-red-50 p-3 rounded-md border-l-4 border-danger">
                    <p class="text-sm text-red-700" x-text="activateErrors.global || activateErrors.id"></p>
                </div>

                <form x-on:submit.prevent="submitActivate()" class="mt-5">
                    <label for="activate-password" class="block text-sm font-medium text-gray-700">
                        Confirmez avec votre mot de passe <span class="text-danger">*</span>
                    </label>
                    @* autocomplete="current-password" : le gestionnaire de mots de passe du navigateur
                       propose le bon, sans que l'utilisateur ait à le retaper de mémoire. *@
                    <input id="activate-password" type="password" x-model="password" required
                           autocomplete="current-password"
                           x-effect="if (yearToActivate) $nextTick(() => $el.focus())"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2">
                    <p x-show="activateErrors.password" x-cloak x-text="activateErrors.password" class="mt-1 text-xs text-danger"></p>

                    <div class="mt-6 flex justify-end gap-3">
                        <button type="button" x-on:click="closeActivate()" class="rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none">
                            Annuler
                        </button>
                        <button type="submit" :disabled="isActivating" class="inline-flex justify-center items-center gap-2 rounded-md border border-transparent bg-primary py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-600 focus:outline-none disabled:opacity-50">
                            <svg x-show="isActivating" x-cloak aria-hidden="true" class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            <span x-text="isActivating ? 'Activation...' : 'Activer cette année'"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
