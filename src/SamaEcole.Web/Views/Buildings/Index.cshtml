@{
    ViewData["Title"] = "Bâtiments & Salles";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/buildings.js" asp-append-version="true"></script>
}

<div x-data="buildingsView()">

 @* ═══════════════════════════════════════════════════════════════════════════
    STICKY HEADER — En-tête fixe opaque (même convention que Classes).
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div class="sticky-sub-header">

  <div>
   <h1 class="page-title">Bâtiments &amp; Salles</h1>
   <p class="page-subtitle">Gestion physique des locaux — indépendante des classes pédagogiques.</p>
  </div>

  <div x-show="error" x-cloak class="mt-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="error"></div>

  @* KPI badges + Recherche + Action *@
  <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4 mt-4">
   <div class="flex gap-4">
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="building" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Bâtiments</span>
      <p class="text-base font-bold text-slate-900" x-text="buildings.length">0</p>
     </div>
    </div>
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="layers" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Salles</span>
      <p class="text-base font-bold text-slate-900" x-text="totalRooms">0</p>
     </div>
    </div>
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="users" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Capacité totale</span>
      <p class="text-base font-bold text-slate-900"><span x-text="totalCapacity">0</span> <span class="text-xs font-normal text-slate-400">places</span></p>
     </div>
    </div>
   </div>

   <div class="flex flex-wrap items-center gap-3">
    <div class="relative w-full sm:w-64 flex items-center">
     <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
      <icon name="search" class="w-4 h-4 text-slate-400" />
     </span>
     <input type="search" x-model="search" placeholder="Rechercher un bâtiment ou une salle…"
      aria-label="Rechercher un bâtiment ou une salle"
      class="input-field !my-0 pl-9 pr-3 w-full" />
    </div>

    <button x-show="canManage" x-cloak @@click="openCreateBuilding()" class="btn-modal-primary group h-10 px-4 ml-auto">
     <icon name="plus" class="w-5 h-5 transition-transform duration-200 group-hover:rotate-90" />
     Nouveau bâtiment
    </button>
   </div>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    LOADING SKELETON
    ═══════════════════════════════════════════════════════════════════════════ *@
 <template x-if="isLoading">
  <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
   <template x-for="i in 4" :key="i">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 space-y-4 animate-pulse">
     <div class="skeleton h-5 w-32 rounded-lg"></div>
     <div class="space-y-3">
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-full rounded-lg"></div>
     </div>
    </div>
   </template>
  </div>
 </template>

 @* ═══════════════════════════════════════════════════════════════════════════
    EMPTY STATE
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && filteredBuildings.length === 0" x-cloak class="mt-8">
  <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
   <div class="mx-auto w-16 h-16 rounded-2xl bg-primary-50 flex items-center justify-center mb-4">
    <icon name="building" class="w-8 h-8 text-primary-400" />
   </div>
   <h3 class="text-base font-semibold text-slate-700 mb-1">Aucun bâtiment n'est configuré.</h3>
   <p class="text-sm text-slate-400">Créez votre premier bâtiment pour y ajouter des salles.</p>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    GRILLE DES BÂTIMENTS — une carte par bâtiment, ses salles listées à l'intérieur.
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && filteredBuildings.length > 0" x-cloak class="mt-8 pt-4 grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
  <template x-for="building in filteredBuildings" :key="building.id">
   <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:shadow-lg overflow-hidden">

    @* En-tête du bâtiment *@
    <div class="px-6 pt-5 pb-4 border-b border-slate-100 bg-gradient-to-r from-primary-50/40 to-transparent flex items-start justify-between gap-3">
     <div class="min-w-0">
      <div class="flex items-center gap-2">
       <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-primary-100 text-primary-600 shrink-0">
        <icon name="building" class="w-3.5 h-3.5" />
       </span>
       @* Raccourci : le nom du bâtiment isole ce bâtiment et ses salles dans la grille
          (buildings.js lit ?q=). Point d'entrée réutilisable depuis d'autres écrans (un
          emplacement de salle en Inventaire, un créneau d'emploi du temps…). *@
       <a :href="`/infrastructures?q=${encodeURIComponent(building.name)}`" :title="'Isoler le bâtiment : ' + building.name"
          class="text-sm font-bold text-primary-700 truncate rounded transition-colors hover:underline focus:outline-none focus:ring-2 focus:ring-primary" x-text="building.name"></a>
      </div>
      <p x-show="building.description" class="text-xs text-slate-400 mt-1 ml-9 truncate" x-text="building.description"></p>
     </div>
     <div x-show="canManage" x-cloak class="shrink-0 flex items-center gap-1">
      <button type="button" @@click="openEditBuilding(building)" title="Modifier le bâtiment" aria-label="Modifier le bâtiment"
       class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
       <icon name="pencil" class="w-4 h-4" />
      </button>
      <button type="button" @@click="openDeleteBuilding(building)" title="Supprimer le bâtiment" aria-label="Supprimer le bâtiment"
       class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
       <icon name="trash-2" class="w-4 h-4" />
      </button>
     </div>
    </div>

    @* Liste des salles *@
    <div class="divide-y divide-slate-50 px-2 py-1">
     <template x-for="room in building.rooms" :key="room.id">
      <div class="group flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50/80 transition-all duration-200">
       <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
         <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400 shrink-0"></span>
         <span class="font-semibold text-slate-800 truncate" x-text="room.name"></span>
         <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-slate-100 text-[11px] font-medium text-slate-500 shrink-0" x-text="roomTypeLabel(room.type)"></span>
        </div>
        <p class="mt-1 text-[11px] font-medium text-slate-400 tabular-nums">
         <span x-text="room.capacity"></span> places
        </p>
       </div>
       <div x-show="canManage" x-cloak class="shrink-0 flex items-center gap-1">
        <button type="button" @@click="openEditRoom(room)" title="Modifier la salle" aria-label="Modifier la salle"
         class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
         <icon name="pencil" class="w-4 h-4" />
        </button>
        <button type="button" @@click="openDeleteRoom(room)" title="Supprimer la salle" aria-label="Supprimer la salle"
         class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
         <icon name="trash-2" class="w-4 h-4" />
        </button>
       </div>
      </div>
     </template>

     <p x-show="building.rooms.length === 0" x-cloak class="py-6 text-center text-xs text-slate-400">
      Aucune salle dans ce bâtiment.
     </p>
    </div>

    <div x-show="canManage" x-cloak class="px-4 pb-4 pt-1">
     <button type="button" @@click="openCreateRoom(building)" class="btn-modal-secondary w-full text-sm justify-center group">
      <icon name="plus" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-90" />
      Ajouter une salle
     </button>
    </div>
   </div>
  </template>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    MODALES — Bâtiments
    ═══════════════════════════════════════════════════════════════════════════ *@

 <modal-shell size="lg" open="isCreateBuildingOpen" on-close="closeCreateBuilding()" title="Nouveau bâtiment">
  <modal-subtitle>Nom et description du bâtiment physique.</modal-subtitle>
  <div x-show="createBuildingErrors.global" x-cloak class="form-error-banner" x-text="createBuildingErrors.global"></div>
  <form x-on:submit.prevent="submitCreateBuilding()" novalidate class="space-y-4">
   <div>
    <label class="form-label form-label-required">Nom du bâtiment</label>
    <input type="text" x-model="newBuilding.name" required placeholder="ex: Bâtiment A" class="input-field" :class="createBuildingErrors.name && 'input-field-error'">
    <p x-show="createBuildingErrors.name" x-text="createBuildingErrors.name" class="field-error"></p>
   </div>
   <div>
    <label class="form-label">Description</label>
    <textarea x-model="newBuilding.description" rows="3" placeholder="ex: Bâtiment principal, 2 étages" class="input-field"></textarea>
    <p x-show="createBuildingErrors.description" x-text="createBuildingErrors.description" class="field-error"></p>
   </div>
   <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
    <button type="button" @@click="closeCreateBuilding()" class="btn-modal-secondary group">Annuler</button>
    <button type="submit" :disabled="isSavingBuilding" class="btn-modal-primary group">
     <span x-text="isSavingBuilding ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 <modal-shell size="lg" open="editingBuilding" on-close="closeEditBuilding()" title="Modifier le bâtiment">
  <modal-subtitle><span x-text="editingBuilding ? editingBuilding.name : ''"></span></modal-subtitle>
  <div x-show="editBuildingErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="editBuildingErrors.global"></div>
  @* Formulaire MONTÉ seulement quand editingBuilding n'est pas null : `x-model` ne peut pas s'écrire
     avec un accès optionnel (`a?.b = x` est une erreur de syntaxe JS), donc seul `x-if` protège une
     liaison bidirectionnelle. Le panneau lui-même continue de s'animer normalement : ses transitions
     portent sur `Open` (modal-shell), jamais sur `editingBuilding` — closeEditBuilding() remet les
     deux à zéro dans le même tick, le formulaire disparaît donc avec le panneau, pas avant lui. *@
  <template x-if="editingBuilding">
  <form x-on:submit.prevent="submitEditBuilding()" novalidate class="space-y-4">
   <div>
    <label class="form-label form-label-required">Nom du bâtiment</label>
    <input type="text" x-model="editingBuilding.name" required maxlength="100" class="input-field" :class="editBuildingErrors.name && 'input-field-error'">
    <p x-show="editBuildingErrors.name" x-cloak x-text="editBuildingErrors.name" class="field-error"></p>
   </div>
   <div>
    <label class="form-label">Description</label>
    <textarea x-model="editingBuilding.description" rows="3" class="input-field"></textarea>
    <p x-show="editBuildingErrors.description" x-cloak x-text="editBuildingErrors.description" class="field-error"></p>
   </div>
   <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
    <button type="button" x-on:click="closeEditBuilding()" class="btn-modal-secondary group">Annuler</button>
    <button type="submit" :disabled="isSavingEditBuilding" class="btn-modal-primary group">
     <span x-text="isSavingEditBuilding ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
  </template>
 </modal-shell>

 <modal-shell open="deletingBuilding" on-close="closeDeleteBuilding()" size="md">
  <modal-title>Supprimer le bâtiment</modal-title>
  <modal-subtitle>
   <span class="font-semibold text-slate-900" x-text="deletingBuilding ? deletingBuilding.name : ''"></span>
   sera archivé et n'apparaîtra plus dans les sélecteurs.
  </modal-subtitle>
  <div x-show="deleteBuildingError" x-cloak class="form-error-banner" x-text="deleteBuildingError"></div>
  <p class="text-base font-medium leading-relaxed text-slate-700">
   Impossible si des salles sont encore rattachées à ce bâtiment : supprimez-les d'abord.
  </p>
  <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
   <button type="button" x-on:click="closeDeleteBuilding()" class="btn-modal-secondary group">Annuler</button>
   <button type="button" x-on:click="confirmDeleteBuilding()" :disabled="isDeletingBuilding" class="btn-modal-danger">
    <span x-text="isDeletingBuilding ? 'Suppression...' : 'Supprimer le bâtiment'"></span>
   </button>
  </div>
 </modal-shell>

 @* ═══════════════════════════════════════════════════════════════════════════
    MODALES — Salles
    ═══════════════════════════════════════════════════════════════════════════ *@

 <modal-shell size="lg" open="isCreateRoomOpen" on-close="closeCreateRoom()" title="Nouvelle salle">
  <modal-subtitle>Configurez une nouvelle salle et sa capacité physique.</modal-subtitle>
  <div x-show="createRoomErrors.global" x-cloak class="form-error-banner" x-text="createRoomErrors.global"></div>
  <form x-on:submit.prevent="submitCreateRoom()" novalidate class="space-y-4">
   <div>
    <label class="form-label form-label-required">Nom de la salle</label>
    <input type="text" x-model="newRoom.name" required placeholder="ex: Salle 101" class="input-field" :class="createRoomErrors.name && 'input-field-error'">
    <p x-show="createRoomErrors.name" x-text="createRoomErrors.name" class="field-error"></p>
   </div>
   <div>
    <label class="form-label form-label-required">Type de salle</label>
    <select-field model="newRoom.type" required="true" aria-label="Type de salle"
     options-expr="[{value:'SalleDeClasse', label:'Salle de classe'},{value:'Laboratoire', label:'Laboratoire'},{value:'Bureau', label:'Bureau'},{value:'Autre', label:'Autre'}]" />
    <p x-show="createRoomErrors.type" x-text="createRoomErrors.type" class="field-error"></p>
   </div>
   <div>
    <label class="form-label form-label-required">Capacité (places physiques)</label>
    <input type="number" x-model.number="newRoom.capacity" required min="1" max="1000" class="input-field" :class="createRoomErrors.capacity && 'input-field-error'">
    <p x-show="createRoomErrors.capacity" x-text="createRoomErrors.capacity" class="field-error"></p>
   </div>
   <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
    <button type="button" @@click="closeCreateRoom()" class="btn-modal-secondary group">Annuler</button>
    <button type="submit" :disabled="isSavingRoom" class="btn-modal-primary group">
     <span x-text="isSavingRoom ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 <modal-shell size="lg" open="editingRoom" on-close="closeEditRoom()" title="Modifier la salle">
  <modal-subtitle><span x-text="editingRoom ? editingRoom.name : ''"></span></modal-subtitle>
  <div x-show="editRoomErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="editRoomErrors.global"></div>
  @* Formulaire MONTÉ seulement quand editingRoom n'est pas null — même raison et même garantie
     d'animation que le formulaire « Modifier le bâtiment » ci-dessus. *@
  <template x-if="editingRoom">
  <form x-on:submit.prevent="submitEditRoom()" novalidate class="space-y-4">
   <div>
    <label class="form-label form-label-required">Nom de la salle</label>
    <input type="text" x-model="editingRoom.name" required maxlength="100" class="input-field" :class="editRoomErrors.name && 'input-field-error'">
    <p x-show="editRoomErrors.name" x-cloak x-text="editRoomErrors.name" class="field-error"></p>
   </div>
   <div>
    <label class="form-label form-label-required">Type de salle</label>
    <select-field model="editingRoom.type" required="true" aria-label="Type de salle"
     options-expr="[{value:'SalleDeClasse', label:'Salle de classe'},{value:'Laboratoire', label:'Laboratoire'},{value:'Bureau', label:'Bureau'},{value:'Autre', label:'Autre'}]" />
    <p x-show="editRoomErrors.type" x-cloak x-text="editRoomErrors.type" class="field-error"></p>
   </div>
   <div>
    <label class="form-label form-label-required">Capacité (places physiques)</label>
    <input type="number" x-model.number="editingRoom.capacity" required min="1" max="1000" class="input-field" :class="editRoomErrors.capacity && 'input-field-error'">
    <p x-show="editRoomErrors.capacity" x-cloak x-text="editRoomErrors.capacity" class="field-error"></p>
   </div>
   <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
    <button type="button" x-on:click="closeEditRoom()" class="btn-modal-secondary group">Annuler</button>
    <button type="submit" :disabled="isSavingEditRoom" class="btn-modal-primary group">
     <span x-text="isSavingEditRoom ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
  </template>
 </modal-shell>

 <modal-shell open="deletingRoom" on-close="closeDeleteRoom()" size="md">
  <modal-title>Supprimer la salle</modal-title>
  <modal-subtitle>
   <span class="font-semibold text-slate-900" x-text="deletingRoom ? deletingRoom.name : ''"></span>
   sera archivée et n'apparaîtra plus dans la liste.
  </modal-subtitle>
  <div x-show="deleteRoomError" x-cloak class="form-error-banner" x-text="deleteRoomError"></div>
  <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
   <button type="button" x-on:click="closeDeleteRoom()" class="btn-modal-secondary group">Annuler</button>
   <button type="button" x-on:click="confirmDeleteRoom()" :disabled="isDeletingRoom" class="btn-modal-danger">
    <span x-text="isDeletingRoom ? 'Suppression...' : 'Supprimer la salle'"></span>
   </button>
  </div>
 </modal-shell>
</div>
