@* Conformité de l'emploi du temps d'une classe (Évolution N°7) — vue « Par classe », Directeur et Secrétariat.
   Composant imbriqué dans teachersView : x-effect lui passe la classe choisie et la grille de créneaux, il se
   recharge quand l'une ou l'autre change. Chiffres et statuts : GET /api/v1/hour-volumes/compliance. *@
<div x-data="timetableCompliance()" x-effect="sync(scheduleViewMode === 'classroom' ? selectedScheduleClassroomId : '', scheduleSlots)"
     x-show="visible && classroomId" x-cloak class="card mt-4 p-4 space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="text-sm font-semibold text-slate-800">Conformité aux volumes horaires</p>
            <p class="text-xs text-slate-500" x-show="classCompliance" x-cloak>
                Niveau <span x-text="classCompliance && classCompliance.gradeLevel ? classCompliance.gradeLevel : 'non reconnu'"></span><span x-show="classCompliance && classCompliance.series"> · série <span x-text="classCompliance && classCompliance.series"></span></span>
                — volumes réglables dans <a href="/programmes?tab=hours" class="font-medium text-primary-600 hover:underline">Programmes › Volumes horaires</a>.
            </p>
        </div>
        <template x-if="classCompliance">
            <div class="flex items-center gap-2 text-sm">
                <span class="text-slate-500">Total :</span>
                <span class="font-semibold text-slate-800" x-text="formatHours(classCompliance.totals.plannedHours)"></span>
                <span class="text-slate-400">/</span>
                <span class="text-slate-600" x-text="formatHours(classCompliance.totals.normHours)"></span>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset"
                      :class="statusClass(classCompliance.totals.status)" x-text="statusLabel(classCompliance.totals.status)"></span>
            </div>
        </template>
    </div>

    <div x-show="error" x-cloak class="form-error-banner" x-text="error"></div>
    <div x-show="isLoading && !classCompliance" x-cloak class="skeleton h-4 w-1/2"></div>

    <template x-if="classCompliance">
        <div class="space-y-4">
            <div x-show="classCompliance.subjects.length === 0" class="text-sm text-slate-500">
                Aucun volume de référence n'est connu pour ce niveau et aucune matière n'y est planifiée.
            </div>

            <div x-show="classCompliance.subjects.length > 0" class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="table-head">
                            <th class="py-2 px-3 text-left">Matière</th>
                            <th class="py-2 px-3 text-right">Planifié</th>
                            <th class="py-2 px-3 text-right">Référence</th>
                            <th class="py-2 px-3 text-right">Écart</th>
                            <th class="py-2 px-3 text-left">Statut</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <template x-for="s in classCompliance.subjects" :key="(s.subjectId || '') + s.subjectName">
                            <tr>
                                <td class="py-2 px-3 text-slate-800">
                                    <span x-text="s.subjectName"></span>
                                    <span x-show="s.optionGroup" x-cloak class="ml-1 text-xs text-slate-400" x-text="'(' + s.optionGroup + ')'"></span>
                                </td>
                                <td class="py-2 px-3 text-right text-slate-700" x-text="formatHours(s.plannedHours)"></td>
                                <td class="py-2 px-3 text-right text-slate-500" x-text="formatHours(s.normHours)"></td>
                                <td class="py-2 px-3 text-right font-medium"
                                    :class="s.status === 'Under' ? 'text-amber-700' : (s.status === 'Over' ? 'text-red-700' : 'text-slate-500')"
                                    x-text="formatDifference(s.difference)"></td>
                                <td class="py-2 px-3">
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset"
                                          :class="statusClass(s.status)" x-text="statusLabel(s.status)"></span>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>

            <div class="rounded-xl border p-3" :class="conflicts.length ? 'border-red-200 bg-red-50/60' : 'border-emerald-200 bg-emerald-50/60'">
                <div class="flex items-center justify-between gap-3">
                    <p class="text-sm font-medium" :class="conflicts.length ? 'text-red-800' : 'text-emerald-800'"
                       x-text="conflicts.length ? conflicts.length + ' chevauchement(s) touchent cette classe (enseignant, salle ou classe).' : 'Aucun chevauchement d\'enseignant, de salle ou de classe.'"></p>
                    <button type="button" x-show="conflicts.length" x-cloak x-on:click="showConflicts = !showConflicts"
                            class="text-xs font-medium text-red-700 hover:underline" x-text="showConflicts ? 'Masquer' : 'Voir le détail'"></button>
                </div>
                <ul x-show="showConflicts && conflicts.length" x-cloak class="mt-2 space-y-1 text-xs text-red-800">
                    <template x-for="(c, i) in conflicts" :key="i">
                        <li>
                            <span class="font-semibold" x-text="conflictLabel(c.kind) + ' « ' + c.resource + ' » — ' + dayLabel(c.dayOfWeek) + ' :'"></span>
                            <span x-text="slotLabel(c.first) + ' et ' + slotLabel(c.second)"></span>
                        </li>
                    </template>
                </ul>
            </div>
        </div>
    </template>
</div>
