@{
 ViewData["Title"] = "Enseignants";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/photo-compress.js" asp-append-version="true"></script>
 <script src="~/js/teachers.js" asp-append-version="true"></script>
}

<div x-data="teachersView()">
 <div class="flex items-start justify-between gap-4">
 <div>
 <h1 class="page-title">Enseignants</h1>
 <p class="page-subtitle">Fiches du personnel enseignant, matières qualifiées et affectations.</p>
 </div>
 </div>

 <!-- Navigation principale : Liste vs Emploi du Temps -->
 <div class="mt-6 flex bg-slate-100 p-1 rounded-xl w-fit">
    <button type="button" x-on:click="activeTab = 'teachers'" 
            :class="activeTab === 'teachers' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'"
            class="px-3 py-1.5 text-sm rounded-lg"
            :aria-selected="activeTab === 'teachers'">
        Liste des Enseignants
    </button>
    <button type="button" x-on:click="activeTab = 'schedule'" 
            :class="activeTab === 'schedule' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'"
            class="px-3 py-1.5 text-sm rounded-lg"
            :aria-selected="activeTab === 'schedule'">
        Emploi du Temps
    </button>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- ONGLET 1: Liste des Enseignants -->
 <div x-show="activeTab === 'teachers'" x-cloak>
     <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
     <stat-card label="Total enseignants" icon="users" accent="primary">
     <span x-text="totalCount">0</span>
     </stat-card>
     </div>

     <div class="card mt-6 relative">
 <div class="filter-bar lg:items-center lg:justify-between">
 <div class="flex flex-wrap items-center gap-3">
 <div class="relative">
 <span class="absolute inset-y-0 left-0 flex items-center pl-3">
 <icon name="search" class="w-4 h-4 text-slate-400" />
 </span>
 <input type="text" x-model="search" x-on:input.debounce.400ms="applyFilters()"
 placeholder="Nom, matricule ou e-mail..." aria-label="Rechercher un enseignant"
 class="input-field mt-0 pl-9 pr-3 w-full sm:w-72" />
 </div>
 <button type="button" x-on:click="resetFilters()" class="text-sm font-medium text-slate-500 hover:text-slate-900">
 Réinitialiser
 </button>
 </div>

 <div class="flex items-center gap-3">
 <!-- Export PDF (docs/Volume_7_Security.md « Enseignants ») : Super Admin, Directeur, Secrétariat. -->
 <button type="button" x-show="canExportTeachers" x-cloak x-on:click="exportTeachersPdf()" class="btn-modal-secondary group">
 <icon name="document-text" class="w-4 h-4" />
 Exporter en PDF
 </button>
 <button type="button" x-show="canManage" x-cloak x-on:click="openImport()" class="btn-modal-secondary group">
 <icon name="upload" class="w-4 h-4" />
 Importer des enseignants
 </button>
 <button type="button" x-show="canManage" x-cloak x-on:click="openCreate()" class="btn-modal-primary group">
 <icon name="plus" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-90" />
 Ajouter un enseignant
 </button>
 </div>
 </div>

 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head">
 <th class="py-3 px-4">Matricule</th>
 <th class="py-3 px-4">Enseignant</th>
 <th class="py-3 px-4">Téléphone</th>
 <th class="py-3 px-4">Matières</th>
 <th class="py-3 px-4">Statut</th>
 <th class="py-3 px-4 w-16 text-right">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-if="isLoading">
 <template x-for="i in 5" :key="i">
 <tr class="hover:bg-slate-50 transition-colors duration-150"><td class="py-3 px-4" colspan="6"><div class="skeleton h-4 w-full"></div></td></tr>
 </template>
 </template>

 <tr class="hover:bg-slate-50 transition-colors duration-150" x-show="!isLoading && teachers.length === 0" x-cloak>
 <td colspan="6">
 <empty-state icon="users" title="Aucun enseignant trouvé."
 hint="Ajustez la recherche, ou ajoutez une fiche enseignant." />
 </td>
 </tr>

 <template x-for="teacher in teachers" :key="teacher.id">
 <tr class="hover:bg-slate-50 transition-colors duration-150">
 <td class="py-3 px-4 font-mono text-xs text-slate-500" x-text="teacher.matricule"></td>
 <td class="py-3 px-4">
 <div class="flex items-center gap-3">
 <img x-show="teacher.photoDisplayUrl" :src="teacher.photoDisplayUrl" alt=""
 class="w-8 h-8 rounded-full object-cover shrink-0" x-cloak>
 <div x-show="!teacher.photoDisplayUrl" class="w-8 h-8 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xs shrink-0" x-text="initials(teacher.fullName)"></div>
 <div>
 <p class="font-medium text-slate-900" x-text="teacher.fullName"></p>
 <p class="text-xs text-slate-500" x-text="teacher.email"></p>
 </div>
 </div>
 </td>
 <td class="py-3 px-4 text-slate-500" x-text="$phone(teacher.phone)"></td>
 <td class="py-3 px-4">
 <div class="flex flex-wrap gap-1">
 <template x-for="s in teacher.subjects" :key="s">
 <span class="inline-flex items-center px-2 py-0.5 rounded-xl text-xs font-medium bg-primary-50 text-primary" x-text="s"></span>
 </template>
 <span x-show="!teacher.subjects || teacher.subjects.length === 0" class="text-slate-400 text-xs">—</span>
 </div>
 </td>
 <td class="py-3 px-4">
 <span class="inline-flex items-center px-2 py-0.5 rounded-xl text-xs font-medium"
 :class="statusClass(teacher.status)" x-text="statusLabel(teacher.status)"></span>
 </td>
 <td class="py-3 px-4 text-right">
 <button type="button" x-on:click="openDetail(teacher)" title="Voir la fiche" aria-label="Voir la fiche"
 class="p-1.5 text-slate-400 hover:text-primary rounded-xl focus:outline-none focus:ring-2 focus:ring-primary transition-colors">
 <icon name="eye" class="w-5 h-5" />
 </button>
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>

 <pagination page="page" page-size="pageSize" total="totalCount" on-change="loadTeachers()" />
 </div>

 <!-- Fiche enseignant : infos + matières + affectations (historique) + attribution (Directeur/Secrétariat) -->
 <modal-shell open="detail" on-close="closeDetail()" title="Fiche enseignant" size="wide">
 <template x-if="detail">
 <div>
 <div class="flex items-center gap-5 pb-6 border-b border-slate-100">
 <img x-show="detail.photoDisplayUrl" :src="detail.photoDisplayUrl" alt=""
 class="w-16 h-16 rounded-full ring-4 ring-indigo-50 shadow-md object-cover flex-shrink-0" x-cloak>
 <div x-show="!detail.photoDisplayUrl" class="w-16 h-16 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xl flex-shrink-0 shadow-md ring-4 ring-indigo-50" x-text="initials(detail.fullName)"></div>
 <div>
 <p class="text-2xl font-bold text-slate-900" x-text="detail.fullName"></p>
 <div class="flex items-center gap-2 mt-1.5">
 <span class="bg-indigo-50 text-indigo-700 font-medium px-2.5 py-0.5 text-xs rounded-full font-mono" x-text="detail.matricule"></span>
 <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold" :class="statusClass(detail.status)" x-text="statusLabel(detail.status)"></span>
 </div>
 </div>
 </div>

 <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6">
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">E-mail</dt>
 <dd class="mt-1 text-base font-medium text-slate-900" x-text="detail.email"></dd>
 </div>
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Téléphone</dt>
 <dd class="mt-1 flex items-center gap-2">
 <span class="text-base font-bold text-slate-900 font-mono" x-text="$phone(detail.phone)"></span>
 <a x-show="detail.phone" :href="'tel:' + detail.phone" class="bg-emerald-100 text-emerald-700 hover:bg-emerald-200 p-1.5 rounded-lg transition-all" title="Appeler">
 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
 </a>
 </dd>
 </div>
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Date de naissance</dt>
 <dd class="mt-1 text-base font-medium text-slate-900" x-text="formatDate(detail.birthDate)"></dd>
 </div>
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Lieu de naissance</dt>
 <dd class="mt-1 text-base font-medium text-slate-900" x-text="detail.birthPlace || '—'"></dd>
 </div>
 <div class="sm:col-span-2 lg:col-span-4">
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Adresse de résidence</dt>
 <dd class="mt-1 text-base font-medium text-slate-900" x-text="detail.address || '—'"></dd>
 </div>
 </dl>

 <div class="mt-6">
 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Matières qualifiées</p>
 <div class="flex flex-wrap gap-1.5">
 <template x-for="s in detail.subjects" :key="s">
 <span class="inline-flex items-center px-2.5 py-0.5 rounded-xl text-xs font-medium bg-primary-50 text-primary" x-text="s"></span>
 </template>
 <span x-show="!detail.subjects || detail.subjects.length === 0" class="text-slate-400 text-sm">Aucune matière.</span>
 </div>
 </div>

 <!-- Affectations classe/matière, groupées par année scolaire (historique) -->
 <div class="mt-6">
 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Affectations</p>
 <div x-show="assignmentsByYear().length === 0" class="text-slate-400 text-sm">Aucune affectation.</div>
 <template x-for="group in assignmentsByYear()" :key="group.label">
 <div class="mb-4">
 <div class="flex items-center gap-2 mb-1.5">
 <span class="text-sm font-semibold text-slate-700" x-text="group.label"></span>
 <span x-show="group.isActive" class="inline-flex items-center px-2 py-0.5 rounded-xl text-[10px] font-bold bg-success-bg text-success">Active</span>
 </div>
 <ul class="space-y-1">
 <template x-for="a in group.items" :key="a.id">
 <li class="text-sm text-slate-600 flex items-center justify-between group/assign hover:bg-slate-50 p-1 -ml-1 rounded transition-colors">
 <div class="flex items-center gap-2">
 <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
 <span x-text="a.classroomName"></span>
 <span class="text-slate-300">·</span>
 <span x-text="a.subjectName"></span>
 </div>
 <button type="button" x-show="canManage" x-cloak @@click.stop="openDeleteAssignment(a.id)" class="opacity-30 group-hover/assign:opacity-100 text-danger hover:text-red-700 p-1 rounded transition-opacity" title="Retirer cette affectation">
 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
 </button>
 </li>
 </template>
 </ul>
 </div>
 </template>
 </div>

 <!-- Attribution d'une classe/matière (année active) — Directeur/Secrétariat -->
 <div class="mt-6 bg-slate-50 rounded-2xl p-6 sm:p-5" x-show="canManage" x-cloak>
 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">Attribuer une classe / matière (année active)</p>
 @* Bandeau d'explication, et non d'alarme. Le message qui arrive ici fait deux ou trois phrases
 (voir UniqueConstraintCatalog et AssignTeacherCommandHandler) : il dit ce qui s'est passé,
 pourquoi c'est refusé et quoi faire. L'ancien gabarit — une ligne serrée en p-2.5, sans titre
 ni repère visuel — était calibré pour six mots ; un paragraphe s'y écrasait en un bloc rouge
 illisible. Icône et intertitre donnent le point d'entrée, `leading-relaxed` rend le paragraphe
 lisible, et le rouge reste cantonné aux accents plutôt que d'inonder le bloc. *@
 <div x-show="assignError" x-cloak role="alert"
 class="mb-3 flex items-start gap-3 rounded-xl border border-rose-200/70 bg-rose-50/70 p-4">
 <span class="icon-chip-sm icon-chip-rose mt-0.5">
 <icon name="alert-circle" class="w-4 h-4" />
 </span>
 <div class="min-w-0">
 <p class="text-sm font-semibold text-rose-900">Affectation impossible</p>
 <p class="mt-1 text-sm leading-relaxed text-rose-800" x-text="assignError"></p>
 </div>
 </div>
 <div x-show="assignSuccess" x-cloak role="status"
 class="mb-3 flex items-center gap-3 rounded-xl border border-emerald-200/70 bg-emerald-50/70 p-4">
 <span class="icon-chip-sm icon-chip-emerald">
 <icon name="checkmark-circle" class="w-4 h-4" />
 </span>
 <p class="text-sm font-medium text-emerald-900">Affectation enregistrée.</p>
 </div>
 <form x-on:submit.prevent="submitAssign()" novalidate class="flex flex-col sm:flex-row sm:items-end gap-3">
 <div class="flex-1">
 <label class="form-label-sm">Classe</label>
 <select-field model="assignForm.classroomId" required="true" class="mt-0" placeholder="Choisir…"
 options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" />
 </div>
 <div class="flex-1">
 <label class="form-label-sm">Matière</label>
 <select-field model="assignForm.subjectId" required="true" class="mt-0" placeholder="Choisir…"
 options-expr="subjects.map(s => ({value: s.id, label: s.name + ' (' + s.level + ')'}))" />
 </div>
 <button type="submit" :disabled="assignSubmitting" class="btn-modal-primary whitespace-nowrap group">
 <span x-text="assignSubmitting ? '…' : 'Attribuer'"></span>
 </button>
 </form>
 </div>

 <div class="mt-8 flex flex-col-reverse sm:flex-row sm:justify-between gap-3 border-t border-slate-200 pt-4">
 <template x-if="canManage">
 <div class="flex gap-2">
 <button type="button" x-on:click="openEditTeacher()" class="btn-modal-secondary group">
 Modifier la fiche
 </button>
 <button type="button" x-on:click="openDeleteTeacher()" class="text-sm font-medium text-danger bg-danger-bg hover:bg-red-100 px-5 py-2.5 rounded-xl transition-colors">
 Supprimer
 </button>
 </div>
 </template>
 <button type="button" x-on:click="closeDetail()" class="btn-modal-secondary sm:ml-auto group">Fermer</button>
 </div>
 </div>
 </template>
 </modal-shell>

 <!-- Modification de la fiche enseignant : matricule et compte de connexion non modifiables ici. -->
 <modal-shell size="60" open="editingTeacher" on-close="closeEditTeacher()" title="Modifier la fiche">
 <modal-subtitle>Le matricule reste celui déjà attribué : il n'est jamais modifiable.</modal-subtitle>

 <div x-show="teacherEditErrors.global" x-cloak class="form-error-banner" x-text="teacherEditErrors.global"></div>

 <form x-on:submit.prevent="submitEditTeacher()" novalidate class="space-y-4">
 <div>
 <label class="form-label form-label-required">Nom complet</label>
 <input type="text" x-model="editingTeacher.fullName" required class="input-field" :class="teacherEditErrors.fullname && 'input-field-error'">
 <p x-show="teacherEditErrors.fullname" x-text="teacherEditErrors.fullname" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">E-mail</label>
 <input type="email" x-model="editingTeacher.email" required class="input-field" :class="teacherEditErrors.email && 'input-field-error'">
 <p x-show="teacherEditErrors.email" x-text="teacherEditErrors.email" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Téléphone</label>
 <input type="text" x-model="editingTeacher.phone" class="input-field" :class="teacherEditErrors.phone && 'input-field-error'">
 <p x-show="teacherEditErrors.phone" x-text="teacherEditErrors.phone" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">Date de naissance</label>
 <date-field model="editingTeacher.birthDate" required="true" aria-label="Date de naissance" />
 <p x-show="teacherEditErrors.birthdate" x-text="teacherEditErrors.birthdate" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Lieu de naissance</label>
 <input type="text" x-model="editingTeacher.birthPlace" class="input-field" :class="teacherEditErrors.birthplace && 'input-field-error'">
 <p x-show="teacherEditErrors.birthplace" x-text="teacherEditErrors.birthplace" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Adresse de résidence</label>
 <input type="text" x-model="editingTeacher.address" maxlength="300" class="input-field" :class="teacherEditErrors.address && 'input-field-error'">
 <p x-show="teacherEditErrors.address" x-text="teacherEditErrors.address" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Photo</label>
 <photo-dropzone preview="editingTeacher.photoDisplayUrl"
 on-change="uploadTeacherPhoto(photoBase64)" />
 <p x-show="photoUploadError" x-cloak x-text="photoUploadError" class="field-error"></p>
 <div class="mt-3">
 <label class="form-label-sm">…ou une URL externe (utilisée seulement si aucune photo n'est déposée ci-dessus)</label>
 <input type="text" x-model="editingTeacher.photoUrl" placeholder="https://…" class="input-field mt-1">
 </div>
 <p x-show="teacherEditErrors.photourl" x-text="teacherEditErrors.photourl" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">Matières enseignées</label>
 <p class="text-xs text-slate-500 mb-2">Sélectionnez au moins une matière qualifiée.</p>
 <div class="max-h-40 overflow-y-auto rounded-xl border border-slate-200 divide-y divide-slate-100">
 <template x-for="s in subjects" :key="s.id">
 <label class="flex items-center gap-2 px-3 py-2 hover:bg-slate-50 cursor-pointer transition-all duration-200 ease-in-out">
 <input type="checkbox" :value="s.id" x-model="editingTeacher.subjectIds" class="checkbox-field">
 <span class="text-sm text-slate-700" x-text="s.name + ' (' + s.level + ')'"></span>
 </label>
 </template>
 </div>
 <p x-show="teacherEditErrors.subjectids" x-text="teacherEditErrors.subjectids" class="field-error"></p>
 </div>

 <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
 <button type="button" x-on:click="closeEditTeacher()" class="btn-modal-secondary group">Annuler</button>
 <button type="submit" :disabled="isSavingTeacherEdit" class="btn-modal-primary group">
 <span x-text="isSavingTeacherEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : fiche modifiée -->
 <modal-shell open="showTeacherEditedDialog" size="md" on-close="showTeacherEditedDialog = false" title="Fiche modifiée">
 <confirm-dialog-body close-action="showTeacherEditedDialog = false">
 La fiche a bien été mise à jour.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Confirmation : suppression d'une affectation (classe/matière) -->
 <modal-shell open="deletingAssignmentId" on-close="closeDeleteAssignment()" size="md">
 <modal-title>Retirer l'affectation</modal-title>
 <modal-subtitle>
 Êtes-vous sûr de vouloir retirer cette classe et cette matière pour l'enseignant ?
 </modal-subtitle>

 <div x-show="deleteAssignmentError" x-cloak class="form-error-banner" x-text="deleteAssignmentError"></div>

 <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
 <button type="button" x-on:click="closeDeleteAssignment()" class="btn-modal-secondary group">Annuler</button>
 <button type="button" x-on:click="confirmDeleteAssignment()" :disabled="isDeletingAssignment" class="btn-modal-danger">
 <span x-text="isDeletingAssignment ? 'Suppression...' : 'Retirer l\'affectation'"></span>
 </button>
 </div>
 </modal-shell>

 <!-- Confirmation : suppression de la fiche enseignant -->
 <modal-shell open="deletingTeacherRecord" on-close="closeDeleteTeacher()" size="md">
 <modal-title>Supprimer la fiche</modal-title>
 <modal-subtitle>
 <span class="font-semibold text-slate-900" x-text="deletingTeacherRecord ? deletingTeacherRecord.fullName : ''"></span>
 sera archivée et n'apparaîtra plus dans la liste des enseignants.
 </modal-subtitle>

 <div x-show="deleteTeacherRecordError" x-cloak class="form-error-banner" x-text="deleteTeacherRecordError"></div>

 <p class="text-sm text-slate-500">
 Réservé à une fiche créée par pure erreur de saisie : impossible si une attribution classe/matière existe déjà pour cet enseignant.
 </p>

 <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
 <button type="button" x-on:click="closeDeleteTeacher()" class="btn-modal-secondary group">Annuler</button>
 <button type="button" x-on:click="confirmDeleteTeacher()" :disabled="isDeletingTeacherRecord" class="btn-modal-danger">
 <span x-text="isDeletingTeacherRecord ? 'Suppression...' : 'Supprimer la fiche'"></span>
 </button>
 </div>
 </modal-shell>

 <!-- Confirmation : suppression d'une fiche enseignant -->
 <modal-shell open="showTeacherDeletedDialog" size="md" on-close="showTeacherDeletedDialog = false" title="Fiche supprimée">
 <confirm-dialog-body close-action="showTeacherDeletedDialog = false">
 La fiche a bien été supprimée.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Création d'une fiche enseignant (JGK-D03) -->
 <modal-shell size="60" open="isCreateOpen" title="Ajouter un enseignant">
 <modal-subtitle>Le matricule sera généré automatiquement à l'enregistrement.</modal-subtitle>

 <div x-show="createErrors.global" x-cloak class="form-error-banner" x-text="createErrors.global"></div>

 <form x-on:submit.prevent="submitCreate()" novalidate class="space-y-4">
 <div>
 <label class="form-label form-label-required">Nom complet</label>
 <input type="text" x-model="newTeacher.fullName" required class="input-field" :class="createErrors.fullname && 'input-field-error'">
 <p x-show="createErrors.fullname" x-text="createErrors.fullname" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">E-mail</label>
 <input type="email" x-model="newTeacher.email" required class="input-field" :class="createErrors.email && 'input-field-error'">
 <p x-show="createErrors.email" x-text="createErrors.email" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Téléphone</label>
 <input type="text" x-model="newTeacher.phone" class="input-field" :class="createErrors.phone && 'input-field-error'">
 <p x-show="createErrors.phone" x-text="createErrors.phone" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">Date de naissance</label>
 <date-field model="newTeacher.birthDate" required="true" aria-label="Date de naissance" />
 <p x-show="createErrors.birthdate" x-text="createErrors.birthdate" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Lieu de naissance</label>
 <input type="text" x-model="newTeacher.birthPlace" class="input-field" :class="createErrors.birthplace && 'input-field-error'">
 <p x-show="createErrors.birthplace" x-text="createErrors.birthplace" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Adresse de résidence</label>
 <input type="text" x-model="newTeacher.address" maxlength="300" class="input-field" :class="createErrors.address && 'input-field-error'">
 <p x-show="createErrors.address" x-text="createErrors.address" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Photo</label>
 <photo-dropzone preview="newTeacher.photoData ? ('data:image/jpeg;base64,' + newTeacher.photoData) : newTeacher.photoUrl"
 on-change="newTeacher.photoData = photoBase64" />
 <div class="mt-3">
 <label class="form-label-sm">…ou une URL externe (utilisée seulement si aucune photo n'est déposée ci-dessus)</label>
 <input type="text" x-model="newTeacher.photoUrl" placeholder="https://…" class="input-field mt-1">
 </div>
 <p x-show="createErrors.photourl" x-text="createErrors.photourl" class="field-error"></p>
 <p x-show="createErrors.photodata" x-text="createErrors.photodata" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">Matières enseignées</label>
 <p class="text-xs text-slate-500 mb-2">Sélectionnez au moins une matière qualifiée.</p>
 <div class="max-h-40 overflow-y-auto rounded-xl border border-slate-200 divide-y divide-slate-100">
 <template x-for="s in subjects" :key="s.id">
 <label class="flex items-center gap-2 px-3 py-2 hover:bg-slate-50 cursor-pointer transition-all duration-200 ease-in-out">
 <input type="checkbox" :value="s.id" x-model="newTeacher.subjectIds" class="checkbox-field">
 <span class="text-sm text-slate-700" x-text="s.name + ' (' + s.level + ')'"></span>
 </label>
 </template>
 <p x-show="subjects.length === 0" class="px-3 py-2 text-sm text-slate-400">Aucune matière : créez-en d'abord dans « Matières ».</p>
 </div>
 <p x-show="createErrors.subjectids" x-text="createErrors.subjectids" class="field-error"></p>
 </div>

 <!-- Rattachement d'un compte de connexion (Directeur uniquement) : permet à l'enseignant de
 faire l'appel de ses classes (JGK-D06). Optionnel. -->
 <div x-show="canLinkAccount" x-cloak>
 <label class="form-label">Compte de connexion (optionnel)</label>
 <p class="text-xs text-slate-500 mb-1">Rattacher un compte « Enseignant » pour qu'il puisse faire l'appel de ses classes.</p>
 <select-field model="newTeacher.userId" placeholder="Aucun"
 options-expr="[{value:'', label:'Aucun'}].concat(eligibleAccounts.map(u => ({value: u.id, label: u.fullName + ' (' + u.email + ')'})))" />
 <p x-show="createErrors.userid" x-text="createErrors.userid" class="field-error"></p>
 </div>

 <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
 <button type="button" x-on:click="isCreateOpen = false" class="btn-modal-secondary group">Annuler</button>
 <button type="submit" :disabled="isSubmitting" class="btn-modal-primary group">
 <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : enseignant ajouté -->
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Enseignant ajouté">
</modal-shell>

 <!-- Confirmation : enseignant ajouté -->
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Enseignant ajouté">
 <confirm-dialog-body close-action="showAddedDialog = false"
 new-action="showAddedDialog = false; openCreate()" new-label="Nouvel enseignant">
 La fiche de <span class="font-medium text-slate-900" x-text="addedTeacherName"></span> a bien été ajoutée et figure désormais dans la liste.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Import de masse du corps professoral : aperçu AVANT écriture, même patron que Students/Index.cshtml. -->
 <modal-shell open="isImportOpen" on-close="closeImport()" title="Importer des enseignants" size="3xl">
 <modal-subtitle>Fichier CSV ou Excel, un enseignant par ligne. Rien n'est enregistré tant que l'aperçu n'est pas entièrement valide.</modal-subtitle>

 <div x-show="importError" x-cloak class="form-error-banner" x-text="importError"></div>

 <!-- Zone de dépôt du fichier : masquée une fois qu'un import a été confirmé, pour laisser la place au résumé de succès. -->
 <div x-show="!(importResult && importResult.committed)" x-cloak>
 <div x-on:dragover.prevent="importDragging = true" x-on:dragleave.prevent="importDragging = false"
 x-on:drop.prevent="importDragging = false; onImportFileSelected($event.dataTransfer.files[0])"
 x-on:click="$refs.teacherImportFileInput.click()"
 :class="importDragging ? 'border-primary bg-primary/5' : 'border-slate-300 hover:border-primary'"
 class="rounded-2xl border-2 border-dashed p-6 text-center cursor-pointer transition-colors">
 <icon name="upload" class="w-8 h-8 text-slate-400 mx-auto" />
 <p class="mt-2 text-sm">
 <span x-show="!importFileName" class="text-slate-600">Glissez votre fichier ici, ou <span class="text-primary font-medium">cliquez pour le choisir</span>.</span>
 <span x-show="importFileName" x-text="importFileName" class="font-medium text-slate-900"></span>
 </p>
 <p class="text-xs text-slate-400 mt-1">Fichier .csv ou .xlsx, 1000 lignes maximum.</p>
 <input type="file" accept=".csv,.xlsx,.xls" x-ref="teacherImportFileInput" class="hidden"
 x-on:change="onImportFileSelected($event.target.files[0])" x-on:click.stop="">
 </div>

 <div x-show="isPreviewing" x-cloak class="mt-4 flex items-center justify-center py-6">
 <svg aria-hidden="true" class="animate-spin h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 <span class="ml-2 text-sm text-slate-500">Analyse du fichier…</span>
 </div>

 <!-- Aperçu ligne par ligne : cellules en rouge = champ invalide, survol = détail de l'erreur. -->
 <div x-show="importPreview" x-cloak class="mt-4">
 <p class="text-sm text-slate-700 mb-2">
 <span x-text="importPreview ? importPreview.totalRows : 0"></span> ligne(s) détectée(s) —
 <span class="text-success font-medium" x-text="importPreview ? importPreview.validRows : 0"></span> valide(s),
 <span class="text-danger font-medium" x-text="importPreview ? importPreview.invalidRows : 0"></span> invalide(s).
 </p>

 <div class="max-h-80 overflow-auto rounded-2xl border border-slate-200">
 <table class="w-full min-w-[900px] text-left border-collapse text-xs">
 <thead>
 <tr class="table-head">
 <th class="py-2 px-2 w-10">L.</th>
 <th class="py-2 px-2">Nom complet</th>
 <th class="py-2 px-2">E-mail</th>
 <th class="py-2 px-2">Téléphone</th>
 <th class="py-2 px-2">Naissance</th>
 <th class="py-2 px-2">Lieu</th>
 <th class="py-2 px-2">Matières</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-for="row in (importPreview ? importPreview.rows : [])" :key="row.rowNumber">
 <tr class="hover:bg-slate-50 transition-colors duration-150">
 <td class="py-1.5 px-2 text-slate-400" x-text="row.rowNumber"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'fullName')" :title="row.fieldErrors.fullName || ''" x-text="row.fullName"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'email')" :title="row.fieldErrors.email || ''" x-text="row.email"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'phone')" :title="row.fieldErrors.phone || ''" x-text="row.phone"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'birthDate')" :title="row.fieldErrors.birthDate || ''" x-text="row.birthDate"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'birthPlace')" :title="row.fieldErrors.birthPlace || ''" x-text="row.birthPlace"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'subjects')" :title="row.fieldErrors.subjects || ''" x-text="row.subjects"></td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>

 <p x-show="importPreview && importPreview.invalidRows > 0" x-cloak class="field-error">
 Corrigez les cellules en rouge dans votre fichier (survolez-les pour le détail), puis redéposez-le ci-dessus.
 </p>
 </div>
 </div>

 <!-- Résumé de succès, après confirmation. -->
 <div x-show="importResult && importResult.committed" x-cloak class="rounded-xl border-l-4 border-success bg-success-bg p-6 text-sm text-success">
 <span class="font-semibold" x-text="importResult ? importResult.created : 0"></span> enseignant(s) importé(s) avec succès — ils figurent désormais dans la liste.
 </div>

 <div class="mt-6 flex flex-wrap justify-between gap-3 border-t border-slate-200 pt-4">
 <button type="button" @@click="downloadImportTemplate()" class="btn-modal-secondary group">
 <icon name="download" class="w-4 h-4" />
 <span>Télécharger le modèle</span>
 </button>
 <div class="flex gap-3">
 <button type="button" @@click="closeImport()" class="btn-modal-secondary group">Fermer</button>
 <button type="button"
 x-show="importPreview && importPreview.invalidRows === 0 && importPreview.validRows > 0 && !(importResult && importResult.committed)"
 x-cloak @@click="confirmImport()" :disabled="isImporting" class="btn-modal-primary group">
 <span x-text="isImporting ? 'Import en cours…' : ('Confirmer l\'import (' + (importPreview ? importPreview.validRows : 0) + ' enseignants)')"></span>
 </button>
 </div>
 </div>
 </modal-shell>
 </div>

 <!-- ONGLET 2: Emploi du Temps -->
 <div x-show="activeTab === 'schedule'" x-cloak>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mt-6">
        <h2 class="text-lg font-bold text-slate-900">Emploi du Temps</h2>
        <div class="flex flex-wrap items-center gap-4">
            <!-- Toggle Vue Enseignant / Vue Classe -->
            <div class="flex bg-slate-100 p-1 rounded-xl shrink-0">
                <button type="button" x-on:click="scheduleViewMode = 'teacher'; loadSchedule()" 
                        :class="scheduleViewMode === 'teacher' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'"
                        class="px-3 py-1.5 text-xs rounded-lg"
                        :aria-selected="scheduleViewMode === 'teacher'">Par Enseignant</button>
                <button type="button" x-on:click="scheduleViewMode = 'classroom'; loadSchedule()" 
                        :class="scheduleViewMode === 'classroom' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'"
                        class="px-3 py-1.5 text-xs rounded-lg"
                        :aria-selected="scheduleViewMode === 'classroom'">Par Classe</button>
            </div>
            
            <!-- Sélecteur d'entité -->
            <div x-show="scheduleViewMode === 'teacher'" class="w-64 shrink-0">
                <select-field model="selectedScheduleTeacherId" placeholder="Choisir un enseignant..."
                    options-expr="teachers.map(t => ({value: t.id, label: t.fullName}))" on-change="loadSchedule()" />
            </div>
            <div x-show="scheduleViewMode === 'classroom'" class="w-64 shrink-0">
                <select-field model="selectedScheduleClassroomId" placeholder="Choisir une classe..."
                    options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" on-change="loadSchedule()" />
            </div>

            <!-- Actions (Ajouter un créneau) -->
            <div x-show="canManageSchedule" class="shrink-0" x-cloak>
                <button type="button" x-on:click="openCreateScheduleSlot()" class="btn-modal-primary whitespace-nowrap group">
                    <icon name="plus" class="w-4 h-4 mr-1 transition-transform duration-200 group-hover:rotate-90" />
                    Nouveau Créneau
                </button>
            </div>
        </div>
    </div>

        <!-- Grille de l'emploi du temps -->
        <div class="card mt-4 overflow-x-auto relative">
            <div x-show="isLoadingSchedule" class="p-12 text-center text-slate-500">Chargement de l'emploi du temps...</div>
            
            <table x-show="!isLoadingSchedule && ((scheduleViewMode === 'teacher' && selectedScheduleTeacherId) || (scheduleViewMode === 'classroom' && selectedScheduleClassroomId))" class="w-full text-left border-collapse min-w-[800px]" x-cloak>
                <thead>
                    <tr class="bg-slate-50/50">
                        <th class="py-3 px-4 w-32 border-b border-r border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">Heure \ Jour</th>
                        <template x-for="day in daysOfWeek" :key="day.value">
                            <th class="py-3 px-4 text-center border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider" x-text="day.label"></th>
                        </template>
                    </tr>
                </thead>
                <tbody>
                    <tr x-show="scheduleSlots.length === 0">
                        <td colspan="7">
                            <empty-state icon="calendar" title="Aucun créneau programmé."
                                hint="Cliquez sur « Nouveau Créneau » pour remplir la grille." />
                        </td>
                    </tr>
                    <template x-for="time in timeSlots" :key="time.start">
                        <tr class="hover:bg-slate-50 transition-colors border-b border-slate-100 group">
                            <!-- PAUSE -->
                            <td x-show="time.isPause" colspan="7" class="py-3 px-4 text-center font-bold text-slate-400 bg-slate-50 uppercase tracking-widest text-sm" x-text="time.label"></td>
                            
                            <!-- Ligne Normale - Heure -->
                            <td x-show="!time.isPause" class="py-3 px-4 border-r border-slate-200 font-mono text-sm text-slate-500 whitespace-nowrap bg-white" x-text="time.label"></td>
                            
                            <!-- Cellules des Jours -->
                            <template x-for="day in daysOfWeek" :key="day.value">
                                <td x-show="!time.isPause" class="py-2 px-2 text-center border-r border-slate-100 align-top w-40">
                                    <div x-data="{ slot: getSlotForDayAndTime(day.value, time.start) }" class="h-full min-h-[5rem]">
                                        <template x-if="slot">
                                            <div class="bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-lg p-2 text-left shadow-sm relative group/slot h-full flex flex-col">
                                                <div class="font-semibold text-xs leading-tight" x-text="slot.subjectName"></div>
                                                <div class="text-[11px] mt-1 text-indigo-700 font-medium" x-show="scheduleViewMode === 'teacher'" x-text="slot.classroomName"></div>
                                                <div class="text-[11px] mt-1 text-indigo-700 font-medium" x-show="scheduleViewMode === 'classroom'" x-text="slot.teacherName"></div>
                                                <div class="text-[10px] mt-auto pt-1 text-indigo-500" x-show="slot.roomNumber" x-text="'Salle: ' + slot.roomNumber"></div>
                                                
                                                <!-- Actions rapides -->
                                                <div class="absolute top-1 right-1 opacity-0 group-hover/slot:opacity-100 transition-opacity flex gap-1 bg-white/90 rounded shadow-sm p-0.5" x-show="canManageSchedule">
                                                    <button type="button" x-on:click.stop="openDeleteScheduleSlot(slot)" class="text-danger hover:text-red-700 rounded p-1" title="Supprimer">
                                                        <icon name="trash" class="w-3.5 h-3.5" />
                                                    </button>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </td>
                            </template>
                        </tr>
                    </template>
                </tbody>
            </table>

            <div x-show="!isLoadingSchedule && scheduleViewMode === 'teacher' && !selectedScheduleTeacherId" class="p-12 text-center text-slate-500" x-cloak>
                Sélectionnez un enseignant pour voir son emploi du temps.
            </div>
            <div x-show="!isLoadingSchedule && scheduleViewMode === 'classroom' && !selectedScheduleClassroomId" class="p-12 text-center text-slate-500" x-cloak>
                Sélectionnez une classe pour voir son emploi du temps.
            </div>
        </div>

        <!-- Modale : Créer un créneau -->
        <modal-shell open="creatingScheduleSlot" on-close="closeCreateScheduleSlot()" size="md">
            <form x-on:submit.prevent="submitCreateScheduleSlot()" novalidate>
                <modal-title>Nouveau créneau</modal-title>
                
                <div x-show="createScheduleError" x-cloak class="form-error-banner" x-text="createScheduleError"></div>

                <div class="space-y-4 mt-4">
                    <template x-if="scheduleViewMode === 'classroom'">
                        <div>
                            <label class="form-label" for="sched_teacher">Enseignant</label>
                            <select-field model="scheduleForm.teacherId" required="true"
                                options-expr="teachers.map(t => ({value: t.id, label: t.fullName}))" />
                        </div>
                    </template>
                    <template x-if="scheduleViewMode === 'teacher'">
                        <div>
                            <label class="form-label" for="sched_class">Classe</label>
                            <select-field model="scheduleForm.classroomId" required="true"
                                options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" />
                        </div>
                    </template>
                    <div>
                        <label class="form-label" for="sched_subject">Matière</label>
                        <select-field model="scheduleForm.subjectId" required="true"
                            options-expr="subjects.map(s => ({value: s.id, label: s.name}))" />
                    </div>
                    <div>
                        <label class="form-label" for="sched_day">Jour</label>
                        <select-field id="sched_day" model="scheduleForm.dayOfWeek" required="true" options-expr="[{value:1, label:'Lundi'}, {value:2, label:'Mardi'}, {value:3, label:'Mercredi'}, {value:4, label:'Jeudi'}, {value:5, label:'Vendredi'}, {value:6, label:'Samedi'}]" />
                    </div>
                    <div class="flex gap-4">
                        <div class="flex-1">
                            <label class="form-label" for="sched_start">Heure de début</label>
                            <input type="time" id="sched_start" x-model="scheduleForm.startTime" required class="input-field" />
                        </div>
                        <div class="flex-1">
                            <label class="form-label" for="sched_end">Heure de fin</label>
                            <input type="time" id="sched_end" x-model="scheduleForm.endTime" required class="input-field" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="sched_room">Salle (optionnel)</label>
                        <input type="text" id="sched_room" x-model="scheduleForm.roomNumber" class="input-field" placeholder="Ex: Salle 12" />
                    </div>
                </div>

                <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
                    <button type="button" x-on:click="closeCreateScheduleSlot()" class="btn-modal-secondary group">Annuler</button>
                    <button type="submit" :disabled="isSubmittingSchedule" class="btn-modal-primary group">
                        <span x-text="isSubmittingSchedule ? 'Enregistrement...' : 'Enregistrer'"></span>
                    </button>
                </div>
            </form>
        </modal-shell>

        <!-- Modale : Supprimer un créneau -->
        <modal-shell open="deletingScheduleSlot" on-close="closeDeleteScheduleSlot()" size="md">
            <modal-title>Supprimer ce créneau</modal-title>
            <modal-subtitle>Confirmez-vous la suppression de ce créneau ?</modal-subtitle>
            <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
                <button type="button" x-on:click="closeDeleteScheduleSlot()" class="btn-modal-secondary group">Annuler</button>
                <button type="button" x-on:click="confirmDeleteScheduleSlot()" :disabled="isDeletingSchedule" class="btn-modal-danger">
                    <span x-text="isDeletingSchedule ? 'Suppression...' : 'Supprimer'"></span>
                </button>
            </div>
        </modal-shell>
    </div> <!-- Fin de l'onglet Emploi du Temps -->

    @await Html.PartialAsync("_PdfPreviewModal")
</div>
