@{
 ViewData["Title"] = "Enseignants";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/photo-compress.js" asp-append-version="true"></script>
 <script src="~/js/teachers.js" asp-append-version="true"></script>
}

<div x-data="teachersView()">
 <div class="flex items-start justify-between gap-4">
 <div>
 <h1 class="text-jgk-title font-bold text-slate-900">Enseignants</h1>
 <p class="text-jgk-subtitle text-slate-500 mt-1">Fiches du personnel enseignant, matières qualifiées et affectations.</p>
 </div>
 </div>

 <!-- Navigation principale : Liste vs Emploi du Temps -->
 <div class="mt-6 flex bg-slate-100 p-1 rounded-xl w-fit">
    <button type="button" x-on:click="activeTab = 'teachers'" 
            :class="activeTab === 'teachers' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'"
            class="px-3 py-1.5 text-sm rounded-lg"
            :aria-selected="activeTab === 'teachers'">
        Liste des Enseignants
    </button>
    <button type="button" x-on:click="activeTab = 'schedule'" 
            :class="activeTab === 'schedule' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'"
            class="px-3 py-1.5 text-sm rounded-lg"
            :aria-selected="activeTab === 'schedule'">
        Emploi du Temps
    </button>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- ONGLET 1: Liste des Enseignants -->
 <div x-show="activeTab === 'teachers'" x-cloak>
     <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
     <stat-card label="Total enseignants" icon="users" accent="primary">
     <span x-text="totalCount">0</span>
     </stat-card>
     </div>

     <div class="card mt-6 relative">
 <div class="p-6 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
 <div class="flex flex-wrap items-center gap-3">
 <div class="relative">
 <span class="absolute inset-y-0 left-0 flex items-center pl-3">
 <icon name="search" class="w-4 h-4 text-slate-400" />
 </span>
 <input type="text" x-model="search" x-on:input.debounce.400ms="applyFilters()"
 placeholder="Nom, matricule ou e-mail..." aria-label="Rechercher un enseignant"
 class="input-field mt-0 pl-9 pr-3 w-full sm:w-72 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" />
 </div>
 <button type="button" x-on:click="resetFilters()" class="text-sm font-medium text-slate-500 hover:text-slate-900">
 Réinitialiser
 </button>
 </div>

 <div class="flex items-center gap-3" x-show="canManage" x-cloak>
 <button type="button" x-on:click="openCreate()" class="btn-primary">
 <icon name="plus" class="w-4 h-4" />
 Ajouter un enseignant
 </button>
 </div>
 </div>

 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Matricule</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Enseignant</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Téléphone</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Matières</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Statut</th>
 <th class="py-3 px-4 w-16 text-right uppercase tracking-wider text-slate-500 font-semibold">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-if="isLoading">
 <template x-for="i in 5" :key="i">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out"><td class="py-3 px-4" colspan="6"><div class="skeleton h-4 w-full"></div></td></tr>
 </template>
 </template>

 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out" x-show="!isLoading && teachers.length === 0" x-cloak>
 <td colspan="6">
 <empty-state icon="users" title="Aucun enseignant trouvé."
 hint="Ajustez la recherche, ou ajoutez une fiche enseignant." />
 </td>
 </tr>

 <template x-for="teacher in teachers" :key="teacher.id">
 <tr class="hover:bg-slate-50 transition-colors transition-all duration-200 ease-in-out transition-all duration-200 ease-in-out">
 <td class="py-3 px-4 font-mono text-xs text-slate-500" x-text="teacher.matricule"></td>
 <td class="py-3 px-4">
 <div class="flex items-center gap-3">
 <img x-show="teacher.photoDisplayUrl" :src="teacher.photoDisplayUrl" alt=""
 class="w-8 h-8 rounded-full object-cover shrink-0" x-cloak>
 <div x-show="!teacher.photoDisplayUrl" class="w-8 h-8 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xs shrink-0" x-text="initials(teacher.fullName)"></div>
 <div>
 <p class="font-medium text-slate-900" x-text="teacher.fullName"></p>
 <p class="text-xs text-slate-500" x-text="teacher.email"></p>
 </div>
 </div>
 </td>
 <td class="py-3 px-4 text-slate-500" x-text="teacher.phone || '—'"></td>
 <td class="py-3 px-4">
 <div class="flex flex-wrap gap-1">
 <template x-for="s in teacher.subjects" :key="s">
 <span class="inline-flex items-center px-2 py-0.5 rounded-xl text-xs font-medium bg-primary-50 text-primary" x-text="s"></span>
 </template>
 <span x-show="!teacher.subjects || teacher.subjects.length === 0" class="text-slate-400 text-xs">—</span>
 </div>
 </td>
 <td class="py-3 px-4">
 <span class="inline-flex items-center px-2 py-0.5 rounded-xl text-xs font-medium"
 :class="statusClass(teacher.status)" x-text="statusLabel(teacher.status)"></span>
 </td>
 <td class="py-3 px-4 text-right">
 <button type="button" x-on:click="openDetail(teacher)" title="Voir la fiche" aria-label="Voir la fiche"
 class="p-1.5 text-slate-400 hover:text-primary rounded-xl focus:outline-none focus:ring-2 focus:ring-primary transition-colors">
 <icon name="eye" class="w-5 h-5" />
 </button>
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>

 <pagination page="page" page-size="pageSize" total="totalCount" on-change="loadTeachers()" />
 </div>

 <!-- Fiche enseignant : infos + matières + affectations (historique) + attribution (Directeur/Secrétariat) -->
 <modal-shell open="detail" on-close="closeDetail()" title="Fiche enseignant">
 <template x-if="detail">
 <div>
 <div class="flex items-center gap-4 pb-5 border-b border-slate-100">
 <img x-show="detail.photoDisplayUrl" :src="detail.photoDisplayUrl" alt=""
 class="w-14 h-14 rounded-full object-cover flex-shrink-0" x-cloak>
 <div x-show="!detail.photoDisplayUrl" class="w-14 h-14 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" x-text="initials(detail.fullName)"></div>
 <div>
 <p class="text-xl font-bold text-slate-900" x-text="detail.fullName"></p>
 <p class="text-sm text-slate-500 font-mono" x-text="detail.matricule"></p>
 </div>
 </div>

 <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-5">
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">E-mail</dt>
 <dd class="mt-1 text-base font-medium text-slate-900" x-text="detail.email"></dd>
 </div>
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Téléphone</dt>
 <dd class="mt-1 text-base font-medium text-slate-900" x-text="detail.phone || '—'"></dd>
 </div>
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Date de naissance</dt>
 <dd class="mt-1 text-base font-medium text-slate-900" x-text="formatDate(detail.birthDate)"></dd>
 </div>
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Lieu de naissance</dt>
 <dd class="mt-1 text-base font-medium text-slate-900" x-text="detail.birthPlace || '—'"></dd>
 </div>
 <div>
 <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Statut</dt>
 <dd class="mt-1.5">
 <span class="inline-flex items-center px-2.5 py-0.5 rounded-xl text-xs font-bold"
 :class="statusClass(detail.status)" x-text="statusLabel(detail.status)"></span>
 </dd>
 </div>
 </dl>

 <div class="mt-6">
 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Matières qualifiées</p>
 <div class="flex flex-wrap gap-1.5">
 <template x-for="s in detail.subjects" :key="s">
 <span class="inline-flex items-center px-2.5 py-0.5 rounded-xl text-xs font-medium bg-primary-50 text-primary" x-text="s"></span>
 </template>
 <span x-show="!detail.subjects || detail.subjects.length === 0" class="text-slate-400 text-sm">Aucune matière.</span>
 </div>
 </div>

 <!-- Affectations classe/matière, groupées par année scolaire (historique) -->
 <div class="mt-6">
 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Affectations</p>
 <div x-show="assignmentsByYear().length === 0" class="text-slate-400 text-sm">Aucune affectation.</div>
 <template x-for="group in assignmentsByYear()" :key="group.label">
 <div class="mb-4">
 <div class="flex items-center gap-2 mb-1.5">
 <span class="text-sm font-semibold text-slate-700" x-text="group.label"></span>
 <span x-show="group.isActive" class="inline-flex items-center px-2 py-0.5 rounded-xl text-[10px] font-bold bg-success-bg text-success">Active</span>
 </div>
 <ul class="space-y-1">
 <template x-for="a in group.items" :key="a.id">
 <li class="text-sm text-slate-600 flex items-center gap-2">
 <icon name="building" class="w-3.5 h-3.5 text-slate-400" />
 <span x-text="a.classroomName"></span>
 <span class="text-slate-300">·</span>
 <span x-text="a.subjectName"></span>
 </li>
 </template>
 </ul>
 </div>
 </template>
 </div>

 <!-- Attribution d'une classe/matière (année active) — Directeur/Secrétariat -->
 <div class="mt-6 bg-slate-50 rounded-2xl p-6 sm:p-5" x-show="canManage" x-cloak>
 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">Attribuer une classe / matière (année active)</p>
 <div x-show="assignError" x-cloak class="mb-3 rounded-xl border-l-4 border-danger bg-danger-bg p-2.5 text-sm text-danger" x-text="assignError"></div>
 <div x-show="assignSuccess" x-cloak class="mb-3 rounded-xl border-l-4 border-success bg-success-bg p-2.5 text-sm text-success">Affectation enregistrée.</div>
 <form x-on:submit.prevent="submitAssign()" class="flex flex-col sm:flex-row sm:items-end gap-3">
 <div class="flex-1">
 <label class="block text-xs font-medium text-slate-500 mb-1">Classe</label>
 <select-field model="assignForm.classroomId" required="true" class="mt-0 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Choisir…"
 options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" />
 </div>
 <div class="flex-1">
 <label class="block text-xs font-medium text-slate-500 mb-1">Matière</label>
 <select-field model="assignForm.subjectId" required="true" class="mt-0 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Choisir…"
 options-expr="subjects.map(s => ({value: s.id, label: s.name + ' (' + s.level + ')'}))" />
 </div>
 <button type="submit" :disabled="assignSubmitting" class="btn-primary whitespace-nowrap">
 <span x-text="assignSubmitting ? '…' : 'Attribuer'"></span>
 </button>
 </form>
 </div>

 <div class="mt-8 flex flex-col-reverse sm:flex-row sm:justify-between gap-3 border-t border-slate-200 pt-4">
 <template x-if="canManage">
 <div class="flex gap-2">
 <button type="button" x-on:click="openEditTeacher()" class="btn-secondary">
 Modifier la fiche
 </button>
 <button type="button" x-on:click="openDeleteTeacher()" class="text-sm font-medium text-danger bg-danger-bg hover:bg-red-100 px-5 py-2.5 rounded-xl transition-colors">
 Supprimer
 </button>
 </div>
 </template>
 <button type="button" x-on:click="closeDetail()" class="btn-secondary sm:ml-auto">Fermer</button>
 </div>
 </div>
 </template>
 </modal-shell>

 <!-- Modification de la fiche enseignant : matricule et compte de connexion non modifiables ici. -->
 <modal-shell open="editingTeacher" on-close="closeEditTeacher()" title="Modifier la fiche">
 <modal-subtitle>Le matricule reste celui déjà attribué : il n'est jamais modifiable.</modal-subtitle>

 <div x-show="teacherEditErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="teacherEditErrors.global"></div>

 <form x-on:submit.prevent="submitEditTeacher()" class="space-y-4">
 <div>
 <label class="block text-sm font-medium text-slate-700">Nom complet <span class="text-danger">*</span></label>
 <input type="text" x-model="editingTeacher.fullName" required class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="teacherEditErrors.fullname" x-text="teacherEditErrors.fullname" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">E-mail <span class="text-danger">*</span></label>
 <input type="email" x-model="editingTeacher.email" required class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="teacherEditErrors.email" x-text="teacherEditErrors.email" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Téléphone</label>
 <input type="text" x-model="editingTeacher.phone" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="teacherEditErrors.phone" x-text="teacherEditErrors.phone" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Date de naissance <span class="text-danger">*</span></label>
 <date-field model="editingTeacher.birthDate" required="true" aria-label="Date de naissance" />
 <p x-show="teacherEditErrors.birthdate" x-text="teacherEditErrors.birthdate" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Lieu de naissance</label>
 <input type="text" x-model="editingTeacher.birthPlace" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="teacherEditErrors.birthplace" x-text="teacherEditErrors.birthplace" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Photo</label>
 <photo-dropzone preview="editingTeacher.photoDisplayUrl"
 on-change="uploadTeacherPhoto(photoBase64)" />
 <p x-show="photoUploadError" x-cloak x-text="photoUploadError" class="mt-1 text-xs text-danger"></p>
 <div class="mt-3">
 <label class="block text-xs font-medium text-slate-500">…ou une URL externe (utilisée seulement si aucune photo n'est déposée ci-dessus)</label>
 <input type="text" x-model="editingTeacher.photoUrl" placeholder="https://…" class="input-field mt-1 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 </div>
 <p x-show="teacherEditErrors.photourl" x-text="teacherEditErrors.photourl" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Matières enseignées <span class="text-danger">*</span></label>
 <p class="text-xs text-slate-500 mb-2">Sélectionnez au moins une matière qualifiée.</p>
 <div class="max-h-40 overflow-y-auto rounded-xl border border-slate-200 divide-y divide-slate-100">
 <template x-for="s in subjects" :key="s.id">
 <label class="flex items-center gap-2 px-3 py-2 hover:bg-slate-50 cursor-pointer transition-all duration-200 ease-in-out transition-all duration-200 ease-in-out">
 <input type="checkbox" :value="s.id" x-model="editingTeacher.subjectIds" class="rounded-xl border-slate-300 text-primary focus:ring-primary transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <span class="text-sm text-slate-700" x-text="s.name + ' (' + s.level + ')'"></span>
 </label>
 </template>
 </div>
 <p x-show="teacherEditErrors.subjectids" x-text="teacherEditErrors.subjectids" class="mt-1 text-xs text-danger"></p>
 </div>

 <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
 <button type="button" x-on:click="closeEditTeacher()" class="btn-secondary">Annuler</button>
 <button type="submit" :disabled="isSavingTeacherEdit" class="btn-primary">
 <span x-text="isSavingTeacherEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : fiche modifiée -->
 <modal-shell open="showTeacherEditedDialog" size="md" on-close="showTeacherEditedDialog = false" title="Fiche modifiée">
 <confirm-dialog-body close-action="showTeacherEditedDialog = false">
 La fiche a bien été mise à jour.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Confirmation : suppression de la fiche enseignant -->
 <modal-shell open="deletingTeacherRecord" on-close="closeDeleteTeacher()" size="md">
 <modal-title>Supprimer la fiche</modal-title>
 <modal-subtitle>
 <span class="font-semibold text-slate-900" x-text="deletingTeacherRecord ? deletingTeacherRecord.fullName : ''"></span>
 sera archivée et n'apparaîtra plus dans la liste des enseignants.
 </modal-subtitle>

 <div x-show="deleteTeacherRecordError" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="deleteTeacherRecordError"></div>

 <p class="text-sm text-slate-500">
 Réservé à une fiche créée par pure erreur de saisie : impossible si une attribution classe/matière existe déjà pour cet enseignant.
 </p>

 <div class="mt-6 flex justify-end gap-3">
 <button type="button" x-on:click="closeDeleteTeacher()" class="btn-secondary">Annuler</button>
 <button type="button" x-on:click="confirmDeleteTeacher()" :disabled="isDeletingTeacherRecord" class="btn-danger">
 <span x-text="isDeletingTeacherRecord ? 'Suppression...' : 'Supprimer la fiche'"></span>
 </button>
 </div>
 </modal-shell>

 <!-- Confirmation : suppression d'une fiche enseignant -->
 <modal-shell open="showTeacherDeletedDialog" size="md" on-close="showTeacherDeletedDialog = false" title="Fiche supprimée">
 <confirm-dialog-body close-action="showTeacherDeletedDialog = false">
 La fiche a bien été supprimée.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Création d'une fiche enseignant (JGK-D03) -->
 <modal-shell open="isCreateOpen" title="Ajouter un enseignant">
 <modal-subtitle>Le matricule sera généré automatiquement à l'enregistrement.</modal-subtitle>

 <div x-show="createErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="createErrors.global"></div>

 <form x-on:submit.prevent="submitCreate()" class="space-y-4">
 <div>
 <label class="block text-sm font-medium text-slate-700">Nom complet <span class="text-danger">*</span></label>
 <input type="text" x-model="newTeacher.fullName" required class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="createErrors.fullname" x-text="createErrors.fullname" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">E-mail <span class="text-danger">*</span></label>
 <input type="email" x-model="newTeacher.email" required class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="createErrors.email" x-text="createErrors.email" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Téléphone</label>
 <input type="text" x-model="newTeacher.phone" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="createErrors.phone" x-text="createErrors.phone" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Date de naissance <span class="text-danger">*</span></label>
 <date-field model="newTeacher.birthDate" required="true" aria-label="Date de naissance" />
 <p x-show="createErrors.birthdate" x-text="createErrors.birthdate" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Lieu de naissance</label>
 <input type="text" x-model="newTeacher.birthPlace" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="createErrors.birthplace" x-text="createErrors.birthplace" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Photo</label>
 <photo-dropzone preview="newTeacher.photoData ? ('data:image/jpeg;base64,' + newTeacher.photoData) : newTeacher.photoUrl"
 on-change="newTeacher.photoData = photoBase64" />
 <div class="mt-3">
 <label class="block text-xs font-medium text-slate-500">…ou une URL externe (utilisée seulement si aucune photo n'est déposée ci-dessus)</label>
 <input type="text" x-model="newTeacher.photoUrl" placeholder="https://…" class="input-field mt-1 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 </div>
 <p x-show="createErrors.photourl" x-text="createErrors.photourl" class="mt-1 text-xs text-danger"></p>
 <p x-show="createErrors.photodata" x-text="createErrors.photodata" class="mt-1 text-xs text-danger"></p>
 </div>

 <div>
 <label class="block text-sm font-medium text-slate-700">Matières enseignées <span class="text-danger">*</span></label>
 <p class="text-xs text-slate-500 mb-2">Sélectionnez au moins une matière qualifiée.</p>
 <div class="max-h-40 overflow-y-auto rounded-xl border border-slate-200 divide-y divide-slate-100">
 <template x-for="s in subjects" :key="s.id">
 <label class="flex items-center gap-2 px-3 py-2 hover:bg-slate-50 cursor-pointer transition-all duration-200 ease-in-out transition-all duration-200 ease-in-out">
 <input type="checkbox" :value="s.id" x-model="newTeacher.subjectIds" class="rounded-xl border-slate-300 text-primary focus:ring-primary transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <span class="text-sm text-slate-700" x-text="s.name + ' (' + s.level + ')'"></span>
 </label>
 </template>
 <p x-show="subjects.length === 0" class="px-3 py-2 text-sm text-slate-400">Aucune matière : créez-en d'abord dans « Matières ».</p>
 </div>
 <p x-show="createErrors.subjectids" x-text="createErrors.subjectids" class="mt-1 text-xs text-danger"></p>
 </div>

 <!-- Rattachement d'un compte de connexion (Directeur uniquement) : permet à l'enseignant de
 faire l'appel de ses classes (JGK-D06). Optionnel. -->
 <div x-show="canLinkAccount" x-cloak>
 <label class="block text-sm font-medium text-slate-700">Compte de connexion (optionnel)</label>
 <p class="text-xs text-slate-500 mb-1">Rattacher un compte « Enseignant » pour qu'il puisse faire l'appel de ses classes.</p>
 <select-field model="newTeacher.userId" placeholder="Aucun"
 options-expr="[{value:'', label:'Aucun'}].concat(eligibleAccounts.map(u => ({value: u.id, label: u.fullName + ' (' + u.email + ')'})))" />
 <p x-show="createErrors.userid" x-text="createErrors.userid" class="mt-1 text-xs text-danger"></p>
 </div>

 <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
 <button type="button" x-on:click="isCreateOpen = false" class="btn-secondary">Annuler</button>
 <button type="submit" :disabled="isSubmitting" class="btn-primary">
 <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : enseignant ajouté -->
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Enseignant ajouté">
</modal-shell>

 <!-- Confirmation : enseignant ajouté -->
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Enseignant ajouté">
 <confirm-dialog-body close-action="showAddedDialog = false"
 new-action="showAddedDialog = false; openCreate()" new-label="Nouvel enseignant">
 La fiche de <span class="font-medium text-slate-900" x-text="addedTeacherName"></span> a bien été ajoutée et figure désormais dans la liste.
 </confirm-dialog-body>
 </modal-shell>
 </div>

 <!-- ONGLET 2: Emploi du Temps -->
 <div x-show="activeTab === 'schedule'" x-cloak>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mt-6">
        <h2 class="text-lg font-bold text-slate-900">Emploi du Temps</h2>
        <div class="flex flex-wrap items-center gap-4">
            <!-- Toggle Vue Enseignant / Vue Classe -->
            <div class="flex bg-slate-100 p-1 rounded-xl shrink-0">
                <button type="button" x-on:click="scheduleViewMode = 'teacher'; loadSchedule()" 
                        :class="scheduleViewMode === 'teacher' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'"
                        class="px-3 py-1.5 text-xs rounded-lg"
                        :aria-selected="scheduleViewMode === 'teacher'">Par Enseignant</button>
                <button type="button" x-on:click="scheduleViewMode = 'classroom'; loadSchedule()" 
                        :class="scheduleViewMode === 'classroom' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'bg-transparent text-slate-700 font-medium hover:text-slate-900 hover:bg-slate-200/50'"
                        class="px-3 py-1.5 text-xs rounded-lg"
                        :aria-selected="scheduleViewMode === 'classroom'">Par Classe</button>
            </div>
            
            <!-- Sélecteur d'entité -->
            <div x-show="scheduleViewMode === 'teacher'" class="w-64 shrink-0">
                <select-field model="selectedScheduleTeacherId" placeholder="Choisir un enseignant..."
                    options-expr="teachers.map(t => ({value: t.id, label: t.fullName}))" on-change="loadSchedule()" />
            </div>
            <div x-show="scheduleViewMode === 'classroom'" class="w-64 shrink-0">
                <select-field model="selectedScheduleClassroomId" placeholder="Choisir une classe..."
                    options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" on-change="loadSchedule()" />
            </div>

            <!-- Actions (Ajouter un créneau) -->
            <div x-show="canManageSchedule" class="shrink-0" x-cloak>
                <button type="button" x-on:click="openCreateScheduleSlot()" class="btn-primary whitespace-nowrap">
                    <icon name="plus" class="w-4 h-4 mr-1" />
                    Nouveau Créneau
                </button>
            </div>
        </div>
    </div>

        <!-- Grille de l'emploi du temps -->
        <div class="card mt-4 overflow-x-auto relative">
            <div x-show="isLoadingSchedule" class="p-12 text-center text-slate-500">Chargement de l'emploi du temps...</div>
            
            <table x-show="!isLoadingSchedule && ((scheduleViewMode === 'teacher' && selectedScheduleTeacherId) || (scheduleViewMode === 'classroom' && selectedScheduleClassroomId))" class="w-full text-left border-collapse min-w-[800px]" x-cloak>
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4 w-32 border-b border-r border-slate-200">Heure \ Jour</th>
                        <template x-for="day in daysOfWeek" :key="day.value">
                            <th class="py-3 px-4 text-center border-b border-slate-200" x-text="day.label"></th>
                        </template>
                    </tr>
                </thead>
                <tbody>
                    <tr x-show="scheduleSlots.length === 0">
                        <td colspan="7" class="py-12 text-center text-slate-500 border-b border-slate-100">Aucun créneau programmé. Cliquez sur "Nouveau Créneau" pour remplir la grille.</td>
                    </tr>
                    <template x-for="time in timeSlots" :key="time.start">
                        <tr class="hover:bg-slate-50 transition-colors border-b border-slate-100 group">
                            <!-- PAUSE -->
                            <td x-show="time.isPause" colspan="7" class="py-3 px-4 text-center font-bold text-slate-400 bg-slate-50 uppercase tracking-widest text-sm" x-text="time.label"></td>
                            
                            <!-- Ligne Normale - Heure -->
                            <td x-show="!time.isPause" class="py-3 px-4 border-r border-slate-200 font-mono text-sm text-slate-500 whitespace-nowrap bg-white" x-text="time.label"></td>
                            
                            <!-- Cellules des Jours -->
                            <template x-for="day in daysOfWeek" :key="day.value">
                                <td x-show="!time.isPause" class="py-2 px-2 text-center border-r border-slate-100 align-top w-40">
                                    <div x-data="{ slot: getSlotForDayAndTime(day.value, time.start) }" class="h-full min-h-[5rem]">
                                        <template x-if="slot">
                                            <div class="bg-indigo-50 border-l-4 border-indigo-600 text-indigo-900 rounded-r p-2 text-left shadow-sm relative group/slot h-full flex flex-col">
                                                <div class="font-bold text-[13px] leading-tight" x-text="slot.subjectName"></div>
                                                <div class="text-[11px] mt-1 text-indigo-700 font-medium" x-show="scheduleViewMode === 'teacher'" x-text="slot.classroomName"></div>
                                                <div class="text-[11px] mt-1 text-indigo-700 font-medium" x-show="scheduleViewMode === 'classroom'" x-text="slot.teacherName"></div>
                                                <div class="text-[10px] mt-auto pt-1 text-indigo-500" x-show="slot.roomNumber" x-text="'Salle: ' + slot.roomNumber"></div>
                                                
                                                <!-- Actions rapides -->
                                                <div class="absolute top-1 right-1 opacity-0 group-hover/slot:opacity-100 transition-opacity flex gap-1 bg-white/90 rounded shadow-sm p-0.5" x-show="canManageSchedule">
                                                    <button type="button" x-on:click.stop="openDeleteScheduleSlot(slot)" class="text-danger hover:text-red-700 rounded p-1" title="Supprimer">
                                                        <icon name="trash" class="w-3.5 h-3.5" />
                                                    </button>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </td>
                            </template>
                        </tr>
                    </template>
                </tbody>
            </table>

            <div x-show="!isLoadingSchedule && scheduleViewMode === 'teacher' && !selectedScheduleTeacherId" class="p-12 text-center text-slate-500" x-cloak>
                Sélectionnez un enseignant pour voir son emploi du temps.
            </div>
            <div x-show="!isLoadingSchedule && scheduleViewMode === 'classroom' && !selectedScheduleClassroomId" class="p-12 text-center text-slate-500" x-cloak>
                Sélectionnez une classe pour voir son emploi du temps.
            </div>
        </div>

        <!-- Modale : Créer un créneau -->
        <modal-shell open="creatingScheduleSlot" on-close="closeCreateScheduleSlot()" size="md">
            <form x-on:submit.prevent="submitCreateScheduleSlot()">
                <modal-title>Nouveau créneau</modal-title>
                
                <div x-show="createScheduleError" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="createScheduleError"></div>

                <div class="space-y-4 mt-4">
                    <template x-if="scheduleViewMode === 'classroom'">
                        <div>
                            <label class="form-label" for="sched_teacher">Enseignant</label>
                            <select-field model="scheduleForm.teacherId" required="true"
                                options-expr="teachers.map(t => ({value: t.id, label: t.fullName}))" />
                        </div>
                    </template>
                    <template x-if="scheduleViewMode === 'teacher'">
                        <div>
                            <label class="form-label" for="sched_class">Classe</label>
                            <select-field model="scheduleForm.classroomId" required="true"
                                options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" />
                        </div>
                    </template>
                    <div>
                        <label class="form-label" for="sched_subject">Matière</label>
                        <select-field model="scheduleForm.subjectId" required="true"
                            options-expr="subjects.map(s => ({value: s.id, label: s.name}))" />
                    </div>
                    <div>
                        <label class="form-label" for="sched_day">Jour</label>
                        <select-field id="sched_day" model="scheduleForm.dayOfWeek" required="true" options-expr="[{value:1, label:'Lundi'}, {value:2, label:'Mardi'}, {value:3, label:'Mercredi'}, {value:4, label:'Jeudi'}, {value:5, label:'Vendredi'}, {value:6, label:'Samedi'}]" />
                    </div>
                    <div class="flex gap-4">
                        <div class="flex-1">
                            <label class="form-label" for="sched_start">Heure de début</label>
                            <input type="time" id="sched_start" x-model="scheduleForm.startTime" required class="input-field" />
                        </div>
                        <div class="flex-1">
                            <label class="form-label" for="sched_end">Heure de fin</label>
                            <input type="time" id="sched_end" x-model="scheduleForm.endTime" required class="input-field" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="sched_room">Salle (optionnel)</label>
                        <input type="text" id="sched_room" x-model="scheduleForm.roomNumber" class="input-field" placeholder="Ex: Salle 12" />
                    </div>
                </div>

                <div class="mt-6 flex justify-end gap-3">
                    <button type="button" x-on:click="closeCreateScheduleSlot()" class="btn-secondary">Annuler</button>
                    <button type="submit" :disabled="isSubmittingSchedule" class="btn-primary">
                        <span x-text="isSubmittingSchedule ? 'Enregistrement...' : 'Enregistrer'"></span>
                    </button>
                </div>
            </form>
        </modal-shell>

        <!-- Modale : Supprimer un créneau -->
        <modal-shell open="deletingScheduleSlot" on-close="closeDeleteScheduleSlot()" size="md">
            <modal-title>Supprimer ce créneau</modal-title>
            <modal-subtitle>Confirmez-vous la suppression de ce créneau ?</modal-subtitle>
            <div class="mt-6 flex justify-end gap-3">
                <button type="button" x-on:click="closeDeleteScheduleSlot()" class="btn-secondary">Annuler</button>
                <button type="button" x-on:click="confirmDeleteScheduleSlot()" :disabled="isDeletingSchedule" class="btn-danger">
                    <span x-text="isDeletingSchedule ? 'Suppression...' : 'Supprimer'"></span>
                </button>
            </div>
        </modal-shell>
    </div> <!-- Fin de l'onglet Emploi du Temps -->
</div>
