@{
    ViewData["Title"] = "Demandes d'inscription";
    Layout = "_SuperAdminLayout";
}

@* Écran Super Admin de revue des demandes d'inscription self-service (ticket JGK-I03).

   Cette page vit sous _SuperAdminLayout, comme les cinq autres écrans de /admin. Elle est LISTÉE
   dans la barre latérale de la console mais était rendue sous le _Layout tenant : le Super Admin
   basculait donc, depuis son propre menu, dans le chrome d'un établissement — barre latérale
   Élèves / Enseignants / Rapports en tête, dont chaque lien retombe en 403 puisque ce rôle n'a
   aucun schoolId et que la RLS lui ferme toutes les tables tenant (docs/Volume_7_Security.md §8).

   Le balisage est hand-roulé en sombre plutôt que bâti sur modal-shell / badge / empty-state et les
   classes .card / .input-field / .btn-modal-* : ces composants partagés sont codés en dur en thème
   CLAIR (bg-white, text-slate-900 — voir ModalShellTagHelper) et casseraient cette console, qui est
   TOUJOURS sombre. Même arbitrage, et pour la même raison, que Schools.cshtml, Billing.cshtml et
   Pricing.cshtml.

   Le garde-fou de rôle n'est plus dupliqué ici : _SuperAdminLayout l'applique déjà à tout le corps
   de page. Côté JS, registrationRequestsView().init() continue de garder l'appel d'API. *@

@* auth.js et api.js sont chargés par _SuperAdminLayout : les inclure ici les exécuterait deux fois. *@
@section Scripts {
    <script src="~/js/admin-registration-requests.js" asp-append-version="true"></script>
}

<div x-data="registrationRequestsView()" class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-semibold text-white">Demandes d'inscription</h1>
            <p class="text-sm text-zinc-500 mt-1">
                Examinez les établissements candidats, puis validez ou rejetez leur demande.
            </p>
        </div>
        <button type="button" x-on:click="load()" :disabled="isLoading"
                class="inline-flex items-center gap-2 rounded-2xl border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors disabled:opacity-50">
            <icon name="chart-multiple" class="w-4 h-4" />
            <span x-text="isLoading ? 'Actualisation…' : 'Actualiser'"></span>
        </button>
    </div>

    <!-- KPI -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
            <div class="min-w-0">
                <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Demandes en attente</p>
                <p class="mt-1 text-2xl font-black text-amber-400" x-text="pendingCount"></p>
            </div>
            <div class="w-11 h-11 rounded-full bg-amber-500/15 flex items-center justify-center shrink-0 ml-3">
                <icon name="clock" class="w-5 h-5 text-amber-400" />
            </div>
        </div>
    </div>

    <!-- Filtres par statut -->
    <div class="flex flex-wrap items-center gap-2">
        <template x-for="option in [
            { value: 'Pending', label: 'En attente' },
            { value: 'Approved', label: 'Approuvées' },
            { value: 'Rejected', label: 'Rejetées' },
            { value: 'All', label: 'Toutes' }
        ]" :key="option.value">
            <button type="button"
                    x-on:click="statusFilter = option.value; load()"
                    :class="statusFilter === option.value
                        ? 'bg-sky-500/15 text-sky-400 ring-1 ring-inset ring-sky-500/30'
                        : 'text-zinc-400 border border-zinc-800 hover:bg-zinc-900'"
                    class="rounded-2xl px-3 py-1.5 text-xs font-medium transition-colors">
                <span x-text="option.label"></span>
            </button>
        </template>
    </div>

    <div x-show="error" x-cloak class="rounded-2xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300" x-text="error"></div>

    <!-- Tableau (ecran >= sm) -->
    <div class="hidden sm:block rounded-xl border border-zinc-800 bg-zinc-900/60 backdrop-blur overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="text-xs uppercase tracking-wider text-zinc-500 border-b border-zinc-800 bg-zinc-950/40">
                        <th class="py-3 px-4 font-medium">Établissement</th>
                        <th class="py-3 px-4 font-medium">Directeur</th>
                        <th class="py-3 px-4 font-medium">Formule</th>
                        <th class="py-3 px-4 font-medium">Soumise le</th>
                        <th class="py-3 px-4 font-medium">Statut</th>
                        <th class="py-3 px-4 font-medium text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/80">
                    <template x-if="isLoading">
                        <template x-for="i in 3" :key="i">
                            <tr><td class="py-3 px-4" colspan="6"><div class="h-4 w-full rounded-xl bg-zinc-800 animate-pulse"></div></td></tr>
                        </template>
                    </template>

                    <tr x-show="!isLoading && requests.length === 0" x-cloak>
                        <td colspan="6" class="py-12 text-center">
                            <icon name="document" class="mx-auto w-8 h-8 text-zinc-700" />
                            <p class="mt-2 text-sm text-zinc-500">Aucune demande dans cette catégorie.</p>
                            <p class="mt-0.5 text-xs text-zinc-600">Les nouvelles demandes d'inscription apparaîtront ici.</p>
                        </td>
                    </tr>

                    <template x-for="request in requests" :key="request.id">
                        <tr class="hover:bg-zinc-900 transition-colors">
                            <td class="py-3 px-4">
                                <p class="font-medium text-zinc-100" x-text="request.schoolName"></p>
                                <p class="text-xs text-zinc-500" x-text="[request.city, request.region].filter(Boolean).join(', ') || '—'"></p>
                            </td>
                            <td class="py-3 px-4">
                                <p class="text-zinc-300" x-text="request.directorFullName"></p>
                                <p class="text-xs text-zinc-500" x-text="request.directorEmail"></p>
                            </td>
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs font-medium text-zinc-300" x-text="offerLabel(request)"></span>
                            </td>
                            <td class="py-3 px-4 text-zinc-400 whitespace-nowrap" x-text="formatDate(request.submittedAt)"></td>
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium" :class="statusClasses(request.status)" x-text="statusLabel(request.status)"></span>
                            </td>
                            <td class="py-3 px-4 text-right whitespace-nowrap">
                                <button type="button" x-on:click="openDetail(request)"
                                        class="inline-flex items-center gap-1.5 rounded-xl px-2 py-1 text-xs font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 transition-colors">
                                    <icon name="eye" class="w-3.5 h-3.5" />
                                    Détails
                                </button>
                                <template x-if="request.status === 'Pending'">
                                    <span class="inline-flex items-center gap-1">
                                        <button type="button" x-on:click="openApprove(request)"
                                                class="inline-flex items-center gap-1.5 rounded-xl px-2 py-1 text-xs font-medium text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 transition-colors">
                                            <icon name="checkmark-circle" class="w-3.5 h-3.5" />
                                            Approuver
                                        </button>
                                        <button type="button" x-on:click="openReject(request)"
                                                class="inline-flex items-center gap-1.5 rounded-xl px-2 py-1 text-xs font-medium text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition-colors">
                                            <icon name="block" class="w-3.5 h-3.5" />
                                            Rejeter
                                        </button>
                                    </span>
                                </template>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Cartes (ecran < sm) -->
    <div class="sm:hidden space-y-3">
        <template x-if="isLoading">
            <template x-for="i in 3" :key="i">
                <div class="h-28 rounded-xl border border-zinc-800 bg-zinc-900/60 animate-pulse"></div>
            </template>
        </template>

        <p x-show="!isLoading && requests.length === 0" x-cloak class="py-8 text-center text-sm text-zinc-500">
            Aucune demande dans cette catégorie.
        </p>

        <template x-for="request in requests" :key="request.id">
            <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-6">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="font-medium text-zinc-100 truncate" x-text="request.schoolName"></p>
                        <p class="text-xs text-zinc-500 mt-0.5" x-text="request.directorFullName"></p>
                    </div>
                    <span class="shrink-0 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium" :class="statusClasses(request.status)" x-text="statusLabel(request.status)"></span>
                </div>
                <div class="mt-3 flex items-center justify-between text-xs text-zinc-500">
                    <span x-text="offerLabel(request)"></span>
                    <span x-text="formatDate(request.submittedAt)"></span>
                </div>
                <div class="mt-3 flex justify-end gap-2 border-t border-zinc-800 pt-3">
                    <button type="button" x-on:click="openDetail(request)"
                            class="rounded-xl px-2 py-1 text-xs font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 transition-colors">
                        Détails
                    </button>
                    <template x-if="request.status === 'Pending'">
                        <span class="inline-flex items-center gap-2">
                            <button type="button" x-on:click="openApprove(request)"
                                    class="rounded-xl px-2 py-1 text-xs font-medium text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 transition-colors">
                                Approuver
                            </button>
                            <button type="button" x-on:click="openReject(request)"
                                    class="rounded-xl px-2 py-1 text-xs font-medium text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition-colors">
                                Rejeter
                            </button>
                        </span>
                    </template>
                </div>
            </div>
        </template>
    </div>

    @* ---------------------------------------------------------------- Détail d'une demande *@
    <div x-show="detailTarget" x-cloak
         class="fixed inset-0 z-40 flex items-center justify-center bg-black/70 backdrop-blur-sm px-4"
         x-on:keydown.escape.window="closeDetail()">
        <div class="w-full max-w-2xl rounded-xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-start justify-between gap-4">
                <h2 class="text-base font-semibold text-white">Détail de la demande</h2>
                <button type="button" x-on:click="closeDetail()" aria-label="Fermer"
                        class="shrink-0 rounded-xl p-1.5 text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800 transition-colors">
                    <icon name="x" class="w-4 h-4" />
                </button>
            </div>

            <template x-if="detailTarget">
                <div class="mt-4 space-y-5">
                    <div class="flex items-center justify-between gap-4">
                        <span class="font-mono text-sm text-zinc-500" x-text="detailTarget.trackingReference"></span>
                        <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium" :class="statusClasses(detailTarget.status)" x-text="statusLabel(detailTarget.status)"></span>
                    </div>

                    <div>
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Établissement</h3>
                        <dl class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
                            <div><dt class="text-zinc-500">Nom</dt><dd class="text-zinc-100" x-text="detailTarget.schoolName"></dd></div>
                            <div><dt class="text-zinc-500">Type et offre</dt><dd class="text-zinc-100" x-text="offerLabel(detailTarget)"></dd></div>
                            <div><dt class="text-zinc-500">Ville / Région</dt><dd class="text-zinc-100" x-text="[detailTarget.city, detailTarget.region].filter(Boolean).join(', ') || '—'"></dd></div>
                            <div><dt class="text-zinc-500">Effectif estimé</dt><dd class="text-zinc-100" x-text="detailTarget.estimatedStudentCount ?? '—'"></dd></div>
                            <div class="sm:col-span-2"><dt class="text-zinc-500">Adresse</dt><dd class="text-zinc-100" x-text="detailTarget.schoolAddress || '—'"></dd></div>
                        </dl>
                    </div>

                    <div>
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Responsable</h3>
                        <dl class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
                            <div><dt class="text-zinc-500">Nom complet</dt><dd class="text-zinc-100" x-text="detailTarget.directorFullName"></dd></div>
                            <div><dt class="text-zinc-500">Téléphone</dt><dd class="text-zinc-100" x-text="detailTarget.directorPhone"></dd></div>
                            <div class="sm:col-span-2"><dt class="text-zinc-500">E-mail</dt><dd class="text-zinc-100" x-text="detailTarget.directorEmail"></dd></div>
                        </dl>
                    </div>

                    <div x-show="detailTarget.status === 'Rejected' && detailTarget.rejectionReason" x-cloak
                         class="rounded-2xl border border-rose-500/30 bg-rose-500/10 px-4 py-3">
                        <p class="text-[11px] font-bold uppercase tracking-wider text-rose-400">Motif du rejet</p>
                        <p class="mt-1 text-sm text-rose-300" x-text="detailTarget.rejectionReason"></p>
                    </div>

                    <div class="flex justify-end gap-3 border-t border-zinc-800 pt-4">
                        <template x-if="detailTarget.status === 'Pending'">
                            <span class="inline-flex gap-3">
                                <button type="button" x-on:click="openReject(detailTarget)"
                                        class="rounded-2xl border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-sm font-medium text-rose-300 hover:bg-rose-500/20 transition-colors">
                                    Rejeter
                                </button>
                                <button type="button" x-on:click="openApprove(detailTarget)"
                                        class="rounded-2xl bg-emerald-500 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-400 transition-colors">
                                    Approuver
                                </button>
                            </span>
                        </template>
                        <button type="button" x-show="detailTarget.status !== 'Pending'" x-on:click="closeDetail()"
                                class="rounded-2xl border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors">
                            Fermer
                        </button>
                    </div>
                </div>
            </template>
        </div>
    </div>

    @* ---------------------------------------------------------------- Confirmation d'approbation *@
    <div x-show="approveTarget" x-cloak
         class="fixed inset-0 z-40 flex items-center justify-center bg-black/70 backdrop-blur-sm px-4"
         x-on:keydown.escape.window="closeApprove()">
        <div class="w-full max-w-md rounded-xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl">
            <h2 class="text-base font-semibold text-white">Approuver la demande</h2>
            <p class="mt-2 text-sm text-zinc-400">
                Cette action crée l'établissement, le compte Directeur et son abonnement (en attente
                de paiement). Le Directeur pourra alors se connecter. Confirmez-vous ?
            </p>

            <div x-show="approveError" x-cloak class="mt-3 rounded-2xl border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-xs text-rose-300" x-text="approveError"></div>

            <div class="mt-4 rounded-2xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm">
                <p class="font-medium text-zinc-100" x-text="approveTarget && approveTarget.schoolName"></p>
                <p class="text-zinc-500" x-text="approveTarget && (approveTarget.directorFullName + ' · ' + approveTarget.directorEmail)"></p>
            </div>

            <div class="mt-6 flex justify-end gap-3 border-t border-zinc-800 pt-4">
                <button type="button" x-on:click="closeApprove()" :disabled="isApproving"
                        class="rounded-2xl border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors disabled:opacity-50">
                    Annuler
                </button>
                <button type="button" x-on:click="submitApprove()" :disabled="isApproving"
                        class="rounded-2xl bg-emerald-500 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-400 transition-colors disabled:opacity-50">
                    <span x-text="isApproving ? 'Création en cours…' : 'Approuver et créer'"></span>
                </button>
            </div>
        </div>
    </div>

    @* ---------------------------------------------------------------- Rejet (motif obligatoire) *@
    <div x-show="rejectTarget" x-cloak
         class="fixed inset-0 z-40 flex items-center justify-center bg-black/70 backdrop-blur-sm px-4"
         x-on:keydown.escape.window="closeReject()">
        <div class="w-full max-w-md rounded-xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl">
            <h2 class="text-base font-semibold text-white">Rejeter la demande</h2>
            <p class="mt-2 text-sm text-zinc-400">
                Le motif ci-dessous sera communiqué au demandeur. Aucune école n'est créée.
            </p>

            <div x-show="rejectErrors.global" x-cloak class="mt-3 rounded-2xl border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-xs text-rose-300" x-text="rejectErrors.global"></div>

            <form x-on:submit.prevent="submitReject()" novalidate class="mt-4">
                <label for="reject-reason" class="form-label-inverse">Motif du rejet</label>
                <textarea id="reject-reason" x-model="rejectReason" required maxlength="1000" rows="3"
                          placeholder="ex : Informations incomplètes, établissement non identifiable…"
                          class="w-full rounded-2xl border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"></textarea>
                <p x-show="rejectErrors.reason" x-cloak x-text="rejectErrors.reason" class="mt-1 text-xs text-rose-400"></p>

                <div class="mt-6 flex justify-end gap-3 border-t border-zinc-800 pt-4">
                    <button type="button" x-on:click="closeReject()" :disabled="isRejecting"
                            class="rounded-2xl border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors disabled:opacity-50">
                        Annuler
                    </button>
                    <button type="submit" :disabled="isRejecting"
                            class="rounded-2xl bg-rose-500 px-3 py-2 text-sm font-medium text-white hover:bg-rose-400 transition-colors disabled:opacity-50">
                        <span x-text="isRejecting ? 'Enregistrement…' : 'Confirmer le rejet'"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* ---------------------------------------------------------------- Confirmation : demande approuvée *@
    <div x-show="approvedResult" x-cloak
         class="fixed inset-0 z-40 flex items-center justify-center bg-black/70 backdrop-blur-sm px-4"
         x-on:keydown.escape.window="approvedResult = null">
        <div class="w-full max-w-md rounded-xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl">
            <h2 class="text-base font-semibold text-white">Demande approuvée</h2>
            <p class="mt-2 text-sm text-zinc-400">
                L'établissement
                <span class="font-medium text-zinc-100" x-text="approvedResult ? approvedResult.schoolName : ''"></span>
                a été créé.
                <span class="font-medium text-zinc-100" x-text="approvedResult ? approvedResult.directorFullName : ''"></span>
                peut désormais se connecter.
            </p>
            <p x-show="approvedResult && approvedResult.emailSent === false" x-cloak
               class="mt-3 rounded-lg bg-amber-500/10 border border-amber-500/20 px-3 py-2 text-xs text-amber-400">
                L'e-mail de confirmation n'a pas pu être envoyé au Directeur (aucun serveur SMTP configuré
                sur ce déploiement). Prévenez-le par un autre canal.
            </p>
            <div class="mt-6 flex justify-end border-t border-zinc-800 pt-4">
                <button type="button" x-on:click="approvedResult = null"
                        class="rounded-2xl bg-sky-500 px-3 py-2 text-sm font-medium text-white hover:bg-sky-400 transition-colors">
                    Fermer
                </button>
            </div>
        </div>
    </div>

    @* ---------------------------------------------------------------- Confirmation : demande rejetée *@
    <div x-show="rejectedResult" x-cloak
         class="fixed inset-0 z-40 flex items-center justify-center bg-black/70 backdrop-blur-sm px-4"
         x-on:keydown.escape.window="rejectedResult = null">
        <div class="w-full max-w-md rounded-xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl">
            <h2 class="text-base font-semibold text-white">Demande rejetée</h2>
            <p class="mt-2 text-sm text-zinc-400">
                La demande de
                <span class="font-medium text-zinc-100" x-text="rejectedResult ? rejectedResult.schoolName : ''"></span>
                a bien été rejetée.
            </p>
            <div class="mt-6 flex justify-end border-t border-zinc-800 pt-4">
                <button type="button" x-on:click="rejectedResult = null"
                        class="rounded-2xl bg-sky-500 px-3 py-2 text-sm font-medium text-white hover:bg-sky-400 transition-colors">
                    Fermer
                </button>
            </div>
        </div>
    </div>
</div>
