@{
    ViewData["Title"] = "Finance - Paramétrage des frais";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/fees.js" asp-append-version="true"></script>
}

<div x-data="feesView()">
    <!-- Titre et actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-jgk-title font-bold text-gray-900">Paramétrage des frais</h1>
            <p class="text-jgk-subtitle text-gray-500 mt-1">
                Définissez un montant standard par catégorie, puis ajustez les exceptions classe par classe.
            </p>
        </div>

        <div class="flex items-center gap-2" x-show="isDirecteur" x-cloak>
            <button x-on:click="openCreateCategory()" class="btn-secondary">
                <icon name="plus" class="w-5 h-5" />
                Catégorie
            </button>
            <button x-on:click="openApplyStandard()" :disabled="!selectedCategoryId" class="btn-primary">
                <icon name="wallet" class="w-5 h-5" />
                Appliquer un montant standard
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- État vide : aucune catégorie -->
    <div x-show="!isLoading && categories.length === 0" x-cloak class="card mt-6">
        <empty-state icon="wallet" title="Aucune catégorie de frais n'est configurée."
                     hint="Créez une catégorie (inscription, mensualité, cantine…) pour commencer." />
    </div>

    <!-- Grille -->
    <div x-show="categories.length > 0" x-cloak class="card mt-6 relative">

        <!-- Onglets de catégories -->
        <div class="border-b border-gray-200 px-2 overflow-x-auto">
            <nav class="flex gap-1 -mb-px" aria-label="Catégories de frais">
                <template x-for="category in categories" :key="category.id">
                    <button x-on:click="selectedCategoryId = category.id"
                            class="px-4 py-3 text-sm font-medium border-b-2 transition-colors whitespace-nowrap flex items-center gap-2"
                            :class="category.id === selectedCategoryId ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'">
                        <span x-text="category.name"></span>
                        <badge x-show="category.isRecurring" x-cloak variant="neutral" class="text-[10px] uppercase tracking-wide">Mensuel</badge>
                    </button>
                </template>
            </nav>
        </div>

        <!-- Synthèse de la catégorie sélectionnée + recherche/filtre -->
        <div class="p-4 bg-gray-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100">
            <div class="flex gap-6">
                <stat-card size="compact" label="Classes" icon="building" accent="primary">
                    <span x-text="classrooms.length"></span>
                </stat-card>
                <stat-card size="compact" label="Montants définis" icon="wallet">
                    <span :class="definedCount === classrooms.length ? 'text-success' : 'text-warning'"
                          x-text="definedCount + ' / ' + classrooms.length"></span>
                </stat-card>
            </div>

            <div class="flex gap-3">
                <select x-model="levelFilter" aria-label="Filtrer par niveau" class="input-field mt-0 w-40 bg-white">
                    <option value="">Tous les niveaux</option>
                    <template x-for="level in knownLevels" :key="level">
                        <option :value="level" x-text="level"></option>
                    </template>
                </select>

                <div class="relative w-full sm:w-56">
                    <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <icon name="search" class="w-4 h-4 text-gray-400" />
                    </span>
                    <input type="search" x-model="search" placeholder="Rechercher une classe…"
                           aria-label="Rechercher une classe"
                           class="input-field mt-0 w-full pl-9" />
                </div>
            </div>
        </div>

        <!-- Aucune classe -->
        <div x-show="classrooms.length === 0" x-cloak>
            <empty-state icon="building" title="Aucune classe n'est encore définie."
                         hint="Créez vos classes avant de paramétrer leurs frais." />
        </div>

        <!-- Tableau des classes -->
        <div x-show="classrooms.length > 0" x-cloak class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <sort-th column="name" sort-key="sortKey" sort-dir="sortDir" on-sort="toggleSort('name')" class="py-3 px-4">Classe</sort-th>
                        <sort-th column="level" sort-key="sortKey" sort-dir="sortDir" on-sort="toggleSort('level')" class="py-3 px-4">Niveau</sort-th>
                        <sort-th column="amount" sort-key="sortKey" sort-dir="sortDir" on-sort="toggleSort('amount')" class="py-3 px-4 text-right">Montant</sort-th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-cell divide-y divide-gray-100">
                    <tr x-show="rows.length === 0" x-cloak>
                        <td colspan="4">
                            <empty-state icon="search" title="Aucune classe ne correspond à la recherche."
                                         hint="Essayez un autre nom, niveau ou filtre." />
                        </td>
                    </tr>

                    <template x-for="row in rows" :key="row.classroom.id">
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-3 px-4 font-medium text-gray-900" x-text="row.classroom.name"></td>
                            <td class="py-3 px-4"><badge variant="neutral" x-text="row.classroom.level"></badge></td>
                            <td class="py-3 px-4 text-right font-bold" :class="row.fee ? 'text-gray-900' : 'text-gray-300'">
                                <span x-show="row.fee" x-text="formatMoney(row.fee ? row.fee.amount : null)"></span>
                                <span x-show="!row.fee" x-cloak class="text-xs font-medium text-gray-400 italic">non défini</span>
                            </td>
                            <td class="py-3 px-4 text-right whitespace-nowrap">
                                <button x-show="row.fee" x-cloak x-on:click="openHistory(row)"
                                        class="text-xs font-medium text-gray-500 hover:text-primary px-2 py-1 rounded transition-colors"
                                        title="Historique des modifications">
                                    Historique
                                </button>
                                <button x-show="isDirecteur && row.fee" x-cloak x-on:click="openEdit(row)"
                                        class="text-xs font-medium text-primary bg-indigo-50 hover:bg-indigo-100 px-3 py-1 rounded-md transition-colors ml-1">
                                    Modifier
                                </button>
                                <span x-show="isDirecteur && !row.fee" x-cloak class="text-xs text-gray-400 italic">
                                    Appliquez un standard
                                </span>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Création d'une catégorie de frais -->
    <modal-shell open="isCategoryOpen" title="Nouvelle catégorie de frais">
        <modal-subtitle>Inscription, mensualité, cantine, transport… la liste est libre.</modal-subtitle>

        <div x-show="categoryErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="categoryErrors.global"></div>
        <form x-on:submit.prevent="submitCreateCategory()" class="space-y-4">
            <div>
                <label for="cat-name" class="block text-sm font-medium text-gray-700">Nom de la catégorie <span class="text-danger">*</span></label>
                <input id="cat-name" type="text" x-model="newCategory.name" required maxlength="60" placeholder="ex : Mensualité" class="input-field">
                <p x-show="categoryErrors.name" x-cloak x-text="categoryErrors.name" class="mt-1 text-xs text-danger"></p>
            </div>
            <div class="flex items-start gap-2">
                <input id="cat-recurring" type="checkbox" x-model="newCategory.isRecurring" class="mt-1 rounded border-gray-300 text-primary focus:ring-primary">
                <label for="cat-recurring" class="text-sm text-gray-700">
                    Frais mensuel (dû chaque mois)
                    <span class="block text-xs text-gray-400">Décochez pour un frais ponctuel : inscription, uniforme…</span>
                </label>
            </div>
            <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
                <button type="button" x-on:click="isCategoryOpen = false" class="btn-secondary">Annuler</button>
                <button type="submit" :disabled="isSavingCategory" class="btn-primary">
                    <span x-text="isSavingCategory ? 'Enregistrement...' : 'Créer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Modale : appliquer un montant standard -->
    <modal-shell open="isApplyOpen" size="md">
        <modal-title>Montant standard — <span class="text-indigo-100" x-text="selectedCategory ? selectedCategory.name : ''"></span></modal-title>
        <modal-subtitle>
            Ce montant s'appliquera à
            <span class="font-semibold" x-text="classrooms.length"></span>
            classe(s) en une fois.
        </modal-subtitle>

        <!-- Compte-rendu après application -->
        <div x-show="applyReport" x-cloak class="mb-4 rounded-md border-l-4 border-success bg-success-bg p-3 text-sm text-success">
            <span x-text="applyReport ? applyReport.created : 0"></span> créée(s),
            <span x-text="applyReport ? applyReport.updated : 0"></span> réalignée(s),
            <span x-text="applyReport ? applyReport.skipped : 0"></span> inchangée(s).
        </div>

        <div x-show="applyErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="applyErrors.global"></div>

        <form x-on:submit.prevent="submitApplyStandard()" class="space-y-4">
            <div>
                <label for="apply-amount" class="block text-sm font-medium text-gray-700">Montant (FCFA) <span class="text-danger">*</span></label>
                <input id="apply-amount" type="number" x-model.number="applyForm.amount" required min="0" step="500" placeholder="ex : 15000" class="input-field">
                <p x-show="applyErrors.amount" x-cloak x-text="applyErrors.amount" class="mt-1 text-xs text-danger"></p>
            </div>
            <div class="flex items-start gap-2">
                <input id="apply-overwrite" type="checkbox" x-model="applyForm.overwriteExisting" class="mt-1 rounded border-gray-300 text-primary focus:ring-primary">
                <label for="apply-overwrite" class="text-sm text-gray-700">
                    Écraser les montants déjà définis
                    <span class="block text-xs text-gray-400">Décoché, les exceptions ajustées classe par classe sont préservées.</span>
                </label>
            </div>
            <div class="mt-6 flex justify-end gap-3">
                <button type="button" x-on:click="isApplyOpen = false" class="btn-secondary">Fermer</button>
                <button type="submit" :disabled="isApplying" class="btn-primary">
                    <span x-text="isApplying ? 'Application...' : 'Appliquer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Modale : modifier une exception -->
    <modal-shell open="editing" on-close="closeEdit()" size="md">
        <modal-title>Montant — <span class="text-indigo-100" x-text="editing ? editing.classroomName : ''"></span></modal-title>
        <modal-subtitle><span x-text="selectedCategory ? selectedCategory.name : ''"></span></modal-subtitle>

        <div x-show="editErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="editErrors.global"></div>

        <form x-on:submit.prevent="submitEdit()" class="space-y-4">
            <div>
                <label for="edit-amount" class="block text-sm font-medium text-gray-700">Montant (FCFA) <span class="text-danger">*</span></label>
                <input id="edit-amount" type="number" x-model.number="editing.amount" required min="0" step="500"
                       x-effect="if (editing) $nextTick(() => $el.focus())" class="input-field">
                <p x-show="editErrors.amount" x-cloak x-text="editErrors.amount" class="mt-1 text-xs text-danger"></p>
            </div>
            <div class="mt-6 flex justify-end gap-3">
                <button type="button" x-on:click="closeEdit()" class="btn-secondary">Annuler</button>
                <button type="submit" :disabled="isSavingEdit" class="btn-primary">
                    <span x-text="isSavingEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Modale : historique -->
    <modal-shell open="historyFor" on-close="closeHistory()" size="lg">
        <modal-title>Historique — <span class="text-indigo-100" x-text="historyFor ? historyFor.classroomName : ''"></span></modal-title>

        <div x-show="isLoadingHistory" class="py-8 text-center text-sm text-gray-400">Chargement…</div>

        <div x-show="!isLoadingHistory && historyEntries.length === 0" x-cloak class="py-8 text-center text-sm text-gray-400">
            Aucune modification enregistrée.
        </div>

        <ul x-show="!isLoadingHistory && historyEntries.length > 0" x-cloak class="max-h-80 divide-y divide-gray-100 overflow-y-auto">
            <template x-for="(entry, index) in historyEntries" :key="index">
                <li class="flex items-start justify-between gap-4 py-3">
                    <div>
                        <p class="text-sm text-gray-900">
                            <span x-show="entry.oldAmount !== null" x-cloak>
                                <span class="text-gray-400 line-through" x-text="formatMoney(entry.oldAmount)"></span>
                                <span class="text-gray-400">→</span>
                            </span>
                            <span class="font-semibold" x-text="formatMoney(entry.newAmount)"></span>
                            <span x-show="entry.oldAmount === null" x-cloak class="ml-1 text-xs text-gray-400">(définition initiale)</span>
                        </p>
                        <p class="mt-0.5 text-xs text-gray-500" x-text="'par ' + entry.changedByName"></p>
                    </div>
                    <span class="whitespace-nowrap text-xs text-gray-400" x-text="formatDate(entry.changedAt)"></span>
                </li>
            </template>
        </ul>
    </modal-shell>
</div>
