@{
    ViewData["Title"] = "Inscriptions";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/enrollments.js" asp-append-version="true"></script>
}

@* Impression du seul reçu : on masque tout le reste de l'application (barre latérale, formulaire,
   barre d'actions) plutôt que d'ouvrir une fenêtre séparée. La règle visibility:hidden conserve la
   mise en page ; le reçu, remis en absolu en haut de page, s'imprime seul. *@
<style>
    @@media print {
        body * { visibility: hidden !important; }
        #receipt-printable, #receipt-printable * { visibility: visible !important; }
        #receipt-printable {
            position: absolute; left: 0; top: 0; width: 100%;
            margin: 0; padding: 0; box-shadow: none !important; border: 0 !important;
        }
        .no-print { display: none !important; }
    }
</style>

<div x-data="enrollmentsView()">
    <!-- Titre -->
    <div>
        <h1 class="text-jgk-title font-bold text-gray-900">Inscriptions</h1>
        <p class="text-jgk-subtitle text-gray-500 mt-1">
            Inscrivez un nouvel élève ou réinscrivez un élève existant pour l'année scolaire active.
            Les frais dus sont calculés automatiquement à partir du barème de la classe.
        </p>
    </div>

    <!-- Rôle non autorisé : le service Finance encaisse, il ne compose pas le montant dû (règle #4). -->
    <div x-show="!canEnroll" x-cloak class="mt-6 card py-12 text-center">
        <p class="text-gray-500 font-medium">Seuls le Directeur et le Secrétariat peuvent inscrire un élève.</p>
        <p class="text-xs text-gray-400 mt-1">Vous pouvez consulter un reçu depuis la fiche d'un élève.</p>
    </div>

    <div x-show="canEnroll" x-cloak>

        <!-- Chargement -->
        <div x-show="isLoading" class="mt-6 flex items-center justify-center py-12">
            <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </div>

        @await Html.PartialAsync("_ErrorBanner")

        <!-- Aucune année active : rien à rattacher, on bloque l'inscription. -->
        <div x-show="!isLoading && !error && !activeYear" x-cloak class="mt-6 rounded-md border-l-4 border-warning bg-warning-bg p-4">
            <p class="text-sm font-medium text-warning">Aucune année scolaire active.</p>
            <p class="text-xs text-warning mt-1">
                Activez une année scolaire (<a href="/parametres?tab=annees-scolaires" class="underline font-medium">Paramètres › Années scolaires</a>) avant d'inscrire un élève.
            </p>
        </div>

        <!-- ============================= FORMULAIRE + APERÇU ============================= -->
        <div x-show="!isLoading && !error && activeYear && !receipt" x-cloak class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Colonne formulaire -->
            <div class="lg:col-span-2 card p-6 space-y-6">

                <!-- Bandeau année active -->
                <div class="flex items-center gap-2 text-sm text-gray-500">
                    <badge variant="success">Année active</badge>
                    <span class="font-medium text-gray-900" x-text="activeYear ? activeYear.label : ''"></span>
                </div>

                <!-- Choix du mode -->
                <div>
                    <span class="block text-sm font-medium text-gray-700 mb-2">Type de mouvement</span>
                    <div class="inline-flex rounded-lg border border-gray-300 p-0.5 bg-gray-50">
                        <button type="button" x-on:click="selectMode('NewEnrollment')"
                                class="px-4 py-1.5 text-sm font-medium rounded-md transition-colors"
                                :class="mode === 'NewEnrollment' ? 'bg-white text-primary shadow-sm' : 'text-gray-500 hover:text-gray-700'">
                            Nouvelle inscription
                        </button>
                        <button type="button" x-on:click="selectMode('ReEnrollment')"
                                class="px-4 py-1.5 text-sm font-medium rounded-md transition-colors"
                                :class="mode === 'ReEnrollment' ? 'bg-white text-primary shadow-sm' : 'text-gray-500 hover:text-gray-700'">
                            Réinscription
                        </button>
                    </div>
                </div>

                <form x-on:submit.prevent="submit()" class="space-y-5">

                    <!-- Erreur métier globale -->
                    <div x-show="formErrors.global" x-cloak class="rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="formErrors.global"></div>
                    <div x-show="formErrors.schoolyear" x-cloak class="rounded-md border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="formErrors.schoolyear"></div>

                    <!-- Classe -->
                    <div>
                        <label for="enr-classroom" class="block text-sm font-medium text-gray-700">Classe d'affectation <span class="text-danger">*</span></label>
                        <select id="enr-classroom" x-model="form.classroomId" required class="input-field bg-white">
                            <option value="">— Choisir une classe —</option>
                            <template x-for="c in classrooms" :key="c.id">
                                <option :value="c.id" x-text="classroomLabel(c)"></option>
                            </template>
                        </select>
                        <p x-show="formErrors.classroomid" x-cloak x-text="formErrors.classroomid" class="mt-1 text-xs text-danger"></p>
                        <p x-show="classrooms.length === 0" x-cloak class="mt-1 text-xs text-gray-400">
                            Aucune classe définie. Créez vos classes avant d'inscrire (<a href="/classes" class="underline">Classes</a>).
                        </p>
                    </div>

                    <!-- Nouvelle inscription : état civil de l'élève -->
                    <div x-show="mode === 'NewEnrollment'" x-cloak class="space-y-5">
                        <div>
                            <label for="enr-fullname" class="block text-sm font-medium text-gray-700">Nom complet de l'élève <span class="text-danger">*</span></label>
                            <input id="enr-fullname" type="text" x-model="form.fullName" maxlength="200" placeholder="ex : Awa Ndiaye" class="input-field">
                            <p x-show="formErrors.fullname" x-cloak x-text="formErrors.fullname" class="mt-1 text-xs text-danger"></p>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label for="enr-birthdate" class="block text-sm font-medium text-gray-700">Date de naissance <span class="text-danger">*</span></label>
                                <input id="enr-birthdate" type="date" x-model="form.birthDate" class="input-field">
                                <p x-show="formErrors.birthdate" x-cloak x-text="formErrors.birthdate" class="mt-1 text-xs text-danger"></p>
                            </div>
                            <div>
                                <label for="enr-gender" class="block text-sm font-medium text-gray-700">Genre <span class="text-danger">*</span></label>
                                <select id="enr-gender" x-model="form.gender" class="input-field bg-white">
                                    <option value="M">Masculin</option>
                                    <option value="F">Féminin</option>
                                </select>
                                <p x-show="formErrors.gender" x-cloak x-text="formErrors.gender" class="mt-1 text-xs text-danger"></p>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label for="enr-guardian" class="block text-sm font-medium text-gray-700">Nom du tuteur</label>
                                <input id="enr-guardian" type="text" x-model="form.guardianName" maxlength="200" placeholder="Parent / tuteur" class="input-field">
                            </div>
                            <div>
                                <label for="enr-guardian-phone" class="block text-sm font-medium text-gray-700">Téléphone du tuteur</label>
                                <input id="enr-guardian-phone" type="tel" x-model="form.guardianPhone" maxlength="30" placeholder="77 000 00 00" class="input-field">
                            </div>
                        </div>
                    </div>

                    <!-- Réinscription : sélection d'un élève existant -->
                    <div x-show="mode === 'ReEnrollment'" x-cloak>
                        <label for="enr-student-search" class="block text-sm font-medium text-gray-700">Élève à réinscrire <span class="text-danger">*</span></label>
                        <input id="enr-student-search" type="text" x-model="studentSearch" placeholder="Rechercher par nom ou matricule…"
                               x-on:input="form.studentId = ''"
                               class="input-field">
                        <p x-show="formErrors.studentid" x-cloak x-text="formErrors.studentid" class="mt-1 text-xs text-danger"></p>

                        <div class="mt-2 border border-gray-200 rounded-md divide-y divide-gray-100 max-h-56 overflow-y-auto">
                            <template x-for="s in filteredStudents()" :key="s.id">
                                <button type="button" x-on:click="selectStudent(s)"
                                        class="w-full text-left px-3 py-2 hover:bg-gray-50 flex items-center justify-between transition-colors"
                                        :class="form.studentId === s.id ? 'bg-indigo-50' : ''">
                                    <span class="text-sm text-gray-900" x-text="s.fullName"></span>
                                    <span class="text-xs font-mono text-gray-500" x-text="s.matricule"></span>
                                </button>
                            </template>
                            <div x-show="studentsLoaded && filteredStudents().length === 0" x-cloak class="px-3 py-4 text-sm text-gray-400 text-center">
                                Aucun élève ne correspond.
                            </div>
                            <div x-show="!studentsLoaded" class="px-3 py-4 text-sm text-gray-400 text-center">Chargement des élèves…</div>
                        </div>
                    </div>

                    <!-- Soumission -->
                    <div class="pt-2 flex justify-end border-t border-gray-100">
                        <button type="submit" :disabled="!canSubmit()" class="btn-primary mt-4">
                            <icon x-show="!isSubmitting" name="checkmark-circle" class="w-5 h-5" />
                            <span x-text="isSubmitting ? 'Enregistrement…' : 'Inscrire l\'élève'"></span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Colonne aperçu des frais -->
            <div class="lg:col-span-1">
                <div class="card p-5 lg:sticky lg:top-4">
                    <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wider">Frais dus</h2>
                    <p class="text-xs text-gray-400 mt-0.5">Calcul en direct — le serveur fait foi à l'enregistrement.</p>

                    <!-- Pas de classe -->
                    <div x-show="!form.classroomId" x-cloak class="py-8 text-center">
                        <p class="text-sm text-gray-400">Sélectionnez une classe pour voir les frais.</p>
                    </div>

                    <!-- Classe sans barème -->
                    <div x-show="form.classroomId && !hasFeesForSelectedClass()" x-cloak class="py-8 text-center">
                        <p class="text-sm text-gray-500 font-medium">Aucun barème défini pour cette classe.</p>
                        <p class="text-xs text-gray-400 mt-1">Le montant dû sera de 0 FCFA. Paramétrez les frais dans <a href="/frais" class="underline">Finance</a>.</p>
                    </div>

                    <!-- Détail -->
                    <div x-show="form.classroomId && hasFeesForSelectedClass()" x-cloak class="mt-4">
                        <ul class="divide-y divide-gray-100">
                            <template x-for="line in previewLines()" :key="line.designation">
                                <li class="py-2.5 flex items-start justify-between gap-3">
                                    <div>
                                        <p class="text-sm text-gray-800" x-text="line.designation"></p>
                                        <p x-show="line.isRecurring" x-cloak class="text-xs text-gray-400"
                                           x-text="formatMoney(line.unitAmount) + ' × ' + line.months + ' mois'"></p>
                                    </div>
                                    <span class="text-sm font-medium text-gray-900 whitespace-nowrap" x-text="formatMoney(line.lineTotal)"></span>
                                </li>
                            </template>
                        </ul>
                        <div class="mt-3 pt-3 border-t-2 border-gray-200 flex items-center justify-between">
                            <span class="text-sm font-semibold text-gray-900 uppercase tracking-wide">Total à payer</span>
                            <span class="text-lg font-bold text-primary" x-text="formatMoney(previewTotal())"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================= REÇU ============================= -->
        <div x-show="receipt" x-cloak class="mt-6">

            <!-- Barre d'actions (non imprimée) -->
            <div class="no-print flex items-center justify-between mb-4">
                <div class="flex items-center gap-2 text-success">
                    <icon name="checkmark-circle" class="w-6 h-6" />
                    <span class="text-sm font-medium">Inscription enregistrée.</span>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" x-on:click="startNewEnrollment()" class="btn-secondary">
                        Nouvelle inscription
                    </button>
                    <button type="button" x-on:click="downloadPdf()" class="btn-secondary">
                        <icon name="download" class="w-5 h-5" />
                        Télécharger le PDF
                    </button>
                    <button type="button" x-on:click="printReceipt()" class="btn-primary">
                        <icon name="print" class="w-5 h-5" />
                        Imprimer
                    </button>
                </div>
            </div>

            <!-- Échec de téléchargement du PDF (non imprimé). -->
            <div x-show="pdfError" x-cloak class="no-print mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="pdfError"></div>

            <!-- Document imprimable : noir et blanc, sobre (docs/design-references/README.md §1) -->
            <div id="receipt-printable" class="bg-white border border-gray-300 mx-auto max-w-2xl p-8 text-gray-900" style="font-family: 'Times New Roman', Georgia, serif;">

                <!-- En-tête établissement -->
                <div class="flex items-start justify-between border-b border-gray-400 pb-4">
                    <div>
                        <h2 class="text-2xl font-bold uppercase" x-text="receipt.schoolName"></h2>
                        <p class="text-sm text-gray-600 mt-0.5">
                            <span x-text="receipt.schoolName"></span>
                            <span x-show="receipt.schoolPhone" x-cloak> · Téléphone : <span x-text="receipt.schoolPhone"></span></span>
                        </p>
                    </div>
                    <div class="w-20 h-20 border border-dashed border-gray-300 flex items-center justify-center text-[10px] text-gray-400 text-center">Logo officiel</div>
                </div>

                <!-- Titre -->
                <h3 class="text-center font-bold italic text-lg my-5">
                    REÇU D'INSCRIPTION n° <span x-text="receiptReference()"></span>
                </h3>

                <!-- Bloc d'informations -->
                <table class="w-full text-sm mb-6">
                    <tbody>
                        <tr>
                            <td class="py-1 pr-4 text-gray-600 w-1/3">Matricule</td>
                            <td class="py-1 font-semibold" x-text="receipt.matricule"></td>
                        </tr>
                        <tr>
                            <td class="py-1 pr-4 text-gray-600">Nom complet</td>
                            <td class="py-1 font-semibold" x-text="receipt.studentFullName"></td>
                        </tr>
                        <tr>
                            <td class="py-1 pr-4 text-gray-600">Classe d'affectation</td>
                            <td class="py-1 font-semibold" x-text="receipt.classroomName + ' — ' + receipt.classroomLevel"></td>
                        </tr>
                        <tr>
                            <td class="py-1 pr-4 text-gray-600">Année scolaire</td>
                            <td class="py-1 font-semibold" x-text="receipt.schoolYearLabel"></td>
                        </tr>
                        <tr>
                            <td class="py-1 pr-4 text-gray-600">Type de mouvement</td>
                            <td class="py-1 font-semibold" x-text="typeLabel(receipt.type)"></td>
                        </tr>
                        <tr>
                            <td class="py-1 pr-4 text-gray-600">Date de l'opération</td>
                            <td class="py-1 font-semibold" x-text="formatDate(receipt.enrolledAt)"></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Tableau des frais -->
                <table class="w-full text-sm border border-gray-400 border-collapse">
                    <thead>
                        <tr class="border-b border-gray-400">
                            <th class="text-left py-2 px-3 border-r border-gray-400 font-bold">Désignation des frais</th>
                            <th class="text-right py-2 px-3 font-bold">Montant (FCFA)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="line in receipt.lines" :key="line.designation">
                            <tr class="border-b border-gray-300">
                                <td class="py-2 px-3 border-r border-gray-400">
                                    <span x-text="line.designation"></span><span class="text-gray-500" x-text="recurringSuffix(line)"></span>
                                </td>
                                <td class="py-2 px-3 text-right" x-text="formatMoney(line.lineTotal)"></td>
                            </tr>
                        </template>
                        <tr x-show="receipt.lines.length === 0" x-cloak>
                            <td class="py-2 px-3 border-r border-gray-400 text-gray-500 italic" colspan="1">Aucun frais paramétré pour cette classe</td>
                            <td class="py-2 px-3 text-right">0 FCFA</td>
                        </tr>
                        <tr class="border-t-2 border-gray-500 font-bold">
                            <td class="py-2 px-3 border-r border-gray-400 uppercase">Total encaissé</td>
                            <td class="py-2 px-3 text-right" x-text="formatMoney(receipt.totalDue)"></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Mention obligatoire (AGENTS.md règle #12) -->
                <p class="text-center text-sm italic mt-5">
                    Il est demandé aux parents de garder minutieusement leur reçu après le paiement.
                </p>

                <!-- Bas de page -->
                <div class="flex justify-between items-end mt-8 text-sm">
                    <div>
                        <p class="italic" x-text="faitMention()"></p>
                        <div class="mt-2 w-32 h-16 border border-dashed border-gray-300 flex items-center justify-center text-[10px] text-gray-400">Cachet officiel</div>
                    </div>
                    <div class="text-right">
                        <p class="italic">Signature du Directeur / Service Financier</p>
                        <div class="mt-10 w-40 border-t border-gray-400"></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
