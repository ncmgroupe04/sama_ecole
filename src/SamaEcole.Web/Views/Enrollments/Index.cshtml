@{
 ViewData["Title"] = "Inscriptions";
 var genderOptions = new List<SelectFieldOption> { new("M", "Masculin"), new("F", "Féminin") };
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/enrollments.js" asp-append-version="true"></script>
}

@* Impression du seul reçu : on masque tout le reste de l'application (barre latérale, formulaire,
 barre d'actions) plutôt que d'ouvrir une fenêtre séparée. La règle visibility:hidden conserve la
 mise en page ; le reçu, remis en absolu en haut de page, s'imprime seul.

 Format A5 PAYSAGE (210 × 148 mm), marge de 10 mm — les cotes exactes du PDF QuestPDF, pour que
 l'écran, l'impression navigateur et le PDF ne montrent jamais trois documents différents.
 La marge est un padding de la feuille à l'écran, et est portée par @@page à l'impression : les
 deux ne se cumulent donc pas, et la zone utile fait 190 × 128 mm de part et d'autre.
 Le débordement se voit AVANT d'imprimer — checkReceiptFit() le mesure et l'affiche. *@
<style>
    /* A5 PAYSAGE, marge 10 mm — mêmes cotes que le PDF QuestPDF (PageSizes.A5.Landscape() +
       Margin(10, Unit.Millimetre)) : zone utile de 190 × 128 mm de part et d'autre.
       À l'écran la marge est un padding de la feuille, à l'impression elle est portée par @@page.
       Le contenu occupe donc EXACTEMENT la même boîte dans les deux cas, et le débordement se voit
       avant d'imprimer — l'indicateur de tenue en page le mesure et l'affiche. */
    .receipt-a5 {
        width: 210mm;
        height: 148mm;
        padding: 10mm;
        font-family: 'Inter', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        display: flex;
        flex-direction: column;
        /* Aucun bloc ne se laisse comprimer : un dépassement doit être VISIBLE et mesurable,
           jamais absorbé par un écrasement silencieux du texte. */
        --receipt-tabular: tabular-nums;
        font-variant-numeric: var(--receipt-tabular);
        -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
    }

    .receipt-a5 > * { flex-shrink: 0; }

    @@page {
        size: A5 landscape;
        margin: 10mm;
    }

    @@media print {
        /* L'application entière disparaît, seule la pièce reste. visibility (et non display) préserve
           la mise en page des ancêtres, sans quoi le reçu remonterait dans un conteneur effondré. */
        body * { visibility: hidden !important; }
        .no-print, button, .btn, .nav-bar, header, nav, aside, footer { display: none !important; }

        html, body { margin: 0 !important; padding: 0 !important; height: auto !important; background: #fff !important; }

        #receipt-printable, #receipt-printable * { visibility: visible !important; }

        #receipt-printable {
            position: absolute !important; left: 0 !important; top: 0 !important;
            /* La marge est portée par @@page : la feuille imprimée est la zone utile seule. */
            width: 190mm !important;
            height: 128mm !important;
            max-height: 128mm !important;
            margin: 0 !important; padding: 0 !important;
            box-shadow: none !important; border: 0 !important; border-radius: 0 !important;
            /* Dernier garde-fou : rien ne peut déclencher une 2e page. L'indicateur de tenue en page
               signale le cas À L'ÉCRAN avant l'impression, pour qu'il soit corrigé et non subi. */
            overflow: hidden !important;
            page-break-inside: avoid !important; break-inside: avoid !important;
            page-break-after: avoid !important; page-break-before: avoid !important;
        }

        #receipt-printable * { page-break-inside: avoid !important; break-inside: avoid !important; }
    }
</style>

<div x-data="enrollmentsView()">
 <!-- Titre -->
 <div>
 <h1 class="page-title">Inscriptions</h1>
 <p class="page-subtitle">
 Inscrivez un nouvel élève ou réinscrivez un élève existant pour l'année scolaire active.
 Les frais dus sont calculés automatiquement à partir du barème de la classe.
 </p>
 </div>

 <!-- Rôle non autorisé : le service Finance encaisse, il ne compose pas le montant dû (règle #4). -->
 <div x-show="!canEnroll" x-cloak class="mt-6 card py-12 text-center">
 <p class="text-slate-500 font-medium">Seuls le Directeur et le Secrétariat peuvent inscrire un élève.</p>
 <p class="text-xs text-slate-400 mt-1">Vous pouvez consulter un reçu depuis la fiche d'un élève.</p>
 </div>

 <div x-show="canEnroll" x-cloak>

 <!-- Chargement -->
 <div x-show="isLoading" class="mt-6 flex items-center justify-center py-12">
 <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- Aucune année active : rien à rattacher, on bloque l'inscription. -->
 <div x-show="!isLoading && !error && !activeYear" x-cloak class="mt-6 rounded-xl border-l-4 border-warning bg-warning-bg p-6">
 <p class="text-sm font-medium text-warning">Aucune année scolaire active.</p>
 <p class="text-xs text-warning mt-1">
 Activez une année scolaire (<a href="/parametres?tab=annees-scolaires" class="underline font-medium">Paramètres › Années scolaires</a>) avant d'inscrire un élève.
 </p>
 </div>

 <!-- ============================= FORMULAIRE + APERÇU ============================= -->
 <div x-show="!isLoading && !error && activeYear && !showReceipt" x-cloak class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">

 <!-- Colonne formulaire -->
 <div class="lg:col-span-2 card p-6 space-y-6">

 <!-- Bandeau année active -->
 <div class="flex items-center gap-2 text-sm text-slate-500">
 <badge variant="success" dot>Année active</badge>
 <span class="font-medium text-slate-900" x-text="activeYear ? activeYear.label : ''"></span>
 </div>

 <!-- Choix du mode -->
 <div>
 <span class="block text-sm font-medium text-slate-700 mb-2">Type de mouvement</span>
 <div class="inline-flex rounded-2xl border border-slate-300 p-0.5 bg-slate-50">
 <button type="button" x-on:click="selectMode('NewEnrollment')"
 class="px-4 py-1.5 text-sm font-medium rounded-xl transition-colors"
 :class="mode === 'NewEnrollment' ? 'bg-white text-primary shadow-sm' : 'text-slate-500 hover:text-slate-700'">
 Nouvelle inscription
 </button>
 <button type="button" x-on:click="selectMode('ReEnrollment')"
 class="px-4 py-1.5 text-sm font-medium rounded-xl transition-colors"
 :class="mode === 'ReEnrollment' ? 'bg-white text-primary shadow-sm' : 'text-slate-500 hover:text-slate-700'">
 Réinscription
 </button>
 </div>
 </div>

 <!-- Bandeau de restauration de brouillon -->
 <div x-show="hasDraft" x-cloak class="rounded-xl border border-amber-300 bg-amber-50 p-4 mb-4 text-amber-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
 <div class="flex items-center gap-3">
 <icon name="alert-circle" class="w-5 h-5 text-amber-600 shrink-0" />
 <p class="text-xs sm:text-sm">
 <strong class="font-semibold">Saisie en attente :</strong> Un formulaire non validé ou interrompu hors ligne a été retrouvé en mémoire.
 </p>
 </div>
 <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
 <button type="button" x-on:click="restoreDraft()" class="px-3 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold shadow-2xs transition-colors">
 Restaurer
 </button>
 <button type="button" x-on:click="clearDraft()" class="px-3 py-1.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-800 text-xs font-semibold transition-colors">
 Effacer
 </button>
 </div>
 </div>

 <form x-on:submit.prevent="submit()" novalidate class="space-y-5">

 <!-- Erreur métier globale -->
 <div x-show="formErrors.global" x-cloak class="rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="formErrors.global"></div>
 <div x-show="formErrors.schoolyear" x-cloak class="rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="formErrors.schoolyear"></div>

 <!-- Classe -->
 <div>
 <label for="enr-classroom" class="form-label form-label-required">Classe d'affectation</label>
 @* on-change : les frais diffèrent d'une classe à l'autre — la sélection d'encaissement est
 recomposée sur le barème de la nouvelle classe (voir resetCollected). *@
 <select-field id="enr-classroom" model="form.classroomId" required="true"
 placeholder="— Choisir une classe —" on-change="resetCollected()"
 options-expr="[{value:'', label:'— Choisir une classe —'}].concat(classrooms.map(c => ({value: c.id, label: classroomLabel(c)})))" />
 <p x-show="formErrors.classroomid" x-cloak x-text="formErrors.classroomid" class="field-error"></p>
 <p x-show="classrooms.length === 0" x-cloak class="mt-1 text-xs text-slate-400">
 Aucune classe définie. Créez vos classes avant d'inscrire (<a href="/classes" class="underline">Classes</a>).
 </p>
 </div>

 <!-- Classe redoublée (feature F) : coche portée par l'inscription, cochée [X] sur le
 bulletin (Enrollment.IsRepeating). Vaut pour une nouvelle inscription comme pour une
 réinscription — un élève peut redoubler qu'il soit nouveau dans l'école ou non. -->
 <label class="flex items-start gap-2.5 cursor-pointer select-none">
 <input type="checkbox" x-model="form.isRepeating"
 class="checkbox-field mt-0.5">
 <span class="text-sm text-slate-700">
 Classe redoublée
 <span class="block text-xs text-slate-400">L'élève redouble cette classe — la case sera cochée sur son bulletin.</span>
 </span>
 </label>

 <!-- Nouvelle inscription : état civil de l'élève -->
 <div x-show="mode === 'NewEnrollment'" x-cloak class="space-y-5">
 <div>
 <label for="enr-fullname" class="form-label form-label-required">Nom complet de l'élève</label>
 <input id="enr-fullname" type="text" x-model="form.fullName" maxlength="200" placeholder="ex : Awa Ndiaye" class="input-field" :class="formErrors.fullname && 'input-field-error'">
 <p x-show="formErrors.fullname" x-cloak x-text="formErrors.fullname" class="field-error"></p>
 </div>
 <div class="form-grid">
 <div>
 <label for="enr-birthdate" class="form-label form-label-required">Date de naissance</label>
 <date-field id="enr-birthdate" model="form.birthDate" />
 <p x-show="formErrors.birthdate" x-cloak x-text="formErrors.birthdate" class="field-error"></p>
 </div>
 <div>
 <label for="enr-gender" class="form-label form-label-required">Genre</label>
 <select-field id="enr-gender" model="form.gender" options="genderOptions" />
 <p x-show="formErrors.gender" x-cloak x-text="formErrors.gender" class="field-error"></p>
 </div>
 </div>
 <div>
 <label for="enr-birthplace" class="form-label form-label-required">Lieu de naissance</label>
 <input id="enr-birthplace" type="text" x-model="form.birthPlace" maxlength="200" placeholder="ex : Dakar" class="input-field" :class="formErrors.birthplace && 'input-field-error'">
 <p x-show="formErrors.birthplace" x-cloak x-text="formErrors.birthplace" class="field-error"></p>
 </div>
 <div class="form-grid">
 <div>
 <label for="enr-guardian" class="form-label">Nom du tuteur</label>
 <input id="enr-guardian" type="text" x-model="form.guardianName" maxlength="200" placeholder="Parent / tuteur" class="input-field">
 </div>
 <div>
 <label for="enr-guardian-phone" class="form-label">Téléphone du tuteur</label>
 <input id="enr-guardian-phone" type="tel" x-model="form.guardianPhone" maxlength="30" placeholder="77 000 00 00" class="input-field">
 </div>
 </div>
 </div>

 <!-- Réinscription : sélection d'un élève existant -->
 <div x-show="mode === 'ReEnrollment'" x-cloak>
 <label for="enr-student-search" class="block text-sm font-semibold text-slate-700">Élève à réinscrire <span class="text-danger">*</span></label>
 <input id="enr-student-search" type="text" x-model="studentSearch" placeholder="Rechercher par nom ou matricule…"
 x-on:input="form.studentId = ''"
 class="input-field" :class="formErrors.studentid && 'input-field-error'">
 <p x-show="formErrors.studentid" x-cloak x-text="formErrors.studentid" class="field-error"></p>

 <div class="mt-2 border border-slate-200 rounded-xl divide-y divide-slate-100 max-h-56 overflow-y-auto">
 <template x-for="s in filteredStudents()" :key="s.id">
 <button type="button" x-on:click="selectStudent(s)"
 class="w-full text-left px-3 py-2 hover:bg-slate-50 flex items-center justify-between transition-colors duration-150"
 :class="form.studentId === s.id ? 'bg-indigo-50' : ''">
 <span class="text-sm text-slate-900" x-text="s.fullName"></span>
 <span class="text-xs font-mono text-slate-500" x-text="s.matricule"></span>
 </button>
 </template>
 <div x-show="studentsLoaded && filteredStudents().length === 0" x-cloak class="px-3 py-4 text-sm text-slate-400 text-center">
 Aucun élève ne correspond.
 </div>
 <div x-show="!studentsLoaded" class="px-3 py-4 text-sm text-slate-400 text-center">Chargement des élèves…</div>
 </div>
 </div>

 <!-- Soumission -->
 <div class="pt-2 flex justify-end border-t border-slate-100">
 <button type="submit" :disabled="!canSubmit()" class="btn-modal-primary mt-4 group">
 <icon x-show="!isSubmitting" name="checkmark-circle" class="w-5 h-5" />
 <span x-text="isSubmitting ? 'Enregistrement…' : 'Inscrire l\'élève'"></span>
 </button>
 </div>
 </form>
 </div>

 <!-- Colonne aperçu des frais -->
 <div class="lg:col-span-1">
 <div class="card p-5 lg:sticky lg:top-4">
 <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Frais &amp; encaissement</h2>
 <p class="text-xs text-slate-400 mt-0.5">Cochez ce qui est réglé au guichet. Le serveur fait foi à l'enregistrement.</p>

 <!-- Pas de classe -->
 <div x-show="!form.classroomId" x-cloak class="py-8 text-center">
 <p class="text-sm text-slate-400">Sélectionnez une classe pour voir les frais.</p>
 </div>

 <!-- Classe sans barème -->
 <div x-show="form.classroomId && !hasFeesForSelectedClass()" x-cloak class="py-8 text-center">
 <p class="text-sm text-slate-500 font-medium">Aucun barème défini pour cette classe.</p>
 <p class="text-xs text-slate-400 mt-1">Le montant dû sera de 0 FCFA. Paramétrez les frais dans <a href="/frais" class="underline">Finance</a>.</p>
 </div>

 @* Détail du dû annuel ET encaissement du jour, au même endroit : la case cochée dit
 « ce frais est réglé maintenant », le reste alimentera la Caisse plus tard. Seul le
 total ENCAISSÉ partira sur le reçu (pièce comptable), le dû annuel n'y est qu'un rappel. *@
 <div x-show="form.classroomId && hasFeesForSelectedClass()" x-cloak class="mt-4">
 <ul class="divide-y divide-slate-100">
 <template x-for="line in previewLines()" :key="line.feeCategoryId">
 <li class="py-2.5">
 <label class="flex items-start justify-between gap-3 cursor-pointer select-none">
 <span class="flex items-start gap-2.5 min-w-0">
 <input type="checkbox" x-model="collectedEntry(line).checked"
 class="checkbox-field mt-0.5 shrink-0">
 <span class="min-w-0">
 <span class="block text-sm text-slate-800" x-text="line.designation"></span>
 <span x-show="line.isRecurring" x-cloak class="block text-xs text-slate-400"
 x-text="formatMoney(line.unitAmount) + ' × ' + line.months + ' mois'"></span>
 </span>
 </span>
 <span class="text-sm font-medium text-slate-900 whitespace-nowrap amount" x-text="formatMoney(line.lineTotal)"></span>
 </label>

 @* Mensualité : le tuteur règle rarement l'année entière le jour de l'inscription —
 il choisit le nombre de mois d'avance qu'il paie (1 par défaut). *@
 <div x-show="line.isRecurring && collectedEntry(line).checked" x-cloak
 class="mt-2 ml-7 flex items-center gap-2">
 <label class="text-xs text-slate-500" :for="'enr-months-' + line.feeCategoryId">Mois réglés</label>
 <input type="number" :id="'enr-months-' + line.feeCategoryId"
 x-model.number="collectedEntry(line).months" min="1" :max="line.months"
 class="input-field mt-0 w-20 py-1 text-sm">
 <span class="text-xs text-slate-400 amount" x-text="'= ' + formatMoney(collectedAmount(line))"></span>
 </div>
 </li>
 </template>
 </ul>

 <div class="mt-3 pt-3 border-t border-slate-200 flex items-center justify-between text-slate-500">
 <span class="text-xs uppercase tracking-wide">Total dû (année)</span>
 <span class="text-sm font-semibold amount" x-text="formatMoney(previewTotal())"></span>
 </div>

 <div class="mt-4 rounded-xl bg-primary-50 p-3">
 <label for="enr-payment-method" class="block text-xs font-medium text-primary-700">Mode de règlement</label>
 <select-field id="enr-payment-method" model="paymentMethod" class="mt-1"
 options-expr="[{value:'Cash', label:'Espèces'}, {value:'Cheque', label:'Chèque'}, {value:'Transfer', label:'Virement'}, {value:'MobileMoney', label:'Mobile Money'}]" />

 <div class="mt-3 flex items-center justify-between">
 <span class="text-sm font-semibold text-primary-700 uppercase tracking-wide">Encaissé ce jour</span>
 <span class="text-lg font-bold text-primary amount" x-text="formatMoney(collectedTotal())"></span>
 </div>
 <p x-show="collectedTotal() === 0" x-cloak class="mt-1 text-xs text-primary-700">
 Aucun frais coché : le dossier est ouvert sans versement, le reçu s'imprimera à 0 FCFA.
 </p>
 <p x-show="collectedTotal() > 0" x-cloak class="mt-1 text-xs text-primary-700"
 x-text="'Reste à payer après ce versement : ' + formatMoney(previewTotal() - collectedTotal())"></p>
 </div>
 </div>
 </div>
 </div>
 </div>

 <!-- ============================= REÇU ============================= -->
 <div x-show="showReceipt" x-cloak class="mt-6">

 <!-- Barre d'actions (non imprimée) : statut à gauche, actions alignées sur UNE seule ligne
      horizontale à droite (flex-row / items-center) — défilement horizontal en dernier recours
      sur écran très étroit plutôt que retour à la ligne. -->
 <div class="no-print flex flex-row items-center justify-between gap-4 mb-4">
 <div class="flex flex-wrap items-center gap-x-3 gap-y-1 min-w-0">
 <span class="flex items-center gap-2 text-success shrink-0">
 <icon name="checkmark-circle" class="w-6 h-6" />
 <span class="text-sm font-medium">Inscription enregistrée.</span>
 </span>

 @* Tenue en page, MESURÉE sur le rendu réel — pas une promesse. L'impression rogne un
 débordement (overflow:hidden) ; ce badge existe pour qu'il soit vu avant, et corrigé. *@
 <span x-show="receiptFitMm !== null && receiptFitMm >= -0.2" x-cloak
 class="rounded-full border border-success bg-success-bg px-2.5 py-0.5 text-xs font-medium text-success"
 x-text="'Tient sur une page · ' + receiptFitMm.toFixed(1) + ' mm libres'"></span>
 <span x-show="receiptFitMm !== null && receiptFitMm < -0.2" x-cloak
 class="rounded-full border border-warning bg-warning-bg px-2.5 py-0.5 text-xs font-medium text-warning"
 x-text="'Débordement : ' + Math.abs(receiptFitMm).toFixed(1) + ' mm — le bas sera rogné à l\'impression'"></span>
 </div>
 <div class="flex flex-row flex-nowrap items-center justify-end gap-2 overflow-x-auto">
 <button type="button" x-on:click="closeReceipt()" class="btn-modal-secondary group shrink-0">
 Retour
 </button>
 <button type="button" x-on:click="startNewEnrollment()" class="btn-modal-secondary group shrink-0">
 Nouvelle inscription
 </button>
 <button type="button" x-on:click="downloadPdf()" class="btn-modal-secondary group shrink-0">
 <icon name="document-text" class="w-5 h-5 text-indigo-600" />
 Attestation
 </button>
 <button type="button" x-on:click="downloadCertificatePdf()" class="btn-modal-secondary group shrink-0">
 <icon name="document-text" class="w-5 h-5 text-primary" />
 Certificat
 </button>
 <button type="button" x-on:click="printReceipt()" class="btn-modal-primary group shrink-0">
 <icon name="print" class="w-5 h-5" />
 Imprimer
 </button>
 </div>
 </div>

 @* Document imprimable A5 PAYSAGE : sobre, moderne, aux normes officielles *@
 <div id="receipt-printable" class="receipt-a5 receipt-container bg-white border border-slate-200/80 mx-auto text-slate-800 shadow-sm rounded-xl flex flex-col justify-between min-h-[148mm]">

 @* A. En-tête : logo à GAUCHE du nom, badges à droite. Le nom n'est plus en majuscules —
 refonte du 25/08/2026, cf. docs/design-references/README.md §1.1.

 Aucun badge d'ÉTAT DE PAIEMENT ici, volontairement : réimprimée trois mois plus tard,
 l'attestation en afficherait un faux. Le badge ne qualifie que l'acte administratif,
 vrai à toute date. *@
 <div class="receipt-header flex items-start gap-4 border-b border-slate-200 pb-3">
 <img x-show="receipt.schoolLogoUrl" x-cloak :src="receipt.schoolLogoUrl" class="h-10 w-10 shrink-0 object-contain" alt="" />
 <div class="min-w-0 flex-1">
 <h2 class="text-lg font-bold text-slate-900 tracking-tight" x-text="receipt.schoolName"></h2>
 <p class="text-[10px] text-slate-500 mt-0.5" x-text="contactLine()"></p>
 <p x-show="legalMentions()" x-cloak class="text-[10px] text-slate-500" x-text="legalMentions()"></p>
 </div>
 <div class="shrink-0 flex flex-col items-end gap-1">
 <span class="rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-indigo-700 whitespace-nowrap">Inscription enregistrée</span>
 <span class="rounded-full border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-slate-700 whitespace-nowrap">N°&nbsp;<span x-text="receiptReference()"></span></span>
 <span class="rounded-full border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-slate-700 whitespace-nowrap">Année&nbsp;<span x-text="receipt.schoolYearLabel"></span></span>
 </div>
 </div>

 <!-- B. Cartouche d'identité (grille 2 × 2) -->
 <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 rounded-lg border border-slate-200 bg-slate-50 px-4 py-2.5">
 <div>
 <div class="text-[9px] font-semibold uppercase tracking-wider text-slate-500">Élève</div>
 <div class="text-xs font-semibold text-slate-900" x-text="receipt.studentFullName"></div>
 </div>
 <div>
 <div class="text-[9px] font-semibold uppercase tracking-wider text-slate-500">Matricule</div>
 <div class="text-xs font-semibold text-slate-900 whitespace-nowrap" x-text="receipt.matricule"></div>
 </div>
 <div>
 <div class="text-[9px] font-semibold uppercase tracking-wider text-slate-500">Classe &amp; niveau</div>
 @* Classe passerelle : même mention qu'en PDF (ClassroomPromotion.DisplayName) — l'aperçu à
 l'écran et la pièce imprimée ne doivent jamais dire deux choses. *@
 <div class="text-xs font-semibold text-slate-900" x-text="receipt.classroomName + (receipt.isAcceleratedClass ? ' (Cursus Accéléré Passerelle)' : '') + (receipt.classroomLevel ? ' — ' + receipt.classroomLevel : '')"></div>
 </div>
 <div x-show="receipt.guardianName || receipt.guardianPhone" x-cloak>
 <div class="text-[9px] font-semibold uppercase tracking-wider text-slate-500">Tuteur</div>
 <div class="text-xs font-semibold text-slate-900" x-text="[receipt.guardianName, receipt.guardianPhone].filter(Boolean).join('  ·  ')"></div>
 </div>
 </div>

 <!-- C. Déclaration officielle -->
 <div class="mt-3 border-l-2 border-slate-200 pl-3 text-[11px] leading-snug text-slate-600 text-justify">
 L'administration de l'établissement atteste que l'élève
 <span class="font-semibold text-slate-900" x-text="receipt.studentFullName"></span> (matricule
 <span class="font-semibold text-slate-900" x-text="receipt.matricule"></span>) est régulièrement inscrit(e) au sein de
 notre établissement en classe de
 <span class="font-semibold text-slate-900" x-text="receipt.classroomName + (receipt.isAcceleratedClass ? ' (Cursus Accéléré Passerelle)' : '')"></span>
 pour l'année scolaire <span class="font-semibold text-slate-900" x-text="receipt.schoolYearLabel"></span>.
 </div>

 @* D. Corps : deux blocs de NATURE différente. À gauche ce qu'il y a à régler maintenant, à
 l'ENCRE NOIRE — rien n'est acquitté, le secrétariat n'encaisse pas, et le vert signifierait
 « payé ». À droite le prospectif, en indigo.

 Le cumul annuel (totalDue) et le « reste à payer » ont disparu : c'est l'objet même de la
 refonte du 25/08/2026. Voir docs/design-references/README.md §1, rubrique « Interdits ». *@
 <div class="mt-3 grid grid-cols-2 gap-5 items-start">

 <!-- BLOC 1 — Règlement à effectuer (engagement initial) -->
 <div>
 <div class="text-[9px] font-bold uppercase tracking-widest text-slate-500">
 Règlement à effectuer
 <span class="font-medium normal-case tracking-normal text-slate-400">auprès du service de la comptabilité, ce jour</span>
 </div>
 <table class="mt-1.5 w-full text-[11px]">
 <thead>
 <tr class="bg-slate-100 text-slate-700 border-b border-slate-200">
 <th class="text-left py-1 px-2 text-[9px] font-semibold uppercase tracking-wider">Poste à régler</th>
 <th class="text-right py-1 px-2 text-[9px] font-semibold uppercase tracking-wider whitespace-nowrap">Montant</th>
 </tr>
 </thead>
 <tbody>
 <template x-for="line in receipt.lines" :key="line.designation">
 <tr class="border-b border-slate-200">
 <td class="py-1 px-2 text-slate-900">
 <span x-text="line.designation"></span>
 @* « (1 mois) » : le tuteur doit voir qu'il ne règle QU'UN mois, pas l'année. *@
 <span x-show="line.isRecurring" x-cloak class="text-slate-500">(1 mois)</span>
 </td>
 <td class="py-1 px-2 text-right text-slate-900 amount" x-text="formatMoney(line.unitAmount)"></td>
 </tr>
 </template>
 <tr x-show="receipt.lines.length === 0" x-cloak class="border-b border-slate-200">
 <td class="py-1 px-2 text-slate-400 italic">Aucun frais engagé</td>
 <td class="py-1 px-2 text-right text-slate-400">0</td>
 </tr>
 <tr class="border-t border-slate-300">
 <td class="pt-1.5 px-2 text-[9px] font-bold uppercase tracking-wider text-slate-700">Total à régler</td>
 <td class="pt-1.5 px-2 text-right text-sm font-bold text-slate-900 amount whitespace-nowrap" x-text="formatMoney(settlementTotal()) + ' FCFA'"></td>
 </tr>
 </tbody>
 </table>
 </div>

 <!-- BLOC 2 — Échéancier mensuel : tarifs UNITAIRES, jamais multipliés par le nombre de mois -->
 <div>
 <div class="text-[9px] font-bold uppercase tracking-widest text-slate-500">
 Échéancier mensuel
 <span class="font-medium normal-case tracking-normal text-slate-400">à titre indicatif</span>
 </div>

 <div class="mt-1.5">
 <template x-for="line in monthlyLines()" :key="line.designation">
 <div class="flex items-baseline justify-between gap-3 border-b border-slate-200 py-1 text-[11px]">
 <span class="text-slate-900" x-text="line.designation"></span>
 <span class="whitespace-nowrap font-semibold text-slate-900 amount"><span x-text="formatMoney(line.unitAmount)"></span><span class="text-[9px] font-medium text-slate-500"> FCFA / mois</span></span>
 </div>
 </template>
 <p x-show="monthlyLines().length === 0" x-cloak class="py-1 text-[11px] italic text-slate-400">Aucun frais mensuel souscrit.</p>
 </div>

 <div class="mt-2 flex items-center justify-between gap-3 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2">
 <div>
 <div class="text-[9px] font-bold uppercase tracking-wider text-indigo-700">Total à prévoir chaque mois</div>
 <div class="text-[9px] text-indigo-500">Règlement du 1<sup>er</sup> au 5 de chaque mois</div>
 </div>
 <div class="whitespace-nowrap text-lg font-bold leading-none text-indigo-700 amount"><span x-text="formatMoney(monthlyTotal())"></span><span class="text-[10px] font-medium text-indigo-500"> FCFA / mois</span></div>
 </div>
 </div>

 </div>

 @* E. Pied de page, ancré en bas. « Le Secrétariat » et non « Le Caissier » : cette pièce est
 délivrée sans qu'aucun fonds ne soit encaissé. *@
 <div class="receipt-footer mt-auto pt-2 border-t border-slate-200">
 <div class="flex items-end gap-6 text-[10px]">
 <div class="flex-1">
 <p class="italic text-slate-500" x-text="faitMention()"></p>
 <p class="mt-2.5 text-[9px] font-semibold uppercase tracking-wider text-slate-400">Cachet officiel</p>
 </div>
 <div class="flex-1 text-right">
 <div class="h-6"></div>
 <div class="border-t border-dashed border-slate-400 pt-1 text-[9px] font-semibold uppercase tracking-wider text-slate-500">Le Secrétariat</div>
 </div>
 <div class="flex-1 text-right">
 <div class="h-6"></div>
 <div class="border-t border-dashed border-slate-400 pt-1 text-[9px] font-semibold uppercase tracking-wider text-slate-500">Le Directeur</div>
 </div>
 </div>
 <p class="mt-2 text-center text-[8px] leading-tight text-slate-400">
 Le secrétariat n'encaisse aucun fonds : tout règlement s'effectue auprès de la comptabilité,
 seule habilitée à délivrer un reçu de caisse valant validation définitive.
 </p>
 </div>

 </div>
 </div>

 </div>

 @* Fenêtre de confirmation affichée juste après l'enregistrement (avant le reçu) : elle annonce que
 l'inscription est validée, puis laisse le choix entre imprimer le reçu ou terminer. Non imprimée
 (.no-print) — de toute façon elle est fermée au moment d'imprimer le reçu. *@
 <div class="no-print">
 <modal-shell open="showConfirmDialog" size="md" on-close="finishFromDialog()" title="Inscription validée">
 <confirm-dialog-body close-action="finishFromDialog()" close-label="Terminer"
 new-action="showReceiptFromDialog()" new-label="Imprimer le reçu">
 L'inscription de <span class="font-medium text-slate-900" x-text="receipt ? receipt.studentFullName : ''"></span>
 a bien été validée — reçu n° <span class="font-medium text-slate-900" x-text="receiptReference()"></span>.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Modale de prévisualisation PDF et actions (Ticket JGK-F02 / Axe 4) -->
 @await Html.PartialAsync("_PdfPreviewModal")
 </div>
</div>
