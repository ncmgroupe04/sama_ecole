@{
    ViewData["Title"] = "Convocations parent";
}

@section Scripts {
    <script src="~/js/parentSummons.js" asp-append-version="true"></script>
}

<div x-data="parentSummonsView()" class="space-y-6">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-jgk-title font-bold text-slate-900">Convocations parent</h1>
            <p class="text-jgk-subtitle text-slate-500 mt-1">Convoquez un parent/tuteur pour un motif libre, distinct d'une sanction disciplinaire.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <button x-show="canManageParentSummons" x-cloak @@click="openCreate()" class="btn-primary">
                <icon name="plus" class="w-4 h-4" />
                Nouvelle convocation
            </button>
        </div>
    </div>

    <!-- Tableau -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Élève</th>
                        <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Date/heure convoquée</th>
                        <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Motif</th>
                        <th class="py-3.5 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <template x-if="isLoading">
                        <tr>
                            <td colspan="4" class="px-4 py-8 text-center text-slate-500">
                                Chargement des convocations...
                            </td>
                        </tr>
                    </template>
                    <template x-if="!isLoading && records.length === 0">
                        <tr>
                            <td colspan="4">
                                <empty-state icon="envelope" title="Aucune convocation enregistrée."
                                    hint="Les convocations de parents/tuteurs apparaîtront ici." />
                            </td>
                        </tr>
                    </template>
                    <template x-for="record in records" :key="record.id">
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-4 py-4">
                                <div class="font-semibold text-slate-900" x-text="record.studentFullName"></div>
                                <div class="text-xs text-slate-500" x-text="'Matricule : ' + record.studentMatricule"></div>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap text-slate-600" x-text="formatDateTime(record.scheduledAt)"></td>
                            <td class="px-4 py-4 text-slate-600 truncate max-w-xs" x-text="record.reason" :title="record.reason"></td>
                            <td class="px-4 py-4 whitespace-nowrap text-right">
                                <button type="button" @@click="printNotice(record.id)" :disabled="printingId === record.id"
                                        class="btn-secondary inline-flex items-center gap-2 disabled:opacity-60">
                                    <icon name="print" class="w-4 h-4" x-show="printingId !== record.id" />
                                    <icon name="loader" class="w-4 h-4 animate-spin" x-show="printingId === record.id" x-cloak />
                                    <span x-text="printingId === record.id ? 'Génération...' : 'Convocation PDF'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modale de création -->
    <modal-shell open="isCreateOpen" on-close="closeCreate()" title="Nouvelle convocation">
        <modal-subtitle>Convoquer le parent/tuteur d'un élève.</modal-subtitle>

        <div x-show="createErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="createErrors.global"></div>

        <form x-on:submit.prevent="submitCreate()" novalidate class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700">Élève concerné <span class="text-danger">*</span></label>
                <select-field model="form.studentId" required="true" aria-label="Élève concerné"
                              placeholder="Sélectionnez un élève..."
                              options-expr="students.map(s => ({value: s.id, label: s.fullName + ' (' + s.matricule + ')'}))" />
                <p x-show="createErrors.studentid" x-text="createErrors.studentid" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700">Date de convocation <span class="text-danger">*</span></label>
                <date-field model="form.scheduledDate" required="true" aria-label="Date de convocation" />
                <p x-show="createErrors.scheduleddate" x-text="createErrors.scheduleddate" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700">Heure de convocation <span class="text-danger">*</span></label>
                <input type="time" x-model="form.scheduledTime" required
                       class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" />
                <p x-show="createErrors.scheduledtime" x-text="createErrors.scheduledtime" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700">Motif <span class="text-danger">*</span></label>
                <textarea x-model="form.reason" rows="4" placeholder="Motif de la convocation..." required
                          class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"></textarea>
                <p x-show="createErrors.reason" x-text="createErrors.reason" class="mt-1 text-xs text-danger"></p>
            </div>

            <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
                <button type="button" @@click="closeCreate()" class="btn-secondary">Annuler</button>
                <button type="submit" :disabled="isCreating" class="btn-primary">
                    <span x-text="isCreating ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    @* Confirmation : convocation enregistrée *@
    <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Convocation enregistrée">
        <confirm-dialog-body close-action="showAddedDialog = false"
                              new-action="showAddedDialog = false; openCreate()" new-label="Nouvelle convocation">
            La convocation de <span class="font-medium text-slate-900" x-text="addedRecordStudentName"></span> a bien été enregistrée et figure désormais dans la liste.
        </confirm-dialog-body>
    </modal-shell>
</div>
