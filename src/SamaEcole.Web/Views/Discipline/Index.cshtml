@{
    ViewData["Title"] = "Registre Discipline";
}

@section Scripts {
    <script src="~/js/discipline.js" asp-append-version="true"></script>
}

<div x-data="disciplineView()" class="space-y-6">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-jgk-title font-bold text-slate-900">Registre Discipline</h1>
            <p class="text-jgk-subtitle text-slate-500 mt-1">Gérez et consultez l'historique des sanctions disciplinaires des élèves.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <button x-show="canManageDiscipline" x-cloak @@click="isCreateOpen = true" class="btn-primary">
                <icon name="plus" class="w-4 h-4" />
                Ajouter une sanction
            </button>
        </div>
    </div>

    <!-- Tableau -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 font-semibold">Date</th>
                        <th class="px-6 py-4 font-semibold">Élève</th>
                        <th class="px-6 py-4 font-semibold">Type de Sanction</th>
                        <th class="px-6 py-4 font-semibold">Motif</th>
                        <th class="px-6 py-4 font-semibold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    <template x-if="isLoading">
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                                Chargement des sanctions...
                            </td>
                        </tr>
                    </template>
                    <template x-if="!isLoading && records.length === 0">
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                                Aucune sanction enregistrée.
                            </td>
                        </tr>
                    </template>
                    <template x-for="record in records" :key="record.id">
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-slate-600" x-text="formatDate(record.date)"></td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-slate-900" x-text="record.studentFullName"></div>
                                <div class="text-xs text-slate-500" x-text="'Matricule : ' + record.studentMatricule"></div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2.5 py-1 rounded-full text-xs font-medium"
                                      :class="getDisciplineBadge(record.type).css"
                                      x-text="getDisciplineBadge(record.type).label"></span>
                            </td>
                            <td class="px-6 py-4 text-slate-600 truncate max-w-xs" x-text="record.reason" :title="record.reason"></td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <button type="button" @@click="printPv(record.id)" :disabled="printingId === record.id"
                                        title="Télécharger le PV de discipline" aria-label="Télécharger le PV de discipline"
                                        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-slate-500 hover:text-primary-700 hover:bg-primary-50 disabled:opacity-60 transition-colors">
                                    <icon name="document-text" class="w-4 h-4" x-show="printingId !== record.id" />
                                    <icon name="loader" class="w-4 h-4 animate-spin" x-show="printingId === record.id" x-cloak />
                                    <span class="text-xs font-medium" x-text="printingId === record.id ? 'Génération…' : 'PV'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Slide-over Création -->
    <div x-show="isCreateOpen" style="display: none;" class="relative z-50" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div x-show="isCreateOpen" x-transition.opacity class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity"></div>
        
        <div class="fixed inset-0 overflow-hidden">
            <div class="absolute inset-0 overflow-hidden">
                <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10 sm:pl-16">
                    <div x-show="isCreateOpen" 
                         x-transition:enter="transform transition ease-in-out duration-300 sm:duration-500" 
                         x-transition:enter-start="translate-x-full" 
                         x-transition:enter-end="translate-x-0" 
                         x-transition:leave="transform transition ease-in-out duration-300 sm:duration-500" 
                         x-transition:leave-start="translate-x-0" 
                         x-transition:leave-end="translate-x-full" 
                         class="pointer-events-auto w-screen max-w-md">
                        <form @@submit.prevent="submitCreate" class="flex h-full flex-col bg-white shadow-xl">
                            <!-- En-tête -->
                            <div class="px-6 py-6 sm:px-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                                <div>
                                    <h2 class="text-lg font-semibold text-slate-900" id="slide-over-title">Nouvelle Sanction</h2>
                                    <p class="text-sm text-slate-500 mt-1">Enregistrer un incident disciplinaire.</p>
                                </div>
                                <button type="button" @@click="isCreateOpen = false" class="rounded-md bg-white text-slate-400 hover:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
                                    <span class="sr-only">Fermer</span>
                                    <icon name="x" class="h-6 w-6" />
                                </button>
                            </div>
                            <!-- Contenu -->
                            <div class="relative flex-1 px-6 py-6 sm:px-8 overflow-y-auto space-y-6">
                                
                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Élève concerné <span class="text-red-500">*</span></label>
                                    <select x-model="form.studentId" class="input-field mt-1" required>
                                        <option value="">Sélectionnez un élève...</option>
                                        <template x-for="student in students" :key="student.id">
                                            <option :value="student.id" x-text="student.fullName + ' (' + student.matricule + ')'"></option>
                                        </template>
                                    </select>
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Type de Sanction <span class="text-red-500">*</span></label>
                                    <select x-model="form.type" class="input-field mt-1" required>
                                        <option value="Avertissement">Avertissement</option>
                                        <option value="Blame">Blâme</option>
                                        <option value="Retenue">Retenue</option>
                                        <option value="Exclusion">Exclusion</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Date de l'incident <span class="text-red-500">*</span></label>
                                    <input type="date" x-model="form.date" class="input-field mt-1" required />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700">Motif <span class="text-red-500">*</span></label>
                                    <textarea x-model="form.reason" rows="4" class="input-field mt-1" placeholder="Décrivez l'incident..." required></textarea>
                                </div>
                                
                            </div>
                            <!-- Pied de page -->
                            <div class="flex items-center justify-end gap-3 px-6 py-5 border-t border-slate-100 bg-slate-50">
                                <button type="button" @@click="isCreateOpen = false" class="btn-secondary">Annuler</button>
                                <button type="submit" class="btn-primary" :disabled="isCreating">
                                    <span x-show="!isCreating">Enregistrer</span>
                                    <span x-show="isCreating" class="flex items-center gap-2">
                                        <icon name="loader" class="w-4 h-4 animate-spin" />
                                        Enregistrement...
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
