@{
    ViewData["Title"] = "Registre Discipline";
    var disciplineTypeOptions = new List<SelectFieldOption> {
        new("Avertissement", "Avertissement"), new("Blame", "Blâme"),
        new("Retenue", "Retenue"), new("Exclusion", "Exclusion")
    };
}

@section Scripts {
    <script src="~/js/discipline.js" asp-append-version="true"></script>
}

<div x-data="disciplineView()" class="space-y-6">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-jgk-title font-bold text-slate-900">Registre Discipline</h1>
            <p class="text-jgk-subtitle text-slate-500 mt-1">Gérez et consultez l'historique des sanctions disciplinaires des élèves.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <button x-show="canManageDiscipline" x-cloak @@click="openCreate()" class="btn-modal-primary">
                <icon name="plus" class="w-4 h-4" />
                Ajouter une sanction
            </button>
        </div>
    </div>

    <!-- Tableau -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Date</th>
                        <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Élève</th>
                        <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Type de Sanction</th>
                        <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Motif</th>
                        <th class="py-3.5 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <template x-if="isLoading">
                        <tr>
                            <td colspan="5" class="px-4 py-8 text-center text-slate-500">
                                Chargement des sanctions...
                            </td>
                        </tr>
                    </template>
                    <template x-if="!isLoading && records.length === 0">
                        <tr>
                            <td colspan="5">
                                <empty-state icon="shield" title="Aucune sanction enregistrée."
                                    hint="Les sanctions disciplinaires saisies apparaîtront ici." />
                            </td>
                        </tr>
                    </template>
                    <template x-for="record in records" :key="record.id">
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-4 py-4 whitespace-nowrap text-slate-600" x-text="formatDate(record.date)"></td>
                            <td class="px-4 py-4">
                                <div class="font-semibold text-slate-900" x-text="record.studentFullName"></div>
                                <div class="text-xs text-slate-500" x-text="'Matricule : ' + record.studentMatricule"></div>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span class="status-badge"
                                      :class="getDisciplineBadge(record.type).css"
                                      x-text="getDisciplineBadge(record.type).label"></span>
                            </td>
                            <td class="px-4 py-4 text-slate-600 truncate max-w-xs" x-text="record.reason" :title="record.reason"></td>
                            <td class="px-4 py-4 whitespace-nowrap text-right">
                                <button type="button" @@click="printPv(record.id)" :disabled="printingId === record.id"
                                        title="Télécharger le PV de discipline" aria-label="Télécharger le PV de discipline"
                                        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-slate-500 hover:text-primary-700 hover:bg-primary-50 disabled:opacity-60 transition-colors">
                                    <icon name="document-text" class="w-4 h-4" x-show="printingId !== record.id" />
                                    <icon name="loader" class="w-4 h-4 animate-spin" x-show="printingId === record.id" x-cloak />
                                    <span class="text-xs font-medium" x-text="printingId === record.id ? 'Génération…' : 'PV'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modale de création -->
    <modal-shell open="isCreateOpen" on-close="closeCreate()" title="Nouvelle Sanction">
        <modal-subtitle>Enregistrer un incident disciplinaire.</modal-subtitle>

        <div x-show="createErrors.global" x-cloak class="form-error-banner" x-text="createErrors.global"></div>

        <form x-on:submit.prevent="submitCreate()" novalidate class="space-y-4">
            <div>
                <label class="form-label form-label-required">Élève concerné</label>
                <select-field model="form.studentId" required="true" aria-label="Élève concerné"
                              placeholder="Sélectionnez un élève..."
                              options-expr="students.map(s => ({value: s.id, label: s.fullName + ' (' + s.matricule + ')'}))" />
                <p x-show="createErrors.studentid" x-text="createErrors.studentid" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Type de Sanction</label>
                <select-field model="form.type" required="true" aria-label="Type de sanction" options="disciplineTypeOptions" />
                <p x-show="createErrors.type" x-text="createErrors.type" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Date de l'incident</label>
                <date-field model="form.date" required="true" aria-label="Date de l'incident" />
                <p x-show="createErrors.date" x-text="createErrors.date" class="field-error"></p>
            </div>

            <div>
                <label class="form-label form-label-required">Motif</label>
                <textarea x-model="form.reason" rows="4" placeholder="Décrivez l'incident..." required
                          class="input-field"></textarea>
                <p x-show="createErrors.reason" x-text="createErrors.reason" class="field-error"></p>
            </div>

            <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
                <button type="button" @@click="closeCreate()" class="btn-modal-secondary">Annuler</button>
                <button type="submit" :disabled="isCreating" class="btn-modal-primary">
                    <span x-text="isCreating ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    @* Confirmation : sanction ajoutée *@
    <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Sanction enregistrée">
        <confirm-dialog-body close-action="showAddedDialog = false"
                              new-action="showAddedDialog = false; openCreate()" new-label="Nouvelle sanction">
            La sanction de <span class="font-medium text-slate-900" x-text="addedRecordStudentName"></span> a bien été enregistrée et figure désormais dans le registre.
        </confirm-dialog-body>
    </modal-shell>
</div>
