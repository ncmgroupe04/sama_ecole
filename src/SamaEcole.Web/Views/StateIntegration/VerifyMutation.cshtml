@{
    ViewData["Title"] = "Vérification d'un certificat de mutation";
    Layout = "_LayoutPublic";
    var token = ViewData["Token"] as string ?? "";
}

@section Scripts {
    <script src="~/js/verify-mutation.js" asp-append-version="true"></script>
}

<main class="max-w-xl mx-auto px-4 py-16">
    <div x-data="verifyMutationView(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(token)))" x-init="init()">

        <h1 class="text-2xl font-bold text-slate-900 text-center">Vérification d'un certificat de mutation</h1>
        <p class="text-sm text-slate-500 text-center mt-1">
            Contrôle d'authenticité — aucune donnée personnelle de l'élève n'est communiquée ici.
        </p>

        <!-- Chargement -->
        <div x-show="loading" x-cloak class="mt-10 text-center text-slate-400 text-sm">Vérification en cours…</div>

        <!-- Échec de l'appel (réseau, trop de tentatives) — distinct de « certificat inconnu » -->
        <div x-show="!loading && failed" x-cloak
             class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6 text-center">
            <p class="text-slate-700 font-medium">Vérification momentanément indisponible</p>
            <p class="text-sm text-slate-500 mt-1">Réessayez dans quelques instants.</p>
        </div>

        <template x-if="!loading && !failed">
            <div class="mt-10">

                <!-- VALIDE -->
                <template x-if="isValid">
                    <div class="rounded-xl border-2 border-emerald-300 bg-emerald-50 p-6 text-center">
                        <div class="w-14 h-14 mx-auto rounded-full bg-emerald-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <p class="text-lg font-bold text-emerald-800 mt-3">Certificat authentique</p>
                        <p class="text-sm text-emerald-700 mt-1">Ce certificat a bien été délivré et n'a pas été révoqué.</p>
                    </div>
                </template>

                <!-- RÉVOQUÉ -->
                <template x-if="isRevoked">
                    <div class="rounded-xl border-2 border-red-300 bg-red-50 p-6 text-center">
                        <div class="w-14 h-14 mx-auto rounded-full bg-red-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </div>
                        <p class="text-lg font-bold text-red-800 mt-3">Certificat révoqué</p>
                        <p class="text-sm text-red-700 mt-1">
                            Ce certificat a été annulé par l'établissement émetteur
                            <span x-show="result.revokedAt" x-text="'le ' + formatDate(result.revokedAt)"></span>.
                            Ne l'acceptez pas — demandez une pièce à jour.
                        </p>
                    </div>
                </template>

                <!-- INCONNU -->
                <template x-if="isUnknown">
                    <div class="rounded-xl border-2 border-amber-300 bg-amber-50 p-6 text-center">
                        <div class="w-14 h-14 mx-auto rounded-full bg-amber-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008M12 3l9 16H3l9-16z" />
                            </svg>
                        </div>
                        <p class="text-lg font-bold text-amber-800 mt-3">Certificat introuvable</p>
                        <p class="text-sm text-amber-700 mt-1">
                            Aucun certificat ne correspond à ce lien. Vérifiez que le QR a été scanné entièrement,
                            ou contactez l'établissement émetteur.
                        </p>
                    </div>
                </template>

                <!-- Détail de la pièce (valide ou révoqué) -->
                <template x-if="isValid || isRevoked">
                    <dl class="mt-6 rounded-xl border border-slate-200 divide-y divide-slate-100 text-sm">
                        <div class="flex justify-between px-4 py-3">
                            <dt class="text-slate-500">Numéro du certificat</dt>
                            <dd class="font-mono font-semibold text-slate-900" x-text="result.certificateNumber"></dd>
                        </div>
                        <div class="flex justify-between px-4 py-3">
                            <dt class="text-slate-500">Date de délivrance</dt>
                            <dd class="font-medium text-slate-900" x-text="formatDate(result.issuedOn)"></dd>
                        </div>
                        <div class="flex justify-between px-4 py-3">
                            <dt class="text-slate-500">Établissement émetteur</dt>
                            <dd class="font-medium text-slate-900" x-text="result.issuingSchoolName"></dd>
                        </div>
                    </dl>
                </template>

                <p class="text-xs text-slate-400 text-center mt-6">
                    Cette vérification ne communique ni le nom, ni la date de naissance, ni la classe de l'élève.
                    Ces informations figurent sur le certificat papier remis à la famille.
                </p>
            </div>
        </template>
    </div>
</main>
