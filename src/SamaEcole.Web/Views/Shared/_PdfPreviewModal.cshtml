@* Modale d'aperçu PDF partagée — moteur JS unique dans wwwroot/js/pdf-preview.js.
   Le composant Alpine hôte doit étaler `...window.pdfPreview.state()` dans son Alpine.data(). *@
<modal-shell open="showPdfModal" size="xl" on-close="closePdfPreview()" :title="pdfPreviewTitle">
    <div class="space-y-4">
        <!-- Barre d'actions de l'en-tête : impression, téléchargement et ouverture dans un onglet,
             accessibles en permanence (elle reste collée en haut pendant le défilement de l'aperçu). -->
        <div x-show="pdfPreviewUrl" x-cloak
             class="sticky top-0 z-10 -mt-6 -mx-6 px-6 py-3 bg-white/95 backdrop-blur border-b border-slate-100 flex flex-wrap items-center justify-end gap-2">
            <!-- « Ouvrir dans un nouvel onglet » : sortie de secours la plus fiable (visualiseur natif
                 du navigateur) quand l'aperçu intégré rame ou se fige. Mise en avant à gauche, séparée
                 du reste, avec une icône — c'est le premier réflexe à proposer en cas de souci. -->
            <button type="button" x-on:click="openPdfInNewTab()"
                    class="btn-modal-secondary text-xs group mr-auto ring-1 ring-indigo-200 text-indigo-700 hover:bg-indigo-50">
                <icon name="link" class="w-4 h-4" />
                <span>Ouvrir dans un nouvel onglet</span>
            </button>
            <button type="button" x-on:click="downloadPreviewPdf()" class="btn-modal-secondary text-xs group">
                <icon name="download" class="w-4 h-4" />
                <span>Télécharger</span>
            </button>
            <button type="button" x-on:click="printPreviewPdf()" class="btn-modal-primary text-xs group">
                <icon name="print" class="w-4 h-4" />
                <span>Imprimer</span>
            </button>
        </div>

        <!-- Bandeau d'astuce -->
        <div x-show="pdfPreviewUrl" x-cloak class="flex items-center gap-2 p-3 rounded-xl bg-indigo-50/80 border border-indigo-100 text-indigo-900 text-xs font-medium">
            <icon name="document" class="w-4 h-4 text-indigo-600 shrink-0" />
            <span>Astuce : si l'aperçu ne s'affiche pas correctement, cliquez sur <strong>« Ouvrir dans un nouvel onglet »</strong> — le document s'ouvre alors dans le lecteur PDF du navigateur.</span>
        </div>

        <!-- Chargement : récupération du document, ou moteur d'aperçu (PDF.js) encore en cours de chargement. -->
        <template x-if="pdfStatus === 'loading'">
            <div class="w-full bg-slate-50 rounded-xl border border-dashed border-slate-200 flex flex-col items-center justify-center gap-3" style="min-height: 400px;">
                <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <p class="text-sm text-slate-500">Génération de l'aperçu…</p>
            </div>
        </template>

        <!-- Erreur : cause précise + bouton Réessayer, jamais un cul-de-sac. -->
        <template x-if="pdfStatus === 'error'">
            <div class="w-full bg-slate-50 rounded-xl border border-dashed border-slate-300 flex flex-col items-center justify-center gap-2 text-center px-6 py-10" style="min-height: 400px;">
                <icon name="document" class="w-10 h-10 text-slate-400 mb-1" />
                <p class="text-sm font-medium text-slate-700">Impossible d'afficher l'aperçu.</p>
                <p class="text-xs text-slate-500 max-w-md" x-text="pdfErrorMessage"></p>
                <div class="flex flex-wrap justify-center gap-3 mt-4">
                    <!-- Document récupéré mais moteur d'aperçu KO (pdfDegraded) : « nouvel onglet » devient
                         l'action principale — c'est le meilleur recours disponible. Sinon Réessayer prime. -->
                    <button type="button" x-show="pdfPreviewUrl" x-on:click="openPdfInNewTab()"
                            class="text-xs group" :class="pdfDegraded ? 'btn-modal-primary' : 'btn-modal-secondary ring-1 ring-indigo-200 text-indigo-700 hover:bg-indigo-50'">
                        <icon name="link" class="w-4 h-4" />
                        <span>Ouvrir dans un nouvel onglet</span>
                    </button>
                    <button type="button" x-show="!pdfDegraded" x-on:click="retryPdfPreview()"
                            class="text-xs group" :class="pdfPreviewUrl ? 'btn-modal-secondary' : 'btn-modal-primary'">
                        <span>Réessayer</span>
                    </button>
                    <button type="button" x-show="pdfPreviewUrl" x-on:click="downloadPreviewPdf()" class="btn-modal-secondary text-xs group">
                        <icon name="download" class="w-4 h-4" />
                        <span>Télécharger le fichier</span>
                    </button>
                </div>
            </div>
        </template>

        <!-- Aperçu : pages peintes progressivement dans pdfPages par pdf-preview.js. -->
        <div x-show="pdfStatus === 'ready'" x-cloak class="space-y-2">
            <div class="flex items-center justify-between gap-2 px-1">
                <p class="text-xs text-slate-500" x-show="pdfPageCount > 1">
                    <span x-text="pdfRenderedCount"></span> / <span x-text="pdfPageCount"></span> page(s)
                </p>
                <div class="flex items-center gap-1 ml-auto">
                    <button type="button" x-on:click="zoomPdfOut()" :disabled="!canZoomPdfOut" class="btn-modal-secondary text-xs px-2 py-1 disabled:opacity-40 group" aria-label="Réduire">−</button>
                    <button type="button" x-on:click="zoomPdfReset()" class="text-xs text-slate-500 w-14 text-center hover:text-indigo-600" x-text="pdfZoomLabel"></button>
                    <button type="button" x-on:click="zoomPdfIn()" :disabled="!canZoomPdfIn" class="btn-modal-secondary text-xs px-2 py-1 disabled:opacity-40 group" aria-label="Agrandir">+</button>
                </div>
            </div>
            <div class="w-full bg-slate-100 rounded-xl border border-slate-200 overflow-auto p-3" style="max-height: 600px;">
                <div x-ref="pdfPages"></div>
            </div>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
            <button type="button" x-on:click="closePdfPreview()" class="btn-modal-secondary group">Fermer</button>
        </div>
    </div>
</modal-shell>
