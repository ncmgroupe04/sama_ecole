@* Modale d'aperçu PDF partagée — logique dans wwwroot/js/pdf-preview.js.
   L'affichage est confié à la visionneuse PDF NATIVE du navigateur via un <iframe> pointant sur une
   blob URL locale (auth impossible sur une navigation d'iframe → fetch d'abord ; <object> bloqué par
   la CSP object-src 'none'). Le composant Alpine hôte étale `...window.pdfPreview.state()`.

   Gabarit : `hide-header` (pas de bandeau titre), `no-padding` (bord à bord), `tall` (hauteur fixe
   ≈ 92 vh), `size="pdf"` (95 % de large, plafond 7xl). UNE seule barre d'actions compacte en haut —
   « Ouvrir dans un nouvel onglet » à gauche, puis Télécharger / Imprimer / ✕ à l'extrême droite —
   et l'iframe remplit tout l'espace restant. *@
<modal-shell open="showPdfModal" size="pdf" hide-header no-padding tall on-close="closePdfPreview()">
    <div class="flex h-full flex-col bg-white">
        <!-- Barre d'actions unique : Ouvrir dans un onglet | (espace) | Télécharger | Imprimer | Fermer -->
        <div class="flex-shrink-0 flex flex-wrap items-center gap-2 px-3 py-2 border-b border-slate-200 bg-white">
            <button type="button" x-on:click="openPdfInNewTab()"
                    class="btn-modal-secondary text-xs group ring-1 ring-indigo-200 text-indigo-700 hover:bg-indigo-50">
                <icon name="link" class="w-4 h-4" />
                <span>Ouvrir dans un nouvel onglet</span>
            </button>

            <span class="ml-auto"></span>

            <button type="button" x-show="pdfStatus === 'ready'" x-cloak x-on:click="downloadPreviewPdf()"
                    class="btn-modal-secondary text-xs group">
                <icon name="download" class="w-4 h-4" />
                <span>Télécharger</span>
            </button>
            <button type="button" x-show="pdfStatus === 'ready'" x-cloak x-on:click="printPreviewPdf()"
                    class="btn-modal-primary text-xs group">
                <icon name="print" class="w-4 h-4" />
                <span>Imprimer</span>
            </button>

            <button type="button" x-on:click="closePdfPreview()" aria-label="Fermer"
                    class="shrink-0 bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white border border-rose-200/80 p-2 rounded-xl transition-all shadow-sm focus:outline-none">
                <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </button>
        </div>

        <!-- Astuce discrète : la visionneuse intégrée n'a pas signalé `load`. -->
        <div x-show="pdfViewerHint" x-cloak
             class="flex-shrink-0 px-3 py-1.5 text-center text-xs text-amber-800 bg-amber-50 border-b border-amber-100">
            Le document ne s'affiche pas ?
            <button type="button" x-on:click="openPdfInNewTab()" class="font-medium text-indigo-600 hover:underline">Ouvrez-le dans un nouvel onglet</button>
            ou <button type="button" x-on:click="downloadPreviewPdf()" class="font-medium text-indigo-600 hover:underline">téléchargez-le</button>.
        </div>

        <!-- Zone document : remplit tout l'espace restant. Une seule barre de défilement (celle de la
             visionneuse PDF, à l'intérieur de l'iframe). -->
        <div class="relative flex-1 min-h-0 bg-slate-100">
            <!-- Chargement -->
            <template x-if="pdfStatus === 'loading'">
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
                    <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    <p class="text-sm text-slate-500">Génération de l'aperçu…</p>
                </div>
            </template>

            <!-- Erreur : cause précise + « Réessayer », jamais un cul-de-sac. -->
            <template x-if="pdfStatus === 'error'">
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-center px-6">
                    <icon name="document" class="w-10 h-10 text-slate-400 mb-1" />
                    <p class="text-sm font-medium text-slate-700">Impossible d'afficher l'aperçu.</p>
                    <p class="text-xs text-slate-500 max-w-md" x-text="pdfErrorMessage"></p>
                    <div class="flex flex-wrap justify-center gap-3 mt-4">
                        <button type="button" x-on:click="retryPdfPreview()" class="btn-modal-primary text-xs group">
                            <span>Réessayer</span>
                        </button>
                        <button type="button" x-show="pdfPreviewUrl" x-on:click="openPdfInNewTab()" class="btn-modal-secondary text-xs group">
                            <icon name="link" class="w-4 h-4" />
                            <span>Ouvrir dans un nouvel onglet</span>
                        </button>
                    </div>
                </div>
            </template>

            <!-- Aperçu : visionneuse PDF native, en plein cadre. -->
            <template x-if="pdfStatus === 'ready'">
                <iframe x-ref="pdfFrame" :src="pdfPreviewUrl" x-on:load="pdfViewerLoaded()"
                        title="Aperçu du document"
                        class="absolute inset-0 h-full w-full border-0 bg-slate-100"></iframe>
            </template>
        </div>
    </div>
</modal-shell>
