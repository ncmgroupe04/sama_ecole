@model string
@{
 // Modèle = `path` déjà calculé par _Layout.cshtml (Context.Request.Path.Value ?? "/") — une
 // partial ne hérite pas des variables locales du fichier appelant, on le reçoit donc en modèle
 // plutôt que de le recalculer une seconde fois ici.
 var path = Model ?? "/";

 // Source UNIQUE des modules de la barre de navigation rapide, lue par DEUX boucles ci-dessous
 // (rangée desktop + dropdown mobile « Saut rapide ») : c'est la DONNÉE qui est dédupliquée, pas
 // le rendu — si vous ajoutez/retirez un module, faites-le ICI, les deux affichages suivent.
 // Rôles et indicateurs de module repris tels quels de la sidebar (wwwroot/js/auth.js,
 // Alpine.data('sidebarNav', …)) : un module masqué dans la sidebar doit l'être ici aussi.
 var items = new (string Href, string Icon, string Label, string[] Roles, string? Flag)[]
 {
  ("/eleves", "users", "Élèves", new[] { "SuperAdmin", "Directeur", "Secretariat", "Finance", "Enseignant" }, null),
  ("/classes", "building", "Classes", new[] { "Directeur", "Secretariat", "Enseignant" }, null),
  ("/enseignants", "users", "Enseignants", new[] { "SuperAdmin", "Directeur", "Secretariat" }, null),
  ("/notes", "document", "Notes et bulletins", new[] { "Directeur", "Secretariat", "Enseignant" }, "pedagogyEnabled"),
  ("/caisse", "payment", "Caisse", new[] { "Directeur", "Secretariat", "Finance" }, "financeEnabled"),
  ("/internat", "bed", "Internat", new[] { "Directeur", "Secretariat", "Surveillant" }, "internatEnabled"),
 };

 // Expression x-show partagée par les deux rendus d'un même item : rôle (window.auth.canView,
 // commodité d'affichage seule — la vraie garde est côté API, [RequireModule]/[Authorize]) et,
 // le cas échéant, l'indicateur de module du store partagé schoolConfig (voir auth.js).
 string ShowExpr((string Href, string Icon, string Label, string[] Roles, string? Flag) item)
 {
  var quoted = new string[item.Roles.Length];
  for (var i = 0; i < item.Roles.Length; i++) quoted[i] = $"'{item.Roles[i]}'";
  var expr = $"window.auth.canView([{string.Join(", ", quoted)}])";
  if (item.Flag is not null) expr += $" && $store.schoolConfig.{item.Flag}";
  return expr;
 }

 // Nombre de modules effectivement visibles pour l'utilisateur courant (rôle + formule) : sous 2,
 // la barre n'apporte rien (un seul bouton, redondant avec la sidebar) — cas du Surveillant, qui
 // ne voit qu'Internat. Même expressions ShowExpr que les items, agrégées en un tableau JS.
 var visibleCountExpr = $"[{string.Join(", ", items.Select(ShowExpr))}].filter(Boolean).length";
}

@* ═══════════════════════════════════════════════════════════════════════════
   RANGÉE DESKTOP (lg: et plus) — barre de raccourcis modules, onglet courant en surbrillance.
   .tab-nav-scroll/.tab-btn/.tab-btn-active : même composant partagé que Paramètres, Matières,
   Paie… (Styles/input.css) ; tab-nav-scroll.js l'auto-améliore (défilement/fondu) sans
   enregistrement JS supplémentaire, ce nouvel élément étant détecté par son MutationObserver.
   ═══════════════════════════════════════════════════════════════════════════ *@
<nav class="hidden lg:flex tab-nav-scroll" role="tablist" aria-label="Navigation rapide entre modules"
 x-show="@visibleCountExpr > 1" x-cloak>
 @foreach (var item in items)
 {
  var active = path.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase);
  <a href="@item.Href" role="tab" aria-selected="@active.ToString().ToLowerInvariant()"
   x-show="@ShowExpr(item)" x-cloak
   class="tab-btn @(active ? "tab-btn-active" : "")">
   <icon name="@item.Icon" class="w-4 h-4" />
   <span>@item.Label</span>
  </a>
 }
</nav>

@* ═══════════════════════════════════════════════════════════════════════════
   DROPDOWN MOBILE (sous lg:) — bouton unique « Saut rapide », même mécanique que schoolSwitcher()
   (_Layout.cshtml) : x-on:click.outside, Échap, z-30 (échelle de z-index des popovers, voir
   ModalShellTagHelper.cs). Même tableau `items` que la rangée ci-dessus — un module masqué par
   rôle/formule disparaît des DEUX rendus, puisqu'ils lisent la même expression par item.
   ═══════════════════════════════════════════════════════════════════════════ *@
<div class="lg:hidden relative" x-data="quickNavMenu()" x-show="@visibleCountExpr > 1" x-cloak>
 <button type="button" x-on:click="isOpen = !isOpen" aria-haspopup="true" :aria-expanded="isOpen.toString()"
  class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-slate-100 text-slate-700 text-sm font-medium hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-primary transition-all duration-200 active:scale-95">
  <icon name="menu" class="w-4 h-4" />
  <span>Saut rapide</span>
  <icon name="chevron-down" class="w-3.5 h-3.5 transition-transform" :class="isOpen ? 'rotate-180' : ''" />
 </button>

 <div x-show="isOpen" x-cloak x-on:click.outside="isOpen = false" x-on:keydown.escape.window="isOpen = false"
  class="absolute left-0 mt-2 w-64 rounded-xl bg-white p-2 shadow-lg ring-1 ring-slate-100 z-30">
  @foreach (var item in items)
  {
   var active = path.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase);
   <a href="@item.Href" x-show="@ShowExpr(item)" x-cloak
    class="w-full flex items-center gap-2 rounded-lg px-3 py-2 text-left text-sm font-medium transition-colors @(active ? "bg-indigo-50 text-primary-700" : "text-slate-700 hover:bg-slate-50")">
    <icon name="@item.Icon" class="w-4 h-4 shrink-0" />
    <span class="truncate">@item.Label</span>
    @if (active)
    {
     <icon name="check" class="w-4 h-4 shrink-0 ml-auto" />
    }
   </a>
  }
 </div>
</div>
