@*
    Onglet Journal d'audit (ticket JGK-H01), extrait pour être réutilisé comme onglet de l'écran
    Paramètres. Le composant Alpine auditLogView() est défini dans wwwroot/js/audit-log.js, que la
    page hôte (Settings/Index.cshtml) charge dans sa section Scripts.
*@
<div x-data="auditLogView()">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Journal d'audit</h2>
        <p class="text-sm text-gray-500 mt-1">
            Trace des actions sensibles de l'établissement : paiements, création de comptes, changements
            de statut ou de mot de passe, reçus imprimés. Lecture seule — rien ici ne peut être modifié.
        </p>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <div class="card mt-6 relative">
        <div class="p-4 border-b border-gray-200 bg-gray-50/50 rounded-t-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <stat-card size="compact" label="Entrées (page)" icon="archive" accent="primary">
                <span x-text="totalCount"></span>
            </stat-card>

            <div class="flex gap-3">
                <select x-model="moduleFilter" x-on:change="applyFilters()" aria-label="Filtrer par domaine"
                        class="input-field mt-0 w-40 bg-white">
                    <option value="">Tous les domaines</option>
                    <option value="Finance">Finance</option>
                    <option value="Users">Utilisateurs</option>
                </select>

                <select x-model="successFilter" x-on:change="applyFilters()" aria-label="Filtrer par résultat"
                        class="input-field mt-0 w-36 bg-white">
                    <option value="">Tous résultats</option>
                    <option value="true">Succès</option>
                    <option value="false">Échecs</option>
                </select>

                <button type="button" x-on:click="resetFilters()" class="text-sm font-medium text-gray-500 hover:text-gray-900">
                    Réinitialiser
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4">Date/heure</th>
                        <th class="py-3 px-4">Utilisateur</th>
                        <th class="py-3 px-4">Domaine</th>
                        <th class="py-3 px-4">Action</th>
                        <th class="py-3 px-4">Résultat</th>
                        <th class="py-3 px-4">Adresse IP</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <template x-if="isLoading">
                        <template x-for="i in 5" :key="i">
                            <tr><td class="py-3 px-4" colspan="6"><div class="skeleton h-4 w-full"></div></td></tr>
                        </template>
                    </template>

                    <tr x-show="!isLoading && entries.length === 0" x-cloak>
                        <td colspan="6">
                            <empty-state icon="archive" title="Aucune entrée pour ce filtre."
                                         hint="Les paiements, changements de statut et créations de compte apparaîtront ici." />
                        </td>
                    </tr>

                    <template x-for="entry in entries" :key="entry.id">
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-3 px-4 text-gray-600 whitespace-nowrap" x-text="formatDate(entry.occurredAt)"></td>
                            <td class="py-3 px-4 font-medium text-gray-900" x-text="entry.actorFullName"></td>
                            <td class="py-3 px-4"><badge variant="neutral" x-text="entry.module"></badge></td>
                            <td class="py-3 px-4 text-gray-700" x-text="entry.action"></td>
                            <td class="py-3 px-4">
                                <span :class="entry.success ? 'status-badge-success' : 'status-badge-danger'"
                                      x-text="entry.success ? 'Succès' : 'Échec'"></span>
                            </td>
                            <td class="py-3 px-4 font-mono text-xs text-gray-500" x-text="entry.ipAddress || '—'"></td>
                        </tr>
                        <tr x-show="!entry.success && entry.failureReason" x-cloak>
                            <td></td>
                            <td colspan="5" class="pb-3 px-4 -mt-3 text-xs text-danger" x-text="entry.failureReason"></td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>

        <pagination page="page" page-size="pageSize" total="totalCount" on-change="load()" />
    </div>
</div>
