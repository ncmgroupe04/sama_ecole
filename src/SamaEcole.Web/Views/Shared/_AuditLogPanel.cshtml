@*
 Onglet Journal d'audit (ticket JGK-H01), extrait pour être réutilisé comme onglet de l'écran
 Paramètres. Le composant Alpine auditLogView() est défini dans wwwroot/js/audit-log.js, que la
 page hôte (Settings/Index.cshtml) charge dans sa section Scripts.
*@
@{
 var moduleFilterOptions = new List<SelectFieldOption> { new("", "Tous les domaines"), new("Finance", "Finance"), new("Users", "Utilisateurs") };
 var successFilterOptions = new List<SelectFieldOption> { new("", "Tous résultats"), new("true", "Succès"), new("false", "Échecs") };
}
<div x-data="auditLogView()">
 <div>
 <h2 class="text-lg font-semibold text-slate-900">Journal d'audit</h2>
 <p class="text-sm text-slate-500 mt-1">
 Trace des actions sensibles de l'établissement : paiements, création de comptes, changements
 de statut ou de mot de passe, reçus imprimés. Lecture seule — rien ici ne peut être modifié.
 </p>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <div class="card mt-6 relative">
 <div class="p-6 border-b border-slate-200 bg-slate-50/50 rounded-t-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <stat-card size="compact" label="Entrées (page)" icon="archive" accent="primary">
 <span x-text="totalCount"></span>
 </stat-card>

 <div class="flex gap-3">
 <select-field model="moduleFilter" on-change="applyFilters()" aria-label="Filtrer par domaine"
 class="mt-0 w-40 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Tous les domaines" options="moduleFilterOptions" />

 <select-field model="successFilter" on-change="applyFilters()" aria-label="Filtrer par résultat"
 class="mt-0 w-36 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Tous résultats" options="successFilterOptions" />

 <button type="button" x-on:click="resetFilters()" class="text-sm font-medium text-slate-500 hover:text-slate-900">
 Réinitialiser
 </button>
 </div>
 </div>

 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Date/heure</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Utilisateur</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Domaine</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Action</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Résultat</th>
 <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Adresse IP</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-if="isLoading">
 <template x-for="i in 5" :key="i">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out"><td class="py-3 px-4" colspan="6"><div class="skeleton h-4 w-full"></div></td></tr>
 </template>
 </template>

 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out" x-show="!isLoading && entries.length === 0" x-cloak>
 <td colspan="6">
 <empty-state icon="archive" title="Aucune entrée pour ce filtre."
 hint="Les paiements, changements de statut et créations de compte apparaîtront ici." />
 </td>
 </tr>

 <template x-for="entry in entries" :key="entry.id">
 <tr class="hover:bg-slate-50 transition-colors transition-all duration-200 ease-in-out transition-all duration-200 ease-in-out">
 <td class="py-3 px-4 text-slate-600 whitespace-nowrap" x-text="formatDate(entry.occurredAt)"></td>
 <td class="py-3 px-4 font-medium text-slate-900" x-text="entry.actorFullName"></td>
 <td class="py-3 px-4"><badge variant="neutral" x-text="entry.module"></badge></td>
 <td class="py-3 px-4 text-slate-700" x-text="entry.action"></td>
 <td class="py-3 px-4">
 <span :class="entry.success ? 'status-badge-success' : 'status-badge-danger'"
 x-text="entry.success ? 'Succès' : 'Échec'"></span>
 </td>
 <td class="py-3 px-4 font-mono text-xs text-slate-500" x-text="entry.ipAddress || '—'"></td>
 </tr>
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out" x-show="!entry.success && entry.failureReason" x-cloak>
 <td></td>
 <td colspan="5" class="pb-3 px-4 -mt-3 text-xs text-danger" x-text="entry.failureReason"></td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>

 <pagination page="page" page-size="pageSize" total="totalCount" on-change="load()" />
 </div>
</div>
