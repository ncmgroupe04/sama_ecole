@*
    Bandeau d'erreur API partagé (Phase 1 de la refonte UI/UX) — le bloc « rouge, filet à gauche,
    icône + message » recopié à l'identique à la racine de chaque composant Alpine. Une seule source.

    Le modèle est le NOM de l'expression Alpine à surveiller (défaut « error » : la variable que tous
    les contrôleurs de l'app utilisent déjà). L'appelant peut passer une autre expression :
        @await Html.PartialAsync("_ErrorBanner")                 → x-show="error", x-text="error"
        @await Html.PartialAsync("_ErrorBanner", "pdfError")     → x-show="pdfError", x-text="pdfError"
*@
@model string?
@{
    var expr = string.IsNullOrWhiteSpace(Model) ? "error" : Model;
}
<div x-show="@expr" x-cloak class="mt-6 rounded-md border-l-4 border-danger bg-danger-bg p-4">
    <div class="flex items-start gap-3">
        <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-danger" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#icon-alert-circle"></use></svg>
        <p class="text-sm text-danger" x-text="@expr"></p>
    </div>
</div>
