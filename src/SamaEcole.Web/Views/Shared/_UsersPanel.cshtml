@*
 Onglet Utilisateurs (Paramètres) — gestion du personnel par le Directeur. Le composant Alpine
 usersView() est défini dans wwwroot/js/users.js, chargé par la page hôte (Settings/Index.cshtml).
*@
@{
 var userRoleOptions = new List<SelectFieldOption> {
 new("Secretariat", "Secrétariat"), new("Finance", "Finance"), new("Enseignant", "Enseignant"),
 new("Surveillant", "Surveillant")
 };
}
<div x-data="usersView()">
 <!-- Titre et bouton Nouvel utilisateur -->
 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h2 class="text-lg font-semibold text-slate-900">Utilisateurs</h2>
 <p class="text-sm text-slate-500 mt-1">
 Créez les comptes de votre personnel et contrôlez leur accès (blocage, suspension, mot de passe).
 </p>
 </div>

 <button x-show="isDirecteur" x-cloak x-on:click="openCreate()" class="btn-modal-primary">
 <icon name="plus" class="w-5 h-5" />
 Nouvel utilisateur
 </button>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- Synthèse et tableau -->
 <div class="card mt-6 relative">
 <div class="p-6 border-b border-slate-200 bg-slate-50/50 rounded-t-xl flex gap-6">
 <stat-card size="compact" label="Comptes" icon="users" accent="primary">
 <span x-text="users.length"></span>
 </stat-card>
 <stat-card size="compact" label="Actifs" icon="checkmark-circle" accent="success">
 <span x-text="users.filter(u => u.status === 'Active').length"></span>
 </stat-card>
 </div>

 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head">
 <th class="py-3 px-4">Nom complet</th>
 <th class="py-3 px-4">E-mail</th>
 <th class="py-3 px-4">Rôle</th>
 <th class="py-3 px-4">Statut</th>
 <th class="py-3 px-4 text-right">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-if="isLoading">
 <template x-for="i in 3" :key="i">
 <tr class="hover:bg-slate-50 transition-colors duration-150"><td class="py-3 px-4" colspan="5"><div class="skeleton h-4 w-full"></div></td></tr>
 </template>
 </template>

 <tr class="hover:bg-slate-50 transition-colors duration-150" x-show="!isLoading && users.length === 0" x-cloak>
 <td colspan="5">
 <empty-state icon="users" title="Aucun utilisateur n'est encore créé."
 hint="Créez un premier compte pour votre personnel." />
 </td>
 </tr>

 <template x-for="user in users" :key="user.id">
 <tr class="hover:bg-slate-50 transition-colors duration-150">
 <td class="py-3 px-4 font-medium text-slate-900">
 <span class="inline-flex items-center gap-2">
 <span x-text="user.fullName"></span>
 <badge x-show="user.isSelf" x-cloak variant="primary">Vous</badge>
 </span>
 </td>
 <td class="py-3 px-4 text-slate-600" x-text="user.email"></td>
 <td class="py-3 px-4"><badge variant="neutral" x-text="roleLabel(user.role)"></badge></td>
 <td class="py-3 px-4">
 <span :class="statusBadgeVariant(user.status)"><span class="status-dot" aria-hidden="true"></span><span x-text="statusLabel(user.status)"></span></span>
 </td>
 <td class="py-3 px-4 text-right whitespace-nowrap">
 <template x-if="!user.isSelf">
 <row-actions>
 <row-action icon="block" label="Bloquer" on-click="openStatusChange(user, 'Blocked')" show="user.status !== 'Blocked'" variant="danger" />
 <row-action icon="pause" label="Suspendre" on-click="openStatusChange(user, 'Suspended')" show="user.status === 'Active'" />
 <row-action icon="checkmark-circle" label="Réactiver" on-click="openStatusChange(user, 'Active')" show="user.status !== 'Active'" />
 <row-action icon="key" label="Mot de passe" on-click="openResetPassword(user)" />
 <row-action icon="clock" label="Historique" on-click="openHistory(user)" />
 </row-actions>
 </template>
 <span x-show="user.isSelf" x-cloak class="text-xs text-slate-400 italic">—</span>
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>
 </div>

 <!-- Création d'un utilisateur -->
 <modal-shell open="isCreateOpen" title="Nouvel utilisateur">
 <modal-subtitle>Le mot de passe ci-dessous est celui du compte : communiquez-le vous-même à la personne concernée.</modal-subtitle>

 <div x-show="createErrors.global" x-cloak class="form-error-banner" x-text="createErrors.global"></div>

 <form x-on:submit.prevent="submitCreate()" novalidate class="space-y-4">
 <div>
 <label for="user-fullname" class="form-label form-label-required">Nom complet</label>
 <input id="user-fullname" type="text" x-model="newUser.fullName" required maxlength="200" placeholder="ex : Awa Ndiaye" class="input-field" :class="createErrors.fullname && 'input-field-error'">
 <p x-show="createErrors.fullname" x-cloak x-text="createErrors.fullname" class="field-error"></p>
 </div>

 <div>
 <label for="user-email" class="form-label form-label-required">E-mail</label>
 <input id="user-email" type="email" x-model="newUser.email" required maxlength="256" placeholder="nom@ecole.sn" class="input-field" :class="createErrors.email && 'input-field-error'">
 <p x-show="createErrors.email" x-cloak x-text="createErrors.email" class="field-error"></p>
 </div>

 <div>
 <label for="user-role" class="form-label form-label-required">Rôle</label>
 <select-field id="user-role" model="newUser.role" required="true" options="userRoleOptions" />
 <p x-show="createErrors.role" x-cloak x-text="createErrors.role" class="field-error"></p>
 </div>

 <div>
 <label for="user-password" class="form-label form-label-required">Mot de passe</label>
 <input id="user-password" type="text" x-model="newUser.password" required class="input-field font-mono">
 <p class="mt-1 text-xs text-slate-400">Minimum 12 caractères, avec majuscule, minuscule, chiffre et caractère spécial.</p>
 <p x-show="createErrors.password" x-cloak x-text="createErrors.password" class="field-error"></p>
 </div>

 <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
 <button type="button" x-on:click="isCreateOpen = false" class="btn-modal-secondary">Annuler</button>
 <button type="submit" :disabled="isSubmitting" class="btn-modal-primary">
 <span x-text="isSubmitting ? 'Enregistrement...' : 'Créer le compte'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : utilisateur ajouté. Rappelle le mot de passe : une fois cette fenêtre fermée,
 il n'est plus visible nulle part (règle #6 — pas de stockage en clair côté serveur). -->
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Utilisateur ajouté">
 <confirm-dialog-body close-action="showAddedDialog = false"
 new-action="showAddedDialog = false; openCreate()" new-label="Nouvel utilisateur">
 Le compte de <span class="font-medium text-slate-900" x-text="addedUser.fullName"></span> a bien été créé.
 <span class="mt-4 block bg-slate-50 rounded-2xl p-6 text-left text-sm space-y-1.5">
 <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">À communiquer à l'intéressé(e)</span>
 <span class="block"><span class="text-slate-500">E-mail :</span> <span class="font-mono text-slate-900" x-text="addedUser.email"></span></span>
 <span class="block"><span class="text-slate-500">Mot de passe :</span> <span class="font-mono text-slate-900" x-text="addedUser.password"></span></span>
 </span>
 </confirm-dialog-body>
 </modal-shell>

 <!-- Changement de statut (motif obligatoire, JGK-A05) -->
 <modal-shell open="statusTarget" on-close="closeStatusChange()" size="md">
 <modal-title><span x-text="statusTarget ? statusActionLabel(statusTarget.newStatus) : ''"></span> — <span x-text="statusTarget ? statusTarget.fullName : ''"></span></modal-title>
 <modal-subtitle>Ce changement révoque immédiatement les sessions ouvertes du compte, sauf réactivation.</modal-subtitle>

 <div x-show="statusErrors.global" x-cloak class="form-error-banner" x-text="statusErrors.global"></div>

 <form x-on:submit.prevent="submitStatusChange()" novalidate class="space-y-4">
 <div>
 <label for="status-reason" class="form-label form-label-required">Motif</label>
 <input id="status-reason" type="text" x-model="statusReason" required minlength="5" maxlength="500"
 placeholder="ex : Départ de l'établissement" class="input-field" :class="statusErrors.reason && 'input-field-error'">
 <p x-show="statusErrors.reason" x-cloak x-text="statusErrors.reason" class="field-error"></p>
 </div>

 <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
 <button type="button" x-on:click="closeStatusChange()" class="btn-modal-secondary">Annuler</button>
 <button type="submit" :disabled="isChangingStatus" class="btn-modal-primary">
 <span x-text="isChangingStatus ? 'Enregistrement...' : 'Confirmer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : statut modifié -->
 <modal-shell open="showStatusChangedDialog" size="md" on-close="showStatusChangedDialog = false" title="Statut modifié">
 <confirm-dialog-body close-action="showStatusChangedDialog = false">
 Le compte de <span class="font-medium text-slate-900" x-text="statusChangedSummary.fullName"></span>
 est désormais <span class="font-medium text-slate-900" x-text="statusLabel(statusChangedSummary.newStatus).toLowerCase()"></span>.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Réinitialisation de mot de passe -->
 <modal-shell open="passwordTarget" on-close="closeResetPassword()" size="md">
 <modal-title>Mot de passe — <span x-text="passwordTarget ? passwordTarget.fullName : ''"></span></modal-title>
 <modal-subtitle>Communiquez ce mot de passe vous-même : toutes les sessions ouvertes du compte seront fermées.</modal-subtitle>

 <div x-show="passwordErrors.global" x-cloak class="form-error-banner" x-text="passwordErrors.global"></div>

 <form x-on:submit.prevent="submitResetPassword()" novalidate class="space-y-4">
 <div>
 <label for="reset-password" class="form-label form-label-required">Nouveau mot de passe</label>
 <input id="reset-password" type="text" x-model="newPassword" required class="input-field font-mono">
 <p class="mt-1 text-xs text-slate-400">Minimum 12 caractères, avec majuscule, minuscule, chiffre et caractère spécial.</p>
 <p x-show="passwordErrors.newpassword" x-cloak x-text="passwordErrors.newpassword" class="field-error"></p>
 </div>

 <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
 <button type="button" x-on:click="closeResetPassword()" class="btn-modal-secondary">Annuler</button>
 <button type="submit" :disabled="isResettingPassword" class="btn-modal-primary">
 <span x-text="isResettingPassword ? 'Enregistrement...' : 'Réinitialiser'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : mot de passe réinitialisé. Rappelle le mot de passe : une fois cette fenêtre
 fermée, il n'est plus visible nulle part (règle #6 — pas de stockage en clair côté serveur). -->
 <modal-shell open="showPasswordResetDialog" size="md" on-close="showPasswordResetDialog = false" title="Mot de passe réinitialisé">
 <confirm-dialog-body close-action="showPasswordResetDialog = false">
 Le mot de passe de <span class="font-medium text-slate-900" x-text="resetPasswordSummary.fullName"></span> a bien été modifié.
 <span class="mt-4 block bg-slate-50 rounded-2xl p-6 text-left text-sm space-y-1.5">
 <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">À communiquer à l'intéressé(e)</span>
 <span class="block"><span class="text-slate-500">Nouveau mot de passe :</span> <span class="font-mono text-slate-900" x-text="resetPasswordSummary.password"></span></span>
 </span>
 </confirm-dialog-body>
 </modal-shell>

 <!-- Historique des statuts -->
 <modal-shell open="historyFor" on-close="closeHistory()" title="Historique" size="lg">
 <modal-subtitle><span x-text="historyFor ? historyFor.fullName : ''"></span></modal-subtitle>

 <div x-show="isLoadingHistory" class="py-8 text-center text-sm text-slate-400">Chargement…</div>

 <div x-show="!isLoadingHistory && historyEntries.length === 0" x-cloak class="py-8 text-center text-sm text-slate-400">
 Aucun changement de statut enregistré.
 </div>

 <ul x-show="!isLoadingHistory && historyEntries.length > 0" x-cloak class="max-h-80 divide-y divide-slate-100 overflow-y-auto">
 <template x-for="(entry, index) in historyEntries" :key="index">
 <li class="flex items-start justify-between gap-4 py-3">
 <div>
 <p class="text-sm text-slate-900">
 <span class="text-slate-400" x-text="statusLabel(entry.previousStatus)"></span>
 <span class="text-slate-400">→</span>
 <span class="font-semibold" x-text="statusLabel(entry.newStatus)"></span>
 </p>
 <p class="mt-0.5 text-xs text-slate-500" x-text="entry.reason"></p>
 <p class="mt-0.5 text-xs text-slate-400" x-text="'par ' + entry.changedByFullName"></p>
 </div>
 <span class="whitespace-nowrap text-xs text-slate-400" x-text="formatDate(entry.changedAt)"></span>
 </li>
 </template>
 </ul>
 </modal-shell>
</div>
