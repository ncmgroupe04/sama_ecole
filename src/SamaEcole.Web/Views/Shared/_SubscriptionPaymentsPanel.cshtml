@*
    Onglet Facturation & Historique (ticket JGK-I07), extrait pour être réutilisé comme onglet de l'écran
    Paramètres. Le composant Alpine subscriptionPaymentsHistoryView() est défini dans
    wwwroot/js/subscription-payments-history.js, que la page hôte (Settings/Index.cshtml) charge dans sa
    section Scripts.
*@
<div x-data="subscriptionPaymentsHistoryView()">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Facturation & Historique</h2>
        <p class="text-sm text-gray-500 mt-1">
            Statut de votre abonnement et historique des paiements effectués auprès de Sama Ecole.
        </p>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <stat-card size="compact" label="Statut de l'abonnement" icon="wallet" accent="primary">
            <span :class="subscriptionStatusBadgeVariant(subscriptionStatus)" x-text="subscriptionStatusLabel(subscriptionStatus)"></span>
        </stat-card>
        <stat-card size="compact" label="Plan" icon="layers" accent="primary">
            <span x-text="subscriptionPlan || '—'"></span>
        </stat-card>
        <stat-card size="compact" label="Échéance" icon="checkmark-circle" accent="primary">
            <span x-text="formatExpiresAt(subscriptionExpiresAt)"></span>
        </stat-card>
    </div>

    <div class="card mt-6 relative">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4">Date</th>
                        <th class="py-3 px-4">Montant</th>
                        <th class="py-3 px-4">Période couverte</th>
                        <th class="py-3 px-4">Moyen de paiement</th>
                        <th class="py-3 px-4">Statut</th>
                        <th class="py-3 px-4">Référence</th>
                    </tr>
                </thead>
                <tbody class="table-cell divide-y divide-gray-100">
                    <template x-if="isLoading">
                        <template x-for="i in 5" :key="i">
                            <tr><td class="py-3 px-4" colspan="6"><div class="skeleton h-4 w-full"></div></td></tr>
                        </template>
                    </template>

                    <tr x-show="!isLoading && entries.length === 0" x-cloak>
                        <td colspan="6">
                            <empty-state icon="wallet" title="Aucun paiement pour le moment."
                                         hint="Les paiements d'abonnement confirmés apparaîtront ici." />
                        </td>
                    </tr>

                    <template x-for="entry in entries" :key="entry.id">
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-3 px-4 text-gray-600 whitespace-nowrap" x-text="formatDate(entry.initiatedAt)"></td>
                            <td class="py-3 px-4 font-medium text-gray-900 whitespace-nowrap" x-text="formatAmount(entry.amount, entry.currency)"></td>
                            <td class="py-3 px-4 text-gray-700" x-text="billingPeriodLabel(entry.billingPeriod)"></td>
                            <td class="py-3 px-4 text-gray-700" x-text="methodLabel(entry.method)"></td>
                            <td class="py-3 px-4">
                                <span :class="statusBadgeVariant(entry.status)" x-text="statusLabel(entry.status)"></span>
                            </td>
                            <td class="py-3 px-4 font-mono text-xs text-gray-500" x-text="entry.providerTransactionRef || '—'"></td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>

        <pagination page="page" page-size="pageSize" total="totalCount" on-change="load()" />
    </div>
</div>
