@model SamaEcole.Web.Content.MarketingCatalog.PriceOffer
@{
    // Carte tarifaire — PARTAGÉE par tous les groupes de la grille (LandingB2B.cshtml, section #tarifs).
    //
    // Un seul palier = prix unique affiché en grand (modèle « par élève » du public). Plusieurs paliers =
    // liste « libellé → montant » (taille de l'établissement, effectif). Les montants portent des espaces
    // insécables (MarketingCatalog.Pricing) : ils ne se coupent jamais sur deux lignes.
    var single = Model.Tiers.Count == 1;

    // Préremplit le type, les cycles (et la taille) du formulaire d'inscription (registration.js).
    var registerHref = string.IsNullOrEmpty(Model.RegisterQuery) ? "/inscription" : "/inscription?" + Model.RegisterQuery;
}
<article class="mkt-card flex h-full flex-col @(Model.Featured ? "border-2 border-primary-600 shadow-lg shadow-primary-500/5" : "")">
    <h4 class="mkt-h3">@Model.Name</h4>
    <p class="mt-1 text-sm text-slate-500">@Model.Audience</p>

    @if (single)
    {
        <p class="mt-5">
            <span class="block text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">@Model.Tiers[0].Price</span>
            <span class="mt-1 block text-sm text-slate-500">@Model.Unit</span>
        </p>
    }
    else
    {
        <dl class="mt-5 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200">
            @foreach (var tier in Model.Tiers)
            {
                <div class="flex items-baseline justify-between gap-3 px-4 py-2.5">
                    <dt class="text-sm text-slate-600">@tier.Label</dt>
                    <dd class="text-right text-base font-bold tabular-nums text-slate-900">@tier.Price</dd>
                </div>
            }
        </dl>
        <p class="mt-2 text-xs text-slate-500">Forfait @Model.Unit, selon la taille de l'établissement.</p>
    }

    <ul class="mt-5 flex-1 space-y-2.5">
        @foreach (var item in Model.Includes)
        {
            <li class="flex items-start gap-2.5 text-sm text-slate-700">
                <icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-primary-500" />
                <span>@item</span>
            </li>
        }
    </ul>

    <a href="@registerHref" class="mkt-btn @(Model.Featured ? "mkt-btn-primary" : "mkt-btn-secondary") mt-6 w-full">
        Inscrire mon école
    </a>
</article>
