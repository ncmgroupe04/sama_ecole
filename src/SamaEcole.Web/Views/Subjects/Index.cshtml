@{
 ViewData["Title"] = "Pédagogie - Matières";
 var subjectLevelOptions = new List<SelectFieldOption> {
 new("Crèche", "Crèche"), new("Maternelle", "Maternelle"), new("Primaire", "Primaire"),
 new("Collège", "Collège"), new("Lycée", "Lycée")
 };
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/subjects.js" asp-append-version="true"></script>
}

<div x-data="subjectsView()">
 @* ═══════════════════════════════════════════════════════════════════════════
    STICKY HEADER — En-tête fixe opaque (Ticket UI).
    Le titre, les KPI et la recherche restent accessibles à tout moment.
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div class="sticky top-0 z-50 -mx-8 -mt-8 lg:-mx-10 lg:-mt-10 px-8 pt-8 lg:px-10 lg:pt-10 pb-5 bg-white border-b border-slate-200 shadow-sm">

  @* Titre + Bouton *@
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
   <div>
    <h1 class="text-jgk-title font-bold text-slate-900">Matières et coefficients</h1>
    <p class="text-jgk-subtitle text-slate-500 mt-1">
     Le coefficient de chaque matière pèse dans le calcul des moyennes et des bulletins.
    </p>
   </div>

   <button x-show="canCreateSubject" x-cloak x-on:click="openCreate()"
    class="btn-primary group">
    <icon name="plus" class="w-5 h-5 transition-transform duration-200 group-hover:rotate-90" />
    Nouvelle matière
   </button>
  </div>

  @await Html.PartialAsync("_ErrorBanner")

  @* KPI badges + Recherche *@
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
   <div class="flex gap-4">
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="book" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Matières</span>
      <p class="text-base font-bold text-slate-900" x-text="subjects.length">0</p>
     </div>
    </div>
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="layers" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Niveaux</span>
      <p class="text-base font-bold text-slate-900" x-text="visibleLevelCount">0</p>
     </div>
    </div>
   </div>

   <div class="relative w-full sm:w-64 flex items-center">
    <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
     <icon name="search" class="w-4 h-4 text-slate-400" />
    </span>
    <input type="search" x-model="search" placeholder="Rechercher une matière ou un niveau…"
     aria-label="Rechercher une matière"
     class="input-field !my-0 h-10 !py-2 pl-9 pr-3 rounded-xl w-full transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" />
   </div>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    LOADING SKELETON
    ═══════════════════════════════════════════════════════════════════════════ *@
 <template x-if="isLoading">
  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
   <template x-for="i in 4" :key="i">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 space-y-4 animate-pulse">
     <div class="flex justify-between items-center">
      <div class="skeleton h-5 w-32 rounded-lg"></div>
      <div class="skeleton h-5 w-16 rounded-lg"></div>
     </div>
     <div class="space-y-3">
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-3/4 rounded-lg"></div>
     </div>
    </div>
   </template>
  </div>
 </template>

 @* ═══════════════════════════════════════════════════════════════════════════
    EMPTY STATE
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && visibleSubjects.length === 0" x-cloak class="mt-8">
  <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
   <div class="mx-auto w-16 h-16 rounded-2xl bg-primary-50 flex items-center justify-center mb-4">
    <icon name="book" class="w-8 h-8 text-primary-400" />
   </div>
   <h3 class="text-base font-semibold text-slate-700 mb-1">Aucune matière n'est configurée.</h3>
   <p class="text-sm text-slate-400">Créez vos matières et leurs coefficients pour préparer les bulletins.</p>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    GRILLE PRINCIPALE — Cartes « Floating Container »
    Organisation par pôles (Lettres & Langues, Sciences & Technologies,
    Arts Sport & Culture, Éveil & Petite Enfance). Chaque matière affiche
    une jauge de poids relatif du coefficient.
    sm:/lg: (600px/1024px) — tailwind.config.js REMPLACE les breakpoints par
    défaut (Volume 5 §2.4) ; md:/xl: n'existent pas dans ce projet.
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && visibleSubjects.length > 0" x-cloak
  class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6 items-stretch">
  <template x-for="group in categoryGroups" :key="group.category">
   <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg h-full flex flex-col overflow-hidden">

    @* En-tête de catégorie *@
    <div class="px-6 pt-5 pb-4 border-b border-slate-100 bg-gradient-to-r from-primary-50/40 to-transparent">
     <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
       <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-primary-100 text-primary-600">
        <icon name="book" class="w-3.5 h-3.5" />
       </span>
       <span class="text-sm font-bold text-primary-700 uppercase tracking-wide" x-text="group.category"></span>
      </div>
      <span x-show="group.subjects.length > 0" x-cloak
       class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-xs font-semibold text-primary-700">
       Σ <span x-text="formatCoefficient(group.totalCoefficient)"></span>
      </span>
     </div>
     <span class="text-xs text-slate-400 mt-1 block"
      x-text="group.subjects.length + (group.subjects.length > 1 ? ' matières' : ' matière')"></span>
    </div>

    @* Liste des matières avec jauge de coefficient *@
    <div class="divide-y divide-slate-50 flex-1 px-2">
     <template x-for="(subject, index) in group.subjects" :key="subject.id || index">
      <div class="group flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50/80 transition-all duration-200">
       @* Infos de la matière *@
       <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
         <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400 shrink-0"></span>
         <span class="font-semibold text-slate-800 break-words" x-text="displayName(subject.name)" :title="subject.name"></span>
         <badge variant="neutral" class="shrink-0 text-[10px]" x-text="subject.level"></badge>
        </div>

        @* Jauge de poids relatif du coefficient *@
        <div class="mt-1.5 flex items-center gap-2">
         <div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden">
          <div class="h-full rounded-full bg-primary-400 transition-all duration-700 ease-out"
           :style="`width: ${group.totalCoefficient > 0 ? Math.min(100, (subject.coefficient / group.totalCoefficient) * 100) : 0}%`">
          </div>
         </div>
         <span class="text-[11px] font-medium text-slate-400 whitespace-nowrap tabular-nums">
          coef. <span class="text-slate-600 font-semibold" x-text="formatCoefficient(subject.coefficient)"></span>
         </span>
        </div>
       </div>

       @* Actions (toujours visibles pour accès direct) *@
       <template x-if="canManageSubject">
        <div class="shrink-0 flex items-center gap-1">
         <button type="button" @@click="openEdit(subject)" title="Modifier" aria-label="Modifier la matière"
          class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
          <icon name="pencil" class="w-4 h-4" />
         </button>
         <button type="button" @@click="openDelete(subject)" title="Supprimer" aria-label="Supprimer la matière"
          class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
          <icon name="trash-2" class="w-4 h-4" />
         </button>
        </div>
       </template>
      </div>
     </template>

     <p x-show="group.subjects.length === 0" x-cloak class="py-8 text-center text-xs text-slate-400">
      Aucune matière dans cette catégorie.
     </p>
    </div>
   </div>
  </template>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    FILET DE SÉCURITÉ — Matières sans catégorie reconnue
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && otherSubjects.length > 0" x-cloak class="mt-6">
  <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg overflow-hidden">
   <div class="flex items-center justify-between gap-3 px-6 py-4 bg-gradient-to-r from-slate-50 to-transparent border-b border-slate-100">
    <div class="flex items-baseline gap-2.5 min-w-0">
     <span class="text-sm font-bold text-slate-600 uppercase tracking-wide">Autres matières</span>
     <span class="text-xs text-slate-400">— nom sans catégorie reconnue</span>
    </div>
   </div>

   <div class="divide-y divide-slate-50 px-2">
    <template x-for="(subject, index) in otherSubjects" :key="subject.id || index">
     <div class="group flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50/80 transition-all duration-200">
      <div class="flex-1 min-w-0">
       <div class="flex items-center gap-2 flex-wrap">
        <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400"></span>
        <span class="font-semibold text-slate-800" x-text="displayName(subject.name)" :title="subject.name"></span>
        <badge variant="neutral" class="shrink-0 text-[10px]" x-text="subject.level"></badge>
       </div>
       <div class="mt-1.5">
        <span class="text-[11px] font-medium text-slate-400">
         coef. <span class="text-slate-600 font-semibold" x-text="formatCoefficient(subject.coefficient)"></span>
        </span>
       </div>
      </div>
      <template x-if="canManageSubject">
       <div class="shrink-0 flex items-center gap-1">
        <button type="button" @@click="openEdit(subject)" title="Modifier" aria-label="Modifier la matière"
         class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
         <icon name="pencil" class="w-4 h-4" />
        </button>
        <button type="button" @@click="openDelete(subject)" title="Supprimer" aria-label="Supprimer la matière"
         class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
         <icon name="trash-2" class="w-4 h-4" />
        </button>
       </div>
      </template>
     </div>
    </template>
   </div>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    MODALES — Création / Édition / Suppression / Confirmations
    ⚠️ Le champ Niveau est désormais un <select> (menu déroulant) au lieu
    d'un champ texte libre, avec les 5 niveaux normalisés.
    ═══════════════════════════════════════════════════════════════════════════ *@

 @* Création d'une matière *@
 <modal-shell open="isCreateOpen" title="Nouvelle matière">
  <modal-subtitle>Rattachez la matière à un niveau et fixez son coefficient.</modal-subtitle>

  <div x-show="createErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="createErrors.global"></div>

  <form x-on:submit.prevent="submitCreate()" class="space-y-4">
   <div>
    <label for="subject-name" class="block text-sm font-medium text-slate-700">Nom de la matière <span class="text-danger">*</span></label>
    <input id="subject-name" type="text" x-model="newSubject.name" required maxlength="80" placeholder="ex : Mathématiques"
     class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
    <p x-show="createErrors.name" x-cloak x-text="createErrors.name" class="mt-1 text-xs text-danger"></p>
   </div>

   @* ── Niveau : <select> au lieu de <input text> ── *@
   <div>
    <label for="subject-level" class="block text-sm font-medium text-slate-700">Niveau <span class="text-danger">*</span></label>
    <select-field model="newSubject.level" required="true" aria-label="Niveau"
     placeholder="Sélectionner un niveau" options="subjectLevelOptions" />
    <p x-show="createErrors.level" x-cloak x-text="createErrors.level" class="mt-1 text-xs text-danger"></p>
   </div>

   <div>
    <label for="subject-coefficient" class="block text-sm font-medium text-slate-700">Coefficient <span class="text-danger">*</span></label>
    <input id="subject-coefficient" type="number" x-model.number="newSubject.coefficient" required min="0.5" max="20" step="0.5"
     class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
    <p x-show="createErrors.coefficient" x-cloak x-text="createErrors.coefficient" class="mt-1 text-xs text-danger"></p>
   </div>

   <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
    <button type="button" x-on:click="isCreateOpen = false" class="btn-secondary">
     Annuler
    </button>
    <button type="submit" :disabled="isSubmitting" class="btn-primary">
     <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 @* Confirmation : matière ajoutée *@
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Matière ajoutée">
  <confirm-dialog-body close-action="showAddedDialog = false"
   new-action="showAddedDialog = false; openCreate()" new-label="Nouvelle matière">
   La matière <span class="font-medium text-slate-900" x-text="addedSubjectName"></span> a bien été ajoutée.
  </confirm-dialog-body>
 </modal-shell>

 @* Modification d'une matière *@
 <modal-shell open="editing" on-close="closeEdit()" title="Modifier la matière">
  <modal-subtitle><span x-text="editing ? editing.name : ''"></span></modal-subtitle>

  <div x-show="editErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="editErrors.global"></div>

  <form x-on:submit.prevent="submitEdit()" class="space-y-4">
   <div>
    <label for="edit-subject-name" class="block text-sm font-medium text-slate-700">Nom de la matière <span class="text-danger">*</span></label>
    <input id="edit-subject-name" type="text" x-model="editing.name" required maxlength="80" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
    <p x-show="editErrors.name" x-cloak x-text="editErrors.name" class="mt-1 text-xs text-danger"></p>
   </div>

   @* ── Niveau : <select> au lieu de <input text> ── *@
   <div>
    <label for="edit-subject-level" class="block text-sm font-medium text-slate-700">Niveau <span class="text-danger">*</span></label>
    <select-field model="editing.level" required="true" aria-label="Niveau"
     placeholder="Sélectionner un niveau" options="subjectLevelOptions" />
    <p x-show="editErrors.level" x-cloak x-text="editErrors.level" class="mt-1 text-xs text-danger"></p>
   </div>

   <div>
    <label for="edit-subject-coefficient" class="block text-sm font-medium text-slate-700">Coefficient <span class="text-danger">*</span></label>
    <input id="edit-subject-coefficient" type="number" x-model.number="editing.coefficient" required min="0.5" max="20" step="0.5" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
    <p x-show="editErrors.coefficient" x-cloak x-text="editErrors.coefficient" class="mt-1 text-xs text-danger"></p>
   </div>

   <div class="mt-6 flex justify-end gap-3">
    <button type="button" x-on:click="closeEdit()" class="btn-secondary">Annuler</button>
    <button type="submit" :disabled="isSavingEdit" class="btn-primary">
     <span x-text="isSavingEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 @* Confirmation : matière modifiée *@
 <modal-shell open="showEditedDialog" size="md" on-close="showEditedDialog = false" title="Matière modifiée">
  <confirm-dialog-body close-action="showEditedDialog = false">
   La matière <span class="font-medium text-slate-900" x-text="editedSubjectName"></span> a bien été mise à jour.
  </confirm-dialog-body>
 </modal-shell>

 @* Confirmation : suppression d'une matière *@
 <modal-shell open="deletingSubject" on-close="closeDelete()" size="md">
  <modal-title>Supprimer la matière</modal-title>
  <modal-subtitle>
   <span class="font-semibold text-slate-900" x-text="deletingSubject ? deletingSubject.name : ''"></span>
   sera archivée et n'apparaîtra plus dans les sélecteurs de matière.
  </modal-subtitle>

  <div x-show="deleteSubjectError" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="deleteSubjectError"></div>

  <p class="text-sm text-slate-500">
   Impossible si des notes existent déjà pour cette matière : son coefficient pilote encore le calcul des moyennes et des bulletins déjà émis.
  </p>

  <div class="mt-6 flex justify-end gap-3">
   <button type="button" x-on:click="closeDelete()" class="btn-secondary">Annuler</button>
   <button type="button" x-on:click="confirmDelete()" :disabled="isDeletingSubject" class="btn-danger">
    <span x-text="isDeletingSubject ? 'Suppression...' : 'Supprimer la matière'"></span>
   </button>
  </div>
 </modal-shell>

 @* Confirmation : matière supprimée *@
 <modal-shell open="showDeletedDialog" size="md" on-close="showDeletedDialog = false" title="Matière supprimée">
  <confirm-dialog-body close-action="showDeletedDialog = false">
   La matière <span class="font-medium text-slate-900" x-text="deletedSubjectName"></span> a bien été supprimée.
  </confirm-dialog-body>
 </modal-shell>
</div>
