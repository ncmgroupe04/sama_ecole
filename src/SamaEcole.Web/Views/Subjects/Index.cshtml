@{
 ViewData["Title"] = "Pédagogie - Matières";
 var subjectLevelOptions = new List<SelectFieldOption> {
 new("Crèche", "Crèche"), new("Maternelle", "Maternelle"), new("Primaire", "Primaire"),
 new("Collège", "Collège"), new("Lycée", "Lycée")
 };
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/subjects.js" asp-append-version="true"></script>
}

<div x-data="subjectsView()">
 @* ═══════════════════════════════════════════════════════════════════════════
    STICKY HEADER — En-tête fixe opaque (Ticket UI).
    Le titre, les KPI et la recherche restent accessibles à tout moment.
    ═══════════════════════════════════════════════════════════════════════════ *@
  <div class="sticky-sub-header">

  @await Html.PartialAsync("_ErrorBanner")

  @* KPI badges + Recherche + Actions *@
  <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
   <div class="flex gap-4">
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="book" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Matières</span>
      <p class="text-base font-bold text-slate-900" x-text="subjects.length">0</p>
     </div>
    </div>
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="layers" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Niveaux</span>
      <p class="text-base font-bold text-slate-900" x-text="visibleLevelCount">0</p>
     </div>
    </div>
   </div>

   <div class="flex flex-wrap items-center gap-3">
    @* ── Bascule de lecture : la grille par catégories (vue d'origine) ou l'arbre
         domaine → activités, seul endroit d'où se configure la grille du bulletin. ── *@
    <div role="group" aria-label="Mode d'affichage" class="tab-nav">
     <button type="button" x-on:click="viewMode = 'categories'"
      :aria-pressed="viewMode === 'categories'"
      class="tab-btn" :class="viewMode === 'categories' ? 'tab-btn-active' : ''">
      <icon name="book" class="w-3.5 h-3.5" />
      Matières
     </button>
     <button type="button" x-on:click="showStructure()"
      :aria-pressed="viewMode === 'structure'"
      class="tab-btn" :class="viewMode === 'structure' ? 'tab-btn-active' : ''">
      <icon name="layers" class="w-3.5 h-3.5" />
      Structure d'évaluation
     </button>
    </div>

    <div x-show="viewMode === 'categories'" class="relative w-full sm:w-64 flex items-center">
     <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
      <icon name="search" class="w-4 h-4 text-slate-400" />
     </span>
     <input type="search" x-model="search" placeholder="Rechercher une matière ou un niveau…"
      aria-label="Rechercher une matière"
      class="input-field !my-0 pl-9 pr-3 w-full" />
    </div>

    <button x-show="canCreateSubject" x-cloak x-on:click="openCreate()"
     class="btn-modal-primary group h-10 px-4 ml-auto">
     <icon name="plus" class="w-5 h-5 transition-transform duration-200 group-hover:rotate-90" />
     Nouvelle matière
    </button>
   </div>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    LOADING SKELETON
    ═══════════════════════════════════════════════════════════════════════════ *@
 <template x-if="isLoading">
  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
   <template x-for="i in 4" :key="i">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 space-y-4 animate-pulse">
     <div class="flex justify-between items-center">
      <div class="skeleton h-5 w-32 rounded-lg"></div>
      <div class="skeleton h-5 w-16 rounded-lg"></div>
     </div>
     <div class="space-y-3">
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-3/4 rounded-lg"></div>
     </div>
    </div>
   </template>
  </div>
 </template>

 @* ═══════════════════════════════════════════════════════════════════════════
    EMPTY STATE
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="viewMode === 'categories' && !isLoading && visibleSubjects.length === 0" x-cloak class="mt-8">
  <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
   <div class="mx-auto w-16 h-16 rounded-2xl bg-primary-50 flex items-center justify-center mb-4">
    <icon name="book" class="w-8 h-8 text-primary-400" />
   </div>
   <h3 class="text-base font-semibold text-slate-700 mb-1">Aucune matière n'est configurée.</h3>
   <p class="text-sm text-slate-400">Créez vos matières et leurs coefficients pour préparer les bulletins.</p>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    GRILLE PRINCIPALE — Cartes « Floating Container »
    Organisation par pôles (Lettres & Langues, Sciences & Technologies,
    Arts Sport & Culture, Éveil & Petite Enfance). Chaque matière affiche
    une jauge de poids relatif du coefficient.
    sm:/lg: (600px/1024px) — tailwind.config.js REMPLACE les breakpoints par
    défaut (Volume 5 §2.4) ; md:/xl: n'existent pas dans ce projet.
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="viewMode === 'categories' && !isLoading && visibleSubjects.length > 0" x-cloak
  class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6 items-start relative z-0">
  <template x-for="group in categoryGroups" :key="group.category">
   <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg flex flex-col overflow-hidden">

    @* En-tête de catégorie — cliquable : replie/déplie la liste (Collapsible) pour supprimer le
       défilement infini quand beaucoup de catégories sont ouvertes en même temps. *@
    <button type="button" x-on:click="toggleCategory(group.category)"
     :aria-expanded="(!isCategoryCollapsed(group.category)).toString()"
     class="w-full text-left px-6 pt-5 pb-4 border-b border-slate-100 bg-gradient-to-r from-primary-50/40 to-transparent hover:from-primary-50/80 transition-colors">
     <span class="flex items-center justify-between gap-2">
      <span class="flex items-center gap-2 min-w-0">
       <icon name="chevron-down" class="w-4 h-4 text-primary-400 shrink-0 transition-transform duration-200"
        x-bind:class="isCategoryCollapsed(group.category) ? '-rotate-90' : ''" />
       <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-primary-100 text-primary-600 shrink-0">
        <icon name="book" class="w-3.5 h-3.5" />
       </span>
       <span class="text-sm font-bold text-primary-700 uppercase tracking-wide truncate" x-text="group.category"></span>
      </span>
      <span x-show="group.subjects.length > 0" x-cloak
       class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-xs font-semibold text-primary-700 shrink-0">
       Σ <span x-text="formatCoefficient(group.totalCoefficient)"></span>
      </span>
     </span>
     <span class="text-xs text-slate-400 mt-1 block"
      x-text="group.subjects.length + (group.subjects.length > 1 ? ' matières' : ' matière')"></span>
    </button>

    @* Liste des matières avec jauge de coefficient *@
    <div x-show="!isCategoryCollapsed(group.category)"
     x-transition:enter="ease-out duration-150" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
     class="divide-y divide-slate-50 flex-1 px-2">
     <template x-for="(subject, index) in group.subjects" :key="subject.id || index">
      <div class="group flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50/80 transition-all duration-200">
       @* Infos de la matière *@
       <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
         <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400 shrink-0"></span>
         <span class="font-semibold text-slate-800 break-words" x-text="displayName(subject.name)" :title="subject.name"></span>
         <badge variant="neutral" class="shrink-0 text-[10px]" x-text="subject.level"></badge>
        </div>

        @* Jauge de poids relatif du coefficient *@
        <div class="mt-1.5 flex items-center gap-2">
         <div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden">
          <div class="h-full rounded-full bg-primary-400 transition-all duration-700 ease-out"
           :style="`width: ${group.totalCoefficient > 0 ? Math.min(100, (subject.coefficient / group.totalCoefficient) * 100) : 0}%`">
          </div>
         </div>
         <span class="text-[11px] font-medium text-slate-400 whitespace-nowrap tabular-nums">
          coef. <span class="text-slate-600 font-semibold" x-text="formatCoefficient(subject.coefficient)"></span>
         </span>
        </div>
       </div>

       @* Actions (toujours visibles pour accès direct) *@
       <template x-if="canManageSubject">
        <div class="shrink-0 flex items-center gap-1">
         <button type="button" @@click="openEdit(subject)" title="Modifier" aria-label="Modifier la matière"
          class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
          <icon name="pencil" class="w-4 h-4" />
         </button>
         <button type="button" @@click="openDelete(subject)" title="Supprimer" aria-label="Supprimer la matière"
          class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
          <icon name="trash-2" class="w-4 h-4" />
         </button>
        </div>
       </template>
      </div>
     </template>

     <p x-show="group.subjects.length === 0" x-cloak class="py-8 text-center text-xs text-slate-400">
      Aucune matière dans cette catégorie.
     </p>
    </div>
   </div>
  </template>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    FILET DE SÉCURITÉ — Matières sans catégorie reconnue
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="viewMode === 'categories' && !isLoading && otherSubjects.length > 0" x-cloak class="mt-6">
  <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg overflow-hidden">
   <button type="button" x-on:click="otherCollapsed = !otherCollapsed"
    :aria-expanded="(!otherCollapsed).toString()"
    class="w-full text-left flex items-center justify-between gap-3 px-6 py-4 bg-gradient-to-r from-slate-50 to-transparent border-b border-slate-100 hover:from-slate-100 transition-colors">
    <span class="flex items-baseline gap-2.5 min-w-0">
     <icon name="chevron-down" class="w-4 h-4 text-slate-400 shrink-0 self-center transition-transform duration-200"
      x-bind:class="otherCollapsed ? '-rotate-90' : ''" />
     <span class="text-sm font-bold text-slate-600 uppercase tracking-wide">Autres matières</span>
     <span class="text-xs text-slate-400 truncate">— nom sans catégorie reconnue</span>
    </span>
    <span class="text-xs font-semibold text-slate-400 shrink-0" x-text="otherSubjects.length"></span>
   </button>

   <div x-show="!otherCollapsed"
    x-transition:enter="ease-out duration-150" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
    class="divide-y divide-slate-50 px-2">
    <template x-for="(subject, index) in otherSubjects" :key="subject.id || index">
     <div class="group flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50/80 transition-all duration-200">
      <div class="flex-1 min-w-0">
       <div class="flex items-center gap-2 flex-wrap">
        <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400"></span>
        <span class="font-semibold text-slate-800" x-text="displayName(subject.name)" :title="subject.name"></span>
        <badge variant="neutral" class="shrink-0 text-[10px]" x-text="subject.level"></badge>
       </div>
       <div class="mt-1.5">
        <span class="text-[11px] font-medium text-slate-400">
         coef. <span class="text-slate-600 font-semibold" x-text="formatCoefficient(subject.coefficient)"></span>
        </span>
       </div>
      </div>
      <template x-if="canManageSubject">
       <div class="shrink-0 flex items-center gap-1">
        <button type="button" @@click="openEdit(subject)" title="Modifier" aria-label="Modifier la matière"
         class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
         <icon name="pencil" class="w-4 h-4" />
        </button>
        <button type="button" @@click="openDelete(subject)" title="Supprimer" aria-label="Supprimer la matière"
         class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
         <icon name="trash-2" class="w-4 h-4" />
        </button>
       </div>
      </template>
     </div>
    </template>
   </div>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    STRUCTURE D'ÉVALUATION — grilles par compétences (APC) du primaire.
    Un DOMAINE (« Lang & Com. », « Français ») porte des ACTIVITÉS
    (« P. Alphabétique », « Ressources »), chacune avec son propre barème.
    C'est cette configuration, et elle seule, que le bulletin PDF imprime :
    entêtes de colonnes, ordre des lignes, colonne « Sur ». Rien n'est codé
    en dur — trois écoles obtiennent trois bulletins différents.
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="viewMode === 'structure'" x-cloak class="mt-8 space-y-6">

  <div x-show="structureError" x-cloak class="form-error-banner" x-text="structureError"></div>

  @* Sélecteur de niveau : une grille est propre à un niveau (CI-CP, CE1-CE2, CM1-CM2…). *@
  <div class="flex flex-wrap items-center gap-2">
   <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider mr-1">Niveau</span>
   <template x-for="level in structureLevels" :key="level">
    <button type="button" x-on:click="selectStructureLevel(level)"
     :class="structureLevel === level ? 'bg-primary-600 text-white border-primary-600' : 'bg-white text-slate-600 border-slate-200 hover:border-primary-300'"
     class="px-3 h-8 rounded-lg border text-xs font-semibold transition-colors" x-text="level"></button>
   </template>
   <p x-show="structureLevels.length === 0" x-cloak class="text-sm text-slate-400">
    Créez d'abord une matière : son niveau apparaîtra ici.
   </p>
  </div>

  <template x-if="structureLevel">
   <div class="space-y-6">

    @* ── Entêtes des deux premières colonnes du bulletin ── *@
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6">
     <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="min-w-0">
       <h3 class="text-sm font-bold text-slate-700">Entêtes des colonnes du bulletin</h3>
       <p class="text-xs text-slate-400 mt-1">
        « Domaines » / « Activités » au CI-CP, « Activités » / « Contrôles » au CE1-CE2.
        Laissés vides, le bulletin retient « Domaines » et « Activités ».
       </p>
      </div>
      @* Pastille dont la COULEUR change à l'exécution : <badge> fixe sa variante côté serveur, elle ne
         peut donc pas suivre un état Alpine — on pose directement les classes .status-badge-*. *@
      <span class="shrink-0 text-[10px]"
       :class="isHierarchicalLevel ? 'status-badge-success' : 'status-badge-neutral'"
       x-text="isHierarchicalLevel ? 'Bulletin hiérarchique actif' : 'Bulletin classique'"></span>
     </div>

     <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
      <div>
       <label for="structure-col1" class="form-label">1re colonne</label>
       <input id="structure-col1" type="text" maxlength="40" x-model="headerDraft.column1Header"
        placeholder="Domaines" class="input-field" :disabled="!canManageSubject || !headerCarrier">
      </div>
      <div>
       <label for="structure-col2" class="form-label">2e colonne</label>
       <input id="structure-col2" type="text" maxlength="40" x-model="headerDraft.column2Header"
        placeholder="Activités" class="input-field" :disabled="!canManageSubject || !headerCarrier">
      </div>
      <button type="button" x-on:click="saveHeaders()" x-show="canManageSubject"
       :disabled="isSavingHeaders || !headerCarrier" class="btn-modal-secondary h-10 group">
       <span x-text="isSavingHeaders ? 'Enregistrement...' : 'Enregistrer les entêtes'"></span>
      </button>
     </div>
    </div>

    @* ── Les domaines et leurs activités ──
       Réordonnancement à la SOURIS : on saisit la poignée GripVertical et on glisse la ligne à sa
       place (plus de flèches ↑/↓). Le dépôt n'est accepté que dans la même fratrie — un domaine sur
       la liste des domaines, une activité sur les activités de SON domaine.
       Chaque domaine est repliable (Collapsible) : ses activités restent imbriquées dessous. *@
    <template x-for="(group, groupIndex) in structureGroups" :key="group.root.id">
     <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden transition-shadow"
      x-on:dragover="onStructureDragOver('groups', groupIndex, $event)"
      x-on:drop.prevent="dropStructure('groups', groupIndex, structureGroups.map(g => g.root))"
      :class="dragScope === 'groups' && dragOverIndex === groupIndex && dragIndex !== groupIndex ? 'ring-2 ring-primary-400' : ''">

      @* Entête du domaine *@
      <div class="flex items-center gap-2 px-4 sm:px-5 py-4 border-b border-slate-100 bg-gradient-to-r from-primary-50/40 to-transparent"
       :class="dragScope === 'groups' && dragIndex === groupIndex ? 'opacity-50' : ''">
       <button type="button" x-show="canManageSubject" x-cloak draggable="true"
        x-on:dragstart="startStructureDrag('groups', groupIndex, $event)"
        x-on:dragend="endStructureDrag()"
        :class="isReordering ? 'opacity-30 pointer-events-none' : ''"
        title="Glisser pour réordonner le domaine" aria-label="Glisser pour réordonner le domaine"
        class="shrink-0 -ml-1 p-1 rounded text-slate-300 hover:text-primary-600 hover:bg-primary-50 cursor-grab active:cursor-grabbing transition-colors">
        <icon name="grip-vertical" class="w-4 h-4" />
       </button>

       <button type="button" x-on:click="toggleNode(group.root.id)"
        :aria-expanded="(!isNodeCollapsed(group.root.id)).toString()"
        x-show="group.children.length > 0"
        class="shrink-0 p-1 rounded text-slate-400 hover:text-primary-600 hover:bg-primary-50 transition-colors">
        <icon name="chevron-down" class="w-4 h-4 transition-transform duration-200"
         x-bind:class="isNodeCollapsed(group.root.id) ? '-rotate-90' : ''" />
       </button>

       <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
         <span class="font-bold text-slate-800 break-words" x-text="group.root.name"></span>
         <badge variant="neutral" class="shrink-0 text-[10px]">
          coef. <span x-text="formatCoefficient(group.root.coefficient)"></span>
         </badge>
         <badge x-show="group.children.length === 0" x-cloak variant="warning" class="shrink-0 text-[10px]"
          x-text="maxScoreLabel(group.root)"></badge>
        </div>
        <span class="text-xs text-slate-400 mt-0.5 block"
         x-text="group.children.length === 0
          ? 'Matière simple — s\'imprime sur une seule ligne, sans regroupement.'
          : group.children.length + (group.children.length > 1 ? ' activités' : ' activité')"></span>
       </div>

       <template x-if="canManageSubject">
        <div class="shrink-0 flex items-center gap-1">
         <button type="button" x-on:click="openCreateActivity(group.root)" title="Ajouter une activité"
          class="inline-flex items-center gap-1 px-2.5 h-8 rounded-lg text-xs font-semibold text-primary-600 hover:bg-primary-50 transition-colors">
          <icon name="plus" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-90" />
          Activité
         </button>
         <button type="button" x-on:click="openEdit(group.root)" title="Modifier le domaine" aria-label="Modifier le domaine"
          class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
          <icon name="pencil" class="w-4 h-4" />
         </button>
         <button type="button" x-on:click="openDelete(group.root)" title="Supprimer le domaine" aria-label="Supprimer le domaine"
          class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
          <icon name="trash-2" class="w-4 h-4" />
         </button>
        </div>
       </template>
      </div>

      @* Activités du domaine — IMBRIQUÉES sous leur matière d'origine : décalées vers la droite et
         raccordées par un filet vertical. Repliables avec le domaine (x-show ci-dessus). *@
      <div x-show="group.children.length === 0 || !isNodeCollapsed(group.root.id)"
       x-transition:enter="ease-out duration-150" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
       class="divide-y divide-slate-50 pr-2 pl-4 sm:pl-8 ml-4 sm:ml-6 border-l-2 border-primary-100">
       <template x-for="(child, childIndex) in group.children" :key="child.id">
        <div class="flex items-center gap-2 px-2 py-2.5 rounded-xl hover:bg-slate-50/80 transition-colors"
         x-on:dragover="onStructureDragOver(group.root.id, childIndex, $event)"
         x-on:drop.prevent="dropStructure(group.root.id, childIndex, group.children)"
         :class="{
          'ring-2 ring-inset ring-primary-400': dragScope === group.root.id && dragOverIndex === childIndex && dragIndex !== childIndex,
          'opacity-50': dragScope === group.root.id && dragIndex === childIndex
         }">
         <button type="button" x-show="canManageSubject" x-cloak draggable="true"
          x-on:dragstart="startStructureDrag(group.root.id, childIndex, $event)"
          x-on:dragend="endStructureDrag()"
          :class="isReordering ? 'opacity-30 pointer-events-none' : ''"
          title="Glisser pour réordonner l'activité" aria-label="Glisser pour réordonner l'activité"
          class="shrink-0 p-0.5 rounded text-slate-300 hover:text-primary-600 hover:bg-primary-50 cursor-grab active:cursor-grabbing transition-colors">
          <icon name="grip-vertical" class="w-3.5 h-3.5" />
         </button>

         <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-primary-400 shrink-0"></span>
         <span class="flex-1 min-w-0 text-sm text-slate-700 break-words" x-text="child.name"></span>

         <badge variant="neutral" class="shrink-0 text-[10px] tabular-nums" x-text="maxScoreLabel(child)"></badge>

         <template x-if="canManageSubject">
          <div class="shrink-0 flex items-center gap-1">
           <button type="button" x-on:click="openEdit(child)" title="Modifier l'activité" aria-label="Modifier l'activité"
            class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
            <icon name="pencil" class="w-4 h-4" />
           </button>
           <button type="button" x-on:click="openDelete(child)" title="Supprimer l'activité" aria-label="Supprimer l'activité"
            class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
            <icon name="trash-2" class="w-4 h-4" />
           </button>
          </div>
         </template>
        </div>
       </template>

       <p x-show="group.children.length === 0" x-cloak class="py-4 px-2 text-xs text-slate-400">
        Aucune activité — ajoutez « Ressources » et « Compétences », ou laissez la matière telle quelle.
       </p>
      </div>
     </div>
    </template>

    <div class="flex items-center justify-between gap-4 flex-wrap">
     <p class="text-xs text-slate-400">
      <span x-text="structureLineCount"></span> ligne(s) seront imprimées sur le bulletin de ce niveau.
     </p>
     <button type="button" x-show="canManageSubject" x-on:click="openCreateGroup()" class="btn-modal-primary h-10 px-4 group">
      <icon name="plus" class="w-5 h-5 transition-transform duration-200 group-hover:rotate-90" />
      Nouveau domaine
     </button>
    </div>
   </div>
  </template>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    MODALES — Création / Édition / Suppression / Confirmations
    ⚠️ Le champ Niveau est désormais un <select> (menu déroulant) au lieu
    d'un champ texte libre, avec les 5 niveaux normalisés.
    ═══════════════════════════════════════════════════════════════════════════ *@

 @* Création d'une matière *@
 <modal-shell size="lg" open="isCreateOpen" title="Nouvelle matière">
  <modal-subtitle>Rattachez la matière à un niveau et fixez son coefficient.</modal-subtitle>

  <div x-show="createErrors.global" x-cloak class="form-error-banner" x-text="createErrors.global"></div>

  <form x-on:submit.prevent="submitCreate()" novalidate class="space-y-4">
   <div>
    <label for="subject-name" class="form-label form-label-required">Nom de la matière</label>
    <input id="subject-name" type="text" x-model="newSubject.name" required maxlength="80" placeholder="ex : Mathématiques"
     class="input-field" :class="createErrors.name && 'input-field-error'">
    <p x-show="createErrors.name" x-cloak x-text="createErrors.name" class="field-error"></p>
   </div>

   @* Module Coran/Franco-Arabe : facultatif, imprimé sur le bulletin bilingue seulement si renseigné —
      dir="rtl" pour que la saisie se lise dans le bon sens dès la frappe, aucune traduction automatique. *@
   <div>
    <label for="subject-name-ar" class="form-label">Nom en arabe (facultatif)</label>
    <input id="subject-name-ar" type="text" x-model="newSubject.nameAr" maxlength="80" dir="rtl" placeholder="مثال : الرياضيات"
     class="input-field" :class="createErrors.nameAr && 'input-field-error'">
    <p x-show="createErrors.nameAr" x-cloak x-text="createErrors.nameAr" class="field-error"></p>
   </div>

   @* ── Niveau : <select> au lieu de <input text> ── *@
   <div>
    <label for="subject-level" class="form-label form-label-required">Niveau</label>
    <select-field model="newSubject.level" required="true" aria-label="Niveau"
     placeholder="Sélectionner un niveau" options="subjectLevelOptions" />
    <p x-show="createErrors.level" x-cloak x-text="createErrors.level" class="field-error"></p>
   </div>

   <div>
    <label for="subject-coefficient" class="form-label form-label-required">Coefficient</label>
    <input id="subject-coefficient" type="number" x-model.number="newSubject.coefficient" required min="0.5" max="20" step="0.5"
     class="input-field" :class="createErrors.coefficient && 'input-field-error'">
    <p x-show="createErrors.coefficient" x-cloak x-text="createErrors.coefficient" class="field-error"></p>
   </div>

   @* ── Structure d'évaluation : rattachement à un domaine et barème propre ── *@
   <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 space-y-4">
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Structure d'évaluation</p>

    <div>
     <label for="subject-parent" class="form-label">Domaine parent</label>
     <select id="subject-parent" x-model="newSubject.parentSubjectId" class="input-field font-semibold"
      :class="createErrors.parentSubjectId && 'input-field-error'">
      <option value="" class="font-semibold">— Aucun (matière de premier niveau)</option>
      <template x-for="option in parentOptionsForNewSubject" :key="option.id">
       <option :value="option.id" x-text="option.name" class="font-semibold"></option>
      </template>
     </select>
     <p class="text-xs text-slate-400 mt-1">
      Rattachez « Ressources » ou « P. Alphabétique » à son domaine pour que le bulletin les regroupe.
     </p>
     <p x-show="createErrors.parentSubjectId" x-cloak x-text="createErrors.parentSubjectId" class="field-error"></p>
    </div>

    <div>
     <label for="subject-maxscore" class="form-label">Note maximale (colonne « Sur »)</label>
     <input id="subject-maxscore" type="number" x-model.number="newSubject.maxScore" min="1" max="100" step="1"
      placeholder="Vide = barème du cycle (Primaire /10, Collège & Lycée /20)"
      class="input-field" :class="createErrors.maxScore && 'input-field-error'">
     <p x-show="createErrors.maxScore" x-cloak x-text="createErrors.maxScore" class="field-error"></p>
    </div>

    <div>
     <label for="subject-order" class="form-label">Ordre d'affichage</label>
     <input id="subject-order" type="number" x-model.number="newSubject.displayOrder" min="0" max="999" step="1"
      class="input-field" :class="createErrors.displayOrder && 'input-field-error'">
     <p x-show="createErrors.displayOrder" x-cloak x-text="createErrors.displayOrder" class="field-error"></p>
    </div>
   </div>

   <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
    <button type="button" x-on:click="isCreateOpen = false" class="btn-modal-secondary group">
     Annuler
    </button>
    <button type="submit" :disabled="isSubmitting" class="btn-modal-primary group">
     <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 @* Confirmation : matière ajoutée *@
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Matière ajoutée">
  <confirm-dialog-body close-action="showAddedDialog = false"
   new-action="showAddedDialog = false; openCreate()" new-label="Nouvelle matière">
   La matière <span class="font-medium text-slate-900" x-text="addedSubjectName"></span> a bien été ajoutée.
  </confirm-dialog-body>
 </modal-shell>

 @* Modification d'une matière *@
 <modal-shell size="lg" open="editing" on-close="closeEdit()" title="Modifier la matière">
  <modal-subtitle><span x-text="editing ? editing.name : ''"></span></modal-subtitle>

  <div x-show="editErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="editErrors.global"></div>

  @* Formulaire MONTÉ seulement quand editing n'est pas null : `x-model` ne peut pas s'écrire avec un
     accès optionnel (`a?.b = x` est une erreur de syntaxe JS), et le `x-if="!editing.parentSubjectId"`
     plus bas déréférencerait lui aussi editing null au montage. closeEdit() remet editing à null dans
     le même tick que le panneau commence à disparaître — aucun flash visible. *@
  <template x-if="editing">
  <form x-on:submit.prevent="submitEdit()" novalidate class="space-y-4">
   <div>
    <label for="edit-subject-name" class="form-label form-label-required">Nom de la matière</label>
    <input id="edit-subject-name" type="text" x-model="editing.name" required maxlength="80" class="input-field" :class="editErrors.name && 'input-field-error'">
    <p x-show="editErrors.name" x-cloak x-text="editErrors.name" class="field-error"></p>
   </div>

   @* Module Coran/Franco-Arabe : facultatif, même champ que la création. *@
   <div>
    <label for="edit-subject-name-ar" class="form-label">Nom en arabe (facultatif)</label>
    <input id="edit-subject-name-ar" type="text" x-model="editing.nameAr" maxlength="80" dir="rtl" placeholder="مثال : الرياضيات"
     class="input-field" :class="editErrors.nameAr && 'input-field-error'">
    <p x-show="editErrors.nameAr" x-cloak x-text="editErrors.nameAr" class="field-error"></p>
   </div>

   @* ── Niveau : <select> au lieu de <input text> ── *@
   <div>
    <label for="edit-subject-level" class="form-label form-label-required">Niveau</label>
    <select-field model="editing.level" required="true" aria-label="Niveau"
     placeholder="Sélectionner un niveau" options="subjectLevelOptions" />
    <p x-show="editErrors.level" x-cloak x-text="editErrors.level" class="field-error"></p>
   </div>

   <div>
    <label for="edit-subject-coefficient" class="form-label form-label-required">Coefficient</label>
    <input id="edit-subject-coefficient" type="number" x-model.number="editing.coefficient" required min="0.5" max="20" step="0.5" class="input-field" :class="editErrors.coefficient && 'input-field-error'">
    <p x-show="editErrors.coefficient" x-cloak x-text="editErrors.coefficient" class="field-error"></p>
   </div>

   @* ── Structure d'évaluation ── *@
   <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 space-y-4">
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Structure d'évaluation</p>

    <div>
     <label for="edit-subject-parent" class="form-label">Domaine parent</label>
     <select id="edit-subject-parent" x-model="editing.parentSubjectId" class="input-field font-semibold"
      :class="editErrors.parentSubjectId && 'input-field-error'">
      <option value="" class="font-semibold">— Aucun (matière de premier niveau)</option>
      <template x-for="option in parentOptionsForEditing" :key="option.id">
       <option :value="option.id" x-text="option.name" class="font-semibold"></option>
      </template>
     </select>
     <p x-show="editErrors.parentSubjectId" x-cloak x-text="editErrors.parentSubjectId" class="field-error"></p>
    </div>

    <div>
     <label for="edit-subject-maxscore" class="form-label">Note maximale (colonne « Sur »)</label>
     <input id="edit-subject-maxscore" type="number" x-model.number="editing.maxScore" min="1" max="100" step="1"
      placeholder="Vide = barème du cycle (Primaire /10, Collège & Lycée /20)"
      class="input-field" :class="editErrors.maxScore && 'input-field-error'">
     <p x-show="editErrors.maxScore" x-cloak x-text="editErrors.maxScore" class="field-error"></p>
    </div>

    <div>
     <label for="edit-subject-order" class="form-label">Ordre d'affichage</label>
     <input id="edit-subject-order" type="number" x-model.number="editing.displayOrder" min="0" max="999" step="1"
      class="input-field" :class="editErrors.displayOrder && 'input-field-error'">
     <p x-show="editErrors.displayOrder" x-cloak x-text="editErrors.displayOrder" class="field-error"></p>
    </div>

    @* Les entêtes de colonnes ne se règlent que sur un DOMAINE : une activité n'a pas à nommer
       les colonnes du tableau qui la contient. *@
    <template x-if="!editing.parentSubjectId">
     <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
       <label for="edit-subject-col1" class="form-label">Entête 1re colonne</label>
       <input id="edit-subject-col1" type="text" maxlength="40" x-model="editing.column1Header"
        placeholder="Domaines" class="input-field">
      </div>
      <div>
       <label for="edit-subject-col2" class="form-label">Entête 2e colonne</label>
       <input id="edit-subject-col2" type="text" maxlength="40" x-model="editing.column2Header"
        placeholder="Activités" class="input-field">
      </div>
     </div>
    </template>
   </div>

   <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
    <button type="button" x-on:click="closeEdit()" class="btn-modal-secondary group">Annuler</button>
    <button type="submit" :disabled="isSavingEdit" class="btn-modal-primary group">
     <span x-text="isSavingEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
  </template>
 </modal-shell>

 @* Confirmation : matière modifiée *@
 <modal-shell open="showEditedDialog" size="md" on-close="showEditedDialog = false" title="Matière modifiée">
  <confirm-dialog-body close-action="showEditedDialog = false">
   La matière <span class="font-medium text-slate-900" x-text="editedSubjectName"></span> a bien été mise à jour.
  </confirm-dialog-body>
 </modal-shell>

 @* Confirmation : suppression d'une matière *@
 <modal-shell open="deletingSubject" on-close="closeDelete()" size="md">
  <modal-title>Supprimer la matière</modal-title>
  <modal-subtitle>
   <span class="font-semibold text-slate-900" x-text="deletingSubject ? deletingSubject.name : ''"></span>
   sera archivée et n'apparaîtra plus dans les sélecteurs de matière.
  </modal-subtitle>

  <div x-show="deleteSubjectError" x-cloak class="form-error-banner" x-text="deleteSubjectError"></div>

  <p class="text-base font-medium leading-relaxed text-slate-700">
   Impossible si des notes existent déjà pour cette matière : son coefficient pilote encore le calcul des moyennes et des bulletins déjà émis.
  </p>

  <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
   <button type="button" x-on:click="closeDelete()" class="btn-modal-secondary group">Annuler</button>
   <button type="button" x-on:click="confirmDelete()" :disabled="isDeletingSubject" class="btn-modal-danger">
    <span x-text="isDeletingSubject ? 'Suppression...' : 'Supprimer la matière'"></span>
   </button>
  </div>
 </modal-shell>

 @* Confirmation : matière supprimée *@
 <modal-shell open="showDeletedDialog" size="md" on-close="showDeletedDialog = false" title="Matière supprimée">
  <confirm-dialog-body close-action="showDeletedDialog = false">
   La matière <span class="font-medium text-slate-900" x-text="deletedSubjectName"></span> a bien été supprimée.
  </confirm-dialog-body>
 </modal-shell>
</div>
