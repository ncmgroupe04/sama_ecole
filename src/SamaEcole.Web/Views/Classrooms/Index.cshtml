@{
    ViewData["Title"] = "Pédagogie - Classes";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/classrooms.js" asp-append-version="true"></script>
}

<div x-data="classroomsView()">
    <!-- Titre et Bouton Ajouter -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-jgk-title font-bold text-gray-900">Classes</h1>
            <p class="text-jgk-subtitle text-gray-500 mt-1">Gérez l'arborescence et les capacités d'accueil.</p>
        </div>
        <button @@click="isCreateOpen = true" class="btn-primary">
            <icon name="plus" class="w-5 h-5" />
            Nouvelle classe
        </button>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- Synthèse et Tableau -->
    <div class="card mt-6 relative">
        <div class="p-4 border-b border-gray-200 bg-gray-50/50 rounded-t-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex gap-6">
                <stat-card size="compact" label="Total Classes" icon="building" accent="primary">
                    <span x-text="classrooms.length"></span>
                </stat-card>
                <stat-card size="compact" label="Capacité Totale" icon="users" accent="primary">
                    <span x-text="getTotalCapacity() + ' places'"></span>
                </stat-card>
            </div>

            <div class="flex gap-3">
                <select x-model="levelFilter" aria-label="Filtrer par niveau"
                        class="input-field mt-0 w-40 bg-white">
                    <option value="">Tous les niveaux</option>
                    <option value="Crèche">Crèche</option>
                    <option value="Maternelle">Maternelle</option>
                    <option value="Primaire">Primaire</option>
                    <option value="Collège">Collège</option>
                    <option value="Lycée">Lycée</option>
                </select>

                <div class="relative w-full sm:w-56">
                    <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <icon name="search" class="w-4 h-4 text-gray-400" />
                    </span>
                    <input type="search" x-model="search" placeholder="Rechercher une classe…"
                           aria-label="Rechercher une classe"
                           class="input-field mt-0 w-full pl-9" />
                </div>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4 w-12 text-center">N°</th>
                        <sort-th column="name" sort-key="sortKey" sort-dir="sortDir" on-sort="toggleSort('name')" class="py-3 px-4">Nom de la classe</sort-th>
                        <sort-th column="level" sort-key="sortKey" sort-dir="sortDir" on-sort="toggleSort('level')" class="py-3 px-4">Niveau</sort-th>
                        <sort-th column="capacity" sort-key="sortKey" sort-dir="sortDir" on-sort="toggleSort('capacity')" class="py-3 px-4 text-center">Capacité (places)</sort-th>
                        <th class="py-3 px-4">ID Référence (Pour tests)</th>
                    </tr>
                </thead>
                <tbody class="table-cell divide-y divide-gray-100">
                    <template x-if="isLoading">
                        <template x-for="i in 3" :key="i">
                            <tr>
                                <td class="py-3 px-4" colspan="5"><div class="skeleton h-4 w-full"></div></td>
                            </tr>
                        </template>
                    </template>

                    <tr x-show="!isLoading && visibleClassrooms().length === 0" x-cloak>
                        <td colspan="5">
                            <empty-state icon="building" title="Aucune classe n'est configurée."
                                         hint="Créez votre première classe pour commencer les inscriptions." />
                        </td>
                    </tr>

                    <template x-for="(classroom, index) in visibleClassrooms()" :key="classroom.id || index">
                        <tr class="hover:bg-gray-50 transition-colors group">
                            <td class="py-3 px-4 text-center text-gray-400 font-medium" x-text="index + 1"></td>
                            <td class="py-3 px-4 font-bold text-gray-900">
                                <span class="inline-flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                                    <span x-text="classroom.name"></span>
                                </span>
                            </td>
                            <td class="py-3 px-4"><badge variant="neutral" x-text="classroom.level"></badge></td>
                            <td class="py-3 px-4 text-center font-medium" x-text="classroom.capacity"></td>
                            <td class="py-3 px-4 text-xs font-mono text-gray-400 group-hover:text-primary transition-colors">
                                <!-- Pratique pour copier-coller l'ID dans le formulaire Élève pour les tests -->
                                <span x-text="classroom.id"></span>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Création de classe -->
    <modal-shell open="isCreateOpen" title="Nouvelle classe">
        <modal-subtitle>Configurez une nouvelle classe et sa capacité.</modal-subtitle>

        <!-- Erreur globale -->
        <div x-show="createErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="createErrors.global"></div>

        <form x-on:submit.prevent="submitCreate()" class="space-y-4">
            <!-- Nom de la classe -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Nom de la classe <span class="text-danger">*</span></label>
                <input type="text" x-model="newClassroom.name" required placeholder="ex: CM2 B" class="input-field">
                <p x-show="createErrors.name" x-text="createErrors.name" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Niveau -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Niveau <span class="text-danger">*</span></label>
                <select x-model="newClassroom.level" required class="input-field bg-white">
                    <option value="Crèche">Crèche</option>
                    <option value="Maternelle">Maternelle</option>
                    <option value="Primaire">Primaire</option>
                    <option value="Collège">Collège</option>
                    <option value="Lycée">Lycée</option>
                </select>
                <p x-show="createErrors.level" x-text="createErrors.level" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Capacité -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Capacité d'accueil <span class="text-danger">*</span></label>
                <input type="number" x-model.number="newClassroom.capacity" required min="1" max="100" class="input-field">
                <p x-show="createErrors.capacity" x-text="createErrors.capacity" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Boutons d'action -->
            <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
                <button type="button" @@click="isCreateOpen = false" class="btn-secondary">
                    Annuler
                </button>
                <button type="submit" :disabled="isSubmitting" class="btn-primary">
                    <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>
</div>
