@using System.Text.Json
@using SamaEcole.Application.Classrooms
@{
 ViewData["Title"] = "Pédagogie - Classes";
 var classroomLevelOptions = new List<SelectFieldOption> {
 new("Crèche", "Crèche"), new("Maternelle", "Maternelle"), new("Primaire", "Primaire"),
 new("Collège", "Collège"), new("Lycée", "Lycée")
 };
 var levelFilterOptions = new List<SelectFieldOption> { new("", "Tous les niveaux") }.Concat(classroomLevelOptions).ToList();

 // Niveaux (CI, CP… Terminale) proposés pour le SECOND niveau d'une classe passerelle, indexés par la
 // valeur exacte de la liste « Niveau » ci-dessus — la liste déroulante n'a ainsi rien à traduire.
 // Servis depuis ClassroomGradeLevels, la même table que celle qui reconnaît le niveau courant d'une
 // classe côté serveur et qui alimente la délibération : recopier cette nomenclature en JavaScript
 // ferait diverger l'écran et le moteur de promotion, et la validation serveur rejetterait un niveau
 // que l'écran vient pourtant de proposer.
 var gradeLevelsByLevel = classroomLevelOptions.ToDictionary(o => o.Value, o => ClassroomGradeLevels.For(o.Value));

 // JsonSerializer.Serialize (une CHAÎNE) et surtout PAS @@Json.Serialize : ce dernier rend un
 // IHtmlContent déjà encodé pour un bloc <script>, où les guillemets JSON restent des guillemets bruts.
 // Injecté dans un attribut HTML délimité par des guillemets doubles, le premier `"` du JSON FERMAIT
 // l'attribut x-data : le navigateur ne transmettait que « classroomsView({ » à Alpine, l'expression
 // levait une SyntaxError, et le composant classroomsView n'était jamais initialisé — écran Classes
 // bloqué sur son squelette, tous les x-cloak jamais levés. Une chaîne, elle, est encodée par Razor
 // (`&quot;`), et le navigateur la redonne intacte à Alpine. Même parti pris que SelectFieldTagHelper.
 var gradeLevelsJson = JsonSerializer.Serialize(gradeLevelsByLevel);
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/classrooms.js" asp-append-version="true"></script>
}

<div x-data="classroomsView(@gradeLevelsJson)">

 @* ═══════════════════════════════════════════════════════════════════════════
    STICKY HEADER — En-tête fixe opaque (Ticket UI).
    Le titre, les KPI, les filtres et la recherche restent accessibles à tout
    moment même après un long scroll dans la grille de classes.
    ═══════════════════════════════════════════════════════════════════════════ *@
  <div class="sticky-sub-header">

  @await Html.PartialAsync("_ErrorBanner")

  @* KPI badges + Filtres + Actions *@
  <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
   <div class="flex gap-4">
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="building" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Classes</span>
      <p class="text-base font-bold text-slate-900" x-text="classrooms.length">0</p>
     </div>
    </div>
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="users" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Capacité</span>
      <p class="text-base font-bold text-slate-900"><span x-text="getTotalCapacity()">0</span> <span class="text-xs font-normal text-slate-400">places</span></p>
     </div>
    </div>
   </div>

   <div class="flex flex-wrap items-center gap-3">
    <select-field model="levelFilter" aria-label="Filtrer par niveau"
     placeholder="Tous les niveaux" class="!my-0 w-40" options="levelFilterOptions" />

    <div class="relative w-full sm:w-56 flex items-center">
     <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
      <icon name="search" class="w-4 h-4 text-slate-400" />
     </span>
     <input type="search" x-model="search" placeholder="Rechercher une classe…"
      aria-label="Rechercher une classe"
      class="input-field !my-0 pl-9 pr-3 w-full" />
    </div>

    <button x-show="canManage" x-cloak @@click="openCreate()"
     class="btn-modal-primary group h-10 px-4 ml-auto">
     <icon name="plus" class="w-5 h-5 transition-transform duration-200 group-hover:rotate-90" />
     Nouvelle classe
    </button>
   </div>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    LOADING SKELETON
    ═══════════════════════════════════════════════════════════════════════════ *@
 <template x-if="isLoading">
  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
   <template x-for="i in 5" :key="i">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 space-y-4 animate-pulse">
     <div class="flex justify-between items-center">
      <div class="skeleton h-5 w-24 rounded-lg"></div>
      <div class="skeleton h-5 w-16 rounded-lg"></div>
     </div>
     <div class="space-y-3">
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-3/4 rounded-lg"></div>
     </div>
    </div>
   </template>
  </div>
 </template>

 @* ═══════════════════════════════════════════════════════════════════════════
    EMPTY STATE
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && groups.length === 0" x-cloak class="mt-8">
  <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
   <div class="mx-auto w-16 h-16 rounded-2xl bg-primary-50 flex items-center justify-center mb-4">
    <icon name="building" class="w-8 h-8 text-primary-400" />
   </div>
   <h3 class="text-base font-semibold text-slate-700 mb-1">Aucune classe n'est configurée.</h3>
   <p class="text-sm text-slate-400">Créez votre première classe pour commencer les inscriptions.</p>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    GRILLE PRINCIPALE — Cartes « Floating Container »
    Chaque cycle (Primaire, Collège, Lycée, Crèche, Maternelle) est une carte
    arrondie 2xl avec bordure fine et ombre subtile au survol. Les classes à
    l'intérieur affichent une JAUGE de remplissage dynamique.
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && groups.length > 0" x-cloak
  class="mt-8 pt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch relative z-0">
  <template x-for="cycle in mainGroups" :key="cycle.level">
   <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg h-full flex flex-col overflow-hidden">

    @* En-tête de cycle *@
    <div class="px-6 pt-5 pb-4 border-b border-slate-100 bg-gradient-to-r from-primary-50/40 to-transparent">
     <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
       <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-primary-100 text-primary-600">
        <icon name="building" class="w-3.5 h-3.5" />
       </span>
       <span class="text-sm font-bold text-primary-700 uppercase tracking-wide" x-text="cycle.level"></span>
      </div>
      <span x-show="cycle.classrooms.length > 0" x-cloak
       class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-xs font-semibold text-primary-700">
       <span x-text="cycle.totalStudents"></span>/<span x-text="cycle.totalCapacity"></span>
       <span class="text-primary-400 font-normal">élèves</span>
      </span>
     </div>
     <span class="text-xs text-slate-400 mt-1 block" x-text="plural(cycle.classrooms.length, 'classe', 'classes')"></span>
    </div>

    @* Liste des classes avec jauge *@
    <div class="divide-y divide-slate-50 flex-1 px-2">
     <template x-for="classroom in cycle.classrooms" :key="classroom.id">
      <div class="group flex items-center gap-3 px-4 py-3 rounded-xl mx-0 hover:bg-slate-50/80 transition-all duration-200">
       @* Nom de la classe *@
       <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
         <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400 shrink-0"></span>
         <a :href="`/eleves?classroomId=${classroom.id}`" class="font-semibold text-slate-800 truncate hover:text-primary-600 transition-colors" x-text="displayName(classroom.name, cycle.level)" :title="'Voir les élèves de ' + classroom.name"></a>
         @* Classe passerelle : repérable d'un coup d'œil dans la liste — c'est la seule chose qui
            distingue « CI-CP » d'une classe ordinaire au nom inhabituel. *@
         <span x-show="classroom.isAccelerated" x-cloak
          class="shrink-0 px-1.5 py-0.5 rounded-md bg-amber-50 text-[10px] font-semibold text-amber-700 uppercase tracking-wide"
          :title="'Cursus Accéléré Passerelle' + (classroom.targetLevel ? ' — second niveau validé : ' + classroom.targetLevel : '')">Passerelle</span>
         @* Série de lycée (S1, S2, L1a, L2, STEG…) : c'est elle qui décide du programme et des coefficients de la classe. *@
         <span x-show="classroom.series" x-cloak x-text="classroom.series"
          class="shrink-0 px-1.5 py-0.5 rounded-md bg-primary-50 text-[10px] font-semibold text-primary-700 tracking-wide"
          title="Série de la classe (détermine les coefficients)"></span>
        </div>

        @* Jauge de remplissage *@
        <div class="mt-1.5 flex items-center gap-2">
         <div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden">
          <div class="h-full rounded-full transition-all duration-700 ease-out"
           :class="(classroom.studentCount || 0) >= classroom.capacity ? 'bg-danger' : (classroom.studentCount || 0) >= classroom.capacity * 0.8 ? 'bg-warning' : 'bg-primary-400'"
           :style="`width: ${Math.min(100, (classroom.capacity > 0 ? ((classroom.studentCount || 0) / classroom.capacity) * 100 : 0))}%`">
          </div>
         </div>
         <span class="text-[11px] font-medium text-slate-400 whitespace-nowrap tabular-nums">
          <span class="text-slate-600" x-text="classroom.studentCount || 0"></span>/<span x-text="classroom.capacity"></span>
         </span>
        </div>
       </div>

       @* Actions (toujours visibles pour accès direct) *@
       <template x-if="canManage">
        <div class="shrink-0 flex items-center gap-1">
         <button type="button" @@click="classroom.studentCount > 0 ? downloadSchoolCards(classroom) : null" :title="!classroom.studentCount ? 'Aucun élève dans cette classe' : 'Cartes scolaires'" aria-label="Télécharger les cartes scolaires"
          :disabled="!classroom.studentCount"
          :class="!classroom.studentCount ? 'opacity-30 cursor-not-allowed' : 'hover:text-blue-600 hover:bg-blue-50'"
          class="p-1.5 rounded-lg text-slate-400 transition-colors">
          <icon name="payment" class="w-4 h-4" />
         </button>
         <button type="button" @@click="openEdit(classroom)" title="Modifier" aria-label="Modifier la classe"
          class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
          <icon name="pencil" class="w-4 h-4" />
         </button>
         <button type="button" @@click="deleteClassroom(classroom)" title="Supprimer" aria-label="Supprimer la classe"
          class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
          <icon name="trash-2" class="w-4 h-4" />
         </button>
        </div>
       </template>
      </div>
     </template>

     <p x-show="cycle.classrooms.length === 0" x-cloak class="py-8 text-center text-xs text-slate-400">
      Aucune classe dans ce cycle.
     </p>
    </div>
   </div>
  </template>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    FILET DE SÉCURITÉ — Niveaux hors nomenclature
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && otherGroups.length > 0" x-cloak class="mt-6">
  <template x-for="group in otherGroups" :key="group.level">
   <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg overflow-hidden mb-4">
    <div class="flex items-center justify-between gap-3 px-6 py-4 bg-gradient-to-r from-slate-50 to-transparent border-b border-slate-100">
     <div class="flex items-baseline gap-2.5 min-w-0">
      <span class="text-sm font-bold text-slate-600 uppercase tracking-wide" x-text="group.level"></span>
      <span class="text-xs text-slate-400 whitespace-nowrap" x-text="plural(group.classrooms.length, 'classe', 'classes')"></span>
     </div>
     <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
      <span x-text="group.totalStudents"></span> inscrits ·
      <span x-text="group.totalCapacity"></span> places
     </span>
    </div>

    <div class="divide-y divide-slate-50 px-2">
     <template x-for="classroom in group.classrooms" :key="classroom.id">
      <div class="group flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50/80 transition-all duration-200">
       <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
         <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400"></span>
         <a :href="`/eleves?classroomId=${classroom.id}`" class="font-semibold text-slate-800 hover:text-primary-600 transition-colors" x-text="displayName(classroom.name, group.level)" :title="'Voir les élèves de ' + classroom.name"></a>
         <span x-show="classroom.isAccelerated" x-cloak
          class="shrink-0 px-1.5 py-0.5 rounded-md bg-amber-50 text-[10px] font-semibold text-amber-700 uppercase tracking-wide"
          :title="'Cursus Accéléré Passerelle' + (classroom.targetLevel ? ' — second niveau validé : ' + classroom.targetLevel : '')">Passerelle</span>
         @* Série de lycée (S1, S2, L1a, L2, STEG…) : c'est elle qui décide du programme et des coefficients de la classe. *@
         <span x-show="classroom.series" x-cloak x-text="classroom.series"
          class="shrink-0 px-1.5 py-0.5 rounded-md bg-primary-50 text-[10px] font-semibold text-primary-700 tracking-wide"
          title="Série de la classe (détermine les coefficients)"></span>
        </div>
        <div class="mt-1.5 flex items-center gap-2">
         <div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden">
          <div class="h-full rounded-full transition-all duration-700 ease-out"
           :class="(classroom.studentCount || 0) >= classroom.capacity ? 'bg-danger' : (classroom.studentCount || 0) >= classroom.capacity * 0.8 ? 'bg-warning' : 'bg-primary-400'"
           :style="`width: ${Math.min(100, (classroom.capacity > 0 ? ((classroom.studentCount || 0) / classroom.capacity) * 100 : 0))}%`">
          </div>
         </div>
         <span class="text-[11px] font-medium text-slate-400 whitespace-nowrap tabular-nums">
          <span class="text-slate-600" x-text="classroom.studentCount || 0"></span>/<span x-text="classroom.capacity"></span>
         </span>
        </div>
       </div>
       <template x-if="canManage">
        <div class="shrink-0 flex items-center gap-1">
         <button type="button" @@click="classroom.studentCount > 0 ? downloadSchoolCards(classroom) : null" :title="!classroom.studentCount ? 'Aucun élève dans cette classe' : 'Cartes scolaires'" aria-label="Télécharger les cartes scolaires"
          :disabled="!classroom.studentCount"
          :class="!classroom.studentCount ? 'opacity-30 cursor-not-allowed' : 'hover:text-blue-600 hover:bg-blue-50'"
          class="p-1.5 rounded-lg text-slate-400 transition-colors">
          <icon name="payment" class="w-4 h-4" />
         </button>
         <button type="button" @@click="openEdit(classroom)" title="Modifier" aria-label="Modifier la classe"
          class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
          <icon name="pencil" class="w-4 h-4" />
         </button>
         <button type="button" @@click="deleteClassroom(classroom)" title="Supprimer" aria-label="Supprimer la classe"
          class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
          <icon name="trash-2" class="w-4 h-4" />
         </button>
        </div>
       </template>
      </div>
     </template>
    </div>
   </div>
  </template>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    MODALES — Création / Édition / Suppression / Confirmations
    Logique Alpine.js identique, formulaires modernisés (rounded-xl, focus indigo).
    ═══════════════════════════════════════════════════════════════════════════ *@

 @* Création de classe *@
 <modal-shell size="lg" open="isCreateOpen" on-close="closeCreate()" title="Nouvelle classe">
  <modal-subtitle>Configurez une nouvelle classe et sa capacité.</modal-subtitle>

  <div x-show="createErrors.global" x-cloak class="form-error-banner" x-text="createErrors.global"></div>

  <form x-on:submit.prevent="submitCreate()" novalidate class="space-y-4">
   <div>
    <label class="form-label form-label-required">Nom de la classe</label>
    <input type="text" x-model="newClassroom.name" required placeholder="ex: CM2 B" class="input-field" :class="createErrors.name && 'input-field-error'">
    <p x-show="createErrors.name" x-text="createErrors.name" class="field-error"></p>
   </div>

   <div>
    <label class="form-label form-label-required">Niveau</label>
    @* on-change : changer de cycle change la nomenclature du second niveau — la valeur déjà choisie
       n'y appartient plus et doit repartir de zéro (voir onLevelChanged). *@
    <select-field model="newClassroom.level" required="true" aria-label="Niveau"
     options="classroomLevelOptions" on-change="onLevelChanged(newClassroom)" />
    <p x-show="createErrors.level" x-text="createErrors.level" class="field-error"></p>
   </div>

   <div>
    <label class="form-label form-label-required">Capacité d'accueil</label>
    <input type="number" x-model.number="newClassroom.capacity" required min="1" max="100" class="input-field" :class="createErrors.capacity && 'input-field-error'">
    <p x-show="createErrors.capacity" x-text="createErrors.capacity" class="field-error"></p>
   </div>

   @* Série / Filière (lycée) : « Général / Collège » pour une Seconde commune. Une série du référentiel du
      Baccalauréat reçoit à la création son programme officiel — matières, options, coefficients —, réglable
      ensuite dans l'onglet « Matières par classe » de l'écran Matières (Évolution N°6). *@
   <div x-show="showSeriesField(newClassroom)" x-cloak>
    <label class="form-label">Série / Filière</label>
    <select-field model="newClassroom.series" aria-label="Série de la classe" placeholder="Général / Collège (aucune série)"
     options-expr="seriesOptionsFor(newClassroom)" />
    <p x-show="seriesHasTemplate(newClassroom)" x-cloak class="mt-1 text-xs text-slate-500">
     Les matières, options et coefficients officiels de cette série seront ajoutés à la classe.
    </p>
    <p x-show="createErrors.series" x-cloak x-text="createErrors.series" class="field-error"></p>
   </div>

   @* ── Classe passerelle / accélérée (option) ─────────────────────────────────────────────
      La liste du second niveau ne se déplie QUE si la case est cochée : la très grande majorité
      des classes ne sont pas des passerelles, et le formulaire ne doit pas s'allonger pour tout
      le monde. Ses options dépendent du niveau choisi juste au-dessus (gradeLevels). *@
   <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-3">
    <label class="flex items-start gap-2.5 cursor-pointer">
     <input type="checkbox" x-model="newClassroom.isAccelerated"
      class="mt-0.5 h-4 w-4 rounded border-slate-300 text-primary-600 focus:ring-primary-500">
     <span class="leading-tight">
      <span class="text-sm font-medium text-slate-700">Classe Passerelle / Accélérée</span>
      <span class="block text-xs text-slate-400">L'année valide deux niveaux (ex. CI-CP, 6<sup>e</sup>-5<sup>e</sup>).</span>
     </span>
    </label>

    @* Options DYNAMIQUES via options-expr : elles suivent le niveau choisi juste au-dessus (CI…CM2 en
       Primaire, Sixième…Troisième au Collège), réévaluées par x-effect à chaque changement de cycle. *@
    <div x-show="newClassroom.isAccelerated" x-cloak class="mt-3 pl-6">
     <label class="form-label form-label-required">Second niveau validé</label>
     <select-field model="newClassroom.targetLevel" placeholder="Sélectionner le niveau"
      aria-label="Second niveau validé par la classe passerelle"
      options-expr="gradeLevelsFor(newClassroom.level).map(g => ({value: g, label: g}))" />
     <p x-show="createErrors.targetLevel" x-cloak x-text="createErrors.targetLevel" class="field-error"></p>
    </div>
   </div>

   <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
    <button type="button" @@click="closeCreate()" class="btn-modal-secondary group">
     Annuler
    </button>
    <button type="submit" :disabled="isSubmitting" class="btn-modal-primary group">
     <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 @* Confirmation : classe ajoutée *@
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false; resetNewClassroom()" title="Classe ajoutée">
  <confirm-dialog-body close-action="showAddedDialog = false; resetNewClassroom()"
   new-action="showAddedDialog = false; openCreate()" new-label="Nouvelle classe">
   La classe <span class="font-medium text-slate-900" x-text="addedClassroomName"></span> a bien été ajoutée et figure désormais dans la liste.
  </confirm-dialog-body>
 </modal-shell>

 @* Modification d'une classe *@
 <modal-shell size="lg" open="isEditOpen" on-close="closeEdit()" title="Modifier la classe">
  <modal-subtitle><span x-text="editing.name"></span></modal-subtitle>

  <div x-show="editErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="editErrors.global"></div>

  <form x-on:submit.prevent="submitEdit()" novalidate class="space-y-4">
   <div>
    <label class="form-label form-label-required">Nom de la classe</label>
    <input type="text" x-model="editing.name" required maxlength="50" class="input-field" :class="editErrors.name && 'input-field-error'">
    <p x-show="editErrors.name" x-cloak x-text="editErrors.name" class="field-error"></p>
   </div>

   <div>
    <label class="form-label form-label-required">Niveau</label>
    <select-field model="editing.level" required="true" aria-label="Niveau"
     options="classroomLevelOptions" on-change="onLevelChanged(editing)" />
    <p x-show="editErrors.level" x-cloak x-text="editErrors.level" class="field-error"></p>
   </div>

   <div>
    <label class="form-label form-label-required">Capacité d'accueil</label>
    <input type="number" x-model.number="editing.capacity" required min="1" max="200" class="input-field" :class="editErrors.capacity && 'input-field-error'">
    <p x-show="editErrors.capacity" x-cloak x-text="editErrors.capacity" class="field-error"></p>
   </div>

   @* Série (lycée seulement) — même champ qu'à la création. Le PUT remplace la classe en entier :
      la série est toujours renvoyée, sans quoi elle serait effacée. *@
   <div x-show="showSeriesField(editing)" x-cloak>
    <label class="form-label">Série / Filière</label>
    <select-field model="editing.series" aria-label="Série de la classe" placeholder="Général / Collège (aucune série)"
     options-expr="seriesOptionsFor(editing)" />
    <p x-show="editErrors.series" x-cloak x-text="editErrors.series" class="field-error"></p>
   </div>

   @* Classe passerelle / accélérée — même bloc qu'à la création. Décocher la case efface le second
      niveau côté serveur (ClassroomPromotion.NormalizeTargetLevel) : une classe redevenue ordinaire
      ne garde pas un niveau cible invisible. *@
   <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-3">
    <label class="flex items-start gap-2.5 cursor-pointer">
     <input type="checkbox" x-model="editing.isAccelerated"
      class="mt-0.5 h-4 w-4 rounded border-slate-300 text-primary-600 focus:ring-primary-500">
     <span class="leading-tight">
      <span class="text-sm font-medium text-slate-700">Classe Passerelle / Accélérée</span>
      <span class="block text-xs text-slate-400">L'année valide deux niveaux (ex. CI-CP, 6<sup>e</sup>-5<sup>e</sup>).</span>
     </span>
    </label>

    @* La modale est montée en x-show, pas en x-if — son contenu reste dans le DOM et
       Alpine réévalue ces expressions. `editing` est maintenant toujours un objet complet
       initialisé par défaut, évitant les crashs de x-model sur null. *@
    <div x-show="editing.isAccelerated" x-cloak class="mt-3 pl-6">
     <label class="form-label form-label-required">Second niveau validé</label>
     <select-field model="editing.targetLevel" placeholder="Sélectionner le niveau"
      aria-label="Second niveau validé par la classe passerelle"
      options-expr="gradeLevelsFor(editing.level).map(g => ({value: g, label: g}))" />
     <p x-show="editErrors.targetLevel" x-cloak x-text="editErrors.targetLevel" class="field-error"></p>
    </div>
   </div>

   <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
    <button type="button" x-on:click="closeEdit()" class="btn-modal-secondary group">Annuler</button>
    <button type="submit" :disabled="isSavingEdit" class="btn-modal-primary group">
     <span x-text="isSavingEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 @* Confirmation : classe modifiée *@
 <modal-shell open="showEditedDialog" size="md" on-close="showEditedDialog = false" title="Classe modifiée">
  <confirm-dialog-body close-action="showEditedDialog = false">
   La classe <span class="font-medium text-slate-900" x-text="editedClassroomName"></span> a bien été mise à jour.
  </confirm-dialog-body>
 </modal-shell>

 @* Confirmation : suppression d'une classe *@
 <modal-shell open="deletingClassroom" on-close="closeDelete()" size="md">
  <modal-title>Supprimer la classe</modal-title>
  <modal-subtitle>
   <span class="font-semibold text-slate-900" x-text="deletingClassroom ? deletingClassroom.name : ''"></span>
   sera archivée et n'apparaîtra plus dans les sélecteurs de classe.
  </modal-subtitle>

  <div x-show="deleteClassroomError" x-cloak class="form-error-banner" x-text="deleteClassroomError"></div>

  <p class="text-base font-medium leading-relaxed text-slate-700">
   Impossible si des élèves sont encore rattachés à cette classe : déplacez-les d'abord vers une autre classe.
  </p>

  <div class="bg-white border-t border-slate-100 p-4 px-6 flex justify-end gap-3 -mx-6 -mb-6 mt-6 z-10">
   <button type="button" x-on:click="closeDelete()" class="btn-modal-secondary group">Annuler</button>
   <button type="button" x-on:click="confirmDelete()" :disabled="isDeletingClassroom" class="btn-modal-danger">
    <span x-text="isDeletingClassroom ? 'Suppression...' : 'Supprimer la classe'"></span>
   </button>
  </div>
 </modal-shell>

 @* Confirmation : classe supprimée *@
 <modal-shell open="showDeletedDialog" size="md" on-close="showDeletedDialog = false" title="Classe supprimée">
  <confirm-dialog-body close-action="showDeletedDialog = false">
   La classe <span class="font-medium text-slate-900" x-text="deletedClassroomName"></span> a bien été supprimée.
  </confirm-dialog-body>
 </modal-shell>

    @* Aperçu PDF partagé — voir wwwroot/js/pdf-preview.js *@
    @await Html.PartialAsync("_PdfPreviewModal")
</div>
