@{
    ViewData["Title"] = "Pédagogie - Classes";
    var classroomLevelOptions = new List<SelectFieldOption> {
        new("Crèche", "Crèche"), new("Maternelle", "Maternelle"), new("Primaire", "Primaire"),
        new("Collège", "Collège"), new("Lycée", "Lycée")
    };
    var levelFilterOptions = new List<SelectFieldOption> { new("", "Tous les niveaux") }.Concat(classroomLevelOptions).ToList();
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/classrooms.js" asp-append-version="true"></script>
}

<div x-data="classroomsView()">
    <!-- Titre et Bouton Ajouter -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-jgk-title font-bold text-gray-900">Classes</h1>
            <p class="text-jgk-subtitle text-gray-500 mt-1">Gérez l'arborescence et les capacités d'accueil.</p>
        </div>
        <button @@click="isCreateOpen = true" class="btn-primary">
            <icon name="plus" class="w-5 h-5" />
            Nouvelle classe
        </button>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- Synthèse et Tableau -->
    <div class="card mt-6 relative">
        <div class="p-4 border-b border-gray-200 bg-gray-50/50 rounded-t-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex gap-6">
                <stat-card size="compact" label="Total Classes" icon="building" accent="primary">
                    <span x-text="classrooms.length"></span>
                </stat-card>
                <stat-card size="compact" label="Capacité Totale" icon="users" accent="primary">
                    <span x-text="getTotalCapacity() + ' places'"></span>
                </stat-card>
            </div>

            <div class="flex gap-3">
                <select-field model="levelFilter" aria-label="Filtrer par niveau"
                              placeholder="Tous les niveaux" class="w-40" options="levelFilterOptions" />

                <div class="relative w-full sm:w-56">
                    <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <icon name="search" class="w-4 h-4 text-gray-400" />
                    </span>
                    <input type="search" x-model="search" placeholder="Rechercher une classe…"
                           aria-label="Rechercher une classe"
                           class="input-field mt-0 w-full pl-9" />
                </div>
            </div>
        </div>

        <template x-if="isLoading">
            <div class="p-4 space-y-3">
                <template x-for="i in 3" :key="i"><div class="skeleton h-10 w-full"></div></template>
            </div>
        </template>

        <!-- État vide -->
        <div x-show="!isLoading && groups.length === 0" x-cloak>
            <empty-state icon="building" title="Aucune classe n'est configurée."
                         hint="Créez votre première classe pour commencer les inscriptions." />
        </div>

        @* Grille principale : 5 colonnes fixes, une par cycle (Crèche → Lycée), pour exploiter la
           largeur de l'écran plutôt qu'empiler les cycles verticalement (source d'un long défilement
           dès qu'une école dépasse une poignée de classes). Chaque classe est triée par succession
           pédagogique réelle (TPS, PS… puis CI, CP, CE1… puis 6e, 5e… puis Seconde, Première,
           Terminale — voir byGradeThenName dans classrooms.js), pas alphabétiquement.
           items-stretch : les 5 cartes gardent exactement la même hauteur (celle de la plus longue),
           pour que Crèche/Collège avec peu de classes ne cassent pas l'alignement visuel de la rangée.
           sm:/lg: (600px/1024px) et non md:/xl: — tailwind.config.js REMPLACE entièrement les points
           de rupture par défaut de Tailwind (Volume 5 §2.4) ; md:/xl: n'existent pas dans ce projet et
           ne généreraient silencieusement aucun CSS. *@
        <div x-show="!isLoading && groups.length > 0" x-cloak class="p-4 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-4 items-stretch">
            <template x-for="cycle in mainGroups" :key="cycle.level">
                <div class="bg-white rounded-xl border border-gray-100 p-4 h-full flex flex-col">
                    <div class="flex items-center justify-between gap-2 pb-3 border-b border-gray-100">
                        <span class="text-sm font-bold text-primary-700 uppercase tracking-wide truncate" x-text="cycle.level"></span>
                        <span class="text-jgk-table text-gray-500 whitespace-nowrap" x-show="cycle.classrooms.length > 0" x-cloak>
                            <span class="font-semibold text-gray-700" x-text="cycle.totalStudents"></span>/<span class="font-semibold text-gray-700" x-text="cycle.totalCapacity"></span>
                        </span>
                    </div>
                    <span class="text-xs text-gray-500 whitespace-nowrap pt-2" x-text="plural(cycle.classrooms.length, 'classe', 'classes')"></span>

                    <div class="divide-y divide-gray-100 flex-1 mt-1">
                        @* 2fr/1fr : le nom de la classe occupe le double de largeur de la colonne effectif. *@
                        <template x-for="classroom in cycle.classrooms" :key="classroom.id">
                            <div class="grid grid-cols-[2fr_1fr_auto] items-center gap-2 py-2.5 hover:bg-gray-50 transition-colors">
                                <span class="min-w-0 flex items-center gap-2 font-bold text-gray-900">
                                    <span aria-hidden="true" class="w-2 h-2 rounded-full bg-indigo-400 shrink-0"></span>
                                    <span class="truncate" x-text="displayName(classroom.name)" :title="classroom.name"></span>
                                </span>
                                <span class="text-right text-jgk-table font-semibold text-gray-700 whitespace-nowrap">
                                    <span x-text="classroom.studentCount || 0"></span>/<span x-text="classroom.capacity"></span>
                                </span>
                                <template x-if="canManage">
                                    <row-actions>
                                        <row-action icon="pencil" label="Modifier" on-click="openEdit(classroom)" />
                                        <row-action icon="trash-2" label="Supprimer" on-click="openDelete(classroom)" variant="danger" />
                                    </row-actions>
                                </template>
                            </div>
                        </template>

                        <p x-show="cycle.classrooms.length === 0" x-cloak class="py-6 text-center text-xs text-gray-400">
                            Aucune classe dans ce cycle.
                        </p>
                    </div>
                </div>
            </template>
        </div>

        @* Filet de sécurité : un niveau hors des 5 colonnes fixes ci-dessus (donnée héritée, future
           nomenclature) — en pratique vide, MAIN_CYCLES couvrant déjà toute la liste Niveau du formulaire. *@
        <div x-show="!isLoading && otherGroups.length > 0" x-cloak class="border-t border-gray-100 divide-y divide-gray-100">
            <template x-for="group in otherGroups" :key="group.level">
                <div>
                    <div class="flex items-center justify-between gap-3 px-4 py-3 bg-indigo-50/60 border-l-4 border-primary">
                        <div class="flex items-baseline gap-2.5 min-w-0">
                            <span class="text-sm font-bold text-primary-700 uppercase tracking-wide" x-text="group.level"></span>
                            <span class="text-xs text-gray-500 whitespace-nowrap" x-text="plural(group.classrooms.length, 'classe', 'classes')"></span>
                        </div>
                        <span class="text-jgk-table text-gray-500 whitespace-nowrap">
                            <span class="font-semibold text-gray-700" x-text="group.totalStudents"></span> inscrits ·
                            <span class="font-semibold text-gray-700" x-text="group.totalCapacity"></span> places
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <tbody>
                                <template x-for="classroom in group.classrooms" :key="classroom.id">
                                    <tr class="hover:bg-gray-50 transition-colors border-t border-gray-100">
                                        <td class="py-3 px-4 font-bold text-gray-900">
                                            <span class="inline-flex items-center gap-2">
                                                <span aria-hidden="true" class="w-2 h-2 rounded-full bg-indigo-400"></span>
                                                <span x-text="displayName(classroom.name)" :title="classroom.name"></span>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-right w-56 whitespace-nowrap">
                                            <span class="text-gray-400 text-xs">effectif</span>
                                            <span class="font-bold text-gray-900 ml-1">
                                                <span x-text="classroom.studentCount || 0"></span> / <span x-text="classroom.capacity"></span>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-right w-44 whitespace-nowrap">
                                            <template x-if="canManage">
                                                <row-actions>
                                                    <row-action icon="pencil" label="Modifier" on-click="openEdit(classroom)" />
                                                    <row-action icon="trash-2" label="Supprimer" on-click="openDelete(classroom)" variant="danger" />
                                                </row-actions>
                                            </template>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <!-- Création de classe -->
    <modal-shell open="isCreateOpen" title="Nouvelle classe">
        <modal-subtitle>Configurez une nouvelle classe et sa capacité.</modal-subtitle>

        <!-- Erreur globale -->
        <div x-show="createErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="createErrors.global"></div>

        <form x-on:submit.prevent="submitCreate()" class="space-y-4">
            <!-- Nom de la classe -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Nom de la classe <span class="text-danger">*</span></label>
                <input type="text" x-model="newClassroom.name" required placeholder="ex: CM2 B" class="input-field">
                <p x-show="createErrors.name" x-text="createErrors.name" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Niveau -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Niveau <span class="text-danger">*</span></label>
                <select-field model="newClassroom.level" required="true" aria-label="Niveau" options="classroomLevelOptions" />
                <p x-show="createErrors.level" x-text="createErrors.level" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Capacité -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Capacité d'accueil <span class="text-danger">*</span></label>
                <input type="number" x-model.number="newClassroom.capacity" required min="1" max="100" class="input-field">
                <p x-show="createErrors.capacity" x-text="createErrors.capacity" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Boutons d'action -->
            <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
                <button type="button" @@click="isCreateOpen = false" class="btn-secondary">
                    Annuler
                </button>
                <button type="submit" :disabled="isSubmitting" class="btn-primary">
                    <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Confirmation : classe ajoutée -->
    <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Classe ajoutée">
        <confirm-dialog-body close-action="showAddedDialog = false"
                             new-action="showAddedDialog = false; isCreateOpen = true" new-label="Nouvelle classe">
            La classe <span class="font-medium text-gray-900" x-text="addedClassroomName"></span> a bien été ajoutée et figure désormais dans la liste.
        </confirm-dialog-body>
    </modal-shell>

    <!-- Modification d'une classe -->
    <modal-shell open="editing" on-close="closeEdit()" title="Modifier la classe">
        <modal-subtitle><span x-text="editing ? editing.name : ''"></span></modal-subtitle>

        <div x-show="editErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="editErrors.global"></div>

        <form x-on:submit.prevent="submitEdit()" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Nom de la classe <span class="text-danger">*</span></label>
                <input type="text" x-model="editing.name" required maxlength="50" class="input-field">
                <p x-show="editErrors.name" x-cloak x-text="editErrors.name" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Niveau <span class="text-danger">*</span></label>
                <select-field model="editing.level" required="true" aria-label="Niveau" options="classroomLevelOptions" />
                <p x-show="editErrors.level" x-cloak x-text="editErrors.level" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Capacité d'accueil <span class="text-danger">*</span></label>
                <input type="number" x-model.number="editing.capacity" required min="1" max="200" class="input-field">
                <p x-show="editErrors.capacity" x-cloak x-text="editErrors.capacity" class="mt-1 text-xs text-danger"></p>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <button type="button" x-on:click="closeEdit()" class="btn-secondary">Annuler</button>
                <button type="submit" :disabled="isSavingEdit" class="btn-primary">
                    <span x-text="isSavingEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Confirmation : classe modifiée -->
    <modal-shell open="showEditedDialog" size="md" on-close="showEditedDialog = false" title="Classe modifiée">
        <confirm-dialog-body close-action="showEditedDialog = false">
            La classe <span class="font-medium text-gray-900" x-text="editedClassroomName"></span> a bien été mise à jour.
        </confirm-dialog-body>
    </modal-shell>

    <!-- Confirmation : suppression d'une classe -->
    <modal-shell open="deletingClassroom" on-close="closeDelete()" size="md">
        <modal-title>Supprimer la classe</modal-title>
        <modal-subtitle>
            <span class="font-semibold text-gray-900" x-text="deletingClassroom ? deletingClassroom.name : ''"></span>
            sera archivée et n'apparaîtra plus dans les sélecteurs de classe.
        </modal-subtitle>

        <div x-show="deleteClassroomError" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="deleteClassroomError"></div>

        <p class="text-sm text-gray-500">
            Impossible si des élèves sont encore rattachés à cette classe : déplacez-les d'abord vers une autre classe.
        </p>

        <div class="mt-6 flex justify-end gap-3">
            <button type="button" x-on:click="closeDelete()" class="btn-secondary">Annuler</button>
            <button type="button" x-on:click="confirmDelete()" :disabled="isDeletingClassroom" class="btn-danger">
                <span x-text="isDeletingClassroom ? 'Suppression...' : 'Supprimer la classe'"></span>
            </button>
        </div>
    </modal-shell>

    <!-- Confirmation : classe supprimée -->
    <modal-shell open="showDeletedDialog" size="md" on-close="showDeletedDialog = false" title="Classe supprimée">
        <confirm-dialog-body close-action="showDeletedDialog = false">
            La classe <span class="font-medium text-gray-900" x-text="deletedClassroomName"></span> a bien été supprimée.
        </confirm-dialog-body>
    </modal-shell>
</div>
