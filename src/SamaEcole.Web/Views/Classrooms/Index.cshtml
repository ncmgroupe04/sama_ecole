@{
 ViewData["Title"] = "Pédagogie - Classes";
 var classroomLevelOptions = new List<SelectFieldOption> {
 new("Crèche", "Crèche"), new("Maternelle", "Maternelle"), new("Primaire", "Primaire"),
 new("Collège", "Collège"), new("Lycée", "Lycée")
 };
 var levelFilterOptions = new List<SelectFieldOption> { new("", "Tous les niveaux") }.Concat(classroomLevelOptions).ToList();
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/classrooms.js" asp-append-version="true"></script>
}

<div x-data="classroomsView()">

 @* ═══════════════════════════════════════════════════════════════════════════
    STICKY HEADER — Glassmorphism : fond translucide + flou dynamique.
    Le titre, les KPI, les filtres et la recherche restent accessibles à tout
    moment même après un long scroll dans la grille de classes.
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div class="sticky top-0 z-20 -mx-4 -mt-4 px-4 pt-4 pb-5 bg-slate-50/85 backdrop-blur-md border-b border-slate-200/80">

  @* Titre + Bouton *@
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
   <div>
    <h1 class="text-jgk-title font-bold text-slate-900">Classes</h1>
    <p class="text-jgk-subtitle text-slate-500 mt-1">Gérez l'arborescence et les capacités d'accueil.</p>
   </div>
   <button x-show="canManage" x-cloak @@click="openCreate()"
    class="btn-primary group">
    <icon name="plus" class="w-5 h-5 transition-transform duration-200 group-hover:rotate-90" />
    Nouvelle classe
   </button>
  </div>

  @await Html.PartialAsync("_ErrorBanner")

  @* KPI badges + Filtres *@
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
   <div class="flex gap-4">
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="building" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Classes</span>
      <p class="text-base font-bold text-slate-900" x-text="classrooms.length">0</p>
     </div>
    </div>
    <div class="flex items-center gap-2 px-4 py-2 bg-white/80 rounded-xl border border-slate-200/80 shadow-sm">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-50 text-primary-600">
      <icon name="users" class="w-4 h-4" />
     </div>
     <div class="leading-tight">
      <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Capacité</span>
      <p class="text-base font-bold text-slate-900"><span x-text="getTotalCapacity()">0</span> <span class="text-xs font-normal text-slate-400">places</span></p>
     </div>
    </div>
   </div>

   <div class="flex items-center gap-3">
    <select-field model="levelFilter" aria-label="Filtrer par niveau"
     placeholder="Tous les niveaux" class="!my-0 h-10 !py-2 !px-3 rounded-xl w-40 transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" options="levelFilterOptions" />

    <div class="relative w-full sm:w-56 flex items-center">
     <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
      <icon name="search" class="w-4 h-4 text-slate-400" />
     </span>
     <input type="search" x-model="search" placeholder="Rechercher une classe…"
      aria-label="Rechercher une classe"
      class="input-field !my-0 h-10 !py-2 pl-9 pr-3 rounded-xl w-full transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" />
    </div>
   </div>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    LOADING SKELETON
    ═══════════════════════════════════════════════════════════════════════════ *@
 <template x-if="isLoading">
  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
   <template x-for="i in 5" :key="i">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 space-y-4 animate-pulse">
     <div class="flex justify-between items-center">
      <div class="skeleton h-5 w-24 rounded-lg"></div>
      <div class="skeleton h-5 w-16 rounded-lg"></div>
     </div>
     <div class="space-y-3">
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-full rounded-lg"></div>
      <div class="skeleton h-9 w-3/4 rounded-lg"></div>
     </div>
    </div>
   </template>
  </div>
 </template>

 @* ═══════════════════════════════════════════════════════════════════════════
    EMPTY STATE
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && groups.length === 0" x-cloak class="mt-8">
  <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
   <div class="mx-auto w-16 h-16 rounded-2xl bg-primary-50 flex items-center justify-center mb-4">
    <icon name="building" class="w-8 h-8 text-primary-400" />
   </div>
   <h3 class="text-base font-semibold text-slate-700 mb-1">Aucune classe n'est configurée.</h3>
   <p class="text-sm text-slate-400">Créez votre première classe pour commencer les inscriptions.</p>
  </div>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    GRILLE PRINCIPALE — Cartes « Floating Container »
    Chaque cycle (Primaire, Collège, Lycée, Crèche, Maternelle) est une carte
    arrondie 2xl avec bordure fine et ombre subtile au survol. Les classes à
    l'intérieur affichent une JAUGE de remplissage dynamique.
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && groups.length > 0" x-cloak
  class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
  <template x-for="cycle in mainGroups" :key="cycle.level">
   <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg h-full flex flex-col overflow-hidden">

    @* En-tête de cycle *@
    <div class="px-6 pt-5 pb-4 border-b border-slate-100 bg-gradient-to-r from-primary-50/40 to-transparent">
     <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
       <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-primary-100 text-primary-600">
        <icon name="building" class="w-3.5 h-3.5" />
       </span>
       <span class="text-sm font-bold text-primary-700 uppercase tracking-wide" x-text="cycle.level"></span>
      </div>
      <span x-show="cycle.classrooms.length > 0" x-cloak
       class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-xs font-semibold text-primary-700">
       <span x-text="cycle.totalStudents"></span>/<span x-text="cycle.totalCapacity"></span>
       <span class="text-primary-400 font-normal">élèves</span>
      </span>
     </div>
     <span class="text-xs text-slate-400 mt-1 block" x-text="plural(cycle.classrooms.length, 'classe', 'classes')"></span>
    </div>

    @* Liste des classes avec jauge *@
    <div class="divide-y divide-slate-50 flex-1 px-2">
     <template x-for="classroom in cycle.classrooms" :key="classroom.id">
      <div class="group flex items-center gap-3 px-4 py-3 rounded-xl mx-0 hover:bg-slate-50/80 transition-all duration-200">
       @* Nom de la classe *@
       <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
         <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400 shrink-0"></span>
         <span class="font-semibold text-slate-800 truncate" x-text="displayName(classroom.name, cycle.level)" :title="classroom.name"></span>
        </div>

        @* Jauge de remplissage *@
        <div class="mt-1.5 flex items-center gap-2">
         <div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden">
          <div class="h-full rounded-full transition-all duration-700 ease-out"
           :class="(classroom.studentCount || 0) >= classroom.capacity ? 'bg-danger' : (classroom.studentCount || 0) >= classroom.capacity * 0.8 ? 'bg-warning' : 'bg-primary-400'"
           :style="`width: ${Math.min(100, (classroom.capacity > 0 ? ((classroom.studentCount || 0) / classroom.capacity) * 100 : 0))}%`">
          </div>
         </div>
         <span class="text-[11px] font-medium text-slate-400 whitespace-nowrap tabular-nums">
          <span class="text-slate-600" x-text="classroom.studentCount || 0"></span>/<span x-text="classroom.capacity"></span>
         </span>
        </div>
       </div>

       @* Actions (toujours visibles pour accès direct) *@
       <template x-if="canManage">
        <div class="shrink-0 flex items-center gap-1">
         <button type="button" @@click="openEdit(classroom)" title="Modifier" aria-label="Modifier la classe"
          class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
          <icon name="pencil" class="w-4 h-4" />
         </button>
         <button type="button" @@click="deleteClassroom(classroom)" title="Supprimer" aria-label="Supprimer la classe"
          class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
          <icon name="trash-2" class="w-4 h-4" />
         </button>
        </div>
       </template>
      </div>
     </template>

     <p x-show="cycle.classrooms.length === 0" x-cloak class="py-8 text-center text-xs text-slate-400">
      Aucune classe dans ce cycle.
     </p>
    </div>
   </div>
  </template>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    FILET DE SÉCURITÉ — Niveaux hors nomenclature
    ═══════════════════════════════════════════════════════════════════════════ *@
 <div x-show="!isLoading && otherGroups.length > 0" x-cloak class="mt-6">
  <template x-for="group in otherGroups" :key="group.level">
   <div class="bg-white rounded-2xl border border-slate-200/80 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg overflow-hidden mb-4">
    <div class="flex items-center justify-between gap-3 px-6 py-4 bg-gradient-to-r from-slate-50 to-transparent border-b border-slate-100">
     <div class="flex items-baseline gap-2.5 min-w-0">
      <span class="text-sm font-bold text-slate-600 uppercase tracking-wide" x-text="group.level"></span>
      <span class="text-xs text-slate-400 whitespace-nowrap" x-text="plural(group.classrooms.length, 'classe', 'classes')"></span>
     </div>
     <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
      <span x-text="group.totalStudents"></span> inscrits ·
      <span x-text="group.totalCapacity"></span> places
     </span>
    </div>

    <div class="divide-y divide-slate-50 px-2">
     <template x-for="classroom in group.classrooms" :key="classroom.id">
      <div class="group flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50/80 transition-all duration-200">
       <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
         <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primary-400"></span>
         <span class="font-semibold text-slate-800" x-text="displayName(classroom.name, group.level)" :title="classroom.name"></span>
        </div>
        <div class="mt-1.5 flex items-center gap-2">
         <div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden">
          <div class="h-full rounded-full transition-all duration-700 ease-out"
           :class="(classroom.studentCount || 0) >= classroom.capacity ? 'bg-danger' : (classroom.studentCount || 0) >= classroom.capacity * 0.8 ? 'bg-warning' : 'bg-primary-400'"
           :style="`width: ${Math.min(100, (classroom.capacity > 0 ? ((classroom.studentCount || 0) / classroom.capacity) * 100 : 0))}%`">
          </div>
         </div>
         <span class="text-[11px] font-medium text-slate-400 whitespace-nowrap tabular-nums">
          <span class="text-slate-600" x-text="classroom.studentCount || 0"></span>/<span x-text="classroom.capacity"></span>
         </span>
        </div>
       </div>
       <template x-if="canManage">
        <div class="shrink-0 flex items-center gap-1">
         <button type="button" @@click="openEdit(classroom)" title="Modifier" aria-label="Modifier la classe"
          class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
          <icon name="pencil" class="w-4 h-4" />
         </button>
         <button type="button" @@click="deleteClassroom(classroom)" title="Supprimer" aria-label="Supprimer la classe"
          class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
          <icon name="trash-2" class="w-4 h-4" />
         </button>
        </div>
       </template>
      </div>
     </template>
    </div>
   </div>
  </template>
 </div>

 @* ═══════════════════════════════════════════════════════════════════════════
    MODALES — Création / Édition / Suppression / Confirmations
    Logique Alpine.js identique, formulaires modernisés (rounded-xl, focus indigo).
    ═══════════════════════════════════════════════════════════════════════════ *@

 @* Création de classe *@
 <modal-shell open="isCreateOpen" on-close="closeCreate()" title="Nouvelle classe">
  <modal-subtitle>Configurez une nouvelle classe et sa capacité.</modal-subtitle>

  <div x-show="createErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="createErrors.global"></div>

  <form x-on:submit.prevent="submitCreate()" class="space-y-4">
   <div>
    <label class="block text-sm font-medium text-slate-700">Nom de la classe <span class="text-danger">*</span></label>
    <input type="text" x-model="newClassroom.name" required placeholder="ex: CM2 B" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
    <p x-show="createErrors.name" x-text="createErrors.name" class="mt-1 text-xs text-danger"></p>
   </div>

   <div>
    <label class="block text-sm font-medium text-slate-700">Niveau <span class="text-danger">*</span></label>
    <select-field model="newClassroom.level" required="true" aria-label="Niveau" options="classroomLevelOptions" />
    <p x-show="createErrors.level" x-text="createErrors.level" class="mt-1 text-xs text-danger"></p>
   </div>

   <div>
    <label class="block text-sm font-medium text-slate-700">Capacité d'accueil <span class="text-danger">*</span></label>
    <input type="number" x-model.number="newClassroom.capacity" required min="1" max="100" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
    <p x-show="createErrors.capacity" x-text="createErrors.capacity" class="mt-1 text-xs text-danger"></p>
   </div>

   <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
    <button type="button" @@click="closeCreate()" class="btn-secondary">
     Annuler
    </button>
    <button type="submit" :disabled="isSubmitting" class="btn-primary">
     <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 @* Confirmation : classe ajoutée *@
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false; resetNewClassroom()" title="Classe ajoutée">
  <confirm-dialog-body close-action="showAddedDialog = false; resetNewClassroom()"
   new-action="showAddedDialog = false; openCreate()" new-label="Nouvelle classe">
   La classe <span class="font-medium text-slate-900" x-text="addedClassroomName"></span> a bien été ajoutée et figure désormais dans la liste.
  </confirm-dialog-body>
 </modal-shell>

 @* Modification d'une classe *@
 <modal-shell open="editing" on-close="closeEdit()" title="Modifier la classe">
  <modal-subtitle><span x-text="editing ? editing.name : ''"></span></modal-subtitle>

  <div x-show="editErrors.global" x-cloak class="mb-4 rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="editErrors.global"></div>

  <form x-on:submit.prevent="submitEdit()" class="space-y-4">
   <div>
    <label class="block text-sm font-medium text-slate-700">Nom de la classe <span class="text-danger">*</span></label>
    <input type="text" x-model="editing.name" required maxlength="50" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
    <p x-show="editErrors.name" x-cloak x-text="editErrors.name" class="mt-1 text-xs text-danger"></p>
   </div>

   <div>
    <label class="block text-sm font-medium text-slate-700">Niveau <span class="text-danger">*</span></label>
    <select-field model="editing.level" required="true" aria-label="Niveau" options="classroomLevelOptions" />
    <p x-show="editErrors.level" x-cloak x-text="editErrors.level" class="mt-1 text-xs text-danger"></p>
   </div>

   <div>
    <label class="block text-sm font-medium text-slate-700">Capacité d'accueil <span class="text-danger">*</span></label>
    <input type="number" x-model.number="editing.capacity" required min="1" max="200" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
    <p x-show="editErrors.capacity" x-cloak x-text="editErrors.capacity" class="mt-1 text-xs text-danger"></p>
   </div>

   <div class="mt-6 flex justify-end gap-3">
    <button type="button" x-on:click="closeEdit()" class="btn-secondary">Annuler</button>
    <button type="submit" :disabled="isSavingEdit" class="btn-primary">
     <span x-text="isSavingEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
    </button>
   </div>
  </form>
 </modal-shell>

 @* Confirmation : classe modifiée *@
 <modal-shell open="showEditedDialog" size="md" on-close="showEditedDialog = false" title="Classe modifiée">
  <confirm-dialog-body close-action="showEditedDialog = false">
   La classe <span class="font-medium text-slate-900" x-text="editedClassroomName"></span> a bien été mise à jour.
  </confirm-dialog-body>
 </modal-shell>

 @* Confirmation : suppression d'une classe *@
 <modal-shell open="deletingClassroom" on-close="closeDelete()" size="md">
  <modal-title>Supprimer la classe</modal-title>
  <modal-subtitle>
   <span class="font-semibold text-slate-900" x-text="deletingClassroom ? deletingClassroom.name : ''"></span>
   sera archivée et n'apparaîtra plus dans les sélecteurs de classe.
  </modal-subtitle>

  <div x-show="deleteClassroomError" x-cloak class="mb-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="deleteClassroomError"></div>

  <p class="text-sm text-slate-500">
   Impossible si des élèves sont encore rattachés à cette classe : déplacez-les d'abord vers une autre classe.
  </p>

  <div class="mt-6 flex justify-end gap-3">
   <button type="button" x-on:click="closeDelete()" class="btn-secondary">Annuler</button>
   <button type="button" x-on:click="confirmDelete()" :disabled="isDeletingClassroom" class="btn-danger">
    <span x-text="isDeletingClassroom ? 'Suppression...' : 'Supprimer la classe'"></span>
   </button>
  </div>
 </modal-shell>

 @* Confirmation : classe supprimée *@
 <modal-shell open="showDeletedDialog" size="md" on-close="showDeletedDialog = false" title="Classe supprimée">
  <confirm-dialog-body close-action="showDeletedDialog = false">
   La classe <span class="font-medium text-slate-900" x-text="deletedClassroomName"></span> a bien été supprimée.
  </confirm-dialog-body>
 </modal-shell>
</div>
