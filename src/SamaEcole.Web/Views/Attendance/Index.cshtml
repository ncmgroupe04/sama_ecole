@{
 ViewData["Title"] = "Présences";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/attendance.js" asp-append-version="true"></script>
}

<div x-data="attendanceView()">
 <div>
 <h1 class="page-title">Présences</h1>
 <p class="page-subtitle">Faites l'appel d'une classe pour une matière, une date et un créneau.</p>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- Sélection de l'appel -->
 <div class="card mt-6 p-6">
 <div class="flex flex-col lg:flex-row lg:items-end gap-3">
 <div class="flex-1">
 <label class="form-label-sm">Classe</label>
 <select-field model="filters.classroomId" class="mt-0" placeholder="Choisir une classe…"
 options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" />
 </div>
 <div class="flex-1">
 <label class="form-label-sm">Matière</label>
 <select-field model="filters.subjectId" class="mt-0" placeholder="Choisir une matière…"
 options-expr="subjects.map(s => ({value: s.id, label: s.name + ' (' + s.level + ')'}))" />
 </div>
 <div>
 <label class="form-label-sm">Date</label>
 <date-field model="filters.date" class="mt-0" aria-label="Date" />
 </div>
 <div>
 <label class="form-label-sm">Créneau</label>
 <input type="text" x-model="filters.period" list="attendance-periods" placeholder="Matin" class="input-field mt-0 w-40" />
 <datalist id="attendance-periods">
 <option value="Matin" class="font-semibold"></option>
 <option value="Après-midi" class="font-semibold"></option>
 <option value="1re heure" class="font-semibold"></option>
 <option value="2e heure" class="font-semibold"></option>
 </datalist>
 </div>
 <button type="button" x-on:click="loadRoster()" :disabled="!canLoad || isLoading" class="btn-modal-primary whitespace-nowrap group">
 <icon name="checkmark-circle" class="w-4 h-4" />
 <span x-text="isLoading ? 'Chargement…' : 'Charger l\'appel'"></span>
 </button>
 </div>
 </div>

 <!-- Grille d'appel -->
 <div class="card mt-6 relative" x-show="rosterLoaded" x-cloak>
 <div class="card-header">
 <div class="flex items-center flex-wrap gap-2 text-sm">
 <span class="status-badge-success"><span class="status-dot" aria-hidden="true"></span>Présents : <span class="font-bold" x-text="countBy('Present')"></span>
 </span>
 <span class="status-badge-warning"><span class="status-dot" aria-hidden="true"></span>Retards : <span class="font-bold" x-text="countBy('Late')"></span>
 </span>
 <span class="status-badge-danger"><span class="status-dot" aria-hidden="true"></span>Absents non justifiés : <span class="font-bold" x-text="countBy('UnjustifiedAbsence')"></span>
 </span>
 </div>
 <div class="flex items-center gap-3">
 <span x-show="alreadySubmitted" x-cloak class="text-xs font-medium text-warning">Appel déjà enregistré pour ce créneau.</span>
 <button type="button" x-on:click="submit()" :disabled="submitting || alreadySubmitted || entries.length === 0" class="btn-modal-primary group">
 <span x-text="sendState === 'retrying' ? 'En attente d\'envoi…' : (submitting ? 'Enregistrement…' : 'Enregistrer l\'appel')"></span>
 </button>
 </div>
 </div>

 <div x-show="sendState === 'retrying' || sendState === 'failed'" x-cloak class="mx-4 mt-4 rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="sendStateLabel()"></div>

 <div x-show="submitError" x-cloak class="mx-4 mt-4 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="submitError"></div>

 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="table-head">
 <th class="py-3 px-4">Élève</th>
 <th class="py-3 px-4 w-56">Statut</th>
 <th class="py-3 px-4 w-40">Retard (min)</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <tr class="hover:bg-slate-50 transition-colors duration-150" x-show="entries.length === 0">
 <td colspan="3">
 <empty-state icon="users" title="Aucun élève dans cette classe."
 hint="Vérifiez que des élèves sont inscrits dans la classe choisie." />
 </td>
 </tr>
 <template x-for="(entry, index) in entries" :key="entry.studentId">
 <tr class="hover:bg-slate-50 transition-colors duration-150">
 <td class="py-3 px-4">
 <div class="flex items-center gap-3">
 <div class="w-8 h-8 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xs" x-text="initials(entry.fullName)"></div>
 <div>
 <p class="font-medium text-slate-900" x-text="entry.fullName"></p>
 <p class="font-mono text-xs text-slate-500" x-text="entry.matricule"></p>
 </div>
 </div>
 </td>
 <td class="py-3 px-4">
 <select-field model="entry.status" on-change="onStatusChange(entry)" disabled="alreadySubmitted"
 class="mt-0 text-sm" options-expr="statusOptions" />
 </td>
 <td class="py-3 px-4">
 <input type="number" min="1" max="240" x-model.number="entry.lateMinutes"
 x-show="entry.status === 'Late'"
 :disabled="alreadySubmitted"
 class="input-field mt-0 w-28 text-sm py-1.5" placeholder="min" />
 <span x-show="entry.status !== 'Late'" class="text-slate-300">—</span>
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>
 </div>

 <!-- État initial : aucun appel encore chargé -->
 <div class="card mt-6" x-show="!rosterLoaded && !isLoading" x-cloak>
 <empty-state icon="checkmark-circle" title="Sélectionnez une classe, une matière, une date et un créneau."
 hint="Puis cliquez sur « Charger l'appel » pour saisir les présences." />
 </div>

 <!-- Confirmation : appel enregistré. Action terminale unique par classe/matière/créneau (verrouillée
 ensuite par alreadySubmitted), même nature qu'une inscription ou un encaissement — contrairement
 à la saisie de notes (une écriture par cellule), une vraie boîte de dialogue convient ici. -->
 <modal-shell open="submitSuccess" size="md" on-close="submitSuccess = false" title="Appel enregistré">
 <confirm-dialog-body close-action="submitSuccess = false"
 new-action="submitSuccess = false; rosterLoaded = false" new-label="Nouvel appel">
 L'appel de <span class="font-medium text-slate-900" x-text="selectedClassroomLabel"></span>
 en <span class="font-medium text-slate-900" x-text="selectedSubjectLabel"></span>
 du <span class="font-medium text-slate-900" x-text="formatDate(filters.date)"></span>
 (<span x-text="filters.period"></span>) a bien été enregistré :
 <span class="font-medium text-slate-900" x-text="countBy('Present')"></span> présent(s),
 <span class="font-medium text-slate-900" x-text="countBy('Late')"></span> retard(s),
 <span class="font-medium text-slate-900" x-text="countBy('UnjustifiedAbsence') + countBy('JustifiedAbsence')"></span> absent(s).
 </confirm-dialog-body>
 </modal-shell>
</div>
