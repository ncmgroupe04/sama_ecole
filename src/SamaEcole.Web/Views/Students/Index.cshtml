@{
    ViewData["Title"] = "Élèves - Aperçu";
}

@section Scripts {
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/students.js" asp-append-version="true"></script>
}

<div x-data="studentsView()">
    <!-- Titre de la page -->
    <div>
        <h1 class="text-jgk-title font-bold text-gray-900">Élèves</h1>
        <p class="text-jgk-subtitle text-gray-500 mt-1">Gérez les inscriptions et les dossiers des élèves.</p>
    </div>

    <!-- Cartes KPI (4 cartes en ligne) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        <!-- Total Élèves -->
        <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Total Élèves</p>
                <p class="text-2xl font-bold text-gray-900" x-text="totalCount">0</p>
            </div>
            <div class="flex flex-col items-end">
                <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center text-primary mb-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                </div>
            </div>
        </div>
        
        <!-- Filles -->
        <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Filles</p>
                <p class="text-2xl font-bold text-gray-900">--</p>
            </div>
            <div class="flex flex-col items-end">
                <div class="w-10 h-10 rounded-full bg-pink-50 flex items-center justify-center text-pink-600 mb-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                </div>
            </div>
        </div>

        <!-- Garçons -->
        <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Garçons</p>
                <p class="text-2xl font-bold text-gray-900">--</p>
            </div>
            <div class="flex flex-col items-end">
                <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 mb-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                </div>
            </div>
        </div>

        <!-- Nouvelles inscriptions -->
        <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-500 mb-1">Inscriptions (Nouveau)</p>
                <p class="text-2xl font-bold text-gray-900">--</p>
            </div>
            <div class="flex flex-col items-end">
                <div class="w-10 h-10 rounded-full bg-green-50 flex items-center justify-center text-success mb-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert d'erreur API globale -->
    <div x-show="error" x-cloak class="mt-6 bg-red-50 border-l-4 border-danger p-4 rounded-md">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-danger" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
            </div>
            <div class="ml-3">
                <p class="text-sm text-red-700" x-text="error"></p>
            </div>
        </div>
    </div>

    <!-- Bloc Tableau et Filtres -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 mt-6 relative">
        
        <!-- Loading Overlay (Tableau) -->
        <div x-show="isLoading" class="absolute inset-0 z-10 bg-white/70 flex items-center justify-center rounded-xl backdrop-blur-sm">
            <svg class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </div>

        <!-- Barre de filtres et actions -->
        <div class="p-4 border-b border-gray-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <!-- Filtres -->
            <div class="flex flex-wrap items-center gap-3">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    </span>
                    <input type="text" placeholder="Rechercher un élève..." class="pl-9 pr-3 py-1.5 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary w-full sm:w-64" />
                </div>
                <select class="pl-3 pr-8 py-1.5 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary appearance-none">
                    <option value="">Classe : Toutes</option>
                    <template x-for="c in classrooms" :key="c.id">
                        <option :value="c.id" x-text="c.name + ' (' + c.level + ')'"></option>
                    </template>
                </select>
                <select class="pl-3 pr-8 py-1.5 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary appearance-none">
                    <option value="">Genre : Tous</option>
                    <option value="F">Fille</option>
                    <option value="M">Garçon</option>
                </select>
                <button class="text-sm font-medium text-gray-500 hover:text-gray-900">Réinitialiser les filtres</button>
            </div>
            
            <!-- Actions -->
            <div class="flex items-center gap-3">
                <button class="px-3 py-1.5 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors shadow-sm flex items-center gap-2">
                    <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                    Importer CSV
                </button>
                <button @@click="isCreateOpen = true" class="px-4 py-1.5 bg-primary text-white text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-sm shadow-indigo-200 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Ajouter un élève
                </button>
            </div>
        </div>

        <!-- Conteneur Tableau -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <th class="py-3 px-4 w-12 text-center">
                            <input type="checkbox" class="rounded border-gray-300 text-primary focus:ring-primary">
                        </th>
                        <th class="py-3 px-4 cursor-pointer hover:text-gray-700">Matricule</th>
                        <th class="py-3 px-4 cursor-pointer hover:text-gray-700">Élève</th>
                        <th class="py-3 px-4">Date de nais.</th>
                        <th class="py-3 px-4">Genre</th>
                        <th class="py-3 px-4 w-16 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="text-sm text-gray-700 divide-y divide-gray-100">
                    
                    <!-- État vide -->
                    <tr x-show="!isLoading && students.length === 0" x-cloak>
                        <td colspan="6" class="py-8 text-center text-gray-500">
                            Aucun élève trouvé.
                        </td>
                    </tr>

                    <!-- Boucle sur les élèves -->
                    <template x-for="student in students" :key="student.id">
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-3 px-4 text-center">
                                <input type="checkbox" class="rounded border-gray-300 text-primary focus:ring-primary">
                            </td>
                            <td class="py-3 px-4 font-medium text-gray-900" x-text="student.matricule"></td>
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xs" x-text="getInitials(student.fullName)"></div>
                                    <div>
                                        <p class="font-medium text-gray-900" x-text="student.fullName"></p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-4" x-text="formatDate(student.birthDate)"></td>
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium" 
                                      :class="student.gender === 'F' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'"
                                      x-text="student.gender === 'F' ? 'Fille' : 'Garçon'">
                                </span>
                            </td>
                            <td class="py-3 px-4 text-right">
                                <button class="text-gray-400 hover:text-gray-600">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="p-4 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-sm text-gray-500">
                Affichage de <span class="font-medium text-gray-900" x-text="students.length > 0 ? (page - 1) * pageSize + 1 : 0"></span> à <span class="font-medium text-gray-900" x-text="Math.min(page * pageSize, totalCount)"></span> sur <span class="font-medium text-gray-900" x-text="totalCount"></span> résultats
            </div>
            <div class="flex items-center gap-2">
                <nav class="inline-flex rounded-md shadow-sm">
                    <button @@click="if(page > 1) { page--; loadStudents(); }" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50" :disabled="page === 1">
                        <span class="sr-only">Précédent</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                    </button>
                    <!-- Simplification: Page actuelle seule pour la démo alpine -->
                    <span class="z-10 bg-indigo-50 border-primary text-primary relative inline-flex items-center px-4 py-2 border text-sm font-medium" x-text="page"></span>
                    <button @@click="if(page * pageSize < totalCount) { page++; loadStudents(); }" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50" :disabled="page * pageSize >= totalCount">
                        <span class="sr-only">Suivant</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>
                    </button>
                </nav>
            </div>
        </div>
    </div>

    <!-- Modale (Slide-over) de Création d'Élève (JGK-D01) -->
    <div x-show="isCreateOpen" class="fixed inset-0 overflow-hidden z-40" x-cloak>
        <div class="absolute inset-0 overflow-hidden">
            <div x-show="isCreateOpen" x-transition.opacity class="absolute inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @@click="isCreateOpen = false"></div>
            
            <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
                <div x-show="isCreateOpen" x-transition:enter="transform transition ease-in-out duration-300 sm:duration-500" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transform transition ease-in-out duration-300 sm:duration-500" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full" class="pointer-events-auto w-screen max-w-md">
                    <div class="flex h-full flex-col overflow-y-scroll bg-white shadow-xl">
                        <div class="bg-primary px-4 py-6 sm:px-6">
                            <div class="flex items-center justify-between">
                                <h2 class="text-lg font-medium text-white">Ajouter un élève</h2>
                                <div class="ml-3 flex h-7 items-center">
                                    <button type="button" @@click="isCreateOpen = false" class="rounded-md bg-primary text-indigo-200 hover:text-white focus:outline-none">
                                        <span class="sr-only">Fermer le panneau</span>
                                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="mt-1">
                                <p class="text-sm text-indigo-200">Le matricule sera généré automatiquement à l'enregistrement.</p>
                            </div>
                        </div>
                        
                        <div class="relative flex-1 px-4 py-6 sm:px-6">
                            <!-- Erreur globale -->
                            <div x-show="createErrors.global" class="mb-4 bg-red-50 p-3 rounded-md border-l-4 border-danger">
                                <p class="text-sm text-red-700" x-text="createErrors.global"></p>
                            </div>

                            <form @@submit.prevent="submitCreate" class="space-y-4">
                                <!-- Nom complet -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Nom complet <span class="text-danger">*</span></label>
                                    <input type="text" x-model="newStudent.fullName" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2">
                                    <p x-show="createErrors.fullname" x-text="createErrors.fullname" class="mt-1 text-xs text-danger"></p>
                                </div>

                                <!-- Date de naissance -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Date de naissance <span class="text-danger">*</span></label>
                                    <input type="date" x-model="newStudent.birthDate" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2">
                                    <p x-show="createErrors.birthdate" x-text="createErrors.birthdate" class="mt-1 text-xs text-danger"></p>
                                </div>

                                <!-- Genre -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Genre <span class="text-danger">*</span></label>
                                    <select x-model="newStudent.gender" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2 bg-white">
                                        <option value="M">Garçon</option>
                                        <option value="F">Fille</option>
                                    </select>
                                    <p x-show="createErrors.gender" x-text="createErrors.gender" class="mt-1 text-xs text-danger"></p>
                                </div>

                                <!-- Classe (Dynamique) -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Classe <span class="text-danger">*</span></label>
                                    <select x-model="newStudent.classroomId" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2 bg-white">
                                        <option value="" disabled>Sélectionner une classe</option>
                                        <template x-for="c in classrooms" :key="c.id">
                                            <option :value="c.id" x-text="c.name + ' (' + c.level + ')'"></option>
                                        </template>
                                    </select>
                                    <p x-show="createErrors.classroomid" x-text="createErrors.classroomid" class="mt-1 text-xs text-danger"></p>
                                </div>

                                <!-- Tuteur -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Nom du tuteur</label>
                                    <input type="text" x-model="newStudent.guardianName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Téléphone du tuteur</label>
                                    <input type="text" x-model="newStudent.guardianPhone" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm border p-2">
                                </div>

                                <!-- Boutons d'action -->
                                <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
                                    <button type="button" @@click="isCreateOpen = false" class="rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none">
                                        Annuler
                                    </button>
                                    <button type="submit" :disabled="isSubmitting" class="inline-flex justify-center rounded-md border border-transparent bg-primary py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-600 focus:outline-none disabled:opacity-50 flex items-center gap-2">
                                        <svg x-show="isSubmitting" class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                        <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
