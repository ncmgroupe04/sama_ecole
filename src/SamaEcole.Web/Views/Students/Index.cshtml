@{
    ViewData["Title"] = "Élèves - Aperçu";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/students.js" asp-append-version="true"></script>
}

<div x-data="studentsView()">
    <!-- Titre de la page -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-jgk-title font-bold text-gray-900">Élèves</h1>
            <p class="text-jgk-subtitle text-gray-500 mt-1">Gérez les inscriptions et les dossiers des élèves.</p>
        </div>
        <button @@click="isCreateOpen = true" class="btn-primary shrink-0">
            <icon name="plus" class="w-4 h-4" />
            Ajouter un élève
        </button>
    </div>

    <!-- Cartes KPI (4 cartes en ligne) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        <stat-card label="Total Élèves" icon="users" accent="primary">
            <span x-text="totalCount">0</span>
        </stat-card>
        <!-- Filles/Garçons/Nouvelles inscriptions : aucune route n'expose encore ces répartitions
             (seul le total paginé est connu côté client) — « -- » reste honnête, un chiffre inventé
             ne le serait pas. À brancher quand un endpoint les fournira. -->
        <stat-card label="Filles" icon="users" accent="pink">
            <span>--</span>
        </stat-card>
        <stat-card label="Garçons" icon="users" accent="blue">
            <span>--</span>
        </stat-card>
        <stat-card label="Inscriptions (Nouveau)" icon="document" accent="success">
            <span>--</span>
        </stat-card>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- Bloc Tableau et Filtres -->
    <div class="card mt-6 relative">

        <!-- Barre de filtres -->
        <div class="p-4 border-b border-gray-200">
            <div class="flex flex-wrap lg:flex-nowrap items-center gap-3">
                <div class="relative flex-1 min-w-[12rem] lg:max-w-xs">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <icon name="search" class="w-4 h-4 text-gray-400" />
                    </span>
                    <input type="text" x-model="search" x-on:input.debounce.400ms="applyFilters()"
                           placeholder="Rechercher un élève..." aria-label="Rechercher un élève"
                           class="input-field mt-0 pl-9 pr-3 w-full" />
                </div>
                <select x-model="classroomFilter" x-on:change="applyFilters()" aria-label="Filtrer par classe"
                        class="input-field mt-0 bg-white w-full sm:w-auto sm:shrink-0">
                    <option value="">Classe : Toutes</option>
                    <template x-for="c in classrooms" :key="c.id">
                        <option :value="c.id" x-text="c.name + ' (' + c.level + ')'"></option>
                    </template>
                </select>
                <select x-model="genderFilter" x-on:change="applyFilters()" aria-label="Filtrer par genre"
                        class="input-field mt-0 bg-white w-full sm:w-auto sm:shrink-0">
                    <option value="">Genre : Tous</option>
                    <option value="F">Fille</option>
                    <option value="M">Garçon</option>
                </select>
            </div>
            <button type="button" x-on:click="resetFilters()"
                    class="mt-2 text-xs font-medium text-gray-400 hover:text-gray-700">
                Réinitialiser les filtres
            </button>
        </div>

        <!-- Conteneur Tableau -->
        <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] table-fixed text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4 w-[16%] text-left whitespace-nowrap">Matricule</th>
                        <th class="py-3 px-4 w-[28%] text-left whitespace-nowrap">Élève</th>
                        <th class="py-3 px-4 w-[20%] text-left whitespace-nowrap">Date de nais.</th>
                        <th class="py-3 px-4 w-[18%] text-left whitespace-nowrap">Genre</th>
                        <th class="py-3 px-4 w-[18%] text-right whitespace-nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <template x-if="isLoading">
                        <template x-for="i in 5" :key="i">
                            <tr><td class="py-2 px-4" colspan="5"><div class="skeleton h-4 w-full"></div></td></tr>
                        </template>
                    </template>

                    <tr x-show="!isLoading && students.length === 0" x-cloak>
                        <td colspan="5">
                            <empty-state icon="users" title="Aucun élève trouvé."
                                         hint="Ajustez la recherche ou les filtres, ou ajoutez un élève." />
                        </td>
                    </tr>

                    <!-- Boucle sur les élèves -->
                    <template x-for="student in students" :key="student.id">
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-2 px-4 w-[16%] font-medium text-gray-900 truncate" x-text="student.matricule"></td>
                            <td class="py-2 px-4 w-[28%]">
                                <div class="flex items-center gap-3 min-w-0">
                                    <img x-show="student.photoUrl" :src="student.photoUrl" alt=""
                                         class="w-8 h-8 rounded-full object-cover shrink-0" x-cloak>
                                    <div x-show="!student.photoUrl" class="w-8 h-8 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-xs shrink-0" x-text="getInitials(student.fullName)"></div>
                                    <div class="min-w-0">
                                        <p class="font-medium text-gray-900 truncate" x-text="student.fullName"></p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-2 px-4 w-[20%]" x-text="formatDate(student.birthDate)"></td>
                            <td class="py-2 px-4 w-[18%]">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium"
                                      :class="student.gender === 'F' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'"
                                      x-text="student.gender === 'F' ? 'Fille' : 'Garçon'">
                                </span>
                            </td>
                            <td class="py-2 px-4 w-[18%] text-right">
                                <button @@click="openDetail(student)" title="Voir la fiche" aria-label="Voir la fiche" class="p-1.5 text-gray-400 hover:text-primary rounded-md focus:outline-none focus:ring-2 focus:ring-primary transition-colors">
                                    <icon name="eye" class="w-5 h-5" />
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>

        <pagination page="page" page-size="pageSize" total="totalCount" on-change="loadStudents()" />
    </div>

    <!-- Fiche élève complète (ticket JGK-D02) : l'identité vient de la ligne de liste (affichage
         immédiat) ; l'historique scolaire, les notes et les paiements sont chargés depuis
         GET /students/{id} (studentDetail) et présentés en onglets ci-dessous. -->
    <modal-shell open="detailStudent" on-close="closeDetail()" title="Fiche élève">
        <div class="flex items-center gap-4 pb-5 border-b border-gray-100">
            <img x-show="detailStudent && detailStudent.photoUrl" :src="detailStudent ? detailStudent.photoUrl : ''" alt=""
                 class="w-14 h-14 rounded-full object-cover flex-shrink-0" x-cloak>
            <div x-show="!detailStudent || !detailStudent.photoUrl" class="w-14 h-14 rounded-full bg-indigo-100 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" x-text="detailStudent ? getInitials(detailStudent.fullName) : ''"></div>
            <p class="text-xl font-bold text-gray-900" x-text="detailStudent ? detailStudent.fullName : ''"></p>
        </div>

        <!-- Identité : deux colonnes alignées en lignes, valeurs en gras — plus dense et plus lisible
             qu'un champ par bloc vertical. -->
        <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-5">
            <div>
                <dt class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Matricule</dt>
                <dd class="mt-1 text-base font-bold text-gray-900" x-text="detailStudent ? detailStudent.matricule : ''"></dd>
            </div>
            <div>
                <dt class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Date de naissance</dt>
                <dd class="mt-1 text-base font-bold text-gray-900" x-text="detailStudent ? formatDate(detailStudent.birthDate) : ''"></dd>
            </div>
            <div>
                <dt class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Lieu de naissance</dt>
                <dd class="mt-1 text-base font-bold text-gray-900" x-text="detailStudent && detailStudent.birthPlace ? detailStudent.birthPlace : '—'"></dd>
            </div>
            <div>
                <dt class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Genre</dt>
                <dd class="mt-1.5">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold"
                          :class="detailStudent && detailStudent.gender === 'F' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'"
                          x-text="detailStudent ? (detailStudent.gender === 'F' ? 'Fille' : 'Garçon') : ''"></span>
                </dd>
            </div>
            <div>
                <dt class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Classe</dt>
                <dd class="mt-1 text-base font-bold text-gray-900" x-text="detailStudent ? detailStudent.classroomName : ''"></dd>
            </div>
        </dl>

        <!-- Tuteur : bloc distinct pour séparer l'identité de l'élève du contact du tuteur. -->
        <div class="mt-6 bg-gray-50 rounded-lg p-4 sm:p-5">
            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-3">Tuteur</p>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4">
                <div>
                    <dt class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Nom</dt>
                    <dd class="mt-1 text-base font-bold text-gray-900" x-text="detailStudent && detailStudent.guardianName ? detailStudent.guardianName : '—'"></dd>
                </div>
                <div>
                    <dt class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Téléphone</dt>
                    <dd class="mt-1 text-base font-bold text-gray-900" x-text="detailStudent && detailStudent.guardianPhone ? detailStudent.guardianPhone : '—'"></dd>
                </div>
            </dl>
        </div>

        <!-- Onglets : Historique scolaire / Notes & bulletins / Paiements (JGK-D02). -->
        <div class="mt-6 border-t border-gray-100 pt-5">

            <!-- Barre d'onglets. role=tablist + aria-selected : navigation accessible (Volume 5 §8). -->
            <div class="flex gap-1 border-b border-gray-200" role="tablist" aria-label="Sections de la fiche élève">
                <button type="button" role="tab" @@click="detailTab = 'history'"
                        :aria-selected="detailTab === 'history'"
                        :class="detailTab === 'history' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700'"
                        class="inline-flex items-center gap-1.5 border-b-2 px-3 py-2.5 text-sm font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1 rounded-t-md">
                    <icon name="layers" class="w-4 h-4" />
                    <span>Historique scolaire</span>
                </button>
                <button type="button" role="tab" @@click="detailTab = 'grades'"
                        :aria-selected="detailTab === 'grades'"
                        :class="detailTab === 'grades' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700'"
                        class="inline-flex items-center gap-1.5 border-b-2 px-3 py-2.5 text-sm font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1 rounded-t-md">
                    <icon name="book" class="w-4 h-4" />
                    <span>Notes &amp; bulletins</span>
                </button>
                <button type="button" role="tab" @@click="detailTab = 'payments'"
                        :aria-selected="detailTab === 'payments'"
                        :class="detailTab === 'payments' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700'"
                        class="inline-flex items-center gap-1.5 border-b-2 px-3 py-2.5 text-sm font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1 rounded-t-md">
                    <icon name="wallet" class="w-4 h-4" />
                    <span>Paiements</span>
                </button>
            </div>

            <!-- Chargement : squelette pendant l'appel à GET /students/{id} (Volume 5 §1, connexion mobile). -->
            <div x-show="isLoadingDetails" x-cloak class="space-y-3 py-6">
                <div class="skeleton h-16 w-full"></div>
                <div class="skeleton h-16 w-full"></div>
                <div class="skeleton h-16 w-3/4"></div>
            </div>

            <!-- Erreur de chargement de la fiche complète (l'identité reste affichée au-dessus). -->
            <div x-show="detailError" x-cloak
                 class="my-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger"
                 x-text="detailError"></div>

            <!-- Contenu des onglets : uniquement une fois la fiche chargée sans erreur. -->
            <div x-show="!isLoadingDetails && !detailError && studentDetail" x-cloak>

                <!-- ONGLET 1 — Historique scolaire : une carte par inscription (année, classe, type, statut). -->
                <div x-show="detailTab === 'history'" role="tabpanel" class="py-5">
                    <template x-if="studentDetail && studentDetail.academicHistory.length === 0">
                        <empty-state icon="layers" title="Aucune inscription enregistrée."
                                     hint="Cet élève n'a pas encore d'inscription pour une année scolaire." />
                    </template>

                    <div class="space-y-3">
                        <template x-for="entry in (studentDetail ? studentDetail.academicHistory : [])" :key="entry.enrollmentId">
                            <div class="rounded-lg border border-gray-200 p-4">
                                <div class="flex flex-wrap items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2">
                                            <p class="font-bold text-gray-900" x-text="entry.schoolYearLabel"></p>
                                            <span x-show="entry.isActiveYear" class="status-badge-primary">Année active</span>
                                        </div>
                                        <p class="mt-1 text-sm text-gray-600">
                                            <span x-text="entry.classroomName"></span>
                                            <span class="text-gray-300 mx-1.5">•</span>
                                            <span x-text="enrollmentTypeLabel(entry.enrollmentType)"></span>
                                        </p>
                                    </div>
                                    <div class="flex flex-col items-end gap-1.5">
                                        <span :class="enrollmentStatusBadge(entry.status)" x-text="enrollmentStatusLabel(entry.status)"></span>
                                        <template x-if="entry.generalAverage !== null && entry.generalAverage !== undefined">
                                            <p class="text-sm text-gray-700">
                                                Moyenne annuelle :
                                                <span class="font-bold text-gray-900" x-text="formatAverage(entry.generalAverage)"></span>
                                            </p>
                                        </template>
                                    </div>
                                </div>

                                <!-- Cycle de vie de l'inscription : erreur de saisie (annulation) ou
                                     arrêt de scolarité en cours d'année (abandon/transfert). Proposé
                                     uniquement tant que l'inscription est encore active. -->
                                <template x-if="canManageStudent && canTransitionEnrollment(entry.status)">
                                    <div class="mt-3 pt-3 border-t border-gray-100 flex flex-wrap gap-2">
                                        <button type="button" x-on:click="openChangeEnrollmentStatus(entry)"
                                                class="text-xs font-medium text-warning bg-warning-bg hover:bg-amber-100 px-3 py-1 rounded-md transition-colors">
                                            Déclarer un abandon/transfert
                                        </button>
                                        <button type="button" x-on:click="openCancelEnrollment(entry)"
                                                class="text-xs font-medium text-danger bg-danger-bg hover:bg-red-100 px-3 py-1 rounded-md transition-colors"
                                                title="Réservé aux inscriptions sans paiement encaissé">
                                            Annuler l'inscription
                                        </button>
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- ONGLET 2 — Notes & bulletins : un bloc par trimestre, tableau matière par matière. -->
                <div x-show="detailTab === 'grades'" role="tabpanel" class="py-5">
                    <template x-if="studentDetail && studentDetail.grades.length === 0">
                        <empty-state icon="book" title="Aucune note enregistrée."
                                     hint="Les notes saisies pour cet élève apparaîtront ici, regroupées par trimestre." />
                    </template>

                    <!-- Erreur de génération/téléchargement du bulletin (JGK-G03), partagée par tous les trimestres. -->
                    <div x-show="reportCardError" x-cloak
                         class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger"
                         x-text="reportCardError"></div>

                    <div class="space-y-6">
                        <template x-for="term in (studentDetail ? studentDetail.grades : [])" :key="term.termId">
                            <div>
                                <!-- En-tête du trimestre : année + trimestre à gauche, synthèse + bulletin à droite. -->
                                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                                    <p class="font-bold text-gray-900">
                                        <span x-text="term.schoolYearLabel"></span>
                                        <span class="text-gray-300 mx-1.5">•</span>
                                        <span x-text="term.termLabel"></span>
                                    </p>
                                    <div class="flex items-center gap-2">
                                        <template x-if="term.mention">
                                            <span class="status-badge-primary" x-text="term.mention"></span>
                                        </template>
                                        <p class="text-sm text-gray-700">
                                            Moyenne :
                                            <span class="font-bold text-gray-900" x-text="formatAverage(term.generalAverage)"></span>
                                        </p>
                                        <!-- Réservées au Directeur/Enseignant côté serveur (ReportCardsController). -->
                                        <button type="button" x-show="canViewReportCard" x-cloak
                                                x-on:click="openReportCardRemark(term)"
                                                class="btn-secondary text-xs whitespace-nowrap">
                                            <icon name="pencil" class="w-4 h-4" />
                                            <span>Observations</span>
                                        </button>
                                        <button type="button" x-show="canViewReportCard" x-cloak
                                                x-on:click="downloadReportCard(term)"
                                                :disabled="downloadingTermId === term.termId"
                                                class="btn-secondary text-xs whitespace-nowrap">
                                            <icon name="download" class="w-4 h-4" />
                                            <span x-text="downloadingTermId === term.termId ? 'Génération…' : 'Bulletin'"></span>
                                        </button>
                                    </div>
                                </div>

                                <div class="overflow-x-auto rounded-lg border border-gray-200">
                                    <table class="w-full min-w-[480px] text-left border-collapse text-sm">
                                        <thead>
                                            <tr class="table-head">
                                                <th class="py-2.5 px-3">Matière</th>
                                                <th class="py-2.5 px-3 text-center w-16">Coef.</th>
                                                <th class="py-2.5 px-3 text-center w-20">Devoir</th>
                                                <th class="py-2.5 px-3 text-center w-24">Compo.</th>
                                                <th class="py-2.5 px-3 text-center w-20">Moy.</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-gray-100">
                                            <template x-for="subject in term.subjects" :key="subject.subjectId">
                                                <tr>
                                                    <td class="py-2 px-3 font-medium text-gray-900" x-text="subject.subjectName"></td>
                                                    <td class="py-2 px-3 text-center text-gray-600" x-text="formatGrade(subject.coefficient)"></td>
                                                    <td class="py-2 px-3 text-center text-gray-700" x-text="formatGrade(subject.devoir)"></td>
                                                    <td class="py-2 px-3 text-center text-gray-700" x-text="formatGrade(subject.composition)"></td>
                                                    <td class="py-2 px-3 text-center font-bold text-gray-900" x-text="formatGrade(subject.average)"></td>
                                                </tr>
                                            </template>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- ONGLET 3 — Paiements : synthèse (dû / versé / solde) puis liste des reçus. -->
                <div x-show="detailTab === 'payments'" role="tabpanel" class="py-5">
                    <!-- Synthèse financière : reflète les inscriptions, pertinente même sans versement. -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="rounded-lg border border-gray-200 p-4">
                            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Total dû</p>
                            <p class="mt-1 text-lg font-bold text-gray-900" x-text="studentDetail ? formatAmount(studentDetail.payments.totalDue) : '—'"></p>
                        </div>
                        <div class="rounded-lg border border-success/30 bg-success-bg p-4">
                            <p class="text-[11px] font-bold text-success uppercase tracking-wider">Total versé</p>
                            <p class="mt-1 text-lg font-bold text-success" x-text="studentDetail ? formatAmount(studentDetail.payments.totalPaid) : '—'"></p>
                        </div>
                        <!-- Solde : vert s'il est nul (soldé), orange s'il reste dû. -->
                        <div class="rounded-lg border p-4"
                             :class="studentDetail && studentDetail.payments.remainingBalance > 0 ? 'border-warning/30 bg-warning-bg' : 'border-success/30 bg-success-bg'">
                            <p class="text-[11px] font-bold uppercase tracking-wider"
                               :class="studentDetail && studentDetail.payments.remainingBalance > 0 ? 'text-warning' : 'text-success'">Solde restant</p>
                            <p class="mt-1 text-lg font-bold"
                               :class="studentDetail && studentDetail.payments.remainingBalance > 0 ? 'text-warning' : 'text-success'"
                               x-text="studentDetail ? formatAmount(studentDetail.payments.remainingBalance) : '—'"></p>
                        </div>
                    </div>

                    <!-- Liste des versements. -->
                    <div class="mt-5">
                        <template x-if="studentDetail && studentDetail.payments.entries.length === 0">
                            <empty-state icon="wallet" title="Aucun paiement enregistré."
                                         hint="Les versements encaissés pour cet élève apparaîtront ici." />
                        </template>

                        <div x-show="studentDetail && studentDetail.payments.entries.length > 0" class="overflow-x-auto rounded-lg border border-gray-200">
                            <table class="w-full min-w-[560px] text-left border-collapse text-sm">
                                <thead>
                                    <tr class="table-head">
                                        <th class="py-2.5 px-3">Date</th>
                                        <th class="py-2.5 px-3">N° reçu</th>
                                        <th class="py-2.5 px-3 text-right">Montant</th>
                                        <th class="py-2.5 px-3">Méthode</th>
                                        <th class="py-2.5 px-3 text-center">Statut</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <template x-for="payment in (studentDetail ? studentDetail.payments.entries : [])" :key="payment.paymentId">
                                        <tr>
                                            <td class="py-2 px-3 text-gray-700 whitespace-nowrap" x-text="formatDate(payment.paidAt)"></td>
                                            <td class="py-2 px-3 font-mono text-xs text-gray-600 whitespace-nowrap" x-text="payment.receiptNumber || '—'"></td>
                                            <td class="py-2 px-3 text-right font-bold text-gray-900 whitespace-nowrap" x-text="formatAmount(payment.amount)"></td>
                                            <td class="py-2 px-3 text-gray-700 whitespace-nowrap" x-text="paymentMethodLabel(payment.method)"></td>
                                            <td class="py-2 px-3 text-center">
                                                <span :class="paymentStatusBadge(payment.status)" x-text="paymentStatusLabel(payment.status)"></span>
                                            </td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="mt-8 flex flex-col-reverse sm:flex-row sm:justify-between gap-3 border-t border-gray-200 pt-4">
            <template x-if="canManageStudent && studentDetail">
                <div class="flex gap-2">
                    <button type="button" @@click="openEditStudent()" class="btn-secondary">
                        Modifier la fiche
                    </button>
                    <button type="button" @@click="openDeleteStudent()" class="text-sm font-medium text-danger bg-danger-bg hover:bg-red-100 px-4 py-2 rounded-md transition-colors">
                        Supprimer
                    </button>
                </div>
            </template>
            <button type="button" @@click="closeDetail()" class="btn-secondary sm:ml-auto">
                Fermer
            </button>
        </div>
    </modal-shell>

    <!-- Distinction du conseil (Blâme… Félicitations) et observations, imprimées sur le bulletin
         (ReportCardDocument). Réservée au Directeur/Enseignant côté serveur, comme le bouton Bulletin. -->
    <modal-shell open="editingReportCardRemark" on-close="closeReportCardRemark()" title="Observations du conseil">
        <modal-subtitle>Distinction et observations du conseil des professeurs pour ce trimestre — imprimées sur le bulletin.</modal-subtitle>

        <div x-show="reportCardRemarkErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="reportCardRemarkErrors.global"></div>

        <form x-on:submit.prevent="submitReportCardRemark()" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Distinction</label>
                <select x-model="editingReportCardRemark.disciplinaryMention" class="input-field bg-white">
                    <option value="">Aucune</option>
                    <option value="Blame">Blâme</option>
                    <option value="Avertissement">Avertissement</option>
                    <option value="TableauHonneur">Tableau d'honneur</option>
                    <option value="Encouragements">Encouragements</option>
                    <option value="Felicitations">Félicitations</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Observations du conseil des professeurs</label>
                <textarea x-model="editingReportCardRemark.observations" maxlength="300" rows="4"
                          placeholder="ex : Bon trimestre, poursuivez vos efforts."
                          class="input-field"></textarea>
                <p x-show="reportCardRemarkErrors.observations" x-cloak x-text="reportCardRemarkErrors.observations" class="mt-1 text-xs text-danger"></p>
            </div>

            <div class="flex justify-end gap-3 pt-2 border-t border-gray-100">
                <button type="button" x-on:click="closeReportCardRemark()" class="btn-secondary mt-4">Annuler</button>
                <button type="submit" :disabled="isSavingReportCardRemark" class="btn-primary mt-4">
                    <span x-text="isSavingReportCardRemark ? 'Enregistrement…' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Modification de la fiche élève : le matricule n'est jamais modifiable (AGENTS.md règle #3). -->
    <modal-shell open="editingStudent" on-close="closeEditStudent()" title="Modifier la fiche">
        <modal-subtitle>Le matricule reste celui déjà attribué : il n'est jamais modifiable.</modal-subtitle>

        <div x-show="studentEditErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="studentEditErrors.global"></div>

        <form x-on:submit.prevent="submitEditStudent()" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Nom complet <span class="text-danger">*</span></label>
                <input type="text" x-model="editingStudent.fullName" required class="input-field">
                <p x-show="studentEditErrors.fullname" x-text="studentEditErrors.fullname" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Date de naissance <span class="text-danger">*</span></label>
                <date-field model="editingStudent.birthDate" required="true" aria-label="Date de naissance" />
                <p x-show="studentEditErrors.birthdate" x-text="studentEditErrors.birthdate" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Lieu de naissance</label>
                <input type="text" x-model="editingStudent.birthPlace" class="input-field">
                <p x-show="studentEditErrors.birthplace" x-text="studentEditErrors.birthplace" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Genre <span class="text-danger">*</span></label>
                <select x-model="editingStudent.gender" class="input-field bg-white">
                    <option value="M">Garçon</option>
                    <option value="F">Fille</option>
                </select>
                <p x-show="studentEditErrors.gender" x-text="studentEditErrors.gender" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Classe <span class="text-danger">*</span></label>
                <select x-model="editingStudent.classroomId" required class="input-field bg-white">
                    <template x-for="c in classrooms" :key="c.id">
                        <option :value="c.id" x-text="c.name + ' (' + c.level + ')'"></option>
                    </template>
                </select>
                <p x-show="studentEditErrors.classroomid" x-text="studentEditErrors.classroomid" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Photo (URL)</label>
                <div class="mt-1 flex items-center gap-3">
                    <img x-show="editingStudent.photoUrl" :src="editingStudent.photoUrl" alt=""
                         class="w-10 h-10 rounded-full object-cover shrink-0 border border-gray-200" x-cloak>
                    <input type="text" x-model="editingStudent.photoUrl" placeholder="https://…" class="input-field flex-1">
                </div>
                <p x-show="studentEditErrors.photourl" x-text="studentEditErrors.photourl" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Nom du tuteur</label>
                <input type="text" x-model="editingStudent.guardianName" class="input-field">
                <p x-show="studentEditErrors.guardianname" x-text="studentEditErrors.guardianname" class="mt-1 text-xs text-danger"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Téléphone du tuteur</label>
                <input type="text" x-model="editingStudent.guardianPhone" class="input-field">
                <p x-show="studentEditErrors.guardianphone" x-text="studentEditErrors.guardianphone" class="mt-1 text-xs text-danger"></p>
            </div>

            <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
                <button type="button" @@click="closeEditStudent()" class="btn-secondary">Annuler</button>
                <button type="submit" :disabled="isSavingStudentEdit" class="btn-primary">
                    <span x-text="isSavingStudentEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Confirmation : fiche modifiée -->
    <modal-shell open="showStudentEditedDialog" size="md" on-close="showStudentEditedDialog = false" title="Fiche modifiée">
        <confirm-dialog-body close-action="showStudentEditedDialog = false">
            La fiche a bien été mise à jour.
        </confirm-dialog-body>
    </modal-shell>

    <!-- Confirmation : suppression de la fiche élève -->
    <modal-shell open="deletingStudentRecord" on-close="closeDeleteStudent()" size="md">
        <modal-title>Supprimer la fiche</modal-title>
        <modal-subtitle>
            <span class="font-semibold text-gray-900" x-text="deletingStudentRecord ? deletingStudentRecord.fullName : ''"></span>
            sera archivée et n'apparaîtra plus dans la liste des élèves.
        </modal-subtitle>

        <div x-show="deleteStudentRecordError" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="deleteStudentRecordError"></div>

        <p class="text-sm text-gray-500">
            Réservé à une fiche créée par pure erreur de saisie : impossible si une inscription ou une note existe déjà pour cet élève.
        </p>

        <div class="mt-6 flex justify-end gap-3">
            <button type="button" @@click="closeDeleteStudent()" class="btn-secondary">Annuler</button>
            <button type="button" @@click="confirmDeleteStudent()" :disabled="isDeletingStudentRecord" class="btn-danger">
                <span x-text="isDeletingStudentRecord ? 'Suppression...' : 'Supprimer la fiche'"></span>
            </button>
        </div>
    </modal-shell>

    <!-- Confirmation : suppression d'une fiche élève -->
    <modal-shell open="showStudentDeletedDialog" size="md" on-close="showStudentDeletedDialog = false" title="Fiche supprimée">
        <confirm-dialog-body close-action="showStudentDeletedDialog = false">
            La fiche a bien été supprimée.
        </confirm-dialog-body>
    </modal-shell>

    <!-- Annulation d'une inscription (erreur de saisie, sans paiement encaissé) -->
    <modal-shell open="cancelingEnrollment" on-close="closeCancelEnrollment()" size="md">
        <modal-title>Annuler l'inscription</modal-title>
        <modal-subtitle>
            Année <span class="font-semibold text-gray-900" x-text="cancelingEnrollment ? cancelingEnrollment.schoolYearLabel : ''"></span>
        </modal-subtitle>

        <div x-show="cancelEnrollmentError" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="cancelEnrollmentError"></div>

        <p class="text-sm text-gray-500">
            À réserver à une erreur de saisie : refusée si un reçu de paiement existe déjà pour cette inscription — utilisez plutôt « Déclarer un abandon/transfert » dans ce cas.
        </p>

        <div class="mt-6 flex justify-end gap-3">
            <button type="button" @@click="closeCancelEnrollment()" class="btn-secondary">Retour</button>
            <button type="button" @@click="confirmCancelEnrollment()" :disabled="isCancelingEnrollment" class="btn-danger">
                <span x-text="isCancelingEnrollment ? 'Annulation...' : 'Annuler l\'inscription'"></span>
            </button>
        </div>
    </modal-shell>

    <!-- Déclarer un abandon ou un transfert en cours d'année -->
    <modal-shell open="changingEnrollmentStatus" on-close="closeChangeEnrollmentStatus()" size="md">
        <modal-title>Abandon ou transfert</modal-title>
        <modal-subtitle>
            Année <span class="font-semibold text-gray-900" x-text="changingEnrollmentStatus ? changingEnrollmentStatus.schoolYearLabel : ''"></span>
        </modal-subtitle>

        <div x-show="changeEnrollmentStatusError" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="changeEnrollmentStatusError"></div>

        <form x-on:submit.prevent="submitChangeEnrollmentStatus()" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Nouveau statut <span class="text-danger">*</span></label>
                <select x-model="changingEnrollmentStatus.newStatus" required class="input-field bg-white">
                    <option value="DroppedOut">Abandon</option>
                    <option value="Transferred">Transfert vers un autre établissement</option>
                </select>
                <p class="mt-1 text-xs text-gray-400">
                    L'élève sort des futures listes de présence ; ses notes et paiements déjà enregistrés restent intacts.
                </p>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <button type="button" @@click="closeChangeEnrollmentStatus()" class="btn-secondary">Annuler</button>
                <button type="submit" :disabled="isChangingEnrollmentStatus" class="btn-primary">
                    <span x-text="isChangingEnrollmentStatus ? 'Enregistrement...' : 'Confirmer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Création d'élève (JGK-D01) -->
    <modal-shell open="isCreateOpen" title="Ajouter un élève">
        <modal-subtitle>Le matricule sera généré automatiquement à l'enregistrement.</modal-subtitle>

        <!-- Erreur globale -->
        <div x-show="createErrors.global" x-cloak class="mb-4 rounded-md border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="createErrors.global"></div>

        <form x-on:submit.prevent="submitCreate()" class="space-y-4">
            <!-- Nom complet -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Nom complet <span class="text-danger">*</span></label>
                <input type="text" x-model="newStudent.fullName" required class="input-field">
                <p x-show="createErrors.fullname" x-text="createErrors.fullname" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Date de naissance -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Date de naissance <span class="text-danger">*</span></label>
                <date-field model="newStudent.birthDate" required="true" aria-label="Date de naissance" />
                <p x-show="createErrors.birthdate" x-text="createErrors.birthdate" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Lieu de naissance -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Lieu de naissance</label>
                <input type="text" x-model="newStudent.birthPlace" class="input-field">
                <p x-show="createErrors.birthplace" x-text="createErrors.birthplace" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Genre -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Genre <span class="text-danger">*</span></label>
                <select x-model="newStudent.gender" class="input-field bg-white">
                    <option value="M">Garçon</option>
                    <option value="F">Fille</option>
                </select>
                <p x-show="createErrors.gender" x-text="createErrors.gender" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Classe (Dynamique) -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Classe <span class="text-danger">*</span></label>
                <select x-model="newStudent.classroomId" required class="input-field bg-white">
                    <option value="" disabled>Sélectionner une classe</option>
                    <template x-for="c in classrooms" :key="c.id">
                        <option :value="c.id" x-text="c.name + ' (' + c.level + ')'"></option>
                    </template>
                </select>
                <p x-show="createErrors.classroomid" x-text="createErrors.classroomid" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Photo (URL) -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Photo (URL)</label>
                <div class="mt-1 flex items-center gap-3">
                    <img x-show="newStudent.photoUrl" :src="newStudent.photoUrl" alt=""
                         class="w-10 h-10 rounded-full object-cover shrink-0 border border-gray-200" x-cloak>
                    <input type="text" x-model="newStudent.photoUrl" placeholder="https://…"
                           class="input-field flex-1">
                </div>
                <p x-show="createErrors.photourl" x-text="createErrors.photourl" class="mt-1 text-xs text-danger"></p>
            </div>

            <!-- Tuteur -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Nom du tuteur</label>
                <input type="text" x-model="newStudent.guardianName" class="input-field">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Téléphone du tuteur</label>
                <input type="text" x-model="newStudent.guardianPhone" class="input-field">
            </div>

            <!-- Boutons d'action -->
            <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
                <button type="button" @@click="isCreateOpen = false" class="btn-secondary">
                    Annuler
                </button>
                <button type="submit" :disabled="isSubmitting" class="btn-primary">
                    <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
                </button>
            </div>
        </form>
    </modal-shell>

    <!-- Confirmation : élève ajouté -->
    <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Élève ajouté">
        <confirm-dialog-body close-action="showAddedDialog = false"
                             new-action="showAddedDialog = false; isCreateOpen = true" new-label="Nouvel élève">
            <span class="font-medium text-gray-900" x-text="addedStudentName"></span> a bien été ajouté(e) et figure désormais dans la liste.
        </confirm-dialog-body>
    </modal-shell>
</div>
