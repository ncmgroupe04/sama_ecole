@{
 ViewData["Title"] = "Élèves - Aperçu";
 var genderFilterOptions = new List<SelectFieldOption> { new("", "Genre : Tous"), new("F", "Fille"), new("M", "Garçon") };
 // Portée par année scolaire (voir studentsView.yearScope) : par défaut « Inscrits cette année »,
 // avec un retour possible sur l'annuaire complet pour gérer un élève pas encore (ré)inscrit.
 var yearScopeOptions = new List<SelectFieldOption> { new("active", "Inscrits cette année"), new("", "Tous les élèves") };
 var studentGenderOptions = new List<SelectFieldOption> { new("M", "Garçon"), new("F", "Fille") };
 var disciplinaryMentionOptions = new List<SelectFieldOption> {
 new("", "Aucune"), new("Blame", "Blâme"), new("Avertissement", "Avertissement"),
 new("TableauHonneur", "Tableau d'honneur"), new("Encouragements", "Encouragements"), new("Felicitations", "Félicitations")
 };
 var councilDecisionOptions = new List<SelectFieldOption> {
 new("", "Aucune / Non renseignée"), new("Admitted", "Admis(e) en classe supérieure"),
 new("AllowedToRepeat", "Autorisé(e) à redoubler"), new("Excluded", "Exclusion")
 };
 var enrollmentStatusOptions = new List<SelectFieldOption> {
 new("DroppedOut", "Abandon"), new("Transferred", "Transfert vers un autre établissement")
 };
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/photo-compress.js" asp-append-version="true"></script>
 <script src="~/js/students.js" asp-append-version="true"></script>
}

<div x-data="studentsView()">
 <!-- Titre de la page -->
 <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
 <div>
 <h1 class="text-jgk-title font-bold text-slate-900">Élèves</h1>
 <p class="text-jgk-subtitle text-slate-500 mt-1">Gérez les inscriptions et les dossiers des élèves.</p>
 </div>
 <div class="flex items-center gap-2 shrink-0">
 <!-- Export PDF (docs/Volume_7_Security.md §15) : Directeur, Secrétariat, Finance — jamais l'Enseignant. -->
 <button x-show="canExportStudents" x-cloak @@click="exportStudentsPdf()" class="btn-secondary">
 <icon name="document-text" class="w-4 h-4" />
 Exporter en PDF
 </button>
 <button x-show="canManageStudent" x-cloak @@click="openImport()" class="btn-secondary">
 <icon name="upload" class="w-4 h-4" />
 Importer des élèves
 </button>
 <button x-show="canManageStudent" x-cloak @@click="isCreateOpen = true" class="btn-primary">
 <icon name="plus" class="w-4 h-4" />
 Ajouter un élève
 </button>
 </div>
 </div>

 <!-- Cartes KPI (4 cartes en ligne) -->
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
 <stat-card label="Total Élèves" icon="users" accent="primary">
 <span x-text="totalCount">0</span>
 </stat-card>
 <!-- Filles/Garçons/Nouvelles inscriptions : aucune route n'expose encore ces répartitions
 (seul le total paginé est connu côté client) — « -- » reste honnête, un chiffre inventé
 ne le serait pas. À brancher quand un endpoint les fournira. -->
 <stat-card label="Filles" icon="users" accent="pink">
 <span x-text="girlsCount">0</span>
 </stat-card>
 <stat-card label="Garçons" icon="users" accent="blue">
 <span x-text="boysCount">0</span>
 </stat-card>
 <stat-card label="Inscriptions (Nouveau)" icon="document" accent="success">
 <span x-text="newEnrollmentsCount">0</span>
 </stat-card>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- Bloc Tableau et Filtres -->
 <div class="card mt-6 relative">

 <!-- Barre de filtres -->
 <div class="p-6 border-b border-slate-200">
 <div class="flex flex-wrap lg:flex-nowrap items-center gap-3">
 <div class="relative flex-1 min-w-[12rem] lg:max-w-xs">
 <span class="absolute inset-y-0 left-0 flex items-center pl-3">
 <icon name="search" class="w-4 h-4 text-slate-400" />
 </span>
 <input type="text" x-model="search" x-on:input.debounce.400ms="applyFilters()"
 placeholder="Rechercher un élève..." aria-label="Rechercher un élève"
 class="input-field mt-0 pl-9 pr-3 w-full" />
 </div>
 <select-field model="classroomFilter" on-change="applyFilters()" aria-label="Filtrer par classe"
 class="mt-0 w-full sm:w-auto" placeholder="Classe : Toutes"
 options-expr="[{value:'', label:'Classe : Toutes'}].concat(classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'})))" />
 <select-field model="genderFilter" on-change="applyFilters()" aria-label="Filtrer par genre"
 class="mt-0 w-full sm:w-auto" placeholder="Genre : Tous" options="genderFilterOptions" />
 @* Portée par année scolaire : « Inscrits cette année » (défaut) borne la liste à l'effectif
 rattaché à l'année active ; « Tous les élèves » rebascule sur l'annuaire complet pour retrouver
 un élève importé/créé pas encore (ré)inscrit. Voir studentsView.yearScope / GetStudentsQuery. *@
 <select-field model="yearScope" on-change="applyFilters()" aria-label="Portée par année scolaire"
 class="mt-0 w-full sm:w-auto" options="yearScopeOptions" />
 </div>
 <button type="button" x-on:click="resetFilters()"
 class="mt-2 text-xs font-medium text-slate-400 hover:text-slate-700">
 Réinitialiser les filtres
 </button>
 </div>

 <!-- Conteneur Tableau -->
 <div class="overflow-x-auto">
 <table class="w-full min-w-[760px] table-fixed text-left border-collapse">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-3 px-4 w-[16%] text-left whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Matricule</th>
 <th class="py-3 px-4 w-[28%] text-left whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Élève</th>
 <th class="py-3 px-4 w-[20%] text-left whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Date de nais.</th>
 <th class="py-3 px-4 w-[18%] text-left whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Genre</th>
 <th class="py-3 px-4 w-[18%] text-right whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-if="isLoading">
 <template x-for="i in 5" :key="i">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out"><td class="py-2 px-4" colspan="5"><div class="skeleton h-4 w-full"></div></td></tr>
 </template>
 </template>

 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out" x-show="!isLoading && students.length === 0" x-cloak>
 <td colspan="5">
 <empty-state icon="users" title="Aucun élève trouvé."
 hint="Aucun élève inscrit pour l'année active ? Basculez sur « Tous les élèves », ajustez la recherche, ou ajoutez un élève." />
 </td>
 </tr>

 <!-- Boucle sur les élèves -->
 <template x-for="student in students" :key="student.id">
 <tr class="hover:bg-slate-50 transition-colors transition-all duration-200 ease-in-out">
 <td class="py-2 px-4 w-[16%] font-medium text-slate-900 truncate" x-text="student.matricule"></td>
 <td class="py-2 px-4 w-[28%]">
 <div class="flex items-center gap-3 min-w-0">
 <img x-show="student.photoDisplayUrl" :src="student.photoDisplayUrl" alt=""
 class="w-8 h-8 rounded-full object-cover shrink-0" x-cloak>
 <div x-show="!student.photoDisplayUrl" :class="initialsClasses(student.fullName)" class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs shrink-0" x-text="getInitials(student.fullName)"></div>
 <div class="min-w-0">
 <p class="font-medium text-slate-900 truncate" x-text="student.fullName"></p>
 </div>
 </div>
 </td>
 <td class="py-2 px-4 w-[20%]" x-text="formatDate(student.birthDate)"></td>
 <td class="py-2 px-4 w-[18%]">
 <span class="inline-flex items-center px-2 py-0.5 rounded-xl text-xs font-medium"
 :class="student.gender === 'F' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'"
 x-text="student.gender === 'F' ? 'Fille' : 'Garçon'">
 </span>
 </td>
 <td class="py-2 px-4 w-[18%] text-right">
 <button @@click="openDetail(student)" title="Voir la fiche" aria-label="Voir la fiche" class="p-1.5 text-slate-400 hover:text-primary rounded-xl focus:outline-none focus:ring-2 focus:ring-primary transition-colors">
 <icon name="eye" class="w-5 h-5" />
 </button>
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>

 <pagination page="page" page-size="pageSize" total="totalCount" on-change="loadStudents()" />
 </div>

 <!-- Fiche élève complète (ticket JGK-D02) : l'identité vient de la ligne de liste (affichage
 immédiat) ; l'historique scolaire, les notes et les paiements sont chargés depuis
 GET /students/{id} (studentDetail) et présentés en onglets ci-dessous. -->
 <modal-shell open="detailStudent" on-close="closeDetail()" hide-header="true" no-padding="true">
    <div class="bg-white border-b border-slate-100 p-6 flex justify-between items-start">
        <div class="flex items-center gap-4">
            <img x-show="detailStudent && detailStudent.photoDisplayUrl" :src="detailStudent ? detailStudent.photoDisplayUrl : ''" alt=""
                 class="w-16 h-16 rounded-full ring-4 ring-indigo-50 shadow-md object-cover flex-shrink-0" x-cloak />
            <div x-show="!detailStudent || !detailStudent.photoDisplayUrl" :class="detailStudent ? initialsClasses(detailStudent.fullName) : ''" 
                 class="w-16 h-16 rounded-full ring-4 ring-indigo-50 shadow-md flex items-center justify-center font-bold text-xl flex-shrink-0" 
                 x-text="detailStudent ? getInitials(detailStudent.fullName) : ''"></div>
            <div>
                <h2 class="text-2xl font-bold text-slate-900" x-text="detailStudent ? detailStudent.fullName : ''"></h2>
                <div class="mt-1.5 flex items-center gap-2">
                    <span class="bg-indigo-50 text-indigo-700 font-medium px-2.5 py-0.5 text-xs rounded-full" x-text="detailStudent ? detailStudent.classroomName : ''"></span>
                    <span class="bg-emerald-50 text-emerald-700 font-medium px-2.5 py-0.5 text-xs rounded-full">Actif</span>
                </div>
            </div>
        </div>
        <button type="button" @@click="closeDetail()" class="text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg p-2 transition-all focus:outline-none shrink-0">
            <span class="sr-only">Fermer</span>
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
        </button>
    </div>

    <div class="grid grid-cols-2 gap-4 my-6 px-6">
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Matricule</p>
            <span class="font-mono bg-slate-100 text-slate-800 px-2 py-1 rounded text-sm font-semibold" x-text="detailStudent ? detailStudent.matricule : ''"></span>
        </div>
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                Date de naissance
            </p>
            <p class="text-sm font-medium text-slate-900" x-text="detailStudent ? formatDate(detailStudent.birthDate) : ''"></p>
        </div>
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                Lieu de naissance
            </p>
            <p class="text-sm font-medium text-slate-900" x-text="detailStudent && detailStudent.birthPlace ? detailStudent.birthPlace : '—'"></p>
        </div>
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Genre</p>
            <span class="inline-flex items-center font-medium text-xs px-2.5 py-1 rounded-full w-max"
                  :class="detailStudent && detailStudent.gender === 'F' ? 'bg-pink-50 text-pink-600' : 'bg-blue-50 text-blue-600'"
                  x-text="detailStudent ? (detailStudent.gender === 'F' ? 'Fille' : 'Garçon') : ''"></span>
        </div>
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Classe</p>
            <p class="text-sm font-medium text-slate-900" x-text="detailStudent ? detailStudent.classroomName : ''"></p>
        </div>
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Adresse de résidence</p>
            <template x-if="detailStudent && detailStudent.address">
                <p class="text-sm font-medium text-slate-900" x-text="detailStudent.address"></p>
            </template>
            <template x-if="!detailStudent || !detailStudent.address">
                <p class="text-slate-400 italic text-sm">Non renseignée</p>
            </template>
        </div>
    </div>

    <div class="bg-slate-50/80 border border-slate-200/60 rounded-xl p-4 mx-6 mb-6 shadow-sm">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-2">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Tuteur légal
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1">Nom</p>
                <p class="text-sm font-bold text-slate-900" x-text="detailStudent && detailStudent.guardianName ? detailStudent.guardianName : '—'"></p>
            </div>
            <div>
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1">Téléphone</p>
                <div class="flex items-center gap-2">
                    <p class="text-sm font-bold text-slate-900" x-text="detailStudent && detailStudent.guardianPhone ? detailStudent.guardianPhone : '—'"></p>
                    <template x-if="detailStudent && detailStudent.guardianPhone">
                        <a :href="'tel:' + detailStudent.guardianPhone" class="p-1.5 rounded-lg bg-slate-200/50 hover:bg-slate-200 text-slate-500 hover:text-slate-700 transition-colors">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        </a>
                    </template>
                </div>
            </div>
            <div>
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1">E-mail</p>
                <p class="text-sm font-bold text-slate-900 truncate" x-text="detailStudent && detailStudent.guardianEmail ? detailStudent.guardianEmail : '—'"></p>
            </div>
        </div>
    </div>

 <!-- Onglets : -->
    <nav class="bg-slate-100/80 p-1.5 rounded-xl mx-6 mb-6 flex gap-2 border border-slate-200/50 overflow-x-auto scrollbar-hide" role="tablist" aria-label="Sections de la fiche élève">
        <button type="button" role="tab" @@click="detailTab = 'history'"
                :aria-selected="detailTab === 'history'"
                :class="detailTab === 'history' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'text-slate-600 hover:text-slate-900 font-medium hover:bg-slate-200/50'"
                class="inline-flex items-center justify-center flex-1 gap-1.5 whitespace-nowrap rounded-lg px-4 py-2 text-sm transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-1">
            <icon name="clock" class="w-4 h-4" />
            Historique scolaire
        </button>
        <button type="button" role="tab" @@click="detailTab = 'grades'"
                :aria-selected="detailTab === 'grades'"
                :class="detailTab === 'grades' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'text-slate-600 hover:text-slate-900 font-medium hover:bg-slate-200/50'"
                class="inline-flex items-center justify-center flex-1 gap-1.5 whitespace-nowrap rounded-lg px-4 py-2 text-sm transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-1">
            <icon name="academic-cap" class="w-4 h-4" />
            Notes & bulletins
        </button>
        <button type="button" role="tab" x-show="canViewPayments" x-cloak @@click="detailTab = 'payments'"
                :aria-selected="detailTab === 'payments'"
                :class="detailTab === 'payments' ? 'bg-white text-indigo-600 font-semibold shadow-sm' : 'text-slate-600 hover:text-slate-900 font-medium hover:bg-slate-200/50'"
                class="inline-flex items-center justify-center flex-1 gap-1.5 whitespace-nowrap rounded-lg px-4 py-2 text-sm transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-1">
            <icon name="wallet" class="w-4 h-4" />
            Paiements
        </button>
    </nav>

 <!-- Chargement : squelette pendant l'appel à GET /students/{id} (Volume 5 §1, connexion mobile). -->
 <div x-show="isLoadingDetails" x-cloak class="space-y-3 py-6 px-6">
 <div class="skeleton h-16 w-full"></div>
 <div class="skeleton h-16 w-full"></div>
 <div class="skeleton h-16 w-3/4"></div>
 </div>

 <!-- Erreur de chargement de la fiche complète (l'identité reste affichée au-dessus). -->
 <div x-show="detailError" x-cloak
 class="my-4 mx-6 rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger"
 x-text="detailError"></div>

 <!-- Contenu des onglets : uniquement une fois la fiche chargée sans erreur. -->
 <div x-show="!isLoadingDetails && !detailError && studentDetail" x-cloak class="px-6">

 <!-- ONGLET 1 — Historique scolaire : une carte par inscription (année, classe, type, statut). -->
 <div x-show="detailTab === 'history'" role="tabpanel" class="py-5">
 <template x-if="studentDetail && studentDetail.academicHistory.length === 0">
 <empty-state icon="layers" title="Aucune inscription enregistrée."
 hint="Cet élève n'a pas encore d'inscription pour une année scolaire." />
 </template>

 <div class="space-y-3">
 <template x-for="entry in (studentDetail ? studentDetail.academicHistory : [])" :key="entry.enrollmentId">
 <div class="rounded-2xl border border-slate-200 p-6 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <div class="flex flex-wrap items-start justify-between gap-2">
 <div class="min-w-0">
 <div class="flex items-center gap-2">
 <p class="font-bold text-slate-900" x-text="entry.schoolYearLabel"></p>
 <span x-show="entry.isActiveYear" class="status-badge-primary">Année active</span>
 </div>
 <p class="mt-1 text-sm text-slate-600">
 <span x-text="entry.classroomName"></span>
 <span class="text-slate-300 mx-1.5">•</span>
 <span x-text="enrollmentTypeLabel(entry.enrollmentType)"></span>
 </p>
 </div>
 <div class="flex flex-col items-end gap-1.5">
 <span :class="enrollmentStatusBadge(entry.status)" x-text="enrollmentStatusLabel(entry.status)"></span>
 <template x-if="entry.generalAverage !== null && entry.generalAverage !== undefined">
 <p class="text-sm text-slate-700">
 Moyenne annuelle :
 <span class="font-bold text-slate-900" x-text="formatAverage(entry.generalAverage)"></span>
 </p>
 </template>
 </div>
 </div>

 <!-- Barre d'actions de l'inscription : même gabarit que la barre d'onglets de la
 page Paramètres (conteneur bg-slate-100 rounded-xl p-1.5, boutons rounded-lg en ligne).
 Regroupe le cycle de vie de l'inscription (abandon/transfert, annulation — proposés
 uniquement tant que l'inscription est encore active) et l'aperçu des documents
 officiels (Attestation, Reçu, et Exéat si l'inscription est déjà close). -->
 <div class="mt-3 pt-3 border-t border-slate-100">
 <div class="flex items-center gap-1.5 p-1.5 bg-slate-100 rounded-xl overflow-x-auto scrollbar-hide" role="group" aria-label="Actions de l'inscription">
 <template x-if="canManageStudent && canTransitionEnrollment(entry.status)">
 <button type="button" x-on:click="openChangeEnrollmentStatus(entry)"
 class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-warning-bg hover:bg-amber-100 text-warning text-xs font-semibold transition-all whitespace-nowrap shrink-0">
 Déclarer un abandon/transfert
 </button>
 </template>
 <template x-if="canManageStudent && canTransitionEnrollment(entry.status)">
 <button type="button" x-on:click="openCancelEnrollment(entry)"
 title="Réservé aux inscriptions sans paiement encaissé"
 class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-danger-bg hover:bg-red-100 text-danger text-xs font-semibold transition-all whitespace-nowrap shrink-0">
 Annuler l'inscription
 </button>
 </template>
 <button type="button" x-on:click="openEnrollmentCertificatePreview(entry.enrollmentId, entry.schoolYearLabel)"
 title="Aperçu et impression de l'attestation"
 class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-primary-200 bg-primary-50/70 hover:bg-primary-100 text-primary-800 text-xs font-semibold transition-all whitespace-nowrap shrink-0">
 <icon name="document-text" class="w-4 h-4 text-primary shrink-0" />
 <span class="whitespace-nowrap">Attestation / Imprimer</span>
 </button>
 <button type="button" x-on:click="openEnrollmentReceiptPreview(entry.enrollmentId, entry.schoolYearLabel)"
 title="Aperçu et impression du reçu d'inscription"
 class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-emerald-200 bg-emerald-50/70 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold transition-all whitespace-nowrap shrink-0">
 <icon name="wallet" class="w-4 h-4 text-emerald-600 shrink-0" />
 <span class="whitespace-nowrap">Reçu / Imprimer</span>
 </button>
 <!-- Certificat d'exéat : uniquement pour une inscription déjà passée à Abandon/Transfert (le
 serveur renvoie 404 sinon — voir GetExeatCertificateQuery). -->
 <template x-if="entry.status === 'DroppedOut' || entry.status === 'Transferred'">
 <button type="button" x-on:click="openExeatCertificatePreview(entry.enrollmentId, entry.schoolYearLabel)"
 title="Aperçu et impression du certificat d'exéat"
 class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-amber-200 bg-amber-50/70 hover:bg-amber-100 text-amber-800 text-xs font-semibold transition-all whitespace-nowrap shrink-0">
 <icon name="document-text" class="w-4 h-4 text-amber-600 shrink-0" />
 <span class="whitespace-nowrap">Exéat / Imprimer</span>
 </button>
 </template>
 </div>
 </div>
 </div>
 </template>
 </div>
 </div>

 <!-- ONGLET 2 — Notes & bulletins : un bloc par trimestre, tableau matière par matière. -->
 <div x-show="detailTab === 'grades'" role="tabpanel" class="py-5">
 <template x-if="studentDetail && studentDetail.grades.length === 0">
 <empty-state icon="book" title="Aucune note enregistrée."
 hint="Les notes saisies pour cet élève apparaîtront ici, regroupées par trimestre." />
 </template>

 <!-- Erreur de génération/téléchargement du bulletin (JGK-G03), partagée par tous les trimestres. -->
 <div x-show="reportCardError" x-cloak
 class="form-error-banner"
 x-text="reportCardError"></div>

 <div class="space-y-6">
 <template x-for="term in (studentDetail ? studentDetail.grades : [])" :key="term.termId">
 <div>
 <!-- En-tête du trimestre : année + trimestre à gauche, synthèse + bulletin à droite. -->
 <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
 <p class="font-bold text-slate-900">
 <span x-text="term.schoolYearLabel"></span>
 <span class="text-slate-300 mx-1.5">•</span>
 <span x-text="term.termLabel"></span>
 </p>
 <div class="flex items-center gap-2">
 <template x-if="term.mention">
 <span class="status-badge-primary" x-text="term.mention"></span>
 </template>
 <p class="text-sm text-slate-700">
 Moyenne :
 <span class="font-bold text-slate-900" x-text="formatAverage(term.generalAverage)"></span>
 </p>
 <!-- Réservée au Directeur/Enseignant côté serveur (ReportCardsController). -->
 <button type="button" x-show="canEditReportCardRemark" x-cloak
 x-on:click="openReportCardRemark(term)"
 class="btn-secondary text-xs whitespace-nowrap">
 <icon name="pencil" class="w-4 h-4" />
 <span>Observations</span>
 </button>
 <!-- Directeur, Enseignant et Secrétariat (téléchargement seulement). -->
 <button type="button" x-show="canDownloadReportCard" x-cloak
 x-on:click="downloadReportCard(term)"
 :disabled="downloadingTermId === term.termId"
 class="btn-secondary text-xs whitespace-nowrap">
 <icon name="download" class="w-4 h-4" />
 <span x-text="downloadingTermId === term.termId ? 'Génération…' : 'Bulletin'"></span>
 </button>

 <!-- Envoi WhatsApp -->
 <button type="button" x-show="canDownloadReportCard" x-cloak
 x-on:click="sendReportCard(term, 1)"
 :disabled="sendingTermId === term.termId"
 class="btn-secondary text-green-700 hover:bg-green-50 border-green-200 text-xs whitespace-nowrap">
 <icon name="whatsapp" class="w-4 h-4" />
 <span x-text="sendingTermId === term.termId ? 'Envoi…' : 'WhatsApp'"></span>
 </button>

 <!-- Envoi Email -->
 <button type="button" x-show="canDownloadReportCard" x-cloak
 x-on:click="sendReportCard(term, 0)"
 :disabled="sendingTermId === term.termId"
 class="btn-secondary text-blue-700 hover:bg-blue-50 border-blue-200 text-xs whitespace-nowrap">
 <icon name="envelope" class="w-4 h-4" />
 <span x-text="sendingTermId === term.termId ? 'Envoi…' : 'Email'"></span>
 </button>
 </div>
 </div>

 <div class="overflow-x-auto rounded-2xl border border-slate-200">
 <table class="w-full min-w-[480px] text-left border-collapse text-sm">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-2.5 px-3 uppercase tracking-wider text-slate-500 font-semibold">Matière</th>
 <th class="py-2.5 px-3 text-center w-16 uppercase tracking-wider text-slate-500 font-semibold">Coef.</th>
 <th class="py-2.5 px-3 text-center w-20 uppercase tracking-wider text-slate-500 font-semibold">Devoir</th>
 <th class="py-2.5 px-3 text-center w-24 uppercase tracking-wider text-slate-500 font-semibold">Compo.</th>
 <th class="py-2.5 px-3 text-center w-20 uppercase tracking-wider text-slate-500 font-semibold">Moy.</th>
 @* « Sur » : le barème de la matière. Sans lui, une moyenne de 32 sur une ligne notée /40
    (grilles par compétences du primaire) se lirait comme un 32 sur 20. *@
 <th class="py-2.5 px-3 text-center w-16 uppercase tracking-wider text-slate-500 font-semibold">Sur</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-for="subject in term.subjects" :key="subject.subjectId">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <td class="py-2 px-3 font-medium text-slate-900" x-text="subject.subjectName"></td>
 <td class="py-2 px-3 text-center text-slate-600" x-text="formatGrade(coefficientDisplay(subject))"></td>
 <td class="py-2 px-3 text-center text-slate-700" x-text="formatGrade(subject.devoirAverage)"></td>
 <td class="py-2 px-3 text-center text-slate-700" x-text="formatGrade(subject.composition)"></td>
 <td class="py-2 px-3 text-center font-bold text-slate-900" x-text="formatGrade(subject.average)"></td>
 <td class="py-2 px-3 text-center text-slate-500 tabular-nums" x-text="formatGrade(subject.maxScore)"></td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>
 </div>
 </template>
 </div>
 </div>

 <!-- ONGLET 3 — Paiements : synthèse (dû / versé / solde) puis liste des reçus. Jamais pour
 l'Enseignant — studentDetail.payments vaut alors null (voir GetStudentDetailQueryHandler),
 d'où le template x-if : rien ici ne doit s'évaluer contre un payments absent. -->
 <div x-show="detailTab === 'payments'" role="tabpanel" class="py-5">
 <template x-if="studentDetail && studentDetail.payments">
 <div>
 <!-- Synthèse financière : reflète les inscriptions, pertinente même sans versement. -->
 <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
 <div class="rounded-2xl border border-slate-200 p-6 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total dû</p>
 <p class="mt-1 text-lg font-bold text-slate-900" x-text="formatAmount(studentDetail.payments.totalDue)"></p>
 </div>
 <div class="rounded-2xl border border-success/30 bg-success-bg p-6 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <p class="text-[11px] font-bold text-success uppercase tracking-wider">Total versé</p>
 <p class="mt-1 text-lg font-bold text-success" x-text="formatAmount(studentDetail.payments.totalPaid)"></p>
 </div>
 <!-- Solde : vert s'il est nul (soldé), orange s'il reste dû. -->
 <div class="rounded-2xl border p-6 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg"
 :class="studentDetail.payments.remainingBalance > 0 ? 'border-warning/30 bg-warning-bg' : 'border-success/30 bg-success-bg'">
 <p class="text-[11px] font-bold uppercase tracking-wider"
 :class="studentDetail.payments.remainingBalance > 0 ? 'text-warning' : 'text-success'">Solde restant</p>
 <p class="mt-1 text-lg font-bold"
 :class="studentDetail.payments.remainingBalance > 0 ? 'text-warning' : 'text-success'"
 x-text="formatAmount(studentDetail.payments.remainingBalance)"></p>
 </div>
 </div>

 <!-- Sommation impayés + Engagement financier : rattachés à l'inscription ACTIVE de l'année en
 cours (le reste du récapitulatif ci-dessus agrège toutes les années). -->
 <template x-if="activeEnrollmentId">
 <div class="mt-3 flex flex-wrap items-center gap-2.5">
 <button type="button" x-show="studentDetail.payments.remainingBalance > 0" x-cloak
 x-on:click="openDuesNoticePreview(activeEnrollmentId)"
 title="Aperçu et impression de la sommation pour impayés"
 class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-xl border border-danger/30 bg-danger-bg hover:bg-red-100 text-danger text-xs font-semibold shadow-2xs transition-all whitespace-nowrap shrink-0">
 <icon name="alert-circle" class="w-4 h-4 shrink-0" />
 <span class="whitespace-nowrap">Sommation impayés</span>
 </button>
 <button type="button" x-on:click="openCreateCommitmentModal(activeEnrollmentId)"
 title="Créer un engagement financier (échéancier)"
 class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-xl border border-primary-200 bg-primary-50/70 hover:bg-primary-100 text-primary-800 text-xs font-semibold shadow-2xs transition-all whitespace-nowrap shrink-0">
 <icon name="document-text" class="w-4 h-4 text-primary shrink-0" />
 <span class="whitespace-nowrap">Nouvel engagement financier</span>
 </button>
 <button type="button" x-show="createdCommitmentId" x-cloak
 x-on:click="openCommitmentPreview(createdCommitmentId)"
 title="Aperçu et impression de l'engagement financier créé"
 class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-xl border border-emerald-200 bg-emerald-50/70 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold shadow-2xs transition-all whitespace-nowrap shrink-0">
 <icon name="download" class="w-4 h-4 text-emerald-600 shrink-0" />
 <span class="whitespace-nowrap">Télécharger l'engagement créé</span>
 </button>
 </div>
 </template>

 <!-- Liste des versements. -->
 <div class="mt-5">
 <template x-if="studentDetail.payments.entries.length === 0">
 <empty-state icon="wallet" title="Aucun paiement enregistré."
 hint="Les versements encaissés pour cet élève apparaîtront ici." />
 </template>

 <div x-show="studentDetail.payments.entries.length > 0" class="overflow-x-auto rounded-2xl border border-slate-200">
 <table class="w-full min-w-[560px] text-left border-collapse text-sm">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-2.5 px-3 uppercase tracking-wider text-slate-500 font-semibold">Date</th>
 <th class="py-2.5 px-3 uppercase tracking-wider text-slate-500 font-semibold">N° reçu</th>
 <th class="py-2.5 px-3 text-right uppercase tracking-wider text-slate-500 font-semibold">Montant</th>
 <th class="py-2.5 px-3 uppercase tracking-wider text-slate-500 font-semibold">Méthode</th>
 <th class="py-2.5 px-3 text-center uppercase tracking-wider text-slate-500 font-semibold">Statut</th>
 <th class="py-2.5 px-3 text-center uppercase tracking-wider text-slate-500 font-semibold">Document</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-for="payment in studentDetail.payments.entries" :key="payment.paymentId">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <td class="py-2 px-3 text-slate-700 whitespace-nowrap" x-text="formatDate(payment.paidAt)"></td>
 <td class="py-2 px-3 font-mono text-xs text-slate-600 whitespace-nowrap" x-text="payment.receiptNumber || '—'"></td>
 <td class="py-2 px-3 text-right font-bold text-slate-900 whitespace-nowrap" x-text="formatAmount(payment.amount)"></td>
 <td class="py-2 px-3 text-slate-700 whitespace-nowrap" x-text="paymentMethodLabel(payment.method)"></td>
 <td class="py-2 px-3 text-center">
 <span :class="paymentStatusBadge(payment.status)" x-text="paymentStatusLabel(payment.status)"></span>
 </td>
 <td class="py-2 px-3 text-center whitespace-nowrap">
 <button type="button" x-on:click="openPaymentReceiptPreview(payment.paymentId, payment.receiptNumber)"
 title="Aperçu et impression du reçu PDF"
 class="inline-flex items-center justify-center gap-1.5 px-3 py-1 rounded-lg border border-indigo-200 bg-indigo-50/70 hover:bg-indigo-100 text-indigo-800 text-xs font-semibold shadow-2xs transition-all whitespace-nowrap shrink-0">
 <icon name="document-text" class="w-3.5 h-3.5 text-indigo-600 shrink-0" />
 <span class="whitespace-nowrap">Aperçu / Imprimer</span>
 </button>
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </template>
 </div>

 </div>

 <div class="px-6 pb-6 pt-4 flex flex-col-reverse sm:flex-row sm:justify-between gap-3 border-t border-slate-100 mt-4">
 <template x-if="canManageStudent && studentDetail">
 <div class="flex gap-2">
 <button type="button" @@click="openEditStudent()" class="btn-secondary">
 Modifier la fiche
 </button>
 <button type="button" @@click="openDeleteStudent()" class="text-sm font-medium text-danger bg-danger-bg hover:bg-red-100 px-5 py-2.5 rounded-xl transition-colors">
 Supprimer
 </button>
 </div>
 </template>
 <button type="button" @@click="closeDetail()" class="btn-secondary sm:ml-auto">
 Fermer
 </button>
 </div>
 </modal-shell>

 <!-- Distinction du conseil (Blâme… Félicitations) et observations, imprimées sur le bulletin
 (ReportCardDocument). Réservée au Directeur/Enseignant côté serveur, comme le bouton Bulletin. -->
 <modal-shell open="editingReportCardRemark" on-close="closeReportCardRemark()" title="Observations du conseil">
 <modal-subtitle>Distinction et observations du conseil des professeurs pour ce trimestre — imprimées sur le bulletin.</modal-subtitle>

 <div x-show="reportCardRemarkErrors.global" x-cloak class="form-error-banner" x-text="reportCardRemarkErrors.global"></div>

 <!-- modal-shell masque en CSS (x-show) mais laisse le formulaire dans le DOM : sans ce x-if, Alpine
 évalue "editingReportCardRemark.disciplinaryMention" dès l'initialisation, alors que l'état par
 défaut est null (fermé) — TypeError à chaque tick réactif, bien avant toute ouverture de la
 modale. Même pattern que l'onglet Paiements plus haut (template x-if="studentDetail && ..."). -->
 <template x-if="editingReportCardRemark">
 <form x-on:submit.prevent="submitReportCardRemark()" novalidate class="space-y-4">
 <div>
 <label class="form-label">Distinction</label>
 <select-field model="editingReportCardRemark.disciplinaryMention" aria-label="Distinction"
 placeholder="Aucune" options="disciplinaryMentionOptions" />
 </div>

 <div>
 <label class="form-label">Décision du Conseil</label>
 <select-field model="editingReportCardRemark.councilDecision" aria-label="Décision du Conseil"
 placeholder="Aucune / Non renseignée" options="councilDecisionOptions" />
 </div>

 <div>
 <label class="form-label">Observations du conseil des professeurs</label>
 <textarea x-model="editingReportCardRemark.observations" maxlength="300" rows="4"
 placeholder="ex : Bon trimestre, poursuivez vos efforts."
 class="input-field"></textarea>
 <p x-show="reportCardRemarkErrors.observations" x-cloak x-text="reportCardRemarkErrors.observations" class="field-error"></p>
 </div>

 <div class="flex justify-end gap-3 pt-2 border-t border-slate-100">
 <button type="button" x-on:click="closeReportCardRemark()" class="btn-secondary mt-4">Annuler</button>
 <button type="submit" :disabled="isSavingReportCardRemark" class="btn-primary mt-4">
 <span x-text="isSavingReportCardRemark ? 'Enregistrement…' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </template>
 </modal-shell>

 <!-- Modification de la fiche élève : le matricule n'est jamais modifiable (AGENTS.md règle #3). -->
 <modal-shell open="editingStudent" on-close="closeEditStudent()" title="Modifier la fiche">
 <modal-subtitle>Le matricule reste celui déjà attribué : il n'est jamais modifiable.</modal-subtitle>

 <div x-show="studentEditErrors.global" x-cloak class="form-error-banner" x-text="studentEditErrors.global"></div>

 <form x-on:submit.prevent="submitEditStudent()" novalidate class="space-y-4">
 <div>
 <label class="form-label form-label-required">Nom complet</label>
 <input type="text" x-model="editingStudent.fullName" required class="input-field" :class="studentEditErrors.fullname && 'input-field-error'">
 <p x-show="studentEditErrors.fullname" x-text="studentEditErrors.fullname" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">Date de naissance</label>
 <date-field model="editingStudent.birthDate" required="true" aria-label="Date de naissance" />
 <p x-show="studentEditErrors.birthdate" x-text="studentEditErrors.birthdate" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">Lieu de naissance</label>
 <input type="text" x-model="editingStudent.birthPlace" required maxlength="200" class="input-field" :class="studentEditErrors.birthplace && 'input-field-error'">
 <p x-show="studentEditErrors.birthplace" x-text="studentEditErrors.birthplace" class="field-error"></p>
 </div>

 <!-- Adresse de résidence DE L'ÉLÈVE — distincte des coordonnées du tuteur ci-dessous. -->
 <div>
 <label class="form-label">Adresse de résidence</label>
 <input type="text" x-model="editingStudent.address" maxlength="300" class="input-field" :class="studentEditErrors.address && 'input-field-error'">
 <p x-show="studentEditErrors.address" x-text="studentEditErrors.address" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">Genre</label>
 <select-field model="editingStudent.gender" aria-label="Genre" options="studentGenderOptions" />
 <p x-show="studentEditErrors.gender" x-text="studentEditErrors.gender" class="field-error"></p>
 </div>

 <div>
 <label class="form-label form-label-required">Classe</label>
 <select-field model="editingStudent.classroomId" required="true" aria-label="Classe"
 placeholder="Sélectionner une classe"
 options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" />
 <p x-show="studentEditErrors.classroomid" x-text="studentEditErrors.classroomid" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Photo</label>
 <photo-dropzone preview="editingStudent.photoDisplayUrl"
 on-change="uploadStudentPhoto(photoBase64)" />
 <p x-show="photoUploadError" x-cloak x-text="photoUploadError" class="field-error"></p>
 <div class="mt-3">
 <label class="form-label-sm">…ou une URL externe (utilisée seulement si aucune photo n'est déposée ci-dessus)</label>
 <input type="text" x-model="editingStudent.photoUrl" placeholder="https://…" class="input-field mt-1">
 </div>
 <p x-show="studentEditErrors.photourl" x-text="studentEditErrors.photourl" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Nom du tuteur</label>
 <input type="text" x-model="editingStudent.guardianName" class="input-field" :class="studentEditErrors.guardianname && 'input-field-error'">
 <p x-show="studentEditErrors.guardianname" x-text="studentEditErrors.guardianname" class="field-error"></p>
 </div>

 <div>
 <label class="form-label">Téléphone du tuteur</label>
 <input type="text" x-model="editingStudent.guardianPhone" class="input-field" :class="studentEditErrors.guardianphone && 'input-field-error'">
 <p x-show="studentEditErrors.guardianphone" x-text="studentEditErrors.guardianphone" class="field-error"></p>
                </div>

                <div>
                    <label class="form-label">E-mail du tuteur</label>
                    <input type="email" x-model="editingStudent.guardianEmail" class="input-field" :class="studentEditErrors.guardianemail && 'input-field-error'">
                    <p x-show="studentEditErrors.guardianemail" x-text="studentEditErrors.guardianemail" class="field-error"></p>
                </div>

 <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
 <button type="button" @@click="closeEditStudent()" class="btn-secondary">Annuler</button>
 <button type="submit" :disabled="isSavingStudentEdit" class="btn-primary">
 <span x-text="isSavingStudentEdit ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : fiche modifiée -->
 <modal-shell open="showStudentEditedDialog" size="md" on-close="showStudentEditedDialog = false" title="Fiche modifiée">
 <confirm-dialog-body close-action="showStudentEditedDialog = false">
 La fiche a bien été mise à jour.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Confirmation : suppression de la fiche élève -->
 <modal-shell open="deletingStudentRecord" on-close="closeDeleteStudent()" size="md">
 <modal-title>Supprimer la fiche</modal-title>
 <modal-subtitle>
 <span class="font-semibold text-slate-900" x-text="deletingStudentRecord ? deletingStudentRecord.fullName : ''"></span>
 sera archivée et n'apparaîtra plus dans la liste des élèves.
 </modal-subtitle>

 <div x-show="deleteStudentRecordError" x-cloak class="form-error-banner" x-text="deleteStudentRecordError"></div>

 <p class="text-sm text-slate-500">
 Réservé à une fiche créée par pure erreur de saisie : impossible si une inscription ou une note existe déjà pour cet élève.
 </p>

 <div class="mt-6 flex justify-end gap-3">
 <button type="button" @@click="closeDeleteStudent()" class="btn-secondary">Annuler</button>
 <button type="button" @@click="confirmDeleteStudent()" :disabled="isDeletingStudentRecord" class="btn-danger">
 <span x-text="isDeletingStudentRecord ? 'Suppression...' : 'Supprimer la fiche'"></span>
 </button>
 </div>
 </modal-shell>

 <!-- Confirmation : suppression d'une fiche élève -->
 <modal-shell open="showStudentDeletedDialog" size="md" on-close="showStudentDeletedDialog = false" title="Fiche supprimée">
 <confirm-dialog-body close-action="showStudentDeletedDialog = false">
 La fiche a bien été supprimée.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Annulation d'une inscription (erreur de saisie, sans paiement encaissé) -->
 <modal-shell open="cancelingEnrollment" on-close="closeCancelEnrollment()" size="md">
 <modal-title>Annuler l'inscription</modal-title>
 <modal-subtitle>
 Année <span class="font-semibold text-slate-900" x-text="cancelingEnrollment ? cancelingEnrollment.schoolYearLabel : ''"></span>
 </modal-subtitle>

 <div x-show="cancelEnrollmentError" x-cloak class="form-error-banner" x-text="cancelEnrollmentError"></div>

 <p class="text-sm text-slate-500">
 À réserver à une erreur de saisie : refusée si un reçu de paiement existe déjà pour cette inscription — utilisez plutôt « Déclarer un abandon/transfert » dans ce cas.
 </p>

 <div class="mt-6 flex justify-end gap-3">
 <button type="button" @@click="closeCancelEnrollment()" class="btn-secondary">Retour</button>
 <button type="button" @@click="confirmCancelEnrollment()" :disabled="isCancelingEnrollment" class="btn-danger">
 <span x-text="isCancelingEnrollment ? 'Annulation...' : 'Annuler l\'inscription'"></span>
 </button>
 </div>
 </modal-shell>

 <!-- Déclarer un abandon ou un transfert en cours d'année -->
 <modal-shell open="changingEnrollmentStatus" on-close="closeChangeEnrollmentStatus()" size="md">
 <modal-title>Abandon ou transfert</modal-title>
 <modal-subtitle>
 Année <span class="font-semibold text-slate-900" x-text="changingEnrollmentStatus ? changingEnrollmentStatus.schoolYearLabel : ''"></span>
 </modal-subtitle>

 <div x-show="changeEnrollmentStatusError" x-cloak class="form-error-banner" x-text="changeEnrollmentStatusError"></div>

 <form x-on:submit.prevent="submitChangeEnrollmentStatus()" novalidate class="space-y-4">
 <div>
 <label class="form-label form-label-required">Nouveau statut</label>
 <select-field model="changingEnrollmentStatus.newStatus" required="true" aria-label="Nouveau statut"
 options="enrollmentStatusOptions" />
 <p class="mt-1 text-xs text-slate-400">
 L'élève sort des futures listes de présence ; ses notes et paiements déjà enregistrés restent intacts.
 </p>
 </div>

 <div class="mt-6 flex justify-end gap-3">
 <button type="button" @@click="closeChangeEnrollmentStatus()" class="btn-secondary">Annuler</button>
 <button type="submit" :disabled="isChangingEnrollmentStatus" class="btn-primary">
 <span x-text="isChangingEnrollmentStatus ? 'Enregistrement...' : 'Confirmer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Création d'élève (JGK-D01) -->
 <modal-shell open="isCreateOpen" title="Ajouter un élève">
 <modal-subtitle>Le matricule sera généré automatiquement à l'enregistrement.</modal-subtitle>

 <!-- Erreur globale -->
 <div x-show="createErrors.global" x-cloak class="form-error-banner" x-text="createErrors.global"></div>

 <form x-on:submit.prevent="submitCreate()" novalidate class="space-y-4">
 <!-- Nom complet -->
 <div>
 <label class="form-label form-label-required">Nom complet</label>
 <input type="text" x-model="newStudent.fullName" required class="input-field" :class="createErrors.fullname && 'input-field-error'">
 <p x-show="createErrors.fullname" x-text="createErrors.fullname" class="field-error"></p>
 </div>

 <!-- Date de naissance -->
 <div>
 <label class="form-label form-label-required">Date de naissance</label>
 <date-field model="newStudent.birthDate" required="true" aria-label="Date de naissance" />
 <p x-show="createErrors.birthdate" x-text="createErrors.birthdate" class="field-error"></p>
 </div>

 <!-- Lieu de naissance (obligatoire, feature E) -->
 <div>
 <label class="form-label form-label-required">Lieu de naissance</label>
 <input type="text" x-model="newStudent.birthPlace" required maxlength="200" placeholder="ex : Dakar" class="input-field" :class="createErrors.birthplace && 'input-field-error'">
 <p x-show="createErrors.birthplace" x-text="createErrors.birthplace" class="field-error"></p>
 </div>

 <!-- Adresse de résidence DE L'ÉLÈVE — distincte des coordonnées du tuteur ci-dessous (voir
 Student.Address). Placée ici, avec le reste de son identité, plutôt qu'entre les champs
 « du tuteur » où elle se lisait comme l'adresse du tuteur lui-même. -->
 <div>
 <label class="form-label">Adresse de résidence</label>
 <input type="text" x-model="newStudent.address" maxlength="300" class="input-field" :class="createErrors.address && 'input-field-error'">
 <p x-show="createErrors.address" x-text="createErrors.address" class="field-error"></p>
 </div>

 <!-- Genre -->
 <div>
 <label class="form-label form-label-required">Genre</label>
 <select-field model="newStudent.gender" aria-label="Genre" options="studentGenderOptions" />
 <p x-show="createErrors.gender" x-text="createErrors.gender" class="field-error"></p>
 </div>

 <!-- Classe (Dynamique) -->
 <div>
 <label class="form-label form-label-required">Classe</label>
 <select-field model="newStudent.classroomId" required="true" aria-label="Classe"
 placeholder="Sélectionner une classe"
 options-expr="classrooms.map(c => ({value: c.id, label: c.name + ' (' + c.level + ')'}))" />
 <p x-show="createErrors.classroomid" x-text="createErrors.classroomid" class="field-error"></p>
 </div>

 <!-- Photo (feature B : upload local compressé, URL externe en alternative) -->
 <div>
 <label class="form-label">Photo</label>
 <photo-dropzone preview="newStudent.photoData ? ('data:image/jpeg;base64,' + newStudent.photoData) : newStudent.photoUrl"
 on-change="newStudent.photoData = photoBase64" />
 <div class="mt-3">
 <label class="form-label-sm">…ou une URL externe (utilisée seulement si aucune photo n'est déposée ci-dessus)</label>
 <input type="text" x-model="newStudent.photoUrl" placeholder="https://…" class="input-field mt-1">
 </div>
 <p x-show="createErrors.photourl" x-text="createErrors.photourl" class="field-error"></p>
 <p x-show="createErrors.photodata" x-text="createErrors.photodata" class="field-error"></p>
 </div>

 <!-- Tuteur -->
 <div>
 <label class="form-label">Nom du tuteur</label>
 <input type="text" x-model="newStudent.guardianName" class="input-field">
 </div>

 <div>
 <label class="form-label">Téléphone du tuteur</label>
 <input type="text" x-model="newStudent.guardianPhone" class="input-field">
                </div>

                <div>
                    <label class="form-label">E-mail du tuteur</label>
                    <input type="email" x-model="newStudent.guardianEmail" class="input-field" :class="createErrors.guardianemail && 'input-field-error'">
                    <p x-show="createErrors.guardianemail" x-text="createErrors.guardianemail" class="field-error"></p>
                </div>

 <!-- Boutons d'action -->
 <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-4">
 <button type="button" @@click="isCreateOpen = false" class="btn-secondary">
 Annuler
 </button>
 <button type="submit" :disabled="isSubmitting" class="btn-primary">
 <span x-text="isSubmitting ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>

 <!-- Confirmation : élève ajouté -->
 <modal-shell open="showAddedDialog" size="md" on-close="showAddedDialog = false" title="Élève ajouté">
 <confirm-dialog-body close-action="showAddedDialog = false"
 new-action="showAddedDialog = false; isCreateOpen = true" new-label="Nouvel élève">
 <span class="font-medium text-slate-900" x-text="addedStudentName"></span> a bien été ajouté(e) et figure désormais dans la liste.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Import de masse (rentrée scolaire) : aperçu AVANT écriture, une classe par ligne. -->
 <modal-shell open="isImportOpen" on-close="closeImport()" title="Importer des élèves" size="3xl">
 <modal-subtitle>Fichier CSV ou Excel, une classe par ligne. Rien n'est enregistré tant que l'aperçu n'est pas entièrement valide.</modal-subtitle>

 <div x-show="importError" x-cloak class="form-error-banner" x-text="importError"></div>

 <!-- Zone de dépôt du fichier : masquée une fois qu'un import a été confirmé, pour laisser la place au résumé de succès. -->
 <div x-show="!(importResult && importResult.committed)" x-cloak>
 <div x-on:dragover.prevent="importDragging = true" x-on:dragleave.prevent="importDragging = false"
 x-on:drop.prevent="importDragging = false; onImportFileSelected($event.dataTransfer.files[0])"
 x-on:click="$refs.importFileInput.click()"
 :class="importDragging ? 'border-primary bg-primary/5' : 'border-slate-300 hover:border-primary'"
 class="rounded-2xl border-2 border-dashed p-6 text-center cursor-pointer transition-colors">
 <icon name="upload" class="w-8 h-8 text-slate-400 mx-auto" />
 <p class="mt-2 text-sm">
 <span x-show="!importFileName" class="text-slate-600">Glissez votre fichier ici, ou <span class="text-primary font-medium">cliquez pour le choisir</span>.</span>
 <span x-show="importFileName" x-text="importFileName" class="font-medium text-slate-900"></span>
 </p>
 <p class="text-xs text-slate-400 mt-1">Fichier .csv ou .xlsx, 1000 lignes maximum.</p>
 <input type="file" accept=".csv,.xlsx,.xls" x-ref="importFileInput" class="hidden"
 x-on:change="onImportFileSelected($event.target.files[0])" x-on:click.stop="">
 </div>

 <div x-show="isPreviewing" x-cloak class="mt-4 flex items-center justify-center py-6">
 <svg aria-hidden="true" class="animate-spin h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 <span class="ml-2 text-sm text-slate-500">Analyse du fichier…</span>
 </div>

 <!-- Aperçu ligne par ligne : cellules en rouge = champ invalide, survol = détail de l'erreur. -->
 <div x-show="importPreview" x-cloak class="mt-4">
 <p class="text-sm text-slate-700 mb-2">
 <span x-text="importPreview ? importPreview.totalRows : 0"></span> ligne(s) détectée(s) —
 <span class="text-success font-medium" x-text="importPreview ? importPreview.validRows : 0"></span> valide(s),
 <span class="text-danger font-medium" x-text="importPreview ? importPreview.invalidRows : 0"></span> invalide(s).
 </p>

 <div class="max-h-80 overflow-auto rounded-2xl border border-slate-200">
 <table class="w-full min-w-[900px] text-left border-collapse text-xs">
 <thead>
 <tr class="table-head hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <th class="py-2 px-2 w-10 uppercase tracking-wider text-slate-500 font-semibold">L.</th>
 <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">Nom complet</th>
 <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">Naissance</th>
 <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">Lieu</th>
 <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">Genre</th>
 <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">Classe</th>
 <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">Tuteur</th>
 <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">Tél. tuteur</th>
                                    <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">E-mail tuteur</th>
                                    <th class="py-2 px-2 uppercase tracking-wider text-slate-500 font-semibold">Adresse</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-for="row in (importPreview ? importPreview.rows : [])" :key="row.rowNumber">
 <tr class="hover:bg-slate-50 transition-colors duration-150 transition-all duration-200 ease-in-out">
 <td class="py-1.5 px-2 text-slate-400" x-text="row.rowNumber"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'fullName')" :title="row.fieldErrors.fullName || ''" x-text="row.fullName"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'birthDate')" :title="row.fieldErrors.birthDate || ''" x-text="row.birthDate"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'birthPlace')" :title="row.fieldErrors.birthPlace || ''" x-text="row.birthPlace"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'gender')" :title="row.fieldErrors.gender || ''" x-text="row.gender"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'classroomName')" :title="row.fieldErrors.classroomName || ''" x-text="row.classroomName"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'guardianName')" :title="row.fieldErrors.guardianName || ''" x-text="row.guardianName"></td>
 <td class="py-1.5 px-2" :class="importCellClass(row, 'guardianPhone')" :title="row.fieldErrors.guardianPhone || ''" x-text="row.guardianPhone"></td>
                                    <td class="py-1.5 px-2" :class="importCellClass(row, 'guardianEmail')" :title="row.fieldErrors.guardianEmail || ''" x-text="row.guardianEmail"></td>
                                    <td class="py-1.5 px-2" :class="importCellClass(row, 'address')" :title="row.fieldErrors.address || ''" x-text="row.address"></td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>

 <p x-show="importPreview && importPreview.invalidRows > 0" x-cloak class="field-error">
 Corrigez les cellules en rouge dans votre fichier (survolez-les pour le détail), puis redéposez-le ci-dessus.
 </p>
 </div>
 </div>

 <!-- Résumé de succès, après confirmation. -->
 <div x-show="importResult && importResult.committed" x-cloak class="rounded-xl border-l-4 border-success bg-success-bg p-6 text-sm text-success">
 <span class="font-semibold" x-text="importResult ? importResult.created : 0"></span> élève(s) importé(s) avec succès — ils figurent désormais dans la liste.
 </div>

 <div class="mt-6 flex flex-wrap justify-between gap-3 border-t border-slate-200 pt-4">
 <button type="button" @@click="downloadImportTemplate()" class="btn-secondary">
 <icon name="download" class="w-4 h-4" />
 <span>Télécharger le modèle</span>
 </button>
 <div class="flex gap-3">
 <button type="button" @@click="closeImport()" class="btn-secondary">Fermer</button>
 <button type="button"
 x-show="importPreview && importPreview.invalidRows === 0 && importPreview.validRows > 0 && !(importResult && importResult.committed)"
 x-cloak @@click="confirmImport()" :disabled="isImporting" class="btn-primary">
 <span x-text="isImporting ? 'Import en cours…' : ('Confirmer l\'import (' + (importPreview ? importPreview.validRows : 0) + ' élèves)')"></span>
 </button>
 </div>
 </div>
 </modal-shell>

 <!-- Modale d'Aperçu PDF (Certificats et Reçus) -->
 @await Html.PartialAsync("_PdfPreviewModal")

 <!-- Modale : Nouvel engagement financier (échéancier) -->
 <modal-shell open="isCommitmentModalOpen" on-close="isCommitmentModalOpen = false" title="Nouvel engagement financier">
 <modal-subtitle>Trace écrite d'un échéancier de paiement — ne modifie jamais le montant dû de l'inscription.</modal-subtitle>

 <div x-show="commitmentErrors.global" x-cloak class="form-error-banner" x-text="commitmentErrors.global"></div>

 <form x-on:submit.prevent="submitCreateCommitment()" novalidate class="space-y-4">
 <div>
 <label class="form-label form-label-required">Montant (FCFA)</label>
 <input type="number" min="0" x-model.number="commitmentForm.amount" required class="input-field mt-1" :class="commitmentErrors.amount && 'input-field-error'" />
 <p x-show="commitmentErrors.amount" x-cloak x-text="commitmentErrors.amount" class="field-error"></p>
 </div>
 <div>
 <label class="form-label form-label-required">Échéance</label>
 <input type="date" x-model="commitmentForm.dueDate" required class="input-field mt-1" :class="commitmentErrors.dueDate && 'input-field-error'" />
 <p x-show="commitmentErrors.dueDate" x-cloak x-text="commitmentErrors.dueDate" class="field-error"></p>
 </div>
 <div>
 <label class="form-label form-label-required">Termes de l'engagement</label>
 <textarea x-model="commitmentForm.terms" rows="4" required class="input-field mt-1" placeholder="Décrivez l'échéancier convenu..."></textarea>
 <p x-show="commitmentErrors.terms" x-cloak x-text="commitmentErrors.terms" class="field-error"></p>
 </div>

 <div class="mt-6 flex justify-end gap-3">
 <button type="button" x-on:click="isCommitmentModalOpen = false" class="btn-secondary">Annuler</button>
 <button type="submit" :disabled="isSavingCommitment" class="btn-primary">
 <span x-text="isSavingCommitment ? 'Enregistrement...' : 'Enregistrer'"></span>
 </button>
 </div>
 </form>
 </modal-shell>
</div>
