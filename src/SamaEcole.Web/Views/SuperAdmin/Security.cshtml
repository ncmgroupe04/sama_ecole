@{
 ViewData["Title"] = "Sécurité & Logs";
 Layout = "_SuperAdminLayout";
}

@{
 var moduleFilterOptions = new List<SelectFieldOption> {
 new("", "Tous les domaines"), new("Auth", "Authentification"), new("Schools", "Établissements"),
 new("Finance", "Finance"), new("Subscriptions", "Abonnements"), new("RegistrationRequests", "Inscriptions"),
 new("Sms", "SMS"), new("Users", "Utilisateurs"), new("Platform", "Plateforme")
 };
}

@* Cet écran consomme le VRAI GET /api/v1/admin/platform/activity (PlatformController, migrations
 AddPlatformAdminViews puis ExtendGlobalAuditLogsFilters : fonction SECURITY DEFINER
 get_global_audit_logs, désormais paramétrée par module/succès/école/plage de dates). Même nature de
 données que l'onglet Journal d'audit des Paramètres (Views/Shared/_AuditLogPanel.cshtml), mais toutes
 écoles confondues — d'où la colonne Établissement, et le filtre École, en plus. *@
<div x-data="superAdminSecurity()" x-init="load(); loadSchools()" class="space-y-6">

 <div>
 <h1 class="text-xl font-semibold text-white">Sécurité &amp; Logs</h1>
 <p class="text-sm text-zinc-500 mt-1">Journal d'audit de la plateforme, toutes écoles confondues.</p>
 </div>

 <div x-show="isDemoData" x-cloak
 class="rounded-2xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-300 flex items-start gap-2">
 <icon name="alert-circle" class="w-[18px] h-[18px] shrink-0 mt-0.5" />
 <span>
 Backend du journal d'audit plateforme introuvable (<code class="text-amber-200">GET /admin/platform/activity</code>) —
 les entrées ci-dessous sont des données de démonstration, pas des données réelles.
 </span>
 </div>

 <div x-show="error" x-cloak class="rounded-2xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300" x-text="error"></div>

 <!-- Filtres -->
 <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 backdrop-blur p-4 space-y-3">
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
 <div>
 <label class="block text-[11px] font-bold uppercase tracking-wider text-zinc-500 mb-1">Domaine</label>
 <select x-model="moduleFilter" x-on:change="applyFilters()"
 class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500">
 @foreach (var option in moduleFilterOptions)
 {
 <option value="@option.Value">@option.Label</option>
 }
 </select>
 </div>

 <div>
 <label class="block text-[11px] font-bold uppercase tracking-wider text-zinc-500 mb-1">Établissement</label>
 <select x-model="schoolFilter" x-on:change="applyFilters()"
 class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500">
 <option value="">Toutes les écoles</option>
 <template x-for="school in schools" :key="school.id">
 <option :value="school.id" x-text="school.name"></option>
 </template>
 </select>
 </div>

 <div>
 <label class="block text-[11px] font-bold uppercase tracking-wider text-zinc-500 mb-1">Du</label>
 <input type="date" x-model="dateFrom" x-on:change="applyFilters()"
 class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
 </div>

 <div>
 <label class="block text-[11px] font-bold uppercase tracking-wider text-zinc-500 mb-1">Au</label>
 <input type="date" x-model="dateTo" x-on:change="applyFilters()"
 class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
 </div>
 </div>

 <div class="flex flex-wrap items-center justify-between gap-3">
 <div class="flex flex-wrap items-center gap-2">
 <template x-for="option in [
 { value: '', label: 'Tous résultats' },
 { value: 'true', label: 'Succès' },
 { value: 'false', label: 'Échecs' }
 ]" :key="option.value">
 <button type="button" x-on:click="successFilter = option.value; applyFilters()"
 :class="successFilter === option.value ? 'bg-sky-500/15 text-sky-400 ring-1 ring-inset ring-sky-500/30' : 'text-zinc-400 border border-zinc-800 hover:bg-zinc-900'"
 class="rounded-2xl px-3 py-1.5 text-xs font-medium transition-colors">
 <span x-text="option.label"></span>
 </button>
 </template>
 </div>

 <button type="button" x-on:click="resetFilters()"
 class="text-xs font-medium text-zinc-500 hover:text-zinc-200 transition-colors">
 Réinitialiser les filtres
 </button>
 </div>
 </div>

 <!-- Journal -->
 <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 backdrop-blur overflow-hidden">
 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="text-xs uppercase tracking-wider text-zinc-500 border-b border-zinc-800 bg-zinc-950/40">
 <th class="py-3 px-4 font-medium">Date/heure</th>
 <th class="py-3 px-4 font-medium">Établissement</th>
 <th class="py-3 px-4 font-medium">Utilisateur</th>
 <th class="py-3 px-4 font-medium">Domaine</th>
 <th class="py-3 px-4 font-medium">Action</th>
 <th class="py-3 px-4 font-medium">Résultat</th>
 <th class="py-3 px-4 font-medium">IP</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-zinc-800/80">
 <template x-if="isLoading">
 <template x-for="i in 6" :key="i">
 <tr><td class="py-3 px-4" colspan="7"><div class="h-4 w-full rounded-xl bg-zinc-800 animate-pulse"></div></td></tr>
 </template>
 </template>

 <tr x-show="!isLoading && entries.length === 0" x-cloak>
 <td colspan="7" class="py-12 text-center text-sm text-zinc-500">
 Aucune entrée dans le journal.
 </td>
 </tr>

 <template x-for="entry in entries" :key="entry.id">
 <tr class="hover:bg-zinc-900 transition-colors">
 <td class="py-3 px-4 text-zinc-400 whitespace-nowrap" x-text="formatDateTime(entry.occurredAt)"></td>
 <td class="py-3 px-4 text-zinc-100" x-text="entry.schoolName"></td>
 <td class="py-3 px-4 text-zinc-300" x-text="entry.actorFullName"></td>
 <td class="py-3 px-4">
 <span class="inline-flex items-center rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs font-medium text-zinc-300" x-text="entry.module"></span>
 </td>
 <td class="py-3 px-4 text-zinc-300" x-text="entry.action"></td>
 <td class="py-3 px-4">
 <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium"
 :class="entry.success ? 'bg-emerald-500/15 text-emerald-400 ring-1 ring-inset ring-emerald-500/20' : 'bg-rose-500/15 text-rose-400 ring-1 ring-inset ring-rose-500/20'"
 x-text="entry.success ? 'Succès' : 'Échec'"></span>
 </td>
 <td class="py-3 px-4 font-mono text-xs text-zinc-500" x-text="entry.ipAddress || '—'"></td>
 </tr>
 <tr x-show="!entry.success && entry.failureReason" x-cloak>
 <td></td>
 <td colspan="6" class="pb-3 px-4 -mt-3 text-xs text-rose-400" x-text="entry.failureReason"></td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>

 <div class="flex items-center justify-between gap-4 border-t border-zinc-800 px-4 py-3">
 <p class="text-xs text-zinc-500">
 Page <span class="font-medium text-zinc-300" x-text="page"></span>
 <template x-if="totalCount > 0">
 <span> sur <span class="font-medium text-zinc-300" x-text="Math.ceil(totalCount / pageSize)"></span> · <span x-text="totalCount"></span> résultats</span>
 </template>
 </p>
 <div class="flex items-center gap-2">
 <button type="button" x-on:click="if (page > 1) { page--; load(); }" :disabled="page === 1 || isLoading"
 class="rounded-2xl border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors disabled:opacity-50 disabled:hover:bg-zinc-900">
 Précédent
 </button>
 <button type="button" x-on:click="if (page * pageSize < totalCount) { page++; load(); }" :disabled="page * pageSize >= totalCount || isLoading"
 class="rounded-2xl border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors disabled:opacity-50 disabled:hover:bg-zinc-900">
 Suivant
 </button>
 </div>
 </div>
 </div>
</div>

@section Scripts {
 <script src="~/js/superadmin-security.js" asp-append-version="true"></script>
}
