@{
    ViewData["Title"] = "Tableau de bord";
    Layout = "_SuperAdminLayout";
}

@* Aucune query d'agrégation plateforme n'existe encore côté Application (voir le TODO backend dans
   wwwroot/js/superadmin-dashboard.js) : cet écran appelle un contrat GET /admin/platform/dashboard
   pas encore implémenté et bascule sur un jeu de données de démonstration si l'appel échoue, en
   l'annonçant explicitement — jamais un chiffre silencieusement inventé (même principe que les
   <span> désactivés de _Layout.cshtml pour un module non livré). *@
<div x-data="superAdminDashboard()" x-init="load()">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-semibold text-white">Tableau de bord plateforme</h1>
            <p class="text-sm text-zinc-500 mt-1">Vue d'ensemble de tous les établissements Sama Ecole.</p>
        </div>
        <button type="button" x-on:click="load()" :disabled="isLoading"
                class="inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors disabled:opacity-50">
            <icon name="chart-multiple" class="w-4 h-4" />
            <span x-text="isLoading ? 'Actualisation…' : 'Actualiser'"></span>
        </button>
    </div>

    <div x-show="isDemoData" x-cloak
         class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-300 flex items-start gap-2">
        <icon name="alert-circle" class="w-[18px] h-[18px] shrink-0 mt-0.5" />
        <span>
            Backend d'agrégation plateforme pas encore livré (<code class="text-amber-200">GET /admin/platform/dashboard</code> introuvable) —
            les chiffres ci-dessous sont des données de démonstration, pas des données réelles.
        </span>
    </div>

    <div x-show="error" x-cloak class="rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300" x-text="error"></div>

    <!-- Cartes KPI -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <template x-for="tile in kpiTiles" :key="tile.label">
            <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 backdrop-blur p-5">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium uppercase tracking-wider text-zinc-500" x-text="tile.label"></p>
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg" :class="tile.iconBg">
                        @* <icon> est un TagHelper résolu côté SERVEUR (name= doit être un littéral connu à la
                           compilation, voir TagHelpers/IconTagHelper.cs) : il ne peut pas prendre un nom
                           d'icône dynamique venant d'Alpine. On retombe donc ici sur le <use> brut que le
                           TagHelper génère lui-même en interne, avec un href lié côté client. *@
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-4 h-4" :class="tile.iconText">
                            <use :href="`#icon-${tile.icon}`"></use>
                        </svg>
                    </div>
                </div>
                <p class="mt-3 text-2xl font-semibold text-white" x-text="isLoading ? '—' : tile.value"></p>
                <p class="mt-1 text-xs" :class="tile.deltaClass" x-text="tile.deltaLabel"></p>
            </div>
        </template>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Évolution du MRR -->
        <div class="lg:col-span-2 rounded-xl border border-zinc-800 bg-zinc-900/60 backdrop-blur p-5">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-sm font-semibold text-zinc-100">Revenu récurrent mensuel (MRR)</h2>
                    <p class="text-xs text-zinc-500 mt-0.5">12 derniers mois, toutes écoles confondues</p>
                </div>
                <button type="button" x-on:click="showMrrTable = !showMrrTable"
                        class="text-xs font-medium text-zinc-500 hover:text-zinc-200 underline underline-offset-2">
                    <span x-text="showMrrTable ? 'Voir le graphique' : 'Voir en tableau'"></span>
                </button>
            </div>

            <!-- Graphique -->
            <div x-show="!showMrrTable" class="relative" x-on:mouseleave="hoverIndex = null">
                <svg viewBox="0 0 560 180" class="w-full h-44" preserveAspectRatio="none" aria-hidden="true">
                    <!-- Lignes de grille horizontales (hairline, recessive) -->
                    <template x-for="gy in [20, 65, 110, 155]" :key="gy">
                        <line x1="0" :y1="gy" x2="560" :y2="gy" stroke="#2c2c2a" stroke-width="1" />
                    </template>

                    <!-- Aire (10% opacité) -->
                    <path :d="mrrAreaPath()" fill="#38bdf8" fill-opacity="0.1" stroke="none"></path>
                    <!-- Ligne (2px) -->
                    <path :d="mrrLinePath()" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>

                    <!-- Points cliquables (cible de survol ≥ 24px via cercle transparent) -->
                    <template x-for="(pt, i) in mrrPoints()" :key="i">
                        <g>
                            <circle :cx="pt.x" :cy="pt.y" r="12" fill="transparent"
                                    x-on:mouseenter="hoverIndex = i" x-on:focus="hoverIndex = i" tabindex="0"></circle>
                            <circle :cx="pt.x" :cy="pt.y" r="4" fill="#38bdf8" stroke="#09090b" stroke-width="2"
                                    x-show="hoverIndex === i"></circle>
                        </g>
                    </template>

                    <!-- Repère vertical -->
                    <line x-show="hoverIndex !== null" :x1="mrrPoints()[hoverIndex ?? 0]?.x" y1="10" :x2="mrrPoints()[hoverIndex ?? 0]?.x" y2="170"
                          stroke="#52525b" stroke-width="1" stroke-dasharray="3 3"></line>

                    <!-- Valeur au dernier point (label direct — le point que raconte le graphique) -->
                    <text :x="mrrPoints().length ? mrrPoints()[mrrPoints().length - 1].x - 4 : 0"
                          :y="mrrPoints().length ? mrrPoints()[mrrPoints().length - 1].y - 10 : 0"
                          text-anchor="end" font-size="11" fill="#e4e4e7" font-weight="600"
                          x-text="mrrSeries.length ? formatCompactXof(mrrSeries[mrrSeries.length - 1].amountXof) : ''"></text>
                </svg>

                <!-- Infobulle -->
                <div x-show="hoverIndex !== null" x-cloak
                     class="pointer-events-none absolute top-0 rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-xs shadow-lg"
                     :style="`left: ${hoverIndex !== null ? Math.min(Math.max((mrrPoints()[hoverIndex].x / 560) * 100, 8), 85) : 0}%`">
                    <p class="text-zinc-400" x-text="hoverIndex !== null ? mrrSeries[hoverIndex].monthLabel : ''"></p>
                    <p class="font-semibold text-white" x-text="hoverIndex !== null ? formatXof(mrrSeries[hoverIndex].amountXof) : ''"></p>
                </div>
            </div>

            <!-- Vue tableau (jumeau accessible du graphique) -->
            <div x-show="showMrrTable" x-cloak class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="text-xs uppercase tracking-wider text-zinc-500 border-b border-zinc-800">
                            <th class="py-2 pr-4">Mois</th>
                            <th class="py-2">MRR</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800">
                        <template x-for="row in mrrSeries" :key="row.monthLabel">
                            <tr>
                                <td class="py-2 pr-4 text-zinc-400" x-text="row.monthLabel"></td>
                                <td class="py-2 text-zinc-100 font-medium" x-text="formatXof(row.amountXof)"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Santé plateforme -->
        <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 backdrop-blur p-5">
            <h2 class="text-sm font-semibold text-zinc-100">Santé de la plateforme</h2>
            <p class="text-xs text-zinc-500 mt-0.5 mb-4">API et base de données PostgreSQL</p>

            <div class="space-y-4">
                <template x-for="meter in healthMeters" :key="meter.label">
                    <div>
                        <div class="flex items-center justify-between text-xs mb-1.5">
                            <span class="flex items-center gap-1.5 text-zinc-400">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-3.5 h-3.5">
                                    <use :href="`#icon-${meter.icon}`"></use>
                                </svg>
                                <span x-text="meter.label"></span>
                            </span>
                            <span class="font-medium" :class="meter.textClass" x-text="meter.valueLabel"></span>
                        </div>
                        <div class="h-1.5 w-full rounded-full" :class="meter.trackClass">
                            <div class="h-1.5 rounded-full" :class="meter.fillClass" :style="`width: ${meter.pct}%`"></div>
                        </div>
                    </div>
                </template>
            </div>

            <div class="mt-5 pt-4 border-t border-zinc-800 flex items-center gap-2 text-xs text-zinc-500">
                <span class="w-1.5 h-1.5 rounded-full" :class="isLoading ? 'bg-zinc-600' : 'bg-emerald-400'"></span>
                <span x-text="isLoading ? 'Vérification…' : 'Dernière vérification à l\'instant'"></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/superadmin-dashboard.js" asp-append-version="true"></script>
}
