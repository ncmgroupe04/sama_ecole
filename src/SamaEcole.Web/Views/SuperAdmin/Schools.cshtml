@{
 ViewData["Title"] = "Établissements";
 Layout = "_SuperAdminLayout";
}

@* Cet écran consomme le VRAI endpoint GET /api/v1/schools (SchoolsController, ticket JGK-B01) — pas
 de démonstration ici, contrairement au tableau de bord. Le plan d'abonnement et le statut de
 paiement de chaque école n'y figurent pas encore (GetSchoolsQuery ne renvoie que les métadonnées
 d'établissement) : à étendre côté Application si ces colonnes deviennent nécessaires.

 Bouton « Infiltrer » : POST /admin/platform/schools/{schoolId}/impersonate
 (ImpersonateSchoolCommand) — voir wwwroot/js/superadmin-schools.js pour le flux complet. *@
<div x-data="superAdminSchools()" x-init="load()">

 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h1 class="text-xl font-semibold text-white">Établissements</h1>
 <p class="text-sm text-zinc-500 mt-1">Tous les établissements inscrits sur la plateforme.</p>
 </div>
 </div>

 <!-- Synthèse -->
 <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
 <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <div class="min-w-0">
 <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Total</p>
 <p class="mt-1 text-2xl font-black text-white" x-text="schools.length"></p>
 </div>
 <div class="w-11 h-11 rounded-full bg-sky-500/15 flex items-center justify-center shrink-0 ml-3">
 <icon name="building" class="w-5 h-5 text-sky-400" />
 </div>
 </div>
 <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <div class="min-w-0">
 <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Actifs</p>
 <p class="mt-1 text-2xl font-black text-emerald-400" x-text="countByStatus('Active')"></p>
 </div>
 <div class="w-11 h-11 rounded-full bg-emerald-500/15 flex items-center justify-center shrink-0 ml-3">
 <icon name="checkmark-circle" class="w-5 h-5 text-emerald-400" />
 </div>
 </div>
 <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <div class="min-w-0">
 <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Suspendus</p>
 <p class="mt-1 text-2xl font-black text-amber-400" x-text="countByStatus('Suspended')"></p>
 </div>
 <div class="w-11 h-11 rounded-full bg-amber-500/15 flex items-center justify-center shrink-0 ml-3">
 <icon name="alert-circle" class="w-5 h-5 text-amber-400" />
 </div>
 </div>
 <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg">
 <div class="min-w-0">
 <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Bloqués</p>
 <p class="mt-1 text-2xl font-black text-rose-400" x-text="countByStatus('Blocked')"></p>
 </div>
 <div class="w-11 h-11 rounded-full bg-rose-500/15 flex items-center justify-center shrink-0 ml-3">
 <icon name="block" class="w-5 h-5 text-rose-400" />
 </div>
 </div>
 </div>

 <!-- Filtres -->
 <div class="flex flex-col sm:flex-row sm:items-center gap-3">
 <div class="relative flex-1 sm:max-w-xs">
 <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-zinc-600">
 <icon name="search" class="w-4 h-4" />
 </span>
 <input type="search" x-model="searchQuery" placeholder="Rechercher un établissement…"
 aria-label="Rechercher un établissement"
 class="w-full rounded-2xl border border-zinc-800 bg-zinc-900 pl-9 pr-3 py-2 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
 </div>

 <div class="flex flex-wrap items-center gap-2">
 <template x-for="option in [
 { value: 'All', label: 'Tous' },
 { value: 'Active', label: 'Actifs' },
 { value: 'Suspended', label: 'Suspendus' },
 { value: 'Blocked', label: 'Bloqués' }
 ]" :key="option.value">
 <button type="button" x-on:click="statusFilter = option.value"
 :class="statusFilter === option.value ? 'bg-sky-500/15 text-sky-400 ring-1 ring-inset ring-sky-500/30' : 'text-zinc-400 border border-zinc-800 hover:bg-zinc-900'"
 class="rounded-2xl px-3 py-1.5 text-xs font-medium transition-colors">
 <span x-text="option.label"></span>
 </button>
 </template>
 </div>
 </div>

 <div x-show="error" x-cloak class="rounded-2xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300" x-text="error"></div>

 <!-- Table (≥ sm) -->
 <div class="hidden sm:block rounded-xl border border-zinc-800 bg-zinc-900/60 backdrop-blur overflow-hidden">
 <div class="overflow-x-auto">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="text-xs uppercase tracking-wider text-zinc-500 border-b border-zinc-800 bg-zinc-950/40">
 <th class="py-3 px-4 font-medium">Établissement</th>
 <th class="py-3 px-4 font-medium">Contact</th>
 <th class="py-3 px-4 font-medium">Statut</th>
 <th class="py-3 px-4 font-medium">Créé le</th>
 <th class="py-3 px-4 font-medium text-right">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-zinc-800/80">
 <template x-if="isLoading">
 <template x-for="i in 4" :key="i">
 <tr><td class="py-3 px-4" colspan="5"><div class="h-4 w-full rounded-xl bg-zinc-800 animate-pulse"></div></td></tr>
 </template>
 </template>

 <tr x-show="!isLoading && filteredSchools.length === 0" x-cloak>
 <td colspan="5" class="py-12 text-center text-sm text-zinc-500">
 Aucun établissement ne correspond à ces filtres.
 </td>
 </tr>

 <template x-for="school in filteredSchools" :key="school.id">
 <tr class="hover:bg-zinc-900 transition-colors">
 <td class="py-3 px-4">
 <p class="font-medium text-zinc-100" x-text="school.name"></p>
 <p class="text-xs text-zinc-500" x-text="school.address || '—'"></p>
 </td>
 <td class="py-3 px-4 text-zinc-400" x-text="school.phone || '—'"></td>
 <td class="py-3 px-4">
 <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium" :class="statusClasses(school.status)" x-text="statusLabel(school.status)"></span>
 </td>
 <td class="py-3 px-4 text-zinc-400 whitespace-nowrap" x-text="formatDate(school.createdAt)"></td>
 <td class="py-3 px-4 text-right whitespace-nowrap">
 <button type="button" x-on:click="openImpersonateConfirm(school)"
 title="Ouvrir une session Directeur pour cet établissement (audité)"
 class="inline-flex items-center gap-1.5 rounded-xl px-2 py-1 text-xs font-medium text-sky-400 hover:text-sky-300 hover:bg-sky-500/10 transition-colors">
 <icon name="eye" class="w-3.5 h-3.5" />
 Infiltrer
 </button>
 <button type="button" x-show="school.status === 'Active'" x-on:click="openStatusConfirm(school, 'Suspended')"
 title="Suspendre cet établissement"
 class="inline-flex items-center gap-1.5 rounded-xl px-2 py-1 text-xs font-medium text-amber-400 hover:text-amber-300 hover:bg-amber-500/10 transition-colors">
 <icon name="alert-circle" class="w-3.5 h-3.5" />
 Suspendre
 </button>
 <button type="button" x-show="school.status !== 'Active'" x-on:click="openStatusConfirm(school, 'Active')"
 title="Réactiver cet établissement"
 class="inline-flex items-center gap-1.5 rounded-xl px-2 py-1 text-xs font-medium text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 transition-colors">
 <icon name="checkmark-circle" class="w-3.5 h-3.5" />
 Réactiver
 </button>
 <button type="button" x-show="school.status !== 'Blocked'" x-on:click="openStatusConfirm(school, 'Blocked')"
 title="Bloquer cet établissement"
 class="inline-flex items-center gap-1.5 rounded-xl px-2 py-1 text-xs font-medium text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition-colors">
 <icon name="block" class="w-3.5 h-3.5" />
 Bloquer
 </button>
 </td>
 </tr>
 </template>
 </tbody>
 </table>
 </div>
 </div>

 <!-- Cartes (< sm) -->
 <div class="sm:hidden space-y-3">
 <template x-if="isLoading">
 <template x-for="i in 3" :key="i">
 <div class="h-24 rounded-xl border border-zinc-800 bg-zinc-900/60 animate-pulse"></div>
 </template>
 </template>

 <p x-show="!isLoading && filteredSchools.length === 0" x-cloak class="py-8 text-center text-sm text-zinc-500">
 Aucun établissement ne correspond à ces filtres.
 </p>

 <template x-for="school in filteredSchools" :key="school.id">
 <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-6">
 <div class="flex items-start justify-between gap-3">
 <div class="min-w-0">
 <p class="font-medium text-zinc-100 truncate" x-text="school.name"></p>
 <p class="text-xs text-zinc-500 mt-0.5" x-text="school.address || '—'"></p>
 </div>
 <span class="shrink-0 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium" :class="statusClasses(school.status)" x-text="statusLabel(school.status)"></span>
 </div>
 <div class="mt-3 flex items-center justify-between text-xs text-zinc-500">
 <span x-text="school.phone || '—'"></span>
 <span x-text="formatDate(school.createdAt)"></span>
 </div>
 </div>
 </template>
 </div>

 @* Confirmation « Infiltrer » — action à fort impact (bascule toute la session sur l'identité du
 Directeur ciblé), d'où une confirmation explicite plutôt qu'un simple clic comme pour Relancer. *@
 <div x-show="impersonateTarget" x-cloak
 class="fixed inset-0 z-40 flex items-center justify-center bg-black/70 backdrop-blur-sm px-4"
 x-on:keydown.escape.window="closeImpersonateConfirm()">
 <div class="w-full max-w-md rounded-xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl">
 <h2 class="text-base font-semibold text-white">Infiltrer un établissement</h2>
 <p class="mt-2 text-sm text-zinc-400">
 Vous allez ouvrir une session Directeur pour
 <span class="font-medium text-zinc-100" x-text="impersonateTarget ? impersonateTarget.name : ''"></span>.
 Cette action est journalisée dans le journal d'audit de cet établissement. La session
 expire automatiquement au bout de 15 minutes.
 </p>

 <div x-show="impersonateError" x-cloak class="mt-3 rounded-2xl border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-xs text-rose-300" x-text="impersonateError"></div>

 <div class="mt-6 flex justify-end gap-3">
 <button type="button" x-on:click="closeImpersonateConfirm()" :disabled="isImpersonating"
 class="rounded-2xl border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors disabled:opacity-50">
 Annuler
 </button>
 <button type="button" x-on:click="confirmImpersonate()" :disabled="isImpersonating"
 class="rounded-2xl bg-sky-500 px-3 py-2 text-sm font-medium text-white hover:bg-sky-400 transition-colors disabled:opacity-50">
 <span x-text="isImpersonating ? 'Ouverture…' : 'Confirmer'"></span>
 </button>
 </div>
 </div>
 </div>

 @* Confirmation changement de statut — motif obligatoire (même exigence que la suspension d'un
 compte utilisateur, ChangeUserStatusCommandValidator) : l'historique doit rester exploitable des
 mois plus tard. *@
 <div x-show="statusTarget" x-cloak
 class="fixed inset-0 z-40 flex items-center justify-center bg-black/70 backdrop-blur-sm px-4"
 x-on:keydown.escape.window="closeStatusConfirm()">
 <div class="w-full max-w-md rounded-xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl">
 <h2 class="text-base font-semibold text-white" x-text="statusModalTitle()"></h2>
 <p class="mt-2 text-sm text-zinc-400">
 <span x-text="statusTarget ? statusTarget.name : ''" class="font-medium text-zinc-100"></span>
 <template x-if="statusTarget && statusTarget.newStatus !== 'Active'">
 <span> — toutes les sessions ouvertes de cet établissement seront immédiatement révoquées.</span>
 </template>
 </p>

 <label class="mt-4 block text-xs font-medium uppercase tracking-wider text-zinc-500">Motif (obligatoire)</label>
 <textarea x-model="statusReason" rows="3" placeholder="Ex. Impayé constaté, fermeture administrative…"
 class="mt-1.5 w-full rounded-2xl border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"></textarea>

 <div x-show="statusError" x-cloak class="mt-3 rounded-2xl border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-xs text-rose-300" x-text="statusError"></div>

 <div class="mt-6 flex justify-end gap-3">
 <button type="button" x-on:click="closeStatusConfirm()" :disabled="isChangingStatus"
 class="rounded-2xl border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors disabled:opacity-50">
 Annuler
 </button>
 <button type="button" x-on:click="confirmStatusChange()" :disabled="isChangingStatus"
 class="rounded-2xl bg-sky-500 px-3 py-2 text-sm font-medium text-white hover:bg-sky-400 transition-colors disabled:opacity-50">
 <span x-text="isChangingStatus ? 'Application…' : 'Confirmer'"></span>
 </button>
 </div>
 </div>
 </div>
</div>

@section Scripts {
 <script src="~/js/superadmin-schools.js" asp-append-version="true"></script>
}
