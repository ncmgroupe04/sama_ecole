root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json}]
indent_size = 2

[*.{cshtml,html,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Style C# ---
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_prefer_braces = true:warning

# --- Nommage (aligné sur docs/Volume_6_Dev_Guide.md §3) ---
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style

dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case_style

dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

# --- Using directives ---
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# --- Qualité ---
dotnet_diagnostic.CS8618.severity = warning   # non-nullable non initialisé
# ConfigureAwait : désactivé pour toute la solution. ASP.NET Core n'installe aucun
# SynchronizationContext (ConfigureAwait(false) n'y change rien), et dans les tests xUnit il est
# même déconseillé (xUnit1030). Il n'était ignoré que dans Application et Web (NoWarn) : ailleurs il
# produisait ~1 800 avertissements sans valeur qui noyaient les vrais.
dotnet_diagnostic.CA2007.severity = none
