@{
    ViewData["Title"] = "Fiscalité";
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
    <script src="~/js/taxes.js" asp-append-version="true"></script>
}

<div x-data="taxesView()" class="space-y-6">
    <!-- ===================== En-tête + sélecteur de période ===================== -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div>
            <h1 class="text-jgk-title font-bold text-slate-900">Fiscalité</h1>
            <p class="text-jgk-subtitle text-slate-500 mt-1">Déclarations mensuelles VRS / IPRES / CSS / BRS et TVA.</p>
        </div>
        <div class="flex flex-wrap items-end gap-3">
            <div class="w-44">
                <label class="block text-[11px] font-bold tracking-wider text-slate-400 uppercase mb-1">Mois</label>
                <select-field model="periodMonth" placeholder="Mois" aria-label="Mois de la période fiscale"
                    on-change="onPeriodChange()" class="!mt-0"
                    options-expr="monthOptions()" />
            </div>
            <div class="w-36">
                <label class="block text-[11px] font-bold tracking-wider text-slate-400 uppercase mb-1">Année fiscale</label>
                <select-field model="periodYear" placeholder="Année" aria-label="Année fiscale"
                    on-change="onYearChange()" class="!mt-0"
                    options-expr="yearOptions()" />
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- ===================== Récapitulatif : cartes KPI de la période ===================== -->
    <div>
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-semibold text-slate-700">Récapitulatif</h2>
            <span class="text-xs font-medium" :class="selectedDeclaration ? 'text-slate-500' : 'text-amber-600'"
                  x-text="selectedDeclaration ? periodLabel() : periodLabel() + ' — aucune déclaration générée'"></span>
        </div>

        <!-- Ligne 1 : cotisations sociales & retraite -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex items-center justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">IPRES</p>
                    <p class="text-2xl font-black text-indigo-600 mt-1" x-text="amountOf('totalIpres')"></p>
                    <p class="text-xs text-slate-500 mt-1">Retraite — part salariale + patronale</p>
                </div>
                <div class="w-11 h-11 rounded-full bg-indigo-50 flex items-center justify-center shrink-0 ml-3">
                    <icon name="shield" class="w-5 h-5 text-indigo-600" />
                </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex items-center justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">CSS</p>
                    <p class="text-2xl font-black text-blue-600 mt-1" x-text="amountOf('totalCss')"></p>
                    <p class="text-xs text-slate-500 mt-1">Caisse de Sécurité Sociale</p>
                </div>
                <div class="w-11 h-11 rounded-full bg-blue-50 flex items-center justify-center shrink-0 ml-3">
                    <icon name="users" class="w-5 h-5 text-blue-600" />
                </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex items-center justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">VRS</p>
                    <p class="text-2xl font-black text-slate-800 mt-1" x-text="amountOf('totalVrs')"></p>
                    <p class="text-xs text-slate-500 mt-1">Versement représentatif de l'impôt</p>
                </div>
                <div class="w-11 h-11 rounded-full bg-indigo-50/70 flex items-center justify-center shrink-0 ml-3">
                    <icon name="document" class="w-5 h-5 text-slate-500" />
                </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex items-center justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">BRS</p>
                    <p class="text-2xl font-black text-purple-600 mt-1" x-text="amountOf('totalBrs')"></p>
                    <p class="text-xs text-slate-500 mt-1">Retenue à la source sur salaires</p>
                </div>
                <div class="w-11 h-11 rounded-full bg-purple-50 flex items-center justify-center shrink-0 ml-3">
                    <icon name="percent" class="w-5 h-5 text-purple-600" />
                </div>
            </div>
        </div>

        <!-- Ligne 2 : TVA & synthèse État -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-4">
            <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex items-center justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">TVA collectée</p>
                    <p class="text-2xl font-black text-amber-600 mt-1" x-text="amountOf('tvaCollected')"></p>
                    <p class="text-xs text-slate-500 mt-1">Facturée sur la période</p>
                </div>
                <div class="w-11 h-11 rounded-full bg-amber-50 flex items-center justify-center shrink-0 ml-3">
                    <icon name="arrow-up" class="w-5 h-5 text-amber-600" />
                </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex items-center justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">TVA déductible</p>
                    <p class="text-2xl font-black text-emerald-600 mt-1" x-text="amountOf('tvaDeductible')"></p>
                    <p class="text-xs text-slate-500 mt-1">Récupérable sur les achats</p>
                </div>
                <div class="w-11 h-11 rounded-full bg-emerald-50 flex items-center justify-center shrink-0 ml-3">
                    <icon name="arrow-down" class="w-5 h-5 text-emerald-600" />
                </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex items-center justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">TVA nette</p>
                    <p class="text-2xl font-black text-indigo-600 mt-1" x-text="amountOf('netTva')"></p>
                    <p class="text-xs text-slate-500 mt-1">Collectée − déductible</p>
                </div>
                <div class="w-11 h-11 rounded-full bg-blue-50 flex items-center justify-center shrink-0 ml-3">
                    <icon name="payment" class="w-5 h-5 text-blue-600" />
                </div>
            </div>

            <div class="bg-indigo-50/50 rounded-2xl p-5 border border-indigo-100 shadow-sm hover:shadow-md transition-all flex items-center justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold tracking-wider text-indigo-400 uppercase">Total dû à l'État</p>
                    <p class="text-3xl font-black text-indigo-700 mt-1" x-text="amountOf('totalDueToState')"></p>
                    <p class="text-xs text-slate-500 mt-1">VRS + BRS + TVA nette</p>
                </div>
                <div class="w-11 h-11 rounded-full bg-indigo-600/10 flex items-center justify-center shrink-0 ml-3">
                    <icon name="building" class="w-5 h-5 text-indigo-700" />
                </div>
            </div>
        </div>

        <template x-if="!isLoading && !selectedDeclaration">
            <div class="card p-6 mt-4">
                <empty-state icon="document" title="Aucune déclaration pour cette période."
                    hint="Générez une déclaration pour un mois où des fiches de paie existent." />
            </div>
        </template>
    </div>

    <!-- ===================== Historique des déclarations ===================== -->
    <div class="card">
        <div class="p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <p class="text-sm font-semibold text-slate-900">Historique des déclarations</p>
                <p class="text-xs text-slate-500 mt-0.5">Année fiscale <span class="font-semibold text-slate-700" x-text="periodYear"></span> — filtrée par le sélecteur en haut de page.</p>
            </div>
            <button type="button" x-on:click="openTaxModal()" class="btn-primary">
                <icon name="plus" class="w-4 h-4" />
                Générer une déclaration
            </button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="table-head">
                        <th class="py-3 px-4 uppercase tracking-wider text-slate-500 font-semibold">Période</th>
                        <th class="py-3 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">IPRES</th>
                        <th class="py-3 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">CSS</th>
                        <th class="py-3 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">VRS</th>
                        <th class="py-3 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">BRS</th>
                        <th class="py-3 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">TVA nette</th>
                        <th class="py-3 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">Total dû à l'État</th>
                        <th class="py-3 px-4 text-right uppercase tracking-wider text-slate-500 font-semibold">État synthétique</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr x-show="!isLoading && taxDeclarations.length === 0" x-cloak>
                        <td colspan="8">
                            <empty-state icon="document" title="Aucune déclaration sur cette année."
                                hint="Générez une déclaration pour un mois où des fiches de paie existent." />
                        </td>
                    </tr>
                    <template x-for="declaration in taxDeclarations" :key="declaration.id">
                        <tr class="hover:bg-slate-50 transition-colors"
                            :class="declaration.month === Number(periodMonth) ? 'bg-indigo-50/40' : ''">
                            <td class="py-3 px-4 font-medium text-slate-900" x-text="monthLabel(declaration.month) + ' ' + declaration.year"></td>
                            <td class="py-3 px-4 text-right text-slate-600" x-text="formatAmount(declaration.totalIpres)"></td>
                            <td class="py-3 px-4 text-right text-slate-600" x-text="formatAmount(declaration.totalCss)"></td>
                            <td class="py-3 px-4 text-right text-slate-600" x-text="formatAmount(declaration.totalVrs)"></td>
                            <td class="py-3 px-4 text-right text-slate-600" x-text="formatAmount(declaration.totalBrs)"></td>
                            <td class="py-3 px-4 text-right text-slate-600" x-text="formatAmount(declaration.netTva)"></td>
                            <td class="py-3 px-4 text-right font-semibold text-slate-900" x-text="formatAmount(declaration.totalDueToState)"></td>
                            <td class="py-3 px-4 text-right">
                                <button type="button" x-on:click="downloadDeclarationPdf(declaration.id)" :disabled="downloadingPdfId === declaration.id"
                                        class="btn-secondary inline-flex items-center gap-2 disabled:opacity-60">
                                    <icon name="download" class="w-4 h-4" x-show="downloadingPdfId !== declaration.id" />
                                    <icon name="loader" class="w-4 h-4 animate-spin" x-show="downloadingPdfId === declaration.id" x-cloak />
                                    <span x-text="downloadingPdfId === declaration.id ? 'Génération...' : 'PDF'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===================== Modale : Générer une déclaration fiscale ===================== -->
    <modal-shell open="isTaxModalOpen" title="Générer une déclaration fiscale">
        <form x-on:submit.prevent="submitTaxDeclaration()" novalidate class="space-y-5">
            <p class="text-sm text-slate-500">Agrège les charges sociales de toutes les fiches de paie du mois choisi, ainsi que la TVA collectée/déductible de la période.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700">Mois</label>
                    <select-field model="taxForm.month" placeholder="Sélectionnez un mois..."
                        options-expr="[{value:1,label:'Janvier'},{value:2,label:'Février'},{value:3,label:'Mars'},{value:4,label:'Avril'},{value:5,label:'Mai'},{value:6,label:'Juin'},{value:7,label:'Juillet'},{value:8,label:'Août'},{value:9,label:'Septembre'},{value:10,label:'Octobre'},{value:11,label:'Novembre'},{value:12,label:'Décembre'}]" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">Année</label>
                    <input type="number" x-model="taxForm.year" class="input-field mt-1" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" x-on:click="isTaxModalOpen = false" class="btn-secondary">Annuler</button>
                <button type="submit" class="btn-primary" :disabled="isGeneratingTax">
                    <span x-show="!isGeneratingTax">Générer</span>
                    <span x-show="isGeneratingTax">Génération...</span>
                </button>
            </div>
        </form>
    </modal-shell>
</div>
