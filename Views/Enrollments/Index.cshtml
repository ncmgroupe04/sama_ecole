@{
 ViewData["Title"] = "Inscriptions";
 var genderOptions = new List<SelectFieldOption> { new("M", "Masculin"), new("F", "Féminin") };
}

@* auth.js et api.js sont chargés par _Layout : les inclure ici les exécuterait une seconde fois. *@
@section Scripts {
 <script src="~/js/enrollments.js" asp-append-version="true"></script>
}

@* Impression du seul reçu : on masque tout le reste de l'application (barre latérale, formulaire,
 barre d'actions) plutôt que d'ouvrir une fenêtre séparée. La règle visibility:hidden conserve la
 mise en page ; le reçu, remis en absolu en haut de page, s'imprime seul.

 Format A5 PAYSAGE (210 × 148 mm). La feuille est déclarée à l'imprimante par @@page, et le bloc
 reçoit exactement les mêmes dimensions à l'écran : l'aperçu est alors fidèle au papier, et le
 débordement sur une 2e page se voit AVANT d'imprimer. Marges de 8 mm côté @@page, le reçu n'ayant
 pas de padding propre à l'impression — les deux se cumuleraient sinon. *@
<style>
    .receipt-a5 {
        width: 210mm;
        min-height: 148mm;
        height: 148mm;
        padding: 8mm;
        font-family: 'Inter', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    @@page {
        size: A5 landscape;
        margin: 5mm;
    }

    @@media print {
        /* Éviter le débordement sur 2 pages */
        body, html, .receipt-container, #receipt-printable, .receipt-a5 {
            height: auto !important;
            max-height: 100vh !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        /* Masquer les boutons et éléments inutiles sur le papier */
        body * { visibility: hidden !important; }
        .no-print, button, .btn, .nav-bar, header, nav, aside, footer { display: none !important; }

        #receipt-printable, #receipt-printable * { visibility: visible !important; }
        #receipt-printable {
            position: absolute !important; left: 0 !important; top: 0 !important;
            width: 100% !important; max-width: 210mm !important;
            height: auto !important; max-height: 140mm !important; min-height: auto !important;
            margin: 0 !important; padding: 4mm 6mm !important;
            box-shadow: none !important; border: 0 !important;
            display: flex !important; flex-direction: column !important; justify-content: space-between !important;
            overflow: hidden !important;
            break-inside: avoid !important; page-break-inside: avoid !important;
        }

        /* Réduction des marges/paddings pour le format A4/A5 */
        .receipt-header, .receipt-footer {
            margin-top: 5px !important;
            margin-bottom: 5px !important;
        }
        .receipt-header {
            padding-bottom: 4px !important;
        }
        .receipt-footer {
            padding-top: 4px !important;
        }

        table td, table th {
            padding: 4px 8px !important;
        }

        #receipt-printable .my-3 { margin-top: 4px !important; margin-bottom: 4px !important; }
        #receipt-printable .grid.gap-6 { gap: 10px !important; }
        #receipt-printable .space-y-3 > * + * { margin-top: 4px !important; }
        #receipt-printable .mb-3 { margin-bottom: 3px !important; }
        #receipt-printable .mt-12 { margin-top: 14px !important; }
    }
</style>

<div x-data="enrollmentsView()">
 <!-- Titre -->
 <div>
 <h1 class="text-jgk-title font-bold text-slate-900">Inscriptions</h1>
 <p class="text-jgk-subtitle text-slate-500 mt-1">
 Inscrivez un nouvel élève ou réinscrivez un élève existant pour l'année scolaire active.
 Les frais dus sont calculés automatiquement à partir du barème de la classe.
 </p>
 </div>

 <!-- Rôle non autorisé : le service Finance encaisse, il ne compose pas le montant dû (règle #4). -->
 <div x-show="!canEnroll" x-cloak class="mt-6 card py-12 text-center">
 <p class="text-slate-500 font-medium">Seuls le Directeur et le Secrétariat peuvent inscrire un élève.</p>
 <p class="text-xs text-slate-400 mt-1">Vous pouvez consulter un reçu depuis la fiche d'un élève.</p>
 </div>

 <div x-show="canEnroll" x-cloak>

 <!-- Chargement -->
 <div x-show="isLoading" class="mt-6 flex items-center justify-center py-12">
 <svg aria-hidden="true" class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 </div>

 @await Html.PartialAsync("_ErrorBanner")

 <!-- Aucune année active : rien à rattacher, on bloque l'inscription. -->
 <div x-show="!isLoading && !error && !activeYear" x-cloak class="mt-6 rounded-xl border-l-4 border-warning bg-warning-bg p-6">
 <p class="text-sm font-medium text-warning">Aucune année scolaire active.</p>
 <p class="text-xs text-warning mt-1">
 Activez une année scolaire (<a href="/parametres?tab=annees-scolaires" class="underline font-medium">Paramètres › Années scolaires</a>) avant d'inscrire un élève.
 </p>
 </div>

 <!-- ============================= FORMULAIRE + APERÇU ============================= -->
 <div x-show="!isLoading && !error && activeYear && !showReceipt" x-cloak class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">

 <!-- Colonne formulaire -->
 <div class="lg:col-span-2 card p-6 space-y-6">

 <!-- Bandeau année active -->
 <div class="flex items-center gap-2 text-sm text-slate-500">
 <badge variant="success">Année active</badge>
 <span class="font-medium text-slate-900" x-text="activeYear ? activeYear.label : ''"></span>
 </div>

 <!-- Choix du mode -->
 <div>
 <span class="block text-sm font-medium text-slate-700 mb-2">Type de mouvement</span>
 <div class="inline-flex rounded-2xl border border-slate-300 p-0.5 bg-slate-50">
 <button type="button" x-on:click="selectMode('NewEnrollment')"
 class="px-4 py-1.5 text-sm font-medium rounded-xl transition-colors"
 :class="mode === 'NewEnrollment' ? 'bg-white text-primary shadow-sm' : 'text-slate-500 hover:text-slate-700'">
 Nouvelle inscription
 </button>
 <button type="button" x-on:click="selectMode('ReEnrollment')"
 class="px-4 py-1.5 text-sm font-medium rounded-xl transition-colors"
 :class="mode === 'ReEnrollment' ? 'bg-white text-primary shadow-sm' : 'text-slate-500 hover:text-slate-700'">
 Réinscription
 </button>
 </div>
 </div>

 <!-- Bandeau de restauration de brouillon -->
 <div x-show="hasDraft" x-cloak class="rounded-xl border border-amber-300 bg-amber-50 p-4 mb-4 text-amber-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
 <div class="flex items-center gap-3">
 <icon name="alert-circle" class="w-5 h-5 text-amber-600 shrink-0" />
 <p class="text-xs sm:text-sm">
 <strong class="font-semibold">Saisie en attente :</strong> Un formulaire non validé ou interrompu hors ligne a été retrouvé en mémoire.
 </p>
 </div>
 <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
 <button type="button" x-on:click="restoreDraft()" class="px-3 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold shadow-2xs transition-colors">
 Restaurer
 </button>
 <button type="button" x-on:click="clearDraft()" class="px-3 py-1.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-800 text-xs font-semibold transition-colors">
 Effacer
 </button>
 </div>
 </div>

 <form x-on:submit.prevent="submit()" novalidate class="space-y-5">

 <!-- Erreur métier globale -->
 <div x-show="formErrors.global" x-cloak class="rounded-xl border-l-4 border-danger bg-danger-bg p-3 text-sm text-danger" x-text="formErrors.global"></div>
 <div x-show="formErrors.schoolyear" x-cloak class="rounded-xl border-l-4 border-warning bg-warning-bg p-3 text-sm text-warning" x-text="formErrors.schoolyear"></div>

 <!-- Classe -->
 <div>
 <label for="enr-classroom" class="block text-sm font-medium text-slate-700">Classe d'affectation <span class="text-danger">*</span></label>
 @* on-change : les frais diffèrent d'une classe à l'autre — la sélection d'encaissement est
 recomposée sur le barème de la nouvelle classe (voir resetCollected). *@
 <select-field id="enr-classroom" model="form.classroomId" required="true"
 placeholder="— Choisir une classe —" on-change="resetCollected()"
 options-expr="[{value:'', label:'— Choisir une classe —'}].concat(classrooms.map(c => ({value: c.id, label: classroomLabel(c)})))" />
 <p x-show="formErrors.classroomid" x-cloak x-text="formErrors.classroomid" class="mt-1 text-xs text-danger"></p>
 <p x-show="classrooms.length === 0" x-cloak class="mt-1 text-xs text-slate-400">
 Aucune classe définie. Créez vos classes avant d'inscrire (<a href="/classes" class="underline">Classes</a>).
 </p>
 </div>

 <!-- Classe redoublée (feature F) : coche portée par l'inscription, cochée [X] sur le
 bulletin (Enrollment.IsRepeating). Vaut pour une nouvelle inscription comme pour une
 réinscription — un élève peut redoubler qu'il soit nouveau dans l'école ou non. -->
 <label class="flex items-start gap-2.5 cursor-pointer select-none">
 <input type="checkbox" x-model="form.isRepeating"
 class="mt-0.5 h-4 w-4 rounded-xl border-slate-300 text-primary focus:ring-primary transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <span class="text-sm text-slate-700">
 Classe redoublée
 <span class="block text-xs text-slate-400">L'élève redouble cette classe — la case sera cochée sur son bulletin.</span>
 </span>
 </label>

 <!-- Nouvelle inscription : état civil de l'élève -->
 <div x-show="mode === 'NewEnrollment'" x-cloak class="space-y-5">
 <div>
 <label for="enr-fullname" class="block text-sm font-medium text-slate-700">Nom complet de l'élève <span class="text-danger">*</span></label>
 <input id="enr-fullname" type="text" x-model="form.fullName" maxlength="200" placeholder="ex : Awa Ndiaye" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="formErrors.fullname" x-cloak x-text="formErrors.fullname" class="mt-1 text-xs text-danger"></p>
 </div>
 <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
 <div>
 <label for="enr-birthdate" class="block text-sm font-medium text-slate-700">Date de naissance <span class="text-danger">*</span></label>
 <date-field id="enr-birthdate" model="form.birthDate" />
 <p x-show="formErrors.birthdate" x-cloak x-text="formErrors.birthdate" class="mt-1 text-xs text-danger"></p>
 </div>
 <div>
 <label for="enr-gender" class="block text-sm font-medium text-slate-700">Genre <span class="text-danger">*</span></label>
 <select-field id="enr-gender" model="form.gender" options="genderOptions" />
 <p x-show="formErrors.gender" x-cloak x-text="formErrors.gender" class="mt-1 text-xs text-danger"></p>
 </div>
 </div>
 <div>
 <label for="enr-birthplace" class="block text-sm font-medium text-slate-700">Lieu de naissance <span class="text-danger">*</span></label>
 <input id="enr-birthplace" type="text" x-model="form.birthPlace" maxlength="200" placeholder="ex : Dakar" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="formErrors.birthplace" x-cloak x-text="formErrors.birthplace" class="mt-1 text-xs text-danger"></p>
 </div>
 <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
 <div>
 <label for="enr-guardian" class="block text-sm font-medium text-slate-700">Nom du tuteur</label>
 <input id="enr-guardian" type="text" x-model="form.guardianName" maxlength="200" placeholder="Parent / tuteur" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 </div>
 <div>
 <label for="enr-guardian-phone" class="block text-sm font-medium text-slate-700">Téléphone du tuteur</label>
 <input id="enr-guardian-phone" type="tel" x-model="form.guardianPhone" maxlength="30" placeholder="77 000 00 00" class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 </div>
 </div>
 </div>

 <!-- Réinscription : sélection d'un élève existant -->
 <div x-show="mode === 'ReEnrollment'" x-cloak>
 <label for="enr-student-search" class="block text-sm font-semibold text-slate-700">Élève à réinscrire <span class="text-danger">*</span></label>
 <input id="enr-student-search" type="text" x-model="studentSearch" placeholder="Rechercher par nom ou matricule…"
 x-on:input="form.studentId = ''"
 class="input-field transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <p x-show="formErrors.studentid" x-cloak x-text="formErrors.studentid" class="mt-1 text-xs text-danger"></p>

 <div class="mt-2 border border-slate-200 rounded-xl divide-y divide-slate-100 max-h-56 overflow-y-auto">
 <template x-for="s in filteredStudents()" :key="s.id">
 <button type="button" x-on:click="selectStudent(s)"
 class="w-full text-left px-3 py-2 hover:bg-slate-50 flex items-center justify-between transition-colors transition-all duration-200 ease-in-out transition-all duration-200 ease-in-out"
 :class="form.studentId === s.id ? 'bg-indigo-50' : ''">
 <span class="text-sm text-slate-900" x-text="s.fullName"></span>
 <span class="text-xs font-mono text-slate-500" x-text="s.matricule"></span>
 </button>
 </template>
 <div x-show="studentsLoaded && filteredStudents().length === 0" x-cloak class="px-3 py-4 text-sm text-slate-400 text-center">
 Aucun élève ne correspond.
 </div>
 <div x-show="!studentsLoaded" class="px-3 py-4 text-sm text-slate-400 text-center">Chargement des élèves…</div>
 </div>
 </div>

 <!-- Soumission -->
 <div class="pt-2 flex justify-end border-t border-slate-100">
 <button type="submit" :disabled="!canSubmit()" class="btn-primary mt-4">
 <icon x-show="!isSubmitting" name="checkmark-circle" class="w-5 h-5" />
 <span x-text="isSubmitting ? 'Enregistrement…' : 'Inscrire l\'élève'"></span>
 </button>
 </div>
 </form>
 </div>

 <!-- Colonne aperçu des frais -->
 <div class="lg:col-span-1">
 <div class="card p-5 lg:sticky lg:top-4">
 <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider">Frais &amp; encaissement</h2>
 <p class="text-xs text-slate-400 mt-0.5">Cochez ce qui est réglé au guichet. Le serveur fait foi à l'enregistrement.</p>

 <!-- Pas de classe -->
 <div x-show="!form.classroomId" x-cloak class="py-8 text-center">
 <p class="text-sm text-slate-400">Sélectionnez une classe pour voir les frais.</p>
 </div>

 <!-- Classe sans barème -->
 <div x-show="form.classroomId && !hasFeesForSelectedClass()" x-cloak class="py-8 text-center">
 <p class="text-sm text-slate-500 font-medium">Aucun barème défini pour cette classe.</p>
 <p class="text-xs text-slate-400 mt-1">Le montant dû sera de 0 FCFA. Paramétrez les frais dans <a href="/frais" class="underline">Finance</a>.</p>
 </div>

 @* Détail du dû annuel ET encaissement du jour, au même endroit : la case cochée dit
 « ce frais est réglé maintenant », le reste alimentera la Caisse plus tard. Seul le
 total ENCAISSÉ partira sur le reçu (pièce comptable), le dû annuel n'y est qu'un rappel. *@
 <div x-show="form.classroomId && hasFeesForSelectedClass()" x-cloak class="mt-4">
 <ul class="divide-y divide-slate-100">
 <template x-for="line in previewLines()" :key="line.feeCategoryId">
 <li class="py-2.5">
 <label class="flex items-start justify-between gap-3 cursor-pointer select-none">
 <span class="flex items-start gap-2.5 min-w-0">
 <input type="checkbox" x-model="collectedEntry(line).checked"
 class="mt-0.5 h-4 w-4 shrink-0 rounded-xl border-slate-300 text-primary focus:ring-primary transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <span class="min-w-0">
 <span class="block text-sm text-slate-800" x-text="line.designation"></span>
 <span x-show="line.isRecurring" x-cloak class="block text-xs text-slate-400"
 x-text="formatMoney(line.unitAmount) + ' × ' + line.months + ' mois'"></span>
 </span>
 </span>
 <span class="text-sm font-medium text-slate-900 whitespace-nowrap" x-text="formatMoney(line.lineTotal)"></span>
 </label>

 @* Mensualité : le tuteur règle rarement l'année entière le jour de l'inscription —
 il choisit le nombre de mois d'avance qu'il paie (1 par défaut). *@
 <div x-show="line.isRecurring && collectedEntry(line).checked" x-cloak
 class="mt-2 ml-7 flex items-center gap-2">
 <label class="text-xs text-slate-500" :for="'enr-months-' + line.feeCategoryId">Mois réglés</label>
 <input type="number" :id="'enr-months-' + line.feeCategoryId"
 x-model.number="collectedEntry(line).months" min="1" :max="line.months"
 class="input-field mt-0 w-20 py-1 text-sm transition-all duration-200 focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">
 <span class="text-xs text-slate-400" x-text="'= ' + formatMoney(collectedAmount(line))"></span>
 </div>
 </li>
 </template>
 </ul>

 <div class="mt-3 pt-3 border-t border-slate-200 flex items-center justify-between text-slate-500">
 <span class="text-xs uppercase tracking-wide">Total dû (année)</span>
 <span class="text-sm font-semibold" x-text="formatMoney(previewTotal())"></span>
 </div>

 <div class="mt-4 rounded-xl bg-primary-50 p-3">
 <label for="enr-payment-method" class="block text-xs font-medium text-primary-700">Mode de règlement</label>
 <select-field id="enr-payment-method" model="paymentMethod" class="mt-1"
 options-expr="[{value:'Cash', label:'Espèces'}, {value:'Cheque', label:'Chèque'}, {value:'Transfer', label:'Virement'}, {value:'MobileMoney', label:'Mobile Money'}]" />

 <div class="mt-3 flex items-center justify-between">
 <span class="text-sm font-semibold text-primary-700 uppercase tracking-wide">Encaissé ce jour</span>
 <span class="text-lg font-bold text-primary" x-text="formatMoney(collectedTotal())"></span>
 </div>
 <p x-show="collectedTotal() === 0" x-cloak class="mt-1 text-xs text-primary-700">
 Aucun frais coché : le dossier est ouvert sans versement, le reçu s'imprimera à 0 FCFA.
 </p>
 <p x-show="collectedTotal() > 0" x-cloak class="mt-1 text-xs text-primary-700"
 x-text="'Reste à payer après ce versement : ' + formatMoney(previewTotal() - collectedTotal())"></p>
 </div>
 </div>
 </div>
 </div>
 </div>

 <!-- ============================= REÇU ============================= -->
 <div x-show="showReceipt" x-cloak class="mt-6">

 <!-- Barre d'actions (non imprimée) -->
 <div class="no-print flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
 <div class="flex items-center gap-2 text-success">
 <icon name="checkmark-circle" class="w-6 h-6" />
 <span class="text-sm font-medium">Inscription enregistrée.</span>
 </div>
 <div class="flex flex-wrap items-center gap-2">
 <button type="button" x-on:click="closeReceipt()" class="btn-secondary">
 Retour (Fermer)
 </button>
 <button type="button" x-on:click="startNewEnrollment()" class="btn-secondary">
 Nouvelle inscription
 </button>
 <button type="button" x-on:click="downloadPdf()" class="btn-secondary">
 <icon name="document-text" class="w-5 h-5 text-indigo-600" />
 Aperçu Reçu (PDF)
 </button>
 <button type="button" x-on:click="downloadCertificatePdf()" class="btn-secondary">
 <icon name="document-text" class="w-5 h-5 text-primary" />
 Certificat de Scolarité (PDF)
 </button>
 <button type="button" x-on:click="printReceipt()" class="btn-primary">
 <icon name="print" class="w-5 h-5" />
 Imprimer
 </button>
 </div>
 </div>

 @* Document imprimable A5 PAYSAGE : sobre, moderne, aux normes officielles *@
 <div id="receipt-printable" class="receipt-a5 receipt-container bg-white border border-slate-200/80 mx-auto text-slate-800 shadow-sm rounded-xl flex flex-col justify-between min-h-[148mm]">

 <!-- A. En-tête Institutionnel (Header) -->
 <div class="receipt-header flex items-start justify-between gap-4 border-b border-slate-200 pb-3">
 <div class="min-w-0">
 <h2 class="text-lg font-bold text-slate-900 uppercase tracking-tight" x-text="receipt.schoolName"></h2>
 <p class="text-xs text-slate-500 mt-1" x-text="contactLine()"></p>
 <p x-show="legalMentions()" x-cloak class="text-xs text-slate-500 mt-0.5" x-text="legalMentions()"></p>
 </div>
 <div class="shrink-0 flex items-center justify-end">
 <img x-show="receipt.schoolLogoUrl" :src="receipt.schoolLogoUrl" class="max-h-14 object-contain" alt="Logo" />
 <div x-show="!receipt.schoolLogoUrl" class="h-14 w-14 border border-dashed border-slate-300 rounded-lg flex items-center justify-center text-[9px] text-slate-400 font-medium">Logo</div>
 </div>
 </div>

 <!-- B. Titre & Identifiant du Reçu -->
 <div class="my-3 flex justify-center">
 <div class="text-sm font-semibold tracking-wide text-slate-700 bg-slate-100 px-3 py-1 rounded-md border border-slate-200/60 shadow-2xs">
 REÇU D'INSCRIPTION — n° <span x-text="receiptReference()"></span>
 </div>
 </div>

 <!-- C. Corps du Reçu (2 Colonnes distinctes avec respiration) -->
 <div class="grid grid-cols-2 gap-6 items-start my-auto py-2">

 <!-- COLONNE GAUCHE (Informations Élève & Transaction) -->
 <div class="space-y-3 text-xs text-slate-600">
 <div class="flex justify-between items-baseline border-b border-slate-100/80 pb-2">
 <span class="text-slate-500">Matricule :</span>
 <span class="font-bold text-slate-900" x-text="receipt.matricule"></span>
 </div>
 <div class="flex justify-between items-baseline border-b border-slate-100/80 pb-2">
 <span class="text-slate-500">Nom complet :</span>
 <span class="font-bold text-slate-900" x-text="receipt.studentFullName"></span>
 </div>
 <div class="flex justify-between items-baseline border-b border-slate-100/80 pb-2">
 <span class="text-slate-500">Classe &amp; Niveau :</span>
 <span class="font-medium text-slate-800" x-text="receipt.classroomName + (receipt.classroomLevel ? ' — ' + receipt.classroomLevel : '')"></span>
 </div>
 <div class="flex justify-between items-baseline border-b border-slate-100/80 pb-2">
 <span class="text-slate-500">Année scolaire :</span>
 <span class="font-medium text-slate-800" x-text="receipt.schoolYearLabel"></span>
 </div>
 <div class="flex justify-between items-baseline border-b border-slate-100/80 pb-2" x-show="receipt.guardianName || receipt.guardianPhone" x-cloak>
 <span class="text-slate-500">Tuteur &amp; Contact :</span>
 <span class="font-medium text-slate-800" x-text="(receipt.guardianName || '—') + (receipt.guardianPhone ? ' (' + receipt.guardianPhone + ')' : '')"></span>
 </div>
 <div class="flex justify-between items-baseline pb-1">
 <span class="text-slate-500">Date &amp; Mode de règlement :</span>
 <span class="font-medium text-slate-800" x-text="formatDate(receipt.enrolledAt) + (receipt.paymentMethod ? ' — ' + paymentMethodLabel(receipt.paymentMethod) : '')"></span>
 </div>
 </div>

 <!-- COLONNE DROITE (Ventilation Comptable avec padding vertical plus aéré) -->
 <div class="flex flex-col justify-between">
 <div class="rounded-xl border border-slate-200/80 overflow-hidden shadow-2xs">
 <table class="w-full text-xs">
 <thead>
 <tr class="bg-slate-50 text-slate-600 font-medium border-b border-slate-200">
 <th class="text-left py-2.5 px-3 font-medium">Désignation des frais</th>
 <th class="text-right py-2.5 px-3 font-medium whitespace-nowrap">Montant (FCFA)</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <template x-for="line in receipt.collectedLines" :key="line.designation">
 <tr class="border-b border-slate-100">
 <td class="py-2.5 px-3 text-slate-700" x-text="collectedLabel(line)"></td>
 <td class="py-2.5 px-3 text-right font-medium text-slate-900" x-text="formatMoney(line.amount)"></td>
 </tr>
 </template>
 <tr x-show="receipt.collectedLines.length === 0" x-cloak class="border-b border-slate-100">
 <td class="py-2.5 px-3 text-slate-400 italic">Aucun frais encaissé ce jour</td>
 <td class="py-2.5 px-3 text-right font-medium text-slate-400">0 FCFA</td>
 </tr>
 <tr class="bg-indigo-50/50 text-indigo-950 font-bold border-t border-indigo-100">
 <td class="py-2.5 px-3 uppercase text-xs">Total encaissé</td>
 <td class="py-2.5 px-3 text-right text-sm" x-text="formatMoney(receipt.totalCollected)"></td>
 </tr>
 </tbody>
 </table>
 </div>
 <div class="mt-3 text-[11px] text-slate-500 flex justify-between items-center px-1">
 <span>Frais annuels : <strong class="font-semibold text-slate-700" x-text="formatMoney(receipt.totalDue)"></strong></span>
 <span class="text-slate-300">|</span>
 <span>Reste à payer : <strong class="font-semibold text-slate-700" x-text="formatMoney(receipt.totalDue - receipt.totalCollected)"></strong></span>
 </div>
 </div>

 </div>

 <!-- D. Pied de Page (Footer poussé tout en bas via margin-top: auto) -->
 <div class="receipt-footer mt-auto pt-3 border-t border-slate-100">
 <!-- Note d'information (au centre) -->
 <p class="text-center text-xs italic text-slate-400 mb-3">
 Il est demandé aux parents de garder minutieusement leur reçu après le paiement.
 </p>
 <!-- Zone Basse (2 blocs côte à côte) -->
 <div class="flex justify-between items-start text-xs">
 <div>
 <p class="text-slate-600 font-medium" x-text="faitMention()"></p>
 <div class="mt-2 w-32 h-14 border border-dashed border-slate-300 rounded-lg flex items-center justify-center text-[10px] text-slate-400">Cachet officiel</div>
 </div>
 <div class="text-right">
 <p class="text-slate-600 font-medium">Signature du Directeur / Service Financier</p>
 <div class="mt-12 w-48 border-b border-slate-300 ml-auto"></div>
 </div>
 </div>
 </div>

 </div>
 </div>

 </div>

 @* Fenêtre de confirmation affichée juste après l'enregistrement (avant le reçu) : elle annonce que
 l'inscription est validée, puis laisse le choix entre imprimer le reçu ou terminer. Non imprimée
 (.no-print) — de toute façon elle est fermée au moment d'imprimer le reçu. *@
 <div class="no-print">
 <modal-shell open="showConfirmDialog" size="md" on-close="finishFromDialog()" title="Inscription validée">
 <confirm-dialog-body close-action="finishFromDialog()" close-label="Terminer"
 new-action="showReceiptFromDialog()" new-label="Imprimer le reçu">
 L'inscription de <span class="font-medium text-slate-900" x-text="receipt ? receipt.studentFullName : ''"></span>
 a bien été validée — reçu n° <span class="font-medium text-slate-900" x-text="receiptReference()"></span>.
 </confirm-dialog-body>
 </modal-shell>

 <!-- Modale de prévisualisation PDF et actions (Ticket JGK-F02 / Axe 4) -->
 @await Html.PartialAsync("_PdfPreviewModal")
 </div>
</div>
