@{
    ViewData["Title"] = "Tableau de bord";
}

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

<div x-data="mainDashboard()" x-cloak class="pb-10">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-jgk-title font-bold text-slate-900">Tableau de bord</h1>
            <p class="text-jgk-subtitle text-slate-500 mt-1">Vue consolidée des activités et finances.</p>
        </div>
    </div>

    @await Html.PartialAsync("_ErrorBanner")

    <!-- 1. GRILLE DE KPI (HAUT DE PAGE) - RESTRUCTURATION 4 COLONNES -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        
        <!-- Pédagogie (4 cartes) -->
        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="analyticsRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Élèves inscrits</p>
                <div class="mt-1 flex items-baseline gap-2">
                    <p class="text-2xl font-bold text-slate-900" x-text="analyticsData?.enrollments?.total || 0"></p>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">Garçons : <span class="font-semibold text-slate-700" x-text="analyticsData?.enrollments?.boys || 0"></span> | Filles : <span class="font-semibold text-slate-700" x-text="analyticsData?.enrollments?.girls || 0"></span></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
                <icon name="users" class="w-5 h-5 text-indigo-600"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="analyticsRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Enseignants actifs</p>
                <p class="text-2xl font-bold text-slate-900 mt-1" x-text="analyticsData?.activeTeachers || 0"></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
                <icon name="book" class="w-5 h-5 text-indigo-600"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="analyticsRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Taux de présence (Mois)</p>
                <p class="text-2xl font-bold text-emerald-600 mt-1" x-text="formatPercent(analyticsData?.attendanceRate)"></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
                <icon name="checkmark-circle" class="w-5 h-5 text-emerald-600"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="analyticsRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Salles occupées</p>
                <p class="text-2xl font-bold text-indigo-600 mt-1" x-text="formatPercent(analyticsData?.todayOccupancyRate)"></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
                <icon name="home" class="w-5 h-5 text-indigo-600"></icon>
            </div>
        </div>

        <!-- Finance (4 cartes majeures) -->
        @* Les 4 indicateurs financiers MAJEURS (Solde Net, Encaissements, Décaissements, Reste à
           recouvrer) portent une bordure d'accent + une ombre plus marquée que les cartes secondaires
           ci-dessous, pour une hiérarchie visuelle claire — même grille, même ordre, même palette,
           seule l'emphase change. *@
        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 border-l-4 border-l-success shadow-md flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg cursor-pointer" x-show="financeRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Solde Net</p>
                <p class="text-2xl font-bold text-success mt-1" x-text="formatMoney(financeData?.realBalance)"></p>
            </div>
            <div class="w-12 h-12 rounded-full bg-success/10 flex items-center justify-center shrink-0">
                <icon name="cash" class="w-6 h-6 text-success"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 border-l-4 border-l-indigo-600 shadow-md flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg cursor-pointer" x-show="financeRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Encaissement (Année)</p>
                <p class="text-2xl font-bold text-indigo-600 mt-1" x-text="formatMoney(financeData?.collectedThisYear)"></p>
            </div>
            <div class="w-12 h-12 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
                <icon name="wallet" class="w-6 h-6 text-indigo-600"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 border-l-4 border-l-danger shadow-md flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg cursor-pointer" x-show="financeRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Décaissements</p>
                <p class="text-2xl font-bold text-danger mt-1" x-text="formatMoney(financeData?.totalDisbursements)"></p>
            </div>
            <div class="w-12 h-12 rounded-full bg-danger/10 flex items-center justify-center shrink-0">
                <icon name="arrow-down" class="w-6 h-6 text-danger"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 border-l-4 border-l-warning shadow-md flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg cursor-pointer" x-show="financeRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Reste à recouvrer</p>
                <p class="text-2xl font-bold text-warning mt-1" x-text="formatMoney(financeData?.outstandingBalance)"></p>
            </div>
            <div class="w-12 h-12 rounded-full bg-amber-50 flex items-center justify-center shrink-0">
                <icon name="alert-circle" class="w-6 h-6 text-warning"></icon>
            </div>
        </div>

        <!-- Finance (4 cartes secondaires) -->

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="financeRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Encaissement (Aujourd'hui)</p>
                <p class="text-2xl font-bold text-indigo-600 mt-1" x-text="formatMoney(financeData?.collectedToday)"></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
                <icon name="wallet" class="w-5 h-5 text-indigo-600"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="financeRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Encaissement (Mois)</p>
                <p class="text-2xl font-bold text-indigo-600 mt-1" x-text="formatMoney(financeData?.collectedThisMonth)"></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center shrink-0">
                <icon name="wallet" class="w-5 h-5 text-indigo-600"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="financeRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Attendu (Mois)</p>
                <p class="text-2xl font-bold text-slate-600 mt-1" x-text="formatMoney(financeData?.expectedThisMonth)"></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center shrink-0">
                <icon name="calendar" class="w-5 h-5 text-slate-500"></icon>
            </div>
        </div>

        <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="financeRole">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Taux Recouvrement</p>
                <p class="text-2xl font-bold text-emerald-600 mt-1" x-text="formatPercent(financeData?.recoveryRate)"></p>
            </div>
            <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
                <icon name="trending-up" class="w-5 h-5 text-emerald-600"></icon>
            </div>
        </div>

    </div>

    <!-- 2. SECTION BASSE - RESTRUCTURATION (2 colonnes 50/50) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- COLONNE GAUCHE : Vie Scolaire & Planning -->
        <div class="w-full bg-white p-6 rounded-xl border border-slate-200 shadow-sm transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="analyticsRole">
            <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
                <h2 class="text-[19px] font-bold text-slate-900">Vie Scolaire & Planning</h2>
            </div>
            
            <template x-if="isAnalyticsLoading">
                <div class="w-full h-48 skeleton rounded-lg"></div>
            </template>
            <template x-if="!isAnalyticsLoading && analyticsData">
                <div class="flex flex-col space-y-5">
                    
                    <!-- Graphique & Salles -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Donut Genre -->
                        <div class="flex flex-col items-center justify-center bg-slate-50/80 rounded-xl p-4 border border-slate-100 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer">
                             <div class="relative w-20 h-20 shrink-0 mb-3">
                                 <svg viewBox="0 0 36 36" class="w-full h-full -rotate-90">
                                     <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#E5E7EB" stroke-width="4"></circle>
                                     <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#1D4ED8" stroke-width="4" stroke-linecap="round" :stroke-dasharray="boysFraction() + ' ' + (100 - boysFraction())"></circle>
                                     <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#BE185D" stroke-width="4" stroke-linecap="round" :stroke-dasharray="girlsFraction() + ' ' + (100 - girlsFraction())" :stroke-dashoffset="-boysFraction()"></circle>
                                 </svg>
                             </div>
                             <div class="w-full flex justify-between text-xs px-2">
                                 <div class="flex items-center gap-1.5">
                                     <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                                     <span class="text-slate-600 font-medium">G: <span class="font-bold text-slate-900" x-text="analyticsData.enrollments.boys"></span></span>
                                 </div>
                                 <div class="flex items-center gap-1.5">
                                     <span class="w-2.5 h-2.5 rounded-full bg-pink-600"></span>
                                     <span class="text-slate-600 font-medium">F: <span class="font-bold text-slate-900" x-text="analyticsData.enrollments.girls"></span></span>
                                 </div>
                             </div>
                        </div>
                        
                        <!-- Indicateurs -->
                        <div class="flex flex-col justify-center gap-3 w-full">
                             <!-- Gauge Présence -->
                             <div class="bg-emerald-50 px-4 py-3 rounded-xl border border-emerald-100 flex items-center justify-between gap-3 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer">
                                 <div>
                                     <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wide block">Présence</span>
                                     <span class="text-base font-black text-emerald-800" x-text="formatPercent(analyticsData.attendanceRate)"></span>
                                 </div>
                                 <div class="relative w-10 h-10 shrink-0">
                                     <svg viewBox="0 0 36 36" class="w-full h-full -rotate-90">
                                         <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#D1FAE5" stroke-width="4"></circle>
                                         <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#059669" stroke-width="4" stroke-linecap="round" :stroke-dasharray="pctVal(analyticsData.attendanceRate, 1) + ' 100'"></circle>
                                     </svg>
                                 </div>
                             </div>
                             <!-- Gauge Salles Occupées -->
                             <div class="bg-indigo-50 px-4 py-3 rounded-xl border border-indigo-100 flex items-center justify-between gap-3 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer">
                                 <div>
                                     <span class="text-[10px] font-bold text-indigo-700 uppercase tracking-wide block">Salles Occupées</span>
                                     <span class="text-base font-black text-indigo-800" x-text="formatPercent(analyticsData.todayOccupancyRate)"></span>
                                 </div>
                                 <div class="relative w-10 h-10 shrink-0">
                                     <svg viewBox="0 0 36 36" class="w-full h-full -rotate-90">
                                         <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#E0E7FF" stroke-width="4"></circle>
                                         <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#4F46E5" stroke-width="4" stroke-linecap="round" :stroke-dasharray="pctVal(analyticsData.todayOccupancyRate, 1) + ' 100'"></circle>
                                     </svg>
                                 </div>
                             </div>
                        </div>
                    </div>
                    
                    <!-- Prochains cours -->
                    <div class="pt-3 border-t border-slate-100">
                        <div class="flex items-center justify-between mb-3">
                            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Prochains cours (Aujourd'hui)</p>
                        </div>
                        <div class="max-h-[160px] overflow-y-auto pr-1 scrollbar-hide">
                            <ul class="space-y-2.5">
                                <template x-for="(cls, idx) in analyticsData.nextClasses" :key="idx">
                                    <li class="flex items-center gap-3 text-xs bg-slate-50/80 p-2.5 rounded-lg border border-slate-100">
                                        <span class="font-mono font-semibold text-indigo-700 bg-indigo-100/50 px-2 py-1 rounded border border-indigo-100 shrink-0" x-text="cls.startTime"></span>
                                        <div class="min-w-0 flex-1">
                                            <p class="font-bold text-slate-800 truncate" x-text="cls.subjectName"></p>
                                            <p class="text-[10px] text-slate-500 truncate mt-0.5" x-text="cls.teacherName"></p>
                                        </div>
                                        <span class="font-semibold text-slate-600 bg-white px-2.5 py-1 rounded-full border border-slate-200 shadow-2xs shrink-0" x-text="cls.roomNumber"></span>
                                    </li>
                                </template>
                                <template x-if="!analyticsData.nextClasses || analyticsData.nextClasses.length === 0">
                                    <li class="text-xs text-slate-400 text-center py-6 bg-slate-50 rounded-lg border border-dashed border-slate-200">Aucun cours à venir.</li>
                                </template>
                            </ul>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <!-- COLONNE DROITE : Trésorerie & Bilan -->
        <div class="w-full bg-white p-6 rounded-xl border border-slate-200 shadow-sm transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="financeRole">
            <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
                <h2 class="text-[19px] font-bold text-slate-900">Trésorerie & Bilan</h2>
                <nav class="flex p-1 space-x-1 bg-slate-100 rounded-lg" role="tablist">
                    <button type="button" role="tab" x-on:click="activeTab = 'synth'"
                            :class="activeTab === 'synth' ? 'bg-white text-indigo-600 font-semibold shadow-xs' : 'text-slate-600 font-medium hover:text-slate-900'"
                            class="px-3 py-1.5 rounded-md text-xs transition-all duration-200 hover:bg-indigo-50 hover:text-indigo-600 active:scale-95">
                        Synthèse
                    </button>
                    <button type="button" role="tab" x-on:click="activeTab = 'expenses'"
                            :class="activeTab === 'expenses' ? 'bg-white text-indigo-600 font-semibold shadow-xs' : 'text-slate-600 font-medium hover:text-slate-900'"
                            class="px-3 py-1.5 rounded-md text-xs transition-all duration-200 hover:bg-indigo-50 hover:text-indigo-600 active:scale-95">
                        Décaissements
                    </button>
                </nav>
            </div>
            
            <template x-if="isFinanceLoading">
                <div class="w-full h-48 skeleton rounded-lg"></div>
            </template>
            <template x-if="!isFinanceLoading && financeData">
                <div>
                    
                    <!-- TAB 1 : SYNTHÈSE (CORRECTION OBLIGATOIRE APPLIQUÉE) -->
                    <div x-show="activeTab === 'synth'" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        
                        <!-- Bilan Annuel Global -->
                        <div class="w-full h-auto p-4 bg-slate-50 rounded-lg border border-slate-100 flex flex-col justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer">
                            <div>
                                <span class="text-sm font-bold text-slate-900 block mb-2 uppercase">Exercice Actif</span>
                                <div class="flex items-center gap-4 mb-4">
                                    <div class="relative w-14 h-14 shrink-0">
                                        <svg viewBox="0 0 36 36" class="w-full h-full -rotate-90">
                                            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#E5E7EB" stroke-width="4"></circle>
                                            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#4F46E5" stroke-width="4" stroke-linecap="round" :stroke-dasharray="pctVal(financeData.recoveryRate || financeData.yearlyRecoveryRate, 1) + ' 100'"></circle>
                                        </svg>
                                        <div class="absolute inset-0 flex items-center justify-center">
                                            <span class="text-[10px] font-bold text-slate-700" x-text="formatPercent(financeData.recoveryRate || financeData.yearlyRecoveryRate)"></span>
                                        </div>
                                    </div>
                                    <div>
                                        <span class="text-[10px] font-semibold text-slate-500 uppercase tracking-wide block">Recouvrement</span>
                                        <span class="text-xl font-bold text-indigo-600 block" x-text="formatPercent(financeData.recoveryRate || financeData.yearlyRecoveryRate)"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="flex flex-col gap-2">
                                <div class="bg-white p-2.5 rounded border border-slate-100 shadow-sm flex items-center justify-between">
                                    <span class="text-xs font-semibold text-slate-500 uppercase">Encaissé</span>
                                    <span class="text-sm font-bold text-slate-900" x-text="formatMoney(financeData.collectedThisYear)"></span>
                                </div>
                                <div class="bg-white p-2.5 rounded border border-slate-100 shadow-sm flex items-center justify-between">
                                    <span class="text-xs font-semibold text-slate-500 uppercase">Attendu</span>
                                    <span class="text-sm font-bold text-warning" x-text="formatMoney(financeData.outstandingBalance)"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Bilan Mensuel -->
                        <div class="w-full h-auto p-4 bg-slate-50 rounded-lg border border-slate-100 flex flex-col justify-between transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer">
                            <div>
                                <span class="text-sm font-bold text-slate-900 block mb-2 uppercase">Mois en cours</span>
                                <div class="flex items-center gap-4 mb-4">
                                    <div class="relative w-14 h-14 shrink-0">
                                        <svg viewBox="0 0 36 36" class="w-full h-full -rotate-90">
                                            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#E5E7EB" stroke-width="4"></circle>
                                            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#059669" stroke-width="4" stroke-linecap="round" :stroke-dasharray="pctVal(financeData.monthlyRecoveryRate || (financeData.expectedThisMonth ? (financeData.collectedThisMonth / financeData.expectedThisMonth) : 0), 1) + ' 100'"></circle>
                                        </svg>
                                        <div class="absolute inset-0 flex items-center justify-center">
                                            <span class="text-[10px] font-bold text-slate-700" x-text="formatPercent(financeData.monthlyRecoveryRate || (financeData.expectedThisMonth ? (financeData.collectedThisMonth / financeData.expectedThisMonth) : 0))"></span>
                                        </div>
                                    </div>
                                    <div>
                                        <span class="text-[10px] font-semibold text-slate-500 uppercase tracking-wide block">Recouvrement</span>
                                        <span class="text-xl font-bold text-emerald-600 block" x-text="formatPercent(financeData.monthlyRecoveryRate || (financeData.expectedThisMonth ? (financeData.collectedThisMonth / financeData.expectedThisMonth) : 0))"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="flex flex-col gap-2">
                                <div class="bg-white p-2.5 rounded border border-slate-100 shadow-sm flex items-center justify-between">
                                    <span class="text-xs font-semibold text-slate-500 uppercase">Encaissé</span>
                                    <span class="text-sm font-bold text-slate-900" x-text="formatMoney(financeData.collectedThisMonth)"></span>
                                </div>
                                <div class="bg-white p-2.5 rounded border border-slate-100 shadow-sm flex items-center justify-between">
                                    <span class="text-xs font-semibold text-slate-500 uppercase">Attendu</span>
                                    <span class="text-sm font-bold text-slate-600" x-text="formatMoney(financeData.expectedThisMonth)"></span>
                                </div>
                            </div>
                        </div>
                        
                    </div>

                    <!-- TAB 2 : DÉCAISSEMENTS -->
                    <div x-show="activeTab === 'expenses'" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="w-full h-auto p-4 bg-slate-50 rounded-lg border border-slate-100 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer">
                            <p class="text-xs font-bold uppercase text-slate-500 text-center tracking-wide mb-3">Entrées vs Sorties</p>
                            <div class="space-y-4">
                                <div>
                                    <div class="flex justify-between text-xs mb-1">
                                        <span class="text-slate-600 font-medium">Encaissements</span>
                                        <span class="font-bold text-success" x-text="formatMoney(financeData.collectedThisYear)"></span>
                                    </div>
                                    <div class="h-2 rounded-full bg-slate-200"><div class="h-full rounded-full bg-success" :style="'width: ' + pctVal(financeData.collectedThisYear, financeData.collectedThisYear + financeData.totalDisbursements) + '%'"></div></div>
                                </div>
                                <div>
                                    <div class="flex justify-between text-xs mb-1">
                                        <span class="text-slate-600 font-medium">Décaissements</span>
                                        <span class="font-bold text-danger" x-text="formatMoney(financeData.totalDisbursements)"></span>
                                    </div>
                                    <div class="h-2 rounded-full bg-slate-200"><div class="h-full rounded-full bg-danger" :style="'width: ' + pctVal(financeData.totalDisbursements, financeData.collectedThisYear + financeData.totalDisbursements) + '%'"></div></div>
                                </div>
                            </div>
                        </div>

                        <div class="w-full h-auto p-4 bg-slate-50 rounded-lg border border-slate-100 flex flex-col sm:flex-row items-center gap-4 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer">
                            <!-- Graphique Donut -->
                            <div class="relative w-24 h-24 shrink-0">
                                @* 7 <circle> fixes plutôt qu'un <template x-for="segment in ...">  : le contenu
                                   d'un <template> est TOUJOURS analysé en namespace HTML, même quand ce
                                   <template> est lui-même un enfant de <svg> — un <circle> qui en sort n'est
                                   donc pas un SVGCircleElement mais un élément inconnu, invisible sans la
                                   moindre erreur visible à l'écran (seule la console révélait "segment is not
                                   defined" / "reading 'children'"). disbursementSegments() (dashboard.js)
                                   retourne désormais un tableau de longueur fixe pour cette raison — même
                                   correctif que paymentMethodSegments() (financial-report.js). *@
                                <svg viewBox="0 0 36 36" class="w-full h-full -rotate-90 drop-shadow-sm">
                                    <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#E5E7EB" stroke-width="4"></circle>
                                    <circle cx="18" cy="18" r="15.9155" fill="none" :stroke="disbursementSegments()[0].color" stroke-width="4" stroke-linecap="round" :stroke-dasharray="disbursementSegments()[0].fraction + ' ' + (100 - disbursementSegments()[0].fraction)" :stroke-dashoffset="disbursementSegments()[0].offset" class="transition-all duration-500 ease-out"></circle>
                                    <circle cx="18" cy="18" r="15.9155" fill="none" :stroke="disbursementSegments()[1].color" stroke-width="4" stroke-linecap="round" :stroke-dasharray="disbursementSegments()[1].fraction + ' ' + (100 - disbursementSegments()[1].fraction)" :stroke-dashoffset="disbursementSegments()[1].offset" class="transition-all duration-500 ease-out"></circle>
                                    <circle cx="18" cy="18" r="15.9155" fill="none" :stroke="disbursementSegments()[2].color" stroke-width="4" stroke-linecap="round" :stroke-dasharray="disbursementSegments()[2].fraction + ' ' + (100 - disbursementSegments()[2].fraction)" :stroke-dashoffset="disbursementSegments()[2].offset" class="transition-all duration-500 ease-out"></circle>
                                    <circle cx="18" cy="18" r="15.9155" fill="none" :stroke="disbursementSegments()[3].color" stroke-width="4" stroke-linecap="round" :stroke-dasharray="disbursementSegments()[3].fraction + ' ' + (100 - disbursementSegments()[3].fraction)" :stroke-dashoffset="disbursementSegments()[3].offset" class="transition-all duration-500 ease-out"></circle>
                                    <circle cx="18" cy="18" r="15.9155" fill="none" :stroke="disbursementSegments()[4].color" stroke-width="4" stroke-linecap="round" :stroke-dasharray="disbursementSegments()[4].fraction + ' ' + (100 - disbursementSegments()[4].fraction)" :stroke-dashoffset="disbursementSegments()[4].offset" class="transition-all duration-500 ease-out"></circle>
                                    <circle cx="18" cy="18" r="15.9155" fill="none" :stroke="disbursementSegments()[5].color" stroke-width="4" stroke-linecap="round" :stroke-dasharray="disbursementSegments()[5].fraction + ' ' + (100 - disbursementSegments()[5].fraction)" :stroke-dashoffset="disbursementSegments()[5].offset" class="transition-all duration-500 ease-out"></circle>
                                    <circle cx="18" cy="18" r="15.9155" fill="none" :stroke="disbursementSegments()[6].color" stroke-width="4" stroke-linecap="round" :stroke-dasharray="disbursementSegments()[6].fraction + ' ' + (100 - disbursementSegments()[6].fraction)" :stroke-dashoffset="disbursementSegments()[6].offset" class="transition-all duration-500 ease-out"></circle>
                                </svg>
                            </div>
                            
                            <!-- Légende -->
                            <div class="flex-1 w-full">
                                <p class="text-xs font-bold uppercase text-slate-500 tracking-wide mb-2 text-center sm:text-left">Catégories</p>
                                <template x-if="financeData.totalDisbursements > 0">
                                    <ul class="grid grid-cols-1 gap-1.5 max-h-[100px] overflow-y-auto pr-1 scrollbar-hide">
                                      <template x-for="(cat, idx) in financeData.disbursementsByCategory" :key="cat.category">
                                        <li class="flex items-center justify-between text-[11px] bg-white px-2 py-1.5 rounded shadow-sm border border-slate-100">
                                          <div class="flex items-center gap-1.5 min-w-0">
                                            <span class="w-2 h-2 rounded-full shrink-0" :style="'background-color: ' + getCategoryColor(idx)"></span>
                                            <span class="text-slate-600 font-medium truncate" x-text="cat.category"></span>
                                          </div>
                                          <span class="font-bold text-slate-900 ml-2 shrink-0" x-text="pct(cat.amount, financeData.totalDisbursements)"></span>
                                        </li>
                                      </template>
                                    </ul>
                                </template>
                                <template x-if="!financeData.totalDisbursements || financeData.totalDisbursements === 0">
                                    <p class="text-xs text-slate-400 italic text-center sm:text-left">Aucune dépense</p>
                                </template>
                            </div>
                        </div>
                    </div>

                </div>
            </template>
        </div>
    </div>
    
    <!-- 3. FLUX & DERNIERS PAIEMENTS -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm mt-6 transition-all duration-200 ease-in-out hover:-translate-y-1 hover:shadow-md cursor-pointer" x-show="financeRole">
        <div class="p-5 border-b border-slate-200 bg-slate-50/50 rounded-t-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
             <div>
                 <p class="text-sm font-semibold text-slate-900">Derniers paiements</p>
                 <p class="text-xs text-slate-500 mt-0.5">Les 10 versements les plus récents encaissés à la caisse.</p>
             </div>
             <div class="relative w-full sm:max-w-xs">
                 <span aria-hidden="true" class="absolute inset-y-0 left-0 flex items-center pl-3">
                     <icon name="search" class="w-4 h-4 text-slate-400" />
                 </span>
                 <input type="search" x-model="search" placeholder="Élève, matricule, reçu…"
                        class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm shadow-sm focus:border-primary focus:ring-primary transition-all duration-200">
             </div>
        </div>

        <div class="overflow-x-auto">
             <table class="w-full text-left border-collapse table-auto text-sm">
                 <thead>
                     <tr class="table-head">
                         <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Élève</th>
                         <th class="py-3.5 px-4 whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Matricule</th>
                         <th class="py-3.5 px-4 whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Reçu N°</th>
                         <th class="py-3.5 px-4 text-right whitespace-nowrap uppercase tracking-wider text-slate-500 font-semibold">Montant</th>
                         <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Mode</th>
                         <th class="py-3.5 px-4 uppercase tracking-wider text-slate-500 font-semibold">Date</th>
                         <th class="py-3.5 px-4 w-12 uppercase tracking-wider text-slate-500 font-semibold"><span class="sr-only">Action</span></th>
                     </tr>
                 </thead>
                 <tbody class="divide-y divide-slate-100">
                     <template x-if="isFinanceLoading">
                         <tr><td colspan="7" class="p-6"><div class="skeleton h-10 w-full rounded-lg"></div></td></tr>
                     </template>
                     <template x-for="payment in filteredPayments()" :key="payment.paymentId">
                         <tr class="hover:bg-slate-50 transition-colors">
                             <td class="py-3 px-4">
                                 <span class="inline-flex items-center gap-2.5">
                                     <span class="w-8 h-8 shrink-0 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold uppercase"
                                           x-text="initials(payment.studentFullName)"></span>
                                     <span class="font-semibold text-slate-900" x-text="payment.studentFullName"></span>
                                 </span>
                             </td>
                             <td class="py-3 px-4 font-mono text-xs text-slate-500 whitespace-nowrap" x-text="payment.matricule"></td>
                             <td class="py-3 px-4 font-mono text-xs text-slate-500 whitespace-nowrap" x-text="payment.receiptNumber"></td>
                             <td class="py-3 px-4 text-right font-bold text-slate-900 whitespace-nowrap" x-text="formatMoney(payment.amount)"></td>
                             <td class="py-3 px-4"><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-semibold" x-text="methodLabel(payment.method)"></span></td>
                             <td class="py-3 px-4 text-slate-500 text-xs whitespace-nowrap" x-text="formatDate(payment.paidAt)"></td>
                             <td class="py-3 px-4 text-right whitespace-nowrap">
                                 <button type="button" x-on:click="previewReceipt(payment.paymentId, payment.receiptNumber)"
                                         class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-indigo-50 hover:text-indigo-600 active:scale-95 text-slate-700 text-xs font-semibold shadow-sm transition-all duration-200">
                                     <icon name="document-text" class="w-4 h-4 text-indigo-600" />
                                     <span>Aperçu</span>
                                 </button>
                             </td>
                         </tr>
                     </template>
                 </tbody>
             </table>
        </div>
    </div>

    <!-- Modale PDF ... -->
    @await Html.PartialAsync("_PdfPreviewModal")
</div>
